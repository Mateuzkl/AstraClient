/* Native RmlUi chrome. Spell images are the existing Astra 32px atlas, not new art. */
body { font-family: Barlow; font-size: 16dp; color: #c0c5c7; }
.skill-window { position: relative; display: flex; flex-direction: column; width: 100%; height: 100%; box-sizing: border-box; padding: 8dp; border: 2dp #96713b; border-radius: 15dp; background-color: #080e13fa; }
.rim { position: absolute; left: 14dp; right: 14dp; height: 1dp; background-color: #d5a65b; }
.rim-top { top: 4dp; }.rim-bottom { bottom: 4dp; }
.corner { position: absolute; width: 14dp; height: 14dp; border: 2dp #e1b865; background-color: #111a20; transform: rotate(45deg); }
.top-left { top: 6dp; left: 6dp; }.top-right { top: 6dp; right: 6dp; }.bottom-left { bottom: 6dp; left: 6dp; }.bottom-right { bottom: 6dp; right: 6dp; }
.skill-header { position: relative; display: flex; align-items: center; flex: 0 0 77dp; padding: 0 12dp; border: 1dp #514631; border-radius: 7dp 7dp 0 0; background-color: #0b141cf5; }
.brand { width: 196dp; flex: 0 0 196dp; }.brand-name { display: block; font-family: Cinzel; font-size: 25dp; color: #ead3a3; letter-spacing: 6dp; }.brand-sub { display: block; color: #71828f; font-size: 9dp; letter-spacing: 2dp; margin-top: 4dp; }
.heading { position: absolute; left: 24%; right: 30%; top: 0; height: 77dp; text-align: center; }
h1 { font-family: Cinzel; font-size: 31dp; font-weight: normal; color: #f4d38a; margin: 24dp 0 0 0; text-align: center; }
.heading-line { height: 1dp; margin: 5dp 38dp 0 38dp; background-color: #8f6b32; }
.crown { position: absolute; width: 48dp; height: 18dp; left: 50%; margin-left: -24dp; top: 4dp; border-bottom: 1dp #c09850; transform: rotate(0deg); }
.gem { width: 14dp; height: 14dp; margin: 2dp auto; transform: rotate(45deg); border: 2dp #edc878; background-color: #24bceb; }
.point-bank { margin-left: auto; display: flex; align-items: center; height: 36dp; padding: 0 10dp 0 14dp; border: 1dp #766140; background-color: #070c11; border-radius: 4dp; }
.point-bank span { font-size: 16dp; color: #e2dfd4; }.point-bank b { color: #36c7f1; font-size: 29dp; margin-left: 12dp; min-width: 20dp; }
.grant { color: #a4bfcd; background-color: #101e29; border: 1dp #2c4b5b; margin-left: 10dp; width: 43dp; height: 24dp; padding: 0; font-size: 12dp; border-radius: 3dp; }.grant:hover { color: #ffffff; border-color: #3ac6f4; }
.header-button { width: 28dp; height: 28dp; padding: 0; line-height: 25dp; text-align: center; border: 1dp #9c7840; border-radius: 4dp; margin-left: 8dp; font-family: Cinzel; font-size: 22dp; background-color: #211b12; color: #eed49e; }.header-button:hover { background-color: #4b3820; }.header-button.close { background-color: #411a17; border-color: #ae5441; color: #f58b78; font-family: Barlow; font-size: 29dp; }.header-button.close:hover { background-color: #74261e; }
.skill-body { display: flex; flex: 1; min-height: 0; padding-top: 7dp; padding-bottom: 7dp; }
.category-panel { display: flex; flex-direction: column; flex: 0 0 198dp; width: 198dp; padding: 10dp 8dp 8dp 8dp; border: 1dp #695333; background-color: #09131af0; overflow: hidden; }
.section-eyebrow { font-size: 10dp; letter-spacing: 1dp; color: #8c836e; margin: 2dp 0 11dp 2dp; text-align: center; }
.category { display: flex; align-items: center; position: relative; width: 100%; height: 57dp; box-sizing: border-box; margin-bottom: 9dp; padding: 4dp 12dp 4dp 8dp; border: 1dp #465260; border-radius: 3dp; background-color: #0b1822; color: #b5c8d6; font-family: Cinzel; font-size: 17dp; text-align: left; }
.category-icon { width: 36dp; height: 36dp; flex: 0 0 36dp; margin-right: 10dp; }.category-notch { margin-left: auto; width: 5dp; height: 5dp; border: 1dp #71603c; transform: rotate(45deg); }
.category:hover { border-color: #ad8f54; color: #ffdf9d; background-color: #1e2524; }.category.selected { border: 2dp #dcac56; background-color: #372512; color: #ffe3ab; }.category.selected .category-notch { color: #f6cd7e; }
.character-card { position: relative; flex: 1; min-height: 0; overflow: hidden; margin-top: 1dp; }
.character-art { position: absolute; top: 0; width: 100%; height: 270dp; decorator: image(st-warrior cover); opacity: 0.76; }.character-shade { position: absolute; left: 0; right: 0; top: 145dp; height: 130dp; background-color: #09131aab; }
.role-plaque { position: relative; text-align: center; font-family: Cinzel; color: #efc77b; font-size: 20dp; padding: 5dp 2dp; border-top: 1dp #9e7940; border-bottom: 1dp #9e7940; background-color: #090f13db; margin-top: 206dp; }
.character-card p { position: relative; font-size: 16dp; line-height: 22dp; padding: 0 8dp; margin: 12dp 0 8dp; color: #8e9ba6; }
.demo-character { position: relative; display: flex; align-items: center; gap: 8dp; justify-content: center; font-size: 12dp; color: #869baa; }.demo-character b { color: #e2c788; font-size: 14dp; }
.small-gem { width: 6dp; height: 6dp; transform: rotate(45deg); border: 1dp #4bc0e4; background-color: #176e98; }
.local-tag { display: flex; align-items: center; justify-content: center; gap: 6dp; font-size: 9dp; color: #7d9891; height: 22dp; letter-spacing: 0.8dp; }.local-dot { width: 5dp; height: 5dp; border-radius: 3dp; background-color: #70b59a; }
.tree-panel { position: relative; display: flex; flex-direction: column; flex: 1; min-width: 0; margin: 0 7dp; border: 1dp #5b4b30; background-color: #070f16; }
.tree-topline { display: flex; align-items: center; justify-content: space-between; flex: 0 0 26dp; padding: 0 14dp; font-size: 10dp; letter-spacing: 1dp; color: #637481; border-bottom: 1dp #25303a; background-color: #0b141b; }.tree-topline span:first-child { color: #b7a37d; text-transform: uppercase; }
.tree-viewport { position: relative; flex: 1; min-height: 0; overflow: hidden; }
.tree-canvas { position: absolute; width: 720dp; height: 770dp; transform-origin: 0 0; }
.tree-watermark { position: absolute; left: 50%; top: 50%; width: 400dp; height: 560dp; margin-left: -200dp; margin-top: -280dp; opacity: 0.22; }
.sigil-outer { position: absolute; left: 55dp; top: 80dp; width: 280dp; height: 280dp; border: 1dp #425260; transform: rotate(45deg); }.sigil-inner { position: absolute; left: 84dp; top: 109dp; width: 222dp; height: 222dp; border: 1dp #425260; transform: rotate(45deg); }.sigil-blade { position: absolute; left: 192dp; top: 0; width: 14dp; height: 500dp; background-color: #263d4f; border: 1dp #4f5e69; }
.connection { position: absolute; background-color: #2c3d49; pointer-events: none; opacity: 0.5; }.connection.green { background-color: #6fdc76; }.connection.blue { background-color: #39b7f2; }.connection.gold { background-color: #cfa84e; }.connection.active { opacity: 0.85; }.connection.on-path { opacity: 1; }.connection.on-path:not(.green):not(.blue):not(.gold) { background-color: #a0804c; }
.skill-node { position: absolute; width: 72dp; height: 72dp; border-radius: 40dp; border: 2dp #52616c; background-color: #0a1018; padding: 0; color: #d4dce0; overflow: visible; }
.node-inner { position: absolute; left: 5dp; top: 5dp; width: 58dp; height: 58dp; border: 1dp #394957; border-radius: 32dp; background-color: #06121b; }.node-icon { width: 46dp; height: 46dp; margin: 5dp; }
.node-jewel { position: absolute; left: 30dp; top: -6dp; width: 7dp; height: 7dp; transform: rotate(45deg); border: 1dp #7b8790; background-color: #152b36; }
.node-diamond { display: none; }.skill-node.owned.green { border-color: #77d676; }.skill-node.owned.blue { border-color: #40bff0; }.skill-node.gold { border-color: #b98e48; }
.skill-node.owned.green .node-jewel { background-color: #8bf48c; border-color: #c7ffc4; }.skill-node.owned.blue .node-jewel { background-color: #51cdf9; border-color: #bbf5ff; }.skill-node.gold .node-jewel { background-color: #e2b650; border-color: #f4de91; }
.skill-node.available:not(.owned) { border-color: #c0a56a; }.skill-node:hover { border-color: #ffe2a5; background-color: #263129; }.skill-node.selected { border: 3dp #f6cb68; background-color: #4c2d0d; }.skill-node.selected .node-inner { left: 4dp; top: 4dp; border-color: #dfac4c; }
.skill-node.locked { border-color: #424a53; }.skill-node.locked .node-icon { opacity: 0.2; }.skill-node.locked .node-jewel { opacity: 0.3; }
.skill-node.on-path:not(.selected) { border-color: #b9a77e; }.skill-node.selected.locked { border-color: #f6cb68; }
.build-button { display: flex; align-items: center; justify-content: space-between; flex: 0 0 34dp; padding: 0 9dp; border: 1dp #947443; background-color: #182329; color: #f0cd8b; font-size: 14dp; }.build-button span { font-size: 11dp; color: #91a7b4; }.build-button:hover { background-color: #30414a; border-color: #dfba71; }
.requirement-guide { width: 100%; padding: 10dp 5dp; border: 1dp #947443; background-color: #242016; color: #ecd394; font-size: 14dp; flex: 0 0 auto; }.requirement-guide span { display: block; font-size: 12dp; color: #b4b0a2; margin-bottom: 5dp; }.requirement-guide:hover { border-color: #e7be63; background-color: #3b2e17; }
.tree-legend b { font-weight: normal; }
.build-modal { width: 620dp; max-height: 90%; padding-top: 20dp; padding-bottom: 16dp; display: flex; flex-direction: column; box-sizing: border-box; }.build-modal h2 { margin: 0 0 5dp; }.build-modal .build-subtitle { text-align: center; font-size: 13dp; color: #93a7b5; margin: 0 0 13dp; }.build-metrics { display: flex; justify-content: space-around; border: 1dp #4e5150; background-color: #081118; padding: 10dp 0; flex: 0 0 auto; }.build-metrics div { text-align: center; }.build-metrics b { display: block; font-size: 25dp; color: #e7c278; }.build-metrics span { font-size: 12dp; color: #9bb1bc; }.build-scroll { max-height: 370dp; overflow-y: auto; min-height: 0; padding-right: 10dp; }.build-scroll h3 { font-family: Cinzel; font-size: 16dp; color: #e9c681; margin: 18dp 0 10dp; }.build-tree { border-bottom: 1dp #2b3942; padding: 8dp 0; }.build-tree div { display: flex; justify-content: space-between; color: #d3d8d9; font-size: 15dp; }.build-tree span { color: #7e9baa; font-size: 12dp; }.build-tree p { color: #87bca1; font-size: 12dp; line-height: 17dp; margin: 4dp 0 0; }.build-skill { display: flex; align-items: center; padding: 6dp 0; border-bottom: 1dp #24343d; font-size: 14dp; }.build-skill div { flex: 1; margin-left: 9dp; }.build-skill div b,.build-skill div span { display: block; }.build-skill div span { color: #8098a7; font-size: 12dp; margin-top: 2dp; }.build-skill > b { color: #edcd87; }.build-modal .build-disclaimer { font-size: 12dp; line-height: 17dp; color: #8198a6; margin: 12dp 0 0; }.build-modal .action { flex: 0 0 38dp; margin-top: 12dp; }
.skill-node.keystone .node-diamond { display: block; position: absolute; left: 7dp; top: 7dp; width: 50dp; height: 50dp; border: 3dp #b48634; transform: rotate(45deg); }.skill-node.keystone .node-inner { background-color: #241906; border-color: #d1a24c; }
.rank { position: absolute; left: 9dp; top: 60dp; width: 49dp; height: 21dp; background-color: #080d12; border: 1dp #998047; border-radius: 3dp; text-align: center; line-height: 20dp; color: #f0eddb; font-size: 17dp; font-weight: bold; }.rank span { color: #b4bec2; font-weight: normal; }.locked .rank { border-color: #525963; color: #7f8b95; }
.lock { position: absolute; left: 24dp; top: 20dp; width: 22dp; height: 31dp; }.lock-shackle { width: 12dp; height: 13dp; border: 3dp #81909e; border-radius: 8dp; margin: 0 auto; }.lock-body { position: absolute; top: 12dp; width: 22dp; height: 17dp; background-color: #8c9daa; border-radius: 3dp; border: 1dp #c1d0d7; }.keyhole { width: 3dp; height: 7dp; margin: 4dp auto; background-color: #16232f; }
.tree-legend { display: flex; align-items: center; justify-content: center; gap: 13dp; flex: 0 0 25dp; font-size: 10dp; color: #81939f; border-top: 1dp #202d35; }.tree-legend span { display: flex; align-items: center; gap: 5dp; }.legend-dot { display: inline-block; width: 5dp; height: 5dp; border-radius: 4dp; background-color: #53636d; }.legend-dot.invested { background-color: #71d67d; }.legend-dot.available { background-color: #d6b46f; }.legend-note { color: #5b6d7b; margin-left: 6dp; }
.detail-panel { display: flex; flex-direction: column; flex: 0 0 292dp; width: 292dp; border: 1dp #695333; background-color: #0b1218f5; }.detail-scroll { position: relative; flex: 1; padding: 18dp 16dp 0; overflow-y: auto; overflow-x: hidden; }
.detail-portrait { position: relative; width: 142dp; height: 142dp; margin: 3dp auto 17dp; }.portrait-diamond { position: absolute; width: 106dp; height: 106dp; top: 16dp; left: 16dp; transform: rotate(45deg); border: 2dp #bd914c; }.portrait-rim { position: absolute; width: 124dp; height: 124dp; top: 7dp; left: 7dp; border-radius: 68dp; border: 3dp #d6ac5c; background-color: #110e0c; }.portrait-icon { width: 98dp; height: 98dp; margin: 11dp; }.portrait-gem { position: absolute; top: 0; left: 64dp; width: 10dp; height: 10dp; transform: rotate(45deg); border: 2dp #f3d490; background-color: #986f2f; }
.skill-title { font-family: Cinzel; font-weight: normal; font-size: 26dp; text-align: center; color: #efcd80; line-height: 32dp; margin: 0 0 7dp; }.ornament-rule { height: 1dp; position: relative; background-color: #8c6d37; margin: 10dp 0 14dp; }.ornament-rule span { position: absolute; left: 50%; top: -3dp; width: 6dp; height: 6dp; border: 1dp #b7985f; transform: rotate(45deg); background-color: #0b1218; margin-left: -3dp; }
.skill-description { font-size: 17dp; line-height: 23dp; text-align: center; color: #d3d8d6; margin-bottom: 19dp; }
.effect-card { padding: 13dp 12dp; border: 1dp #76603b; background-color: #070c11a0; }.effect-title { display: flex; justify-content: space-between; align-items: center; color: #e4bd72; font-size: 17dp; }.effect-title b { color: #e0e8e9; font-family: "Share Tech Mono"; font-size: 17dp; }.level-pill { font-size: 12dp; color: #879ba8; }
.current-effect { font-size: 15dp; color: #9daab2; line-height: 22dp; margin: 9dp 0 0; }.effect-divider { height: 1dp; background-color: #26343b; margin: 13dp 0; }.next-effect { font-size: 16dp; line-height: 23dp; color: #70e583; margin: 9dp 0 0; }
.requirements { margin-top: 17dp; }.requirements h3 { font-family: Cinzel; font-size: 16dp; font-weight: normal; color: #d6af67; margin: 0 0 9dp; }
.requirement { display: flex; align-items: center; gap: 8dp; font-size: 15dp; height: 27dp; color: #bf7971; }.requirement b { margin-left: auto; font-size: 15dp; }.requirement.met { color: #adb9bf; }.req-symbol { width: 16dp; color: #c9a561; }.req-symbol.blue { color: #3bbde9; }
.prerequisite { display: flex; align-items: center; gap: 7dp; padding: 5dp 0; font-size: 14dp; color: #dc8475; }.prerequisite.met { color: #8cbe92; }.prerequisite b { margin-left: auto; }.req-icon { width: 22dp; height: 22dp; flex: 0 0 22dp; }.no-prerequisite { color: #748d9b; font-size: 13dp; line-height: 19dp; }
.availability { display: flex; align-items: center; gap: 7dp; padding: 10dp 0; font-size: 12dp; line-height: 17dp; color: #ae8d7b; }.availability-dot { width: 5dp; height: 5dp; flex: 0 0 5dp; border-radius: 3dp; background-color: #a16f50; }.availability.ready { color: #97cb9c; }.availability.ready .availability-dot { background-color: #71d386; }.availability.mastered { color: #e3bf72; }
.quote { font-family: Cinzel; font-size: 14dp; line-height: 23dp; color: #c5a163; text-align: center; padding: 10dp 0; }.detail-art { height: 123dp; opacity: 0.43; decorator: image(st-warrior cover); }
.skill-footer { display: flex; align-items: center; gap: 18dp; flex: 0 0 67dp; padding: 0 15dp; border: 1dp #6d5735; background-color: #0b151c; }
.allocation { width: 250dp; flex: 1; max-width: 320dp; }.allocation > div:first-child { display: flex; align-items: center; justify-content: space-between; font-size: 10dp; color: #9e947e; letter-spacing: 1dp; }.allocation b { color: #d9c291; font-family: "Share Tech Mono"; font-size: 12dp; }.allocation-track { height: 5dp; margin-top: 7dp; border: 1dp #273b47; background-color: #050a0e; }.allocation-track div { height: 100%; background-color: #9c7c3d; }.allocation-note { font-size: 10dp; color: #627d8c; margin-top: 3dp; display: block; }
.footer-actions { display: flex; gap: 14dp; margin-left: auto; }.action { display: inline-block; min-width: 150dp; height: 42dp; line-height: 39dp; box-sizing: border-box; padding: 0 20dp; border: 2dp #bb9149; border-radius: 4dp; font-family: Cinzel; font-size: 17dp; text-align: center; color: #f6e2bb; background-color: #153c25; }.action-icon { font-family: Barlow; font-size: 24dp; margin-right: 13dp; vertical-align: middle; color: #e8c47c; }.action.upgrade { min-width: 220dp; }.action.reset { background-color: #102c43; border-color: #668fa5; }.action.leave { background-color: #4b1614; border-color: #b77a42; }.action:hover { color: #ffffff; border-color: #ffe0a0; }.action:disabled { color: #7e827d; border-color: #505143; background-color: #151e1a; }.action:disabled .action-icon { color: #68756d; }
.upgrade-mark { display: inline-block; position: relative; width: 19dp; height: 24dp; }.arrow-head { position: absolute; width: 10dp; height: 10dp; left: 4dp; top: 3dp; border-top: 2dp #e8c47c; border-left: 2dp #e8c47c; transform: rotate(45deg); }.arrow-stem { position: absolute; left: 9dp; top: 6dp; width: 2dp; height: 18dp; background-color: #e8c47c; }.reset-mark { display: inline-block; position: relative; width: 16dp; height: 16dp; border: 2dp #b7d3e0; border-radius: 11dp; }.reset-tip { position: absolute; right: -3dp; top: -3dp; width: 6dp; height: 6dp; border-right: 2dp #b7d3e0; border-bottom: 2dp #b7d3e0; }
.status-bar { height: 22dp; line-height: 22dp; flex: 0 0 22dp; text-align: center; color: #6f8d98; font-size: 11dp; background-color: #080f14; }
.modal-shade { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #03080fe8; display: flex; align-items: center; justify-content: center; }.modal { position: relative; width: 490dp; padding: 31dp 30dp 26dp; border: 2dp #bb9657; background-color: #0c1821; border-radius: 8dp; }.modal-gem { position: absolute; width: 16dp; height: 16dp; left: 50%; top: -10dp; transform: rotate(45deg); background-color: #168fb9; border: 2dp #d7b471; }.modal h2 { font-family: Cinzel; font-size: 24dp; font-weight: normal; color: #efcf8a; text-align: center; margin-bottom: 19dp; }.modal p { font-size: 17dp; line-height: 25dp; margin-bottom: 16dp; }.modal .action { display: block; margin: 19dp auto 0; }.modal-actions { display: flex; gap: 10dp; }.modal-actions .action { padding: 0 11dp; font-size: 13dp; flex: 1; }
.modal.build-modal { width: 650dp; padding: 20dp 25dp 16dp; }.modal.build-modal h2 { margin: 0 0 5dp; }.modal.build-modal .build-tree p { font-size: 12dp; line-height: 17dp; margin: 4dp 0 0; }.modal.build-modal .build-disclaimer { font-size: 12dp; line-height: 17dp; margin: 12dp 0 0; }.modal.build-modal .action { margin-top: 12dp; }
.action[disabled] { pointer-events: none; color: #7e827d; border-color: #505143; background-color: #151e1a; }.action[disabled] .action-icon { color: #68756d; }
@spritesheet st-art { src: /images/game/tutorial/backdrop_knight.png; st-warrior: 0px 90px 226px 236px; }
@media (theme: efeitos) {
  .skill-header { decorator: linear-gradient(180deg, #14232e, #091119); }
  .point-bank { decorator: linear-gradient(0deg, #0b1621, #060b10); }
  .category.selected { decorator: linear-gradient(90deg, #533719, #241d11); box-shadow: #d8a04430 0 0 10dp 1dp; }
  .tree-panel { decorator: radial-gradient(ellipse at center, #122630, #070e14); }
  .character-shade { decorator: linear-gradient(180deg, #09131a00, #09131a); }
  .skill-node.selected { box-shadow: #ffc83d8c 0 0 17dp 2dp; }
  .connection.active.green { box-shadow: #5dff6980 0 0 7dp 1dp; }.connection.active.blue { box-shadow: #36c3ff80 0 0 7dp 1dp; }.connection.active.gold { box-shadow: #f8c96680 0 0 7dp 1dp; }
  .skill-node.owned.green { box-shadow: #47d95635 0 0 8dp 1dp; }.skill-node.owned.blue { box-shadow: #28a6f035 0 0 8dp 1dp; }
  .portrait-rim { box-shadow: #be853c45 0 0 17dp 2dp; }
  .action.upgrade { decorator: linear-gradient(180deg, #17623d, #0b2c1b); }.action.reset { decorator: linear-gradient(180deg, #163f60, #0b1c2d); }.action.leave { decorator: linear-gradient(180deg, #6a2920, #2e0c0b); }
  .action[disabled] { decorator: linear-gradient(180deg, #24302a, #131b17); }
}
@media (max-height: 650dp) { .character-card { display: none; }.categories { flex: 1; } }
@media (max-height: 850dp) {
  .character-art { height: 145dp; }.character-shade { top: 85dp; height: 75dp; }.role-plaque { margin-top: 108dp; font-size: 17dp; }.character-card p { display: none; }.demo-character { margin-top: 8dp; font-size: 10dp; }
  .detail-portrait { width: 142dp; transform: scale(0.72); height: 105dp; margin-top: -14dp; margin-bottom: 4dp; }.detail-scroll { padding-top: 12dp; }.skill-title { font-size: 23dp; line-height: 29dp; }.skill-description { font-size: 14dp; line-height: 20dp; margin-bottom: 12dp; }.effect-card { padding: 10dp; }.effect-title { font-size: 15dp; }.current-effect,.next-effect { font-size: 14dp; line-height: 20dp; }.quote { font-size: 12dp; line-height: 18dp; }.detail-art { height: 70dp; }
}
@media (max-width: 1150dp) {
  .brand { flex-basis: 150dp; width: 150dp; }.brand-sub { font-size: 8dp; letter-spacing: 0; }.heading { left: 19%; right: 34%; }h1 { font-size: 25dp; margin-top: 28dp; }
  .category-panel { flex-basis: 156dp; width: 156dp; padding-left: 5dp; padding-right: 5dp; }.category { font-size: 14dp; padding-right: 5dp; }.category-icon { width: 28dp; height: 28dp; flex-basis: 28dp; margin-right: 7dp; }.section-eyebrow { font-size: 8dp; letter-spacing: 0; }
  .detail-panel { flex-basis: 255dp; width: 255dp; }.detail-scroll { padding-left: 12dp; padding-right: 12dp; }.legend-note { display: none; }.point-bank span { font-size: 12dp; }.point-bank { padding-left: 7dp; }.point-bank b { font-size: 22dp; margin-left: 7dp; }.grant { margin-left: 5dp; }.allocation { max-width: 190dp; }.footer-actions { gap: 9dp; }.action { min-width: 115dp; font-size: 14dp; padding: 0 13dp; }.action.upgrade { min-width: 180dp; }
}
@media (max-height: 750dp) {
  .skill-header { flex-basis: 65dp; }.heading { height: 65dp; }h1 { margin-top: 21dp; font-size: 26dp; }.brand-name { font-size: 20dp; }
  .category { height: 46dp; margin-bottom: 7dp; }.character-art { height: 190dp; }.character-shade { top: 90dp; }.role-plaque { margin-top: 133dp; font-size: 17dp; }.character-card p { font-size: 13dp; line-height: 18dp; margin-top: 8dp; }.demo-character { font-size: 10dp; }.skill-footer { flex-basis: 56dp; }.tree-legend { font-size: 9dp; }.detail-portrait { transform: scale(0.8); height: 118dp; margin-top: -8dp; margin-bottom: 4dp; }.skill-title { font-size: 22dp; }.skill-description { font-size: 14dp; line-height: 20dp; margin-bottom: 13dp; }.effect-card { padding: 10dp; }.effect-title { font-size: 15dp; }.current-effect,.next-effect { font-size: 14dp; line-height: 20dp; }.detail-art { height: 70dp; }
}
