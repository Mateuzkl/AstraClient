/* Native RmlUi chrome. Spell images are the existing Astra 32px atlas, not new art. */
body { font-family: Barlow; font-size: 16dp; color: #c0c5c7; }
.skill-window { position: relative; display: flex; flex-direction: column; width: 100%; height: 100%; box-sizing: border-box; border: 2dp #96713b; background-color: #080e13fa;  padding: 7dp; border-radius: 10dp; }
.rim { position: absolute; left: 14dp; right: 14dp; height: 1dp; background-color: #d5a65b; }
.rim-top { top: 4dp; }.rim-bottom { bottom: 4dp; }
.corner { position: absolute; border: 2dp #e1b865; background-color: #111a20; transform: rotate(45deg);  width: 9dp; height: 9dp; pointer-events: none; }
.top-left {  top: 7dp; left: 7dp; }.top-right {  top: 7dp; right: 7dp; }.bottom-left {  bottom: 7dp; left: 7dp; }.bottom-right {  bottom: 7dp; right: 7dp; }
.skill-header { position: relative; display: flex; align-items: center; border: 1dp #514631; border-radius: 7dp 7dp 0 0; background-color: #0b141cf5;  flex: 0 0 54dp; padding: 0 10dp; }
.brand {  width: 95dp; flex: 0 0 95dp; }.brand-name { display: block; font-family: Cinzel; color: #ead3a3;  font-size: 19dp; letter-spacing: 3dp; }.brand-sub { color: #71828f; font-size: 9dp; letter-spacing: 2dp; margin-top: 4dp;  display: none; }
.heading { text-align: center;  position: relative; left: auto; right: auto; top: auto; height: auto; flex: 1; }
h1 { font-family: Cinzel; font-weight: normal; color: #f4d38a; text-align: center;  font-size: 24dp; margin: 0; white-space: nowrap; }
.heading-line { height: 1dp; background-color: #8f6b32;  margin: 4dp 25dp 0; }
.crown { position: absolute; width: 48dp; height: 18dp; left: 50%; margin-left: -24dp; top: 4dp; border-bottom: 1dp #c09850; transform: rotate(0deg);  display: none; }
.gem { width: 14dp; height: 14dp; margin: 2dp auto; transform: rotate(45deg); border: 2dp #edc878; background-color: #24bceb; }
.point-bank { display: flex; align-items: center; border: 1dp #766140; background-color: #070c11; border-radius: 4dp;  height: 30dp; padding: 0 6dp 0 9dp; margin-left: 6dp; }
.point-bank span { color: #e2dfd4;  font-size: 12dp; }.point-bank b { color: #36c7f1; min-width: 20dp;  font-size: 23dp; margin-left: 8dp; }
.grant { color: #a4bfcd; background-color: #101e29; border: 1dp #2c4b5b; margin-left: 10dp; width: 43dp; height: 24dp; padding: 0; font-size: 12dp; border-radius: 3dp; }.grant:hover { color: #ffffff; border-color: #3ac6f4; }
.header-button { width: 28dp; height: 28dp; padding: 0; line-height: 25dp; text-align: center; border: 1dp #9c7840; border-radius: 4dp; margin-left: 8dp; font-family: Cinzel; font-size: 22dp; background-color: #211b12; color: #eed49e; }.header-button:hover { background-color: #4b3820; }.header-button.close { background-color: #411a17; border-color: #ae5441; color: #f58b78; font-family: Barlow; font-size: 29dp; }.header-button.close:hover { background-color: #74261e; }
.skill-body { display: flex; flex: 1; min-height: 0;  padding-top: 5dp; padding-bottom: 5dp; min-width: 0; }
.category-panel { display: flex; flex-direction: column; border: 1dp #695333; background-color: #09131af0; overflow: hidden;  flex: 0 0 168dp; width: 168dp; box-sizing: border-box; padding: 8dp 6dp; }
.section-eyebrow { color: #8c836e; text-align: center;  font-size: 9dp; letter-spacing: 0; margin: 0 0 7dp; }
.category { display: flex; align-items: center; position: relative; width: 100%; box-sizing: border-box; border: 1dp #465260; border-radius: 3dp; background-color: #0b1822; color: #b5c8d6; font-family: Cinzel; text-align: left;  height: 42dp; margin-bottom: 6dp; padding: 3dp 7dp; font-size: 14dp; }
.category-icon {  width: 30dp; height: 30dp; flex: 0 0 30dp; margin-right: 7dp; }.category-notch { margin-left: auto; width: 5dp; height: 5dp; border: 1dp #71603c; transform: rotate(45deg); }
.category:hover { border-color: #ad8f54; color: #ffdf9d; background-color: #1e2524; }.category.selected { border: 2dp #dcac56; background-color: #372512; color: #ffe3ab; }.category.selected .category-notch { color: #f6cd7e; }
.character-card { position: relative; flex: 1; min-height: 0; overflow: hidden; margin-top: 1dp;  display: flex; flex-direction: column; margin: 4dp 0 0; }
.character-art { top: 0; width: 100%; opacity: 0.76;  position: relative; height: auto; flex: 1; min-height: 0; decorator: image(st-warrior contain); }.character-shade { position: absolute; left: 0; right: 0; top: 145dp; height: 130dp; background-color: #09131aab;  display: none; }
.role-plaque { position: relative; text-align: center; font-family: Cinzel; color: #efc77b; border-top: 1dp #9e7940; border-bottom: 1dp #9e7940; background-color: #090f13db;  margin-top: 5dp; font-size: 16dp; padding: 4dp 0; flex: 0 0 auto; }
.character-card p { position: relative; color: #8e9ba6;  font-size: 12dp; line-height: 16dp; margin: 6dp 0; padding: 0 3dp; }
.demo-character { position: relative; display: flex; align-items: center; justify-content: center; color: #869baa;  flex: 0 0 20dp; gap: 5dp; font-size: 10dp; }.demo-character b { color: #e2c788; font-size: 14dp; }
.small-gem { width: 6dp; height: 6dp; transform: rotate(45deg); border: 1dp #4bc0e4; background-color: #176e98; }
.local-tag { display: flex; align-items: center; justify-content: center; gap: 6dp; color: #7d9891; height: 22dp;  flex: 0 0 21dp; font-size: 8dp; letter-spacing: 0; }.local-dot { width: 5dp; height: 5dp; border-radius: 3dp; background-color: #70b59a; }
.tree-panel { position: relative; display: flex; flex-direction: column; flex: 1; min-width: 0; border: 1dp #5b4b30; background-color: #070f16;  margin: 0 5dp; box-sizing: border-box; }
.tree-topline { display: flex; align-items: center; justify-content: space-between; color: #637481; border-bottom: 1dp #25303a; background-color: #0b141b;  padding: 0 8dp; font-size: 10dp; letter-spacing: 0; flex: 0 0 24dp; }.tree-topline span:first-child { color: #b7a37d; text-transform: uppercase; }
.tree-viewport { position: relative; flex: 1; min-height: 0;  overflow: auto; }
.tree-canvas { position: absolute; transform-origin: 0 0;  width: 550dp; height: 506dp; }
.tree-watermark { position: absolute; left: 50%; top: 50%;  width: 300dp; height: 400dp; margin-left: -150dp; margin-top: -200dp; opacity: 0.1; }
.sigil-outer { position: absolute; top: 80dp; border: 1dp #425260; transform: rotate(45deg);  left: 55dp; width: 180dp; height: 180dp; }.sigil-inner { position: absolute; border: 1dp #425260; transform: rotate(45deg);  left: 77dp; top: 102dp; width: 136dp; height: 136dp; }.sigil-blade { position: absolute; top: 0; width: 14dp; background-color: #263d4f; border: 1dp #4f5e69;  height: 340dp; left: 142dp; }
.connection { position: absolute; background-color: #2c3d49; pointer-events: none; opacity: 0.5; }.connection.green { background-color: #6fdc76; }.connection.blue { background-color: #39b7f2; }.connection.gold { background-color: #cfa84e; }.connection.active { opacity: 0.85; }.connection.on-path { opacity: 1; }.connection.on-path:not(.green):not(.blue):not(.gold) { background-color: #a0804c; }
.skill-node { position: absolute; border: 2dp #52616c; background-color: #0a1018; padding: 0; color: #d4dce0; overflow: visible;  width: 56dp; height: 56dp; box-sizing: border-box; border-radius: 30dp; }
.node-inner { position: absolute; overflow: hidden; border: 1dp #394957; border-radius: 32dp; background-color: #06121b;  left: 4dp; top: 4dp; width: 44dp; height: 44dp; box-sizing: border-box; }.node-icon {  width: 36dp; height: 36dp; margin: 3dp; }
.node-jewel { position: absolute; transform: rotate(45deg); border: 1dp #7b8790; background-color: #152b36;  left: 22dp; top: -4dp; width: 6dp; height: 6dp; }
.node-diamond { display: none; }.skill-node.owned.green { border-color: #77d676; }.skill-node.owned.blue { border-color: #40bff0; }.skill-node.gold { border-color: #b98e48; }
.skill-node.owned.green .node-jewel { background-color: #8bf48c; border-color: #c7ffc4; }.skill-node.owned.blue .node-jewel { background-color: #51cdf9; border-color: #bbf5ff; }.skill-node.gold .node-jewel { background-color: #e2b650; border-color: #f4de91; }
.skill-node.available:not(.owned) { border-color: #c0a56a; }.skill-node:hover { border-color: #ffe2a5; background-color: #263129; }.skill-node.selected { border: 3dp #f6cb68; background-color: #4c2d0d; }.skill-node.selected .node-inner { border-color: #dfac4c;  left: 3dp; top: 3dp; }
.skill-node.locked { border-color: #424a53; }.skill-node.locked .node-icon { opacity: 0.2; }.skill-node.locked .node-jewel { opacity: 0.3; }
.skill-node.on-path:not(.selected) { border-color: #b9a77e; }.skill-node.selected.locked { border-color: #f6cb68; }
.build-button { display: flex; align-items: center; justify-content: space-between; border: 1dp #947443; background-color: #182329; color: #f0cd8b;  font-size: 13dp; padding: 0 6dp; flex: 0 0 32dp; }.build-button span { color: #91a7b4;  font-size: 10dp; }.build-button:hover { background-color: #30414a; border-color: #dfba71; }
.requirement-guide { width: 100%; border: 1dp #947443; background-color: #242016; color: #ecd394; flex: 0 0 auto;  box-sizing: border-box; padding: 7dp 4dp; font-size: 12dp; }.requirement-guide span { display: block; color: #b4b0a2; margin-bottom: 5dp;  font-size: 11dp; }.requirement-guide:hover { border-color: #e7be63; background-color: #3b2e17; }
.tree-legend b { font-weight: normal; }
.build-modal { width: 620dp; max-height: 90%; padding-top: 20dp; padding-bottom: 16dp; display: flex; flex-direction: column; box-sizing: border-box; }.build-modal h2 { margin: 0 0 5dp; }.build-modal .build-subtitle { text-align: center; font-size: 13dp; color: #93a7b5; margin: 0 0 13dp; }.build-metrics { display: flex; justify-content: space-around; border: 1dp #4e5150; background-color: #081118; padding: 10dp 0; flex: 0 0 auto; }.build-metrics div { text-align: center; }.build-metrics b { display: block; color: #e7c278;  font-size: 21dp; }.build-metrics span { font-size: 12dp; color: #9bb1bc; }.build-scroll { overflow-y: auto; min-height: 0; padding-right: 10dp;  flex: 1; max-height: 320dp; }.build-scroll h3 { font-family: Cinzel; font-size: 16dp; color: #e9c681; margin: 18dp 0 10dp; }.build-tree { border-bottom: 1dp #2b3942; padding: 8dp 0; }.build-tree div { display: flex; justify-content: space-between; color: #d3d8d9; font-size: 15dp; }.build-tree span { color: #7e9baa; font-size: 12dp; }.build-tree p { color: #87bca1; font-size: 12dp; line-height: 17dp; margin: 4dp 0 0; }.build-skill { display: flex; align-items: center; padding: 6dp 0; border-bottom: 1dp #24343d; font-size: 14dp; }.build-skill div { flex: 1; margin-left: 9dp; }.build-skill div b,.build-skill div span { display: block; }.build-skill div span { color: #8098a7; font-size: 12dp; margin-top: 2dp; }.build-skill > b { color: #edcd87; }.build-modal .build-disclaimer { font-size: 12dp; line-height: 17dp; color: #8198a6; margin: 12dp 0 0; }.build-modal .action { flex: 0 0 38dp; margin-top: 12dp;  min-width: 100dp; height: 34dp; line-height: 30dp; font-size: 14dp; padding: 0 11dp; }
.skill-node.keystone .node-diamond { display: block; position: absolute; border: 3dp #b48634; transform: rotate(45deg);  left: 6dp; top: 6dp; width: 38dp; height: 38dp; box-sizing: border-box; border-width: 2dp; }.skill-node.keystone .node-inner { background-color: #241906; border-color: #d1a24c; }
.rank { position: absolute; background-color: #080d12; border: 1dp #998047; border-radius: 3dp; text-align: center; color: #f0eddb; font-weight: bold;  left: 5dp; top: 44dp; width: 41dp; height: 18dp; line-height: 17dp; font-size: 13dp; box-sizing: border-box; }.rank span { color: #b4bec2; font-weight: normal; }.locked .rank { border-color: #525963; color: #7f8b95; }
.lock { position: absolute; width: 22dp; height: 31dp;  left: 17dp; top: 12dp; transform: scale(0.85); }.lock-shackle { width: 12dp; height: 13dp; border: 3dp #81909e; border-radius: 8dp; margin: 0 auto; }.lock-body { position: absolute; top: 12dp; width: 22dp; height: 17dp; background-color: #8c9daa; border-radius: 3dp; border: 1dp #c1d0d7; }.keyhole { width: 3dp; height: 7dp; margin: 4dp auto; background-color: #16232f; }
.tree-legend { display: flex; align-items: center; justify-content: center; color: #81939f; border-top: 1dp #202d35;  gap: 10dp; font-size: 10dp; flex: 0 0 22dp; }.tree-legend span { display: flex; align-items: center; gap: 5dp; }.legend-dot { display: inline-block; width: 5dp; height: 5dp; border-radius: 4dp; background-color: #53636d; }.legend-dot.invested { background-color: #71d67d; }.legend-dot.available { background-color: #d6b46f; }.legend-note { color: #5b6d7b; margin-left: 6dp;  display: none; }
.detail-panel { display: flex; flex-direction: column; border: 1dp #695333; background-color: #0b1218f5;  width: 240dp; flex: 0 0 240dp; box-sizing: border-box; min-width: 0; }.detail-scroll { position: relative; flex: 1; overflow-y: auto; overflow-x: hidden;  min-height: 0; padding: 9dp 10dp; }
.detail-portrait { position: relative;  width: 70dp; height: 70dp; margin: 2dp auto 8dp; }.portrait-diamond { position: absolute; transform: rotate(45deg); border: 2dp #bd914c;  width: 46dp; height: 46dp; top: 10dp; left: 10dp; }.portrait-rim { position: absolute; overflow: hidden; border-radius: 68dp; border: 3dp #d6ac5c; background-color: #110e0c;  width: 62dp; height: 62dp; top: 2dp; left: 2dp; border-width: 2dp; box-sizing: border-box; }.portrait-icon {  width: 48dp; height: 48dp; margin: 5dp; }.portrait-gem { position: absolute; top: 0; transform: rotate(45deg); border: 2dp #f3d490; background-color: #986f2f;  left: 29dp; width: 7dp; height: 7dp; }
.skill-title { font-family: Cinzel; font-weight: normal; text-align: center; color: #efcd80;  font-size: 20dp; line-height: 25dp; margin: 0 0 5dp; }.ornament-rule { height: 1dp; position: relative; background-color: #8c6d37;  margin: 7dp 0 9dp; }.ornament-rule span { position: absolute; left: 50%; top: -3dp; width: 6dp; height: 6dp; border: 1dp #b7985f; transform: rotate(45deg); background-color: #0b1218; margin-left: -3dp; }
.skill-description { text-align: center; color: #d3d8d6; margin-bottom: 19dp;  font-size: 14dp; line-height: 18dp; margin: 0 0 10dp; }
.effect-card { border: 1dp #76603b; background-color: #070c11a0;  padding: 8dp; box-sizing: border-box; }.effect-title { display: flex; justify-content: space-between; align-items: center; color: #e4bd72;  font-size: 14dp; }.effect-title b { color: #e0e8e9; font-family: "Share Tech Mono";  font-size: 14dp; }.level-pill { font-size: 12dp; color: #879ba8; }
.current-effect { color: #9daab2;  font-size: 13dp; line-height: 18dp; margin: 5dp 0 0; }.effect-divider { height: 1dp; background-color: #26343b;  margin: 8dp 0; }.next-effect { color: #70e583;  font-size: 13dp; line-height: 18dp; margin: 5dp 0 0; }
.requirements {  margin-top: 10dp; }.requirements h3 { font-family: Cinzel; font-weight: normal; color: #d6af67;  font-size: 14dp; margin: 0 0 5dp; }
.requirement { display: flex; align-items: center; gap: 8dp; color: #bf7971;  font-size: 13dp; height: 23dp; }.requirement b { margin-left: auto;  font-size: 13dp; }.requirement.met { color: #adb9bf; }.req-symbol { width: 16dp; color: #c9a561; }.req-symbol.blue { color: #3bbde9; }
.prerequisite { display: flex; align-items: center; color: #dc8475;  font-size: 12dp; gap: 5dp; padding: 4dp 0; }.prerequisite.met { color: #8cbe92; }.prerequisite b { margin-left: auto; }.req-icon { width: 22dp; height: 22dp; flex: 0 0 22dp; }.no-prerequisite { color: #748d9b; font-size: 13dp; line-height: 19dp; }
.availability { display: flex; align-items: center; gap: 7dp; line-height: 17dp; color: #ae8d7b;  font-size: 12dp; padding: 7dp 0; }.availability-dot { width: 5dp; height: 5dp; flex: 0 0 5dp; border-radius: 3dp; background-color: #a16f50; }.availability.ready { color: #97cb9c; }.availability.ready .availability-dot { background-color: #71d386; }.availability.mastered { color: #e3bf72; }
.quote { font-family: Cinzel; color: #c5a163; text-align: center;  font-size: 11dp; line-height: 16dp; padding: 5dp 0; }.detail-art { height: 123dp; opacity: 0.43; decorator: image(st-warrior cover);  display: none; }
.skill-footer { display: flex; align-items: center; border: 1dp #6d5735; background-color: #0b151c;  flex: 0 0 49dp; padding: 0 9dp; gap: 10dp; box-sizing: border-box; }
.allocation { flex: 1;  width: auto; min-width: 0; max-width: 290dp; }.allocation > div:first-child { display: flex; align-items: center; justify-content: space-between; font-size: 10dp; color: #9e947e; letter-spacing: 1dp; }.allocation b { color: #d9c291; font-family: "Share Tech Mono"; font-size: 12dp; }.allocation-track { height: 5dp; margin-top: 7dp; border: 1dp #273b47; background-color: #050a0e; }.allocation-track div { height: 100%; background-color: #9c7c3d; }.allocation-note { color: #627d8c; margin-top: 3dp; display: block;  font-size: 9dp; }
.footer-actions { display: flex; margin-left: auto;  gap: 7dp; }.action { display: inline-block; min-width: 150dp; height: 42dp; line-height: 39dp; box-sizing: border-box; padding: 0 20dp; border: 2dp #bb9149; border-radius: 4dp; font-family: Cinzel; font-size: 17dp; text-align: center; color: #f6e2bb; background-color: #153c25; }.action-icon { font-family: Barlow; vertical-align: middle; color: #e8c47c;  font-size: 19dp; margin-right: 6dp; }.action.upgrade {  min-width: 174dp; }.action.reset { background-color: #102c43; border-color: #668fa5; }.action.leave { background-color: #4b1614; border-color: #b77a42; }.action:hover { color: #ffffff; border-color: #ffe0a0; }.action:disabled { color: #7e827d; border-color: #505143; background-color: #151e1a; }.action:disabled .action-icon { color: #68756d; }
.upgrade-mark { display: inline-block; position: relative; width: 19dp; height: 24dp; }.arrow-head { position: absolute; width: 10dp; height: 10dp; left: 4dp; top: 3dp; border-top: 2dp #e8c47c; border-left: 2dp #e8c47c; transform: rotate(45deg); }.arrow-stem { position: absolute; left: 9dp; top: 6dp; width: 2dp; height: 18dp; background-color: #e8c47c; }.reset-mark { display: inline-block; position: relative; width: 16dp; height: 16dp; border: 2dp #b7d3e0; border-radius: 11dp; }.reset-tip { position: absolute; right: -3dp; top: -3dp; width: 6dp; height: 6dp; border-right: 2dp #b7d3e0; border-bottom: 2dp #b7d3e0; }
.status-bar { text-align: center; color: #6f8d98; background-color: #080f14;  height: auto; flex: 0 0 auto; min-height: 19dp; max-height: 36dp; line-height: 17dp; font-size: 10dp; padding: 2dp 5dp; overflow-y: auto; box-sizing: border-box; }
.modal-shade { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #03080fe8; display: flex; align-items: center; justify-content: center; }.modal { position: relative; border: 2dp #bb9657; background-color: #0c1821; border-radius: 8dp;  width: 490dp; max-width: 92%; max-height: 92%; padding: 18dp; box-sizing: border-box; overflow-y: auto; }.modal-gem { position: absolute; width: 16dp; height: 16dp; left: 50%; top: -10dp; transform: rotate(45deg); background-color: #168fb9; border: 2dp #d7b471; }.modal h2 { font-family: Cinzel; font-weight: normal; color: #efcf8a; text-align: center; margin-bottom: 19dp;  font-size: 21dp; margin: 0 0 12dp; }.modal p {  font-size: 14dp; line-height: 20dp; margin-bottom: 10dp; }.modal .action { display: block; margin: 19dp auto 0;  margin-top: 12dp; }.modal-actions { display: flex; gap: 10dp; }.modal-actions .action { padding: 0 11dp; font-size: 13dp; flex: 1; }
.modal.build-modal { width: 620dp; height: 580dp; padding: 16dp; max-height: 94%; overflow: hidden; }.modal.build-modal h2 { margin: 0 0 5dp; }.modal.build-modal .build-tree p { font-size: 12dp; line-height: 17dp; margin: 4dp 0 0; }.modal.build-modal .build-disclaimer { font-size: 12dp; line-height: 17dp; margin: 12dp 0 0; }.modal.build-modal .action { margin-top: 12dp; }
.action[disabled] { pointer-events: none; color: #7e827d; border-color: #505143; background-color: #151e1a; }.action[disabled] .action-icon { color: #68756d; }
@spritesheet st-art { src: /images/game/tutorial/backdrop_knight.png; st-warrior: 0px 90px 226px 236px; }
@media (theme: efeitos) {
  .skill-header { decorator: linear-gradient(180deg, #14232e, #091119); }
  .point-bank { decorator: linear-gradient(0deg, #0b1621, #060b10); }
  .category.selected { decorator: linear-gradient(90deg, #533719, #241d11); box-shadow: #d8a04430 0 0 10dp 1dp; }
  .tree-panel { decorator: radial-gradient(ellipse at center, #122630, #070e14); }
  .character-shade { decorator: linear-gradient(180deg, #09131a00, #09131a); }
  .skill-node.selected { box-shadow: #ffc83d8c 0 0 17dp 2dp; }
  .connection.active.green { box-shadow: #5dff6980 0 0 7dp 1dp; }.connection.active.blue { box-shadow: #36c3ff80 0 0 7dp 1dp; }.connection.active.gold { box-shadow: #f8c96680 0 0 7dp 1dp; }
  .skill-node.owned.green { box-shadow: #47d95635 0 0 8dp 1dp; }.skill-node.owned.blue { box-shadow: #28a6f035 0 0 8dp 1dp; }
  .portrait-rim { box-shadow: #be853c45 0 0 17dp 2dp; }
  .action.upgrade { decorator: linear-gradient(180deg, #17623d, #0b2c1b); }.action.reset { decorator: linear-gradient(180deg, #163f60, #0b1c2d); }.action.leave { decorator: linear-gradient(180deg, #6a2920, #2e0c0b); }
  .action[disabled] { decorator: linear-gradient(180deg, #24302a, #131b17); }
}
.tree-space { position: relative; }
.categories { flex: 0 0 auto; }
.connection:not(.active):not(.on-path) { background-color: #35434d; opacity: 0.35; }
@media (max-width: 980dp) {
  .brand { display: none; }.heading h1 { font-size: 21dp; }
  .category-panel { width: 140dp; flex-basis: 140dp; }.category { font-size: 12dp; padding: 3dp; }.category-icon { margin-right: 4dp; }
  .detail-panel { width: 222dp; flex-basis: 222dp; }.allocation-note { display: none; }
}
@media (max-width: 800dp) {
  .skill-body { flex-wrap: wrap; align-content: flex-start; overflow: auto; }.category-panel { width: 100%; flex: 0 0 100%; height: 80dp; padding: 4dp; }
  .section-eyebrow,.character-card,.local-tag { display: none; }.categories { display: flex; gap: 4dp; }.category { flex: 1; width: auto; height: 36dp; margin: 0; font-size: 11dp; }.category-icon { width: 22dp; height: 22dp; flex-basis: 22dp; }.category-notch { display: none; }
  .build-button { margin-top: 4dp; flex-basis: 26dp; }.tree-panel { flex: 1; margin: 5dp 5dp 0 0; min-width: 240dp; min-height: 180dp; }.detail-panel { margin-top: 5dp; width: 210dp; flex-basis: 210dp; min-height: 180dp; }
  .heading h1 { font-size: 18dp; }.point-bank span { display: none; }.point-bank b { margin-left: 0; }.header-button { margin-left: 5dp; }
  .skill-footer { flex-wrap: wrap; flex-basis: auto; padding: 5dp; }.allocation { max-width: none; flex: 0 0 100%; }.footer-actions { width: 100%; margin: 0; }.footer-actions .action { flex: 1; min-width: 0; font-size: 12dp; padding: 0 5dp; }.action-icon { display: none; }
}
@media (max-height: 650dp) {
 .character-card p { display: none; }.category { height: 36dp; margin-bottom: 4dp; }.detail-portrait { display: none; }.quote { display: none; }
 .skill-header { flex-basis: 44dp; }.build-metrics { padding: 5dp 0; }.build-scroll { max-height: 210dp; }
}
