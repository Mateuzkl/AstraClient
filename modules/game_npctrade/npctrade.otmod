Module
  name: game_npctrade
  description: NPC trade interface with legacy and HTML support
  author: kokekanon, libergod, AstraClient
  website: https://github.com/Mateuzkl/AstraClient
  sandboxed: true
  scripts: [ game_npctrader, constants/trader_const, controllers/npc_trade_tooltip, controllers/npc_dialog, controllers/npc_trader, controllers/npc_options, controllers/npc_legacy_ui, controllers/npc_compat ]
  @onLoad: controllerNpcTrader:init()
  @onUnload: controllerNpcTrader:terminate()
