ChangelogParagraph < Label
  text-auto-resize: true
  text-wrap: true
  color: #dcdcdc
  margin-right: 6
  margin-bottom: 4

ChangelogHeading < Label
  text-auto-resize: true
  text-wrap: true
  color: #f0d9a0
  margin-right: 6
  margin-top: 6
  margin-bottom: 2

ChangelogQuote < Label
  text-auto-resize: true
  text-wrap: true
  color: #b0b0b0
  margin-left: 12
  margin-right: 6
  margin-bottom: 4

ChangelogCode < Label
  text-auto-resize: true
  text-wrap: true
  color: #cfe0ff
  background-color: #101010
  margin-right: 6
  margin-bottom: 3
  padding: 4

ChangelogWindow < MainWindow
  id: changelogWindow
  !text: tr('Changelog')
  size: 560 540

  Label
    id: subtitle
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    text-align: center
    color: #c9a86a

  TextList
    id: contentList
    anchors.top: subtitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: okButton.top
    margin-top: 6
    margin-bottom: 12
    padding: 6
    focusable: false
    vertical-scrollbar: contentScroll
    background-color: #181818
    layout:
      type: verticalBox

  VerticalScrollBar
    id: contentScroll
    anchors.top: contentList.top
    anchors.bottom: contentList.bottom
    anchors.right: contentList.right
    margin-top: 1
    margin-bottom: 1
    margin-right: 1
    step: 24
    pixels-scroll: true

  Button
    id: okButton
    text: OK
    size: 120 24
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
