// Clean-room Dedicated Mobile Character Selection Stage for AstraClient Web Mobile Lite.
// Loaded ONLY when g_app.isMobile() (Desktop Full characterlist.otui is 100% untouched).

CharacterWidgetOn < UIWidget
  height: 56
  background-color: #0b111ecc
  border-width: 1
  border-color: #ffffff1f
  @onFocusChange: modules.client_entergame.onUpdateOnStates(self)
  @onSetup: modules.client_entergame.onUpdateOnStates(self)

  UICreature
    id: outfit
    size: 48 48
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-left: 2
    idle-animate: true
    phantom: true

  Label
    id: name
    font: mobile-input-14
    color: #f3eedc
    anchors.top: parent.top
    anchors.left: outfit.right
    margin-left: 8
    margin-top: 8
    text-align: left
    text-auto-resize: true
    phantom: true

  UIWidget
    id: main
    size: 9 8
    anchors.verticalCenter: name.verticalCenter
    anchors.left: name.right
    margin-left: 5
    image-source: /images/game/entergame/maincharacter
    visible: false
    phantom: true

  Label
    id: level
    font: mobile-hud-12
    color: #f0c85c
    anchors.bottom: parent.bottom
    anchors.left: outfit.right
    margin-left: 8
    margin-bottom: 8
    text-align: left
    text-auto-resize: true
    phantom: true

  Label
    id: vocation
    font: mobile-hud-12
    color: #b7c2d6
    anchors.verticalCenter: level.verticalCenter
    anchors.left: level.right
    margin-left: 8
    text-align: left
    text-auto-resize: true
    phantom: true

  UIWidget
    id: worldName
    size: 1 1
    visible: false
    anchors.top: parent.top
    anchors.left: parent.left
    &baseText: '%s (%s)'

  CheckBox
    id: pin
    size: 28 28
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    visible: false
    @onCheckChange: onPinCharacter(self, self:isChecked())

  Label
    id: statusDailyReward
    size: 1 1
    visible: false
    anchors.top: parent.top
    anchors.left: parent.left

  Label
    id: statusHidden
    size: 1 1
    visible: false
    anchors.top: parent.top
    anchors.left: parent.left

CharacterWidgetOff < CharacterWidgetOn

UIWindow
  id: charactersWindow
  anchors.fill: parent
  draggable: false
  phantom: true
  visible: false
  color: alpha
  &mobileStage: true
  @onEnter: CharacterList.doLogin()
  @onEscape: CharacterList.hide(true)
  @onSetup: |
    g_keyboard.bindKeyPress('Up', function() self:getChildById('characters'):focusPreviousChild(KeyboardFocusReason) end, self)
    g_keyboard.bindKeyPress('Down', function() self:getChildById('characters'):focusNextChild(KeyboardFocusReason) end, self)

  // ---- Left Sidebar: Translucent Obsidian Character List ----
  MobileGlassPanel
    id: charListSidebar
    width: 308
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-top: 14
    margin-bottom: 14
    margin-left: 14
    phantom: true

  UILabel
    id: charListTitle
    !text: tr('SELECT CHARACTER')
    font: mobile-title-18
    color: #f6d475
    text-auto-resize: true
    anchors.top: charListSidebar.top
    anchors.horizontalCenter: charListSidebar.horizontalCenter
    margin-top: 10
    phantom: true

  HorizontalSeparator
    id: charListDivider
    anchors.top: charListTitle.bottom
    anchors.left: charListSidebar.left
    anchors.right: charListSidebar.right
    margin-top: 6
    margin-left: 14
    margin-right: 14

  VerticalScrollBar
    id: characterListScrollBar
    anchors.top: charListDivider.bottom
    anchors.bottom: accountStatusLabel.top
    anchors.right: charListSidebar.right
    margin-top: 8
    margin-bottom: 6
    margin-right: 6
    step: 58
    pixels-scroll: true

  TextList
    id: characters
    background-color: alpha
    border-width: 0
    padding: 0
    anchors.top: charListDivider.bottom
    anchors.bottom: accountStatusLabel.top
    anchors.left: charListSidebar.left
    anchors.right: characterListScrollBar.left
    margin-top: 8
    margin-bottom: 6
    margin-left: 10
    margin-right: 4
    focusable: false
    vertical-scrollbar: characterListScrollBar
    auto-focus: first
    layout:
      type: verticalBox
      spacing: 5

  Label
    id: accountStatusLabel
    !text: tr('Free Account')
    font: mobile-hud-12
    color: #d6deee
    text-align: center
    height: 18
    anchors.left: charListSidebar.left
    anchors.right: charListSidebar.right
    anchors.bottom: autoReconnect.top
    margin-left: 10
    margin-right: 10
    margin-bottom: 6
    phantom: true
    $on:
      color: #ff7b72

  MobileDarkButton
    id: autoReconnect
    height: 34
    anchors.left: charListSidebar.left
    anchors.right: charListSidebar.right
    anchors.bottom: charListSidebar.bottom
    margin-left: 12
    margin-right: 12
    margin-bottom: 10
    @onClick: CharacterList.toggleAutoReconnect()

  // ---- Center-Right Stage: Live 2x Hero Showcase + Pedestal + CTA ----
  Panel
    id: heroStagePanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: charListSidebar.right
    anchors.right: parent.right
    margin-left: 14
    margin-right: 14
    phantom: true
    focusable: false

    UILabel
      id: stageName
      font: mobile-title-18
      color: #72f290
      text-auto-resize: true
      anchors.bottom: stagePedestal.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 62
      phantom: true

    UIWidget
      id: stagePedestal
      size: 168 58
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10
      image-source: /images/mobile_ui/stage_pedestal
      image-smooth: true
      phantom: true

    UICreature
      id: stageCreature
      size: 112 112
      anchors.bottom: stagePedestal.verticalCenter
      anchors.horizontalCenter: stagePedestal.horizontalCenter
      margin-bottom: -14
      animate: true
      phantom: true

    UILabel
      id: stageDetails
      font: mobile-input-14
      color: #f3eedc
      text-auto-resize: true
      anchors.top: stagePedestal.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 6
      phantom: true

    MobileGlassPanel
      id: stageWorldBadge
      size: 186 28
      anchors.top: stageDetails.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8
      phantom: true

      UILabel
        id: stageWorldLabel
        font: mobile-hud-12
        color: #f6d475
        anchors.fill: parent
        text-align: center
        phantom: true

  MobileGoldButton
    id: buttonOk
    !text: tr('ENTER GAME')
    size: 176 44
    anchors.bottom: parent.bottom
    anchors.right: heroStagePanel.horizontalCenter
    margin-right: 6
    margin-bottom: 24
    @onClick: CharacterList.doLogin()

  MobileDarkButton
    id: buttonCancel
    !text: tr('Back')
    font: mobile-btn-15
    size: 116 44
    anchors.bottom: parent.bottom
    anchors.left: heroStagePanel.horizontalCenter
    margin-left: 6
    margin-bottom: 24
    @onClick: CharacterList.hide(true)

  // ---- Hidden desktop compatibility widgets required by characterlist.lua ----
  Label
    id: accountStatusIcon
    size: 1 1
    visible: false
    anchors.top: parent.top
    anchors.left: parent.left

  UIWidget
    id: characterTable
    size: 1 1
    visible: false
    anchors.top: parent.top
    anchors.left: parent.left

    UIButton
      id: characterSort
      size: 1 1
      visible: false
    UIButton
      id: statusSort
      size: 1 1
      visible: false
    UIButton
      id: levelSort
      size: 1 1
      visible: false
    UIButton
      id: vocationSort
      size: 1 1
      visible: false
    UIButton
      id: worldSort
      size: 1 1
      visible: false

  Panel
    id: recordPanel
    size: 1 1
    visible: false
    anchors.top: parent.top
    anchors.left: parent.left

    CheckBox
      id: recordSession
      size: 1 1
      visible: false
