body { width:100%; height:100%; margin:0; font-family:Barlow; font-size:13dp; color:#e9e6e6; }
div, p, h1, h2 { display:block; box-sizing:border-box; } button, input { font-family:Barlow; }
.scene { width:100%; height:100%; position:relative; overflow:hidden; display:flex; flex-direction:column; background-color:#0b0b12; decorator:image(/modules/client_entergame/login-background.png cover); }
.veil { position:absolute; top:0; right:0; bottom:0; left:0; background-color:#090913ba; }
.topline { position:relative; z-index:1; height:34dp; flex:0 0 34dp; display:flex; align-items:center; gap:8dp; padding:0 22dp; background-color:#101018ed; border-bottom:1dp #514450; color:#e8e5e5; font-size:10dp; font-weight:bold; letter-spacing:1.7dp; }
.online-dot { width:6dp; height:6dp; border-radius:3dp; background-color:#5bd99d; }.top-spacer { flex:1; }.top-motto { color:#a09aa4; font-size:9dp; }.top-value { color:#eaf8ef; font-size:12dp; letter-spacing:0; }.top-label { color:#aaa4ac; font-size:8dp; letter-spacing:1dp; }.cast-dot { width:6dp; height:6dp; border-radius:3dp; background-color:#ef7da1; }.watch { height:23dp; margin-left:7dp; padding:0 9dp; border:1dp #ad6f8b; border-radius:4dp; background-color:#3e2738; color:#f7c6d5; font-size:9dp; font-weight:bold; letter-spacing:0.7dp; }.watch:hover { background-color:#68405b; }
.main { position:relative; z-index:1; flex:1; min-height:0; width:100%; display:flex; justify-content:center; align-items:center; gap:30dp; padding:13dp 32dp 8dp; }
.main.connecting { visibility:hidden; }
.left { flex:0 0 390dp; width:390dp; height:100%; display:flex; flex-direction:column; justify-content:center; align-items:center; }
.brand { height:195dp; width:100%; text-align:center; }.brand img { display:block; width:225dp; height:175dp; margin:auto; }.brand-caption { margin-top:4dp; color:#d7b57b; font-size:9dp; font-weight:bold; letter-spacing:4dp; }
.panel { border:1dp #645462; border-radius:12dp; background-color:#17121deb; box-shadow:#00000088 0 10dp 28dp 0; }
.news { width:100%; height:205dp; padding:17dp 18dp 12dp; display:flex; flex-direction:column; }.panel-kicker { display:flex; align-items:center; gap:7dp; color:#e8b5c1; font-size:9dp; font-weight:bold; letter-spacing:1.8dp; }.red-line { display:inline-block; width:15dp; height:2dp; background-color:#d94d68; }.news-date { margin-left:auto; color:#a2949d; letter-spacing:0; }
.news-meta { margin-top:11dp; color:#d36a85; font-size:9dp; letter-spacing:1dp; } h2 { margin:2dp 0 7dp; color:#fff; font-size:18dp; line-height:20dp; }.news-items { flex:1; min-height:0; overflow-y:auto; }.news-line { display:flex; gap:6dp; margin-bottom:5dp; color:#d0cbd0; font-size:11dp; line-height:14dp; }.news-bullet { color:#f07992; font-size:14dp; }.offline { color:#998b97; font-size:9dp; }.text-link { align-self:flex-start; padding:5dp 0 0; background-color:transparent; color:#f0a9bd; font-size:9dp; font-weight:bold; letter-spacing:1dp; }.text-link:hover { color:#fff; }
.access { flex:0 0 355dp; width:355dp; height:433dp; padding:10dp 22dp 7dp; } h1 { margin:7dp 0 2dp; color:#fff; font-size:25dp; line-height:29dp; font-weight:bold; }.intro { margin:0 0 7dp; color:#afa7b3; font-size:11dp; }.form-label { color:#bdb4bd; font-size:9dp; font-weight:bold; letter-spacing:1.7dp; margin-bottom:4dp; }.field-gap { margin-top:7dp; }
.input { width:100%; height:34dp; box-sizing:border-box; padding:0 11dp; border:1dp #756c77; border-radius:5dp; background-color:#0e0b13; color:#fff; font-size:13dp; }.input:focus { border-color:#e37d9b; }
.extras { display:flex; justify-content:space-between; align-items:center; margin:6dp 0; color:#c9c1c9; font-size:10dp; }.remember-choice { display:flex; align-items:center; gap:5dp; }.extras button { background-color:transparent; color:#e5a9bf; font-size:10dp; }.remember-box { width:13dp; height:13dp; }
.enter, .create { display:block; width:100%; height:35dp; border-radius:5dp; text-align:center; font-size:11dp; font-weight:bold; letter-spacing:1.3dp; }.enter { background-color:#a85066; border:1dp #d9889d; color:#fff; }.enter:hover { background-color:#c2677c; }.create { margin-top:7dp; border:1dp #39745d; background-color:#142d25; color:#9ce8bd; }.create:hover { background-color:#20513a; }
.accounts-head { display:flex; align-items:center; justify-content:space-between; margin:8dp 0 5dp; padding-top:6dp; border-top:1dp #574856; color:#d8c9d2; font-size:9dp; font-weight:bold; letter-spacing:1.3dp; }.accounts-head button { background-color:transparent; color:#e7adbe; font-size:9dp; }.accounts { display:block; width:311dp; height:57dp; overflow-y:auto; }.account { display:block; box-sizing:border-box; width:300dp; height:25dp; padding:4dp 7dp; margin-bottom:3dp; text-align:left; border:1dp #554a58; border-radius:4dp; background-color:#28202b; color:#e3dae2; font-size:11dp; }.account:hover,.account.selected { border-color:#cf7a93; background-color:#49303f; }.account-mark { color:#d78ba4; font-size:8dp; margin-right:7dp; }.account-arrow { display:none; }.no-account { color:#8e8490; font-size:10dp; padding:5dp 0; }.account-footer { display:flex; align-items:center; justify-content:space-between; margin-top:2dp; }.remove { background-color:transparent; color:#a699a6; font-size:9dp; padding:4dp 0; }.remove:hover { color:#f3bac9; }
.token-row { display:flex; align-items:center; gap:7dp; color:#a89eaa; font-size:9dp; letter-spacing:1dp; }.token-input { width:64dp; height:23dp; padding:0 6dp; border:1dp #5b505d; border-radius:4dp; background-color:#0e0b13; color:#fff; text-align:center; font-size:10dp; }.status { margin:2dp 0 0; min-height:14dp; color:#f0b4c4; font-size:10dp; }
.bottom { position:relative; z-index:1; flex:0 0 112dp; height:112dp; padding:9dp 21dp; background-color:#100e17ed; border-top:1dp #685363; }.bottom-title { display:flex; align-items:center; gap:7dp; color:#f1d6de; font-size:9dp; font-weight:bold; letter-spacing:1.6dp; }.bottom-hint { margin-left:auto; color:#847a87; font-size:8dp; }.boosts { display:flex; gap:8dp; margin-top:8dp; }.boost-card,.boss-card { flex:1; min-width:0; height:63dp; display:flex; align-items:center; gap:7dp; padding:6dp; border:1dp #5b4c58; border-radius:6dp; background-color:#211b26; }.boss-card { border-color:#9c5670; background-color:#2f1d2b; }.portrait { flex:0 0 45dp; width:45dp; height:47dp; display:flex; align-items:center; justify-content:center; border:1dp #493647; border-radius:4dp; background-color:#110f18; color:#d293ac; font-size:12dp; font-weight:bold; }.portrait img { display:block; width:43dp; height:43dp; }.boss-portrait { border-color:#8d5870; }.boost-copy { flex:1; min-width:0; display:flex; flex-direction:column; gap:4dp; }.boost-type { color:#ad9eaa; font-size:8dp; letter-spacing:0.5dp; }.boost-copy strong { display:block; color:#fff; font-size:11dp; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
button { cursor:pointer; }
button:disabled { cursor:default; }
button:hover { border-color:#f2a6bf; color:#fff; }
button:active { background-color:#6d3c55; }
.enter:hover { background-color:#d0748d; border-color:#ffd0dd; box-shadow:#d1608455 0 0 12dp 0; }
.create:hover { background-color:#27674a; border-color:#74d9a0; box-shadow:#4eaa7555 0 0 10dp 0; }
.watch:hover,.account:hover { border-color:#f2a6bf; }
.input,.token-input { cursor:text; }
.input:hover,.token-input:hover { border-color:#d39aad; background-color:#1b121e; }
.input:focus,.token-input:focus { border-color:#f3a1bd; background-color:#201522; }
