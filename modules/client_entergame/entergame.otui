// Backlands — tela de login enxuta.
// Substitui modules/client_entergame/entergame.otui.
// Removidos: token 2FA, "Login with Google", botao de gravacoes (cam).
// Mantidos e OCULTOS (on: false) os paineis de servidor — o Lua ainda os consulta
// (EnterGame.onServerChange, serverHostTextEdit, clientVersionSelector). O style ja tem
// $!on: visible: false, entao eles somem da tela sem quebrar getChildById.
// Widgets: os mesmos estilos que o cliente ja tem. Nenhum estilo novo.

ForgotPassword < MenuLabel
ButtonInformation < Button

EnterGameWindow
  id: enterGame
  size: 280 262
  @onEnter: EnterGame.doLogin()

  MenuLabel
    id: emailLabel
    !text: tr('Email:')
    anchors.left: parent.left
    anchors.top: parent.top
    text-auto-resize: true
    font: $var-cip-font
    color: $var-text-cip-color
    margin-top: -3

  UIWidget
    id: emailStatus
    !tooltip: tr('You have not entered a valid email address.')
    anchors.right: prev.right
    anchors.top: prev.top
    margin-right: -15
    margin-top: 1
    image-source: /images/skin/show-gui-help-red
    visible: false
    focusable: false

  AccTextEdit
    id: accountNameTextEdit
    anchors.left: emailLabel.right
    anchors.right: parent.right
    anchors.top: emailLabel.top
    height: 20
    width: 182
    margin-top: -3
    margin-left: 30
    max-length: 49
    padding-right: 23
    @onTextChange: modules.client_entergame.onTextChange()

  // olho do EMAIL — mesmo sprite do olho da senha
  Button
    id: hiddenEmail
    anchors.verticalCenter: accountNameTextEdit.verticalCenter
    anchors.right: accountNameTextEdit.right
    margin-right: 2
    size: 18 18
    image-source: /images/ui/hidden-button
    image-clip: 0 0 18 18
    !tooltip: tr('Show/hide email')
    $pressed:
      image-source: /images/ui/hidden-button-down
      image-clip: 0 0 18 18
    $hover !pressed:
      image-source: /images/ui/hidden-button
      image-clip: 0 0 18 18
    @onClick: chooseTextModeEmail()

  MenuLabel
    id: passwordLabel
    !text: tr('Password: ')
    anchors.left: parent.left
    anchors.top: accountNameTextEdit.bottom
    margin-top: 14
    font: $var-cip-font
    color: $var-text-cip-color
    text-auto-resize: true

  PasswordTextEdit
    id: accountPasswordTextEdit
    anchors.left: prev.right
    anchors.right: parent.right
    anchors.top: prev.top
    height: 20
    max-length: 49
    width: 182
    margin-top: -3
    margin-left: -1

  // olho da SENHA — era o botao "hidden" da arvore antiga
  Button
    id: hidden
    anchors.verticalCenter: accountPasswordTextEdit.verticalCenter
    anchors.right: accountPasswordTextEdit.right
    margin-right: 2
    size: 18 18
    image-source: /images/ui/hidden-button
    image-clip: 0 0 18 18
    !tooltip: tr('Show/hide password')
    $pressed:
      image-source: /images/ui/hidden-button-down
      image-clip: 0 0 18 18
    $hover !pressed:
      image-source: /images/ui/hidden-button
      image-clip: 0 0 18 18
    @onClick: chooseTextMode()

  CheckBox
    id: rememberEmailBox
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: accountPasswordTextEdit.bottom
    margin-top: 14
    @onCheckChange: chooseButtonVisibility()

    Label
      !text: tr('Remember Email')
      text-auto-resize: true
      !tooltip: tr('Remember account and email when starts client')
      anchors.left: parent.left
      anchors.top: parent.top
      font: $var-cip-font
      color: $var-text-cip-color
      margin-left: 14
      margin-top: -2

  ButtonInformation
    id: buttonInformation
    size: 12 12
    image-source: /images/skin/show-gui-help-grey
    image-clip: 0 0 12 12
    !tooltip: tr('Remember account and email when starts client')
    anchors.right: parent.right
    anchors.top: rememberEmailBox.bottom
    margin-top: -11
    visible: false
    $hover:
      image-clip: 0 0 12 12

    $pressed:
      image-clip: 0 0 12 12

  CheckBox
    id: rememberPasswordBox
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: rememberEmailBox.bottom
    margin-top: 5
    @onCheckChange: chooseButtonVisibility()

    Label
      !text: tr('Remember Password')
      text-auto-resize: true
      !tooltip: tr('Remember password when starts client')
      anchors.left: parent.left
      anchors.top: parent.top
      font: $var-cip-font
      color: $var-text-cip-color
      margin-left: 14
      margin-top: -2

  ButtonInformation
    id: passwordInformation
    size: 12 12
    image-source: /images/skin/show-gui-help-red
    image-clip: 0 0 12 12
    !tooltip: tr('Remember account and password when starts client')
    anchors.right: parent.right
    anchors.top: rememberPasswordBox.top
    margin-top: 3
    visible: false
    $hover:
      image-clip: 0 0 12 12

    $pressed:
      image-clip: 0 0 12 12

  CheckBox
    id: autoLoginBox
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: rememberPasswordBox.bottom
    margin-top: 5
    @onCheckChange: chooseAutoLogin()

    Label
      !text: tr('Auto login')
      text-auto-resize: true
      !tooltip: tr('Log in automatically when the client starts')
      anchors.left: parent.left
      anchors.top: parent.top
      font: $var-cip-font
      color: $var-text-cip-color
      margin-left: 14
      margin-top: -2

  // link 1 — senha
  TextButton
    id: clickSitePassword
    !text: tr('Forgot password')
    anchors.left: parent.left
    anchors.top: autoLoginBox.bottom
    text-auto-resize: true
    margin-top: 13
    font: $var-cip-font
    color: $var-text-cip-color
    cursor: pointer
    image-source: /images/ui/special_miniwindow
    @onClick: openPlataform(self)

  Label
    id: clickSitePasswordUnderline
    size: 106 1
    background-color: $var-text-cip-color
    anchors.top: clickSitePassword.bottom
    anchors.left: clickSitePassword.left
    margin-top: -1

  // link 2 — email
  TextButton
    id: clickSiteEmail
    !text: tr('Forgot email')
    anchors.left: parent.left
    anchors.top: clickSitePassword.top
    text-auto-resize: true
    margin-top: 16
    font: $var-cip-font
    color: $var-text-cip-color
    cursor: pointer
    image-source: /images/ui/special_miniwindow
    @onClick: openPlataform(self)

  Label
    id: clickSiteEmailUnderline
    size: 86 1
    background-color: $var-text-cip-color
    anchors.top: clickSiteEmail.bottom
    anchors.left: clickSiteEmail.left
    margin-top: -1

  TextButton
    id: clickSiteCreateAccount
    !text: tr('Create new account')
    anchors.left: parent.left
    anchors.top: clickSiteEmail.top
    text-auto-resize: true
    margin-top: 16
    font: $var-cip-font
    color: $var-text-cip-color
    cursor: pointer
    image-source: /images/ui/special_miniwindow
    @onClick: modules.client_entergame.openPlataform(self)

  Label
    id: clickSiteCreateAccountUnderline
    size: 130 1
    background-color: $var-text-cip-color
    anchors.top: clickSiteCreateAccount.bottom
    anchors.left: clickSiteCreateAccount.left
    margin-top: -1

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: clickSiteCreateAccount.bottom
    margin-top: 11

  Button
    id: loginButton
    !text: tr('Log in')
    height: 20
    width: 86
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 6
    @onClick: EnterGame.doLogin()

  Label
    id: serverInfoLabel
    font: verdana-11px-rounded
    anchors.top: loginButton.top
    anchors.left: parent.left
    margin-top: 5
    color: green
    text-auto-resize: true

  // ---- ocultos, mantidos porque o Lua os referencia ----

  Panel
    id: serverSelectorPanel
    size: 90 20
    anchors.left: parent.left
    anchors.top: loginButton.top
    on: false
    focusable: false

    $on:
      visible: true
      margin-top: 0

    $!on:
      visible: false

    ComboBox
      id: serverSelector
      anchors.fill: parent
      font: $var-cip-font
      color: $var-text-cip-color
      @onOptionChange: EnterGame.onServerChange()

  Panel
    id: customServerSelectorPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: loginButton.top
    height: 52
    on: false
    focusable: true

    $on:
      visible: true
      margin-top: 0

    $!on:
      visible: false

    MenuLabel
      id: serverLabel
      !text: tr('IP:PORT or URL')
      anchors.left: parent.left
      anchors.top: parent.top
      text-auto-resize: true

    TextEdit
      id: serverHostTextEdit
      anchors.left: parent.left
      anchors.top: serverLabel.bottom
      margin-top: 2
      width: 150

    ComboBox
      id: clientVersionSelector
      anchors.top: serverHostTextEdit.top
      anchors.bottom: serverHostTextEdit.bottom
      anchors.left: serverHostTextEdit.right
      anchors.right: parent.right
      menu-scroll: true
      menu-height: 125
      menu-scroll-step: 25
      margin-left: 10
      margin-right: 3

  // token removido da tela, mas o widget fica: entergame.lua o le nas linhas 707 e 739
  TextEdit
    id: accountTokenTextEdit
    anchors.top: parent.top
    anchors.left: parent.left
    max-length: 6
    only-number: true
    width: 180
    visible: false
    focusable: false
