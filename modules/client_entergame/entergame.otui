// ---------------------------------------------------------------------------
// Backlands - login module
//
// Only the options planned in `ui-login` are present, in this exact order:
//   LOGIN field (+ eye) - PASSWORD field (+ eye) - Remember email -
//   Remember password - Auto login - Forgot password? - Forgot email? -
//   CREATE NEW ACCOUNT - LOGIN
//
// Widget styles are in data/styles/40-entergame.otui. The chrome runs at half
// the pack's block size while the baked text stays at 1:1 (rasterised type does
// not downscale), so the ratios here are half of ui-login/layout.json but the
// sprite sizes are not. Every margin is a whole pixel - do not "round" them.
// ---------------------------------------------------------------------------

EnterGameWindow
  id: enterGame
  @onEnter: EnterGame.doLogin()

  LoginPanel
    id: panel

    // 1. LOGIN label
    LoginSprite
      id: accountNameLabel
      size: 57 14
      anchors.top: parent.top
      anchors.left: parent.left
      image-source: /images/ui/login/label-login

    // 2. login field + eye toggle
    LoginField
      id: accountNameField
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-left: -2
      margin-right: -2

      LoginInput
        id: accountNameTextEdit
        !placeholder: tr('email')

      LoginEyeToggle
        id: accountNameEye
        !tooltip: tr('Show login')
        @onCheckChange: EnterGame.onRevealChange(self)

    // 3. PASSWORD label
    LoginSprite
      id: accountPasswordLabel
      size: 94 14
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 18
      image-source: /images/ui/login/label-password

    // 4. password field + eye toggle
    LoginField
      id: accountPasswordField
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-left: -2
      margin-right: -2

      LoginInput
        id: accountPasswordTextEdit
        !placeholder: tr('********')

      LoginEyeToggle
        id: accountPasswordEye
        !tooltip: tr('Show password')
        @onCheckChange: EnterGame.onRevealChange(self)

    // 5. Remember email (on by default)
    LoginCheckBox
      id: rememberEmailBox
      width: 184
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 20
      margin-left: -2
      !tooltip: tr('Remember the login when the client starts')
      @onCheckChange: EnterGame.onOptionChange()

      LoginSprite
        id: caption
        size: 161 11
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 4
        margin-left: 23
        image-source: /images/ui/login/remember-email

    // 6. Remember password
    LoginCheckBox
      id: rememberPasswordBox
      width: 233
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 10
      margin-left: -2
      !tooltip: tr('Remember the password when the client starts')
      @onCheckChange: EnterGame.onOptionChange()

      LoginSprite
        id: caption
        size: 210 11
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 4
        margin-left: 23
        image-source: /images/ui/login/remember-password

    // 7. Auto login
    LoginCheckBox
      id: autoLoginBox
      width: 136
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 10
      margin-left: -2
      !tooltip: tr('Log in automatically the next time the client starts')
      @onCheckChange: EnterGame.onOptionChange()

      LoginSprite
        id: caption
        size: 113 11
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 4
        margin-left: 23
        image-source: /images/ui/login/auto-login

    // 8. Forgot password?
    LoginLinkForgotPassword
      id: forgotPasswordButton
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 24
      @onClick: EnterGame.openRecoverPassword()

    // 9. Forgot email?
    LoginLinkForgotEmail
      id: forgotEmailButton
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 12
      @onClick: EnterGame.openRecoverEmail()

    // 10. CREATE NEW ACCOUNT
    LoginButtonSecondary
      id: createAccountButton
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 20
      margin-left: -4
      margin-right: -4
      @onClick: EnterGame.openCreateAccount()

    // 11. LOGIN (always last)
    LoginButtonPrimary
      id: loginButton
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-left: -4
      margin-right: -4
      @onClick: EnterGame.doLogin()

  // Drawn after the panel so it darkens everything inside it.
  LoginScanlines
    id: scanlines

  // Drawn last so it overlaps the top edge of the frame.
  LoginCrest
    id: crest
