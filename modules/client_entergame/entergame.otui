EnterGameWindow
  id: enterGame
  &loaded: false

  LoginPanel
    id: loginPanel

    LoginSprite
      id: labelLogin
      size: 57 14
      image-source: /images/ui/login/label-login
      anchors.top: parent.top
      anchors.left: parent.left

    LoginField
      id: emailField
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5

      LoginInput
        id: emailInput
        placeholder: login

      LoginEyeToggle
        id: emailEye
        @onCheckChange: modules.client_entergame.onEmailEyeChange(self)

    LoginSprite
      id: labelPassword
      size: 94 14
      image-source: /images/ui/login/label-password
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 13

    LoginField
      id: passwordField
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5

      LoginInput
        id: passwordInput
        placeholder: password

      LoginEyeToggle
        id: passwordEye
        @onCheckChange: modules.client_entergame.onPasswordEyeChange(self)

    LoginCheckBox
      id: rememberEmail
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 13
      @onCheckChange: modules.client_entergame.onRememberEmailChange(self)

      LoginSprite
        id: rememberEmailLabel
        size: 161 11
        image-source: /images/ui/login/remember-email
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 23
        margin-top: 4

    LoginCheckBox
      id: rememberPassword
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7
      @onCheckChange: modules.client_entergame.onRememberPasswordChange(self)

      LoginSprite
        id: rememberPasswordLabel
        size: 210 11
        image-source: /images/ui/login/remember-password
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 23
        margin-top: 4

    LoginCheckBox
      id: autoLogin
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7
      @onCheckChange: modules.client_entergame.onAutoLoginChange(self)

      LoginSprite
        id: autoLoginLabel
        size: 113 11
        image-source: /images/ui/login/auto-login
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 23
        margin-top: 4

    LoginLinkForgotPassword
      id: forgotPassword
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 13
      @onClick: modules.client_entergame.onForgotPassword()

    LoginLinkForgotEmail
      id: forgotEmail
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      @onClick: modules.client_entergame.onForgotEmail()

    LoginButtonSecondary
      id: createAccountButton
      width: 288
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 13
      @onClick: modules.client_entergame.onCreateAccount()

    LoginButtonPrimary
      id: loginButton
      width: 288
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10
      @onClick: modules.client_entergame.doLogin()

  LoginCrest
    id: crest
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter

  LoginScanlines
    id: scanlines
    anchors.fill: loginPanel
