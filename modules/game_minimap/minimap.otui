InvisibleMinimapButton < UIButton
  opacity: 0
  size: 15 15

MapMiniWindow
  id: minimapWindow
  &type: 'miniMap'
  @onClose: modules.game_minimap.onClose()

  Minimap
    id: minimap
    anchors.fill: parent
    margin: 15 4 4 4
    @onHoverPosition: |
      function(self, mapPos)
          -- todo
      end
  UIWidget
    id: title
    size: 58 10
    focusable: false
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 3
    image-source: /images/game/minimap/mapview-label
    phantom: true

  UIButton
    id: expandMapVertical
    size: 13 13
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 1
    margin-right: 6
    image-source: /images/game/actionbar/arrow-down
    image-clip: 0 0 17 17
    image-smooth: true
    tooltip: Expand minimap downward
    tooltip-delayed: true
    @onClick: modules.game_minimap.toggleVerticalExpanded()
    $pressed:
      image-clip: 0 17 17 17

  UIButton
    id: expandMap
    size: 13 13
    anchors.top: parent.top
    anchors.right: expandMapVertical.left
    margin-top: 1
    margin-right: 2
    image-source: /images/game/actionbar/arrow-left
    image-clip: 0 0 17 17
    image-smooth: true
    tooltip: Expand minimap
    tooltip-delayed: true
    @onClick: modules.game_minimap.toggleExpanded()
    $pressed:
      image-clip: 0 17 17 17

  ResizeBorder
    id: resizeBorder
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 5
    enabled: true
    cursor: sizeWE

  UIWidget
    id: centerMap
    size: 29 32
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 23
    margin-right: 35
    image-source: /images/game/minimap/timedisplay-scroll-full
    //image-border: 2
    image-clip: 64 0 34 34
    @onClick: modules.game_minimap.center()
  UIWidget
    id: glass
    size: 47 46
    image-source: /images/game/minimap/timedisplay-glass
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 17
    margin-right: 26

  InvisibleMinimapButton
    anchors.right: glass.right
    anchors.verticalCenter: glass.verticalCenter
    @onClick: function() minimapWidget:move(-10,0) end

  InvisibleMinimapButton
    anchors.left: glass.left
    anchors.verticalCenter: glass.verticalCenter
    @onClick: function() minimapWidget:move(10,0) end

  InvisibleMinimapButton
    anchors.top: glass.top
    anchors.horizontalCenter: glass.horizontalCenter
    @onClick: function() minimapWidget:move(0,10) end

  InvisibleMinimapButton
    anchors.bottom: glass.bottom
    anchors.horizontalCenter: glass.horizontalCenter
    @onClick: function() minimapWidget:move(0,-10) end

  InvisibleMinimapButton
    anchors.top: glass.top
    anchors.left: glass.left
    @onClick: function() minimapWidget:move(10, 10) end

  InvisibleMinimapButton
    anchors.top: glass.top
    anchors.right: glass.right
    @onClick: function() minimapWidget:move(-10, 10) end

  InvisibleMinimapButton
    anchors.bottom: glass.bottom
    anchors.left: glass.left
    @onClick: function() minimapWidget:move(10, -10) end

  InvisibleMinimapButton
    anchors.bottom: glass.bottom
    anchors.right: glass.right
    @onClick: function() minimapWidget:move(-10, -10) end

  InvisibleMinimapButton
    anchors.verticalCenter: glass.verticalCenter
    anchors.horizontalCenter: glass.horizontalCenter
    @onClick: function() minimapWidget:reset() end

  Label
    id: floorPosition
    image-source: /images/automap/automap_indicator_maplayers
    size: 14 67
    image-clip: 98 0 14 67
    anchors.top: glass.bottom
    anchors.right: parent.right
    margin-top: 2
    margin-right: 6
    tooltip: Change floor
    tooltip-delayed: true

    InvisibleMinimapButton
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 33
      tooltip: One floor up
      tooltip-delayed: true
      @onClick: modules.game_minimap.floor(true)

    InvisibleMinimapButton
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 34
      tooltip: One floor down
      tooltip-delayed: true
      @onClick: modules.game_minimap.floor(false)

  Button
    id: zoomOutWidget
    size: 20 20
    image-source: /images/game/minimap/automap-button-zoomout-up
    image-clip: 0 0 20 20
    anchors.top: glass.bottom
    anchors.right: floorPosition.left
    margin-top: 2
    margin-right: 4
    tooltip: Zoom out (Alt + Home)
    tooltip-delayed: true
    $hover !pressed:
      image-clip: 0 0 20 20
    $pressed:
      image-clip: 0 0 20 20
      image-source: /images/game/minimap/automap-button-zoomout-down
    @onClick: modules.game_minimap.zoom(false)

  Button
    id: zoomInWidget
    size: 20 20
    image-source: /images/game/minimap/automap-button-zoomin-up
    image-clip: 0 0 20 20
    anchors.top: zoomOutWidget.bottom
    anchors.right: zoomOutWidget.right
    margin-top: 2
    tooltip: Zoom in (Alt + End)
    tooltip-delayed: true
    $hover !pressed:
      image-clip: 0 0 20 20
    $pressed:
      image-clip: 0 0 20 20
      image-source: /images/game/minimap/automap-button-zoomin-down
    @onClick: modules.game_minimap.zoom(true)

  Button
    id: fullSize
    size: 20 20
    image-source: /images/game/minimap/automap-button-cyclopediamap-up
    image-clip: 0 0 20 20
    anchors.top: zoomInWidget.bottom
    anchors.right: zoomInWidget.right
    margin-top: 2
    tooltip: Go to Cyclopedia Map
    tooltip-delayed: true
    @onClick: modules.game_cyclopedia.toggleRedirect("Map")
    $hover !pressed:
      image-clip: 0 0 20 20

    $pressed:
      image-clip: 0 0 20 20
      image-source: /images/game/minimap/automap-button-cyclopediamap-down

  Button
    id: downloadMapButton
    !text: tr('Download Map')
    anchors.right: zoomInWidget.left
    anchors.bottom: parent.bottom
    margin-right: 4
    margin-bottom: 5
    width: 144
    height: 18
    tooltip: Download the complete minimap
    tooltip-delayed: true
    @onClick: modules.game_minimap.downloadFullMap()
