Module
  name: game_interface
  description: Create the game interface, where the ingame stuff starts
  author: Mateuzkl
  website: https://github.com/Mateuzkl/AstraClient
  sandboxed: true
  call-name: interface
  scripts: [ widgets/uigamemap, gameinterface ]
  load-later:
    - game_buttons
    - game_battle
    - client_stats
    - client_textedit
    - game_sidebars
    - game_minimap
    - game_textmessage
    - game_console
    - game_outfit
    - game_healthinfo
    - game_topbar
    - game_inventory
    - game_containers
    - game_textwindow
    - game_playertrade
    - game_bugreport
    - game_playerdeath
    - game_playermount
    - game_ruleviolation
    - game_cooldown
    - game_modaldialog
    - game_walking
    - game_itemselector
    - game_actionbar
    - game_hotkeys
    - game_prey
    - game_stats
    - game_shaders
    - game_bot
    - game_unjustifiedpoints
    - game_skills
    - game_viplist
    - game_npctrade
    - game_questlog
    - game_spells

  @onLoad: init()
  @onUnload: terminate()
