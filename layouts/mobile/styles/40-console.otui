// Clean-room Translucent Dark-Charcoal On-Demand Mobile Console (zero reserved space when closed).
ConsoleTabBar < MoveableTabBar
  height: 24
  padding: 0 3
  border-width-top: 0
  margin-top: 1
  margin-right: 0

ConsoleTabBarButton < UIButton
  size: 26 22
  font: mobile-hud-12
  background-color: #1c2026d8
  border-width: 1
  border-color: #525864aa
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.bottom: parent.bottom
  color: #b0b6c2
  text-offset: 0 0
  padding-left: 10
  padding-right: 10
  &tabWidth: 88

  $checked:
    color: #ffffff
    background-color: #343a46ee
    border-color: #c8bfa0cc

  $on !checked:
    color: #ff7b72

ConsolePanel < Panel
  id: consolePanel
  anchors.fill: parent
  image-source: /images/mobile_ui/panel_dark
  image-border: 6
  padding: 3

  Panel
    id: parentPanel
    background-color: #0c0e12cc
    border-width: 1
    border-color: #464c56aa
    anchors.top: next.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 2
    padding: 3

    Button
      id: toggleChat
      !text: tr('Hide')
      size: 56 28
      font: mobile-hud-12
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      @onClick: if modules.game_console and modules.game_console.setMobileChatVisible then modules.game_console.setMobileChatVisible(false) else toggleChat() end

    TextEditCipsoft
      id: consoleTextEdit
      font: mobile-input-14
      color: #f0f2f5
      image-source: /images/mobile_ui/input_idle
      image-border: 6
      padding: 4 8 4 8
      anchors.top: sayModeButton.top
      anchors.left: sayModeButton.right
      anchors.right: prev.left
      anchors.bottom: parent.bottom
      height: 28
      margin-left: 3
      margin-right: 3
      shift-navigation: true
      max-length: 255
      text-auto-submit: true
      $focus:
        image-source: /images/mobile_ui/input_focus

    ConsoleIconButton
      id: sayModeButton
      icon: /images/game/console/say
      &sayMode: 2
      size: 28 28
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      @onClick: sayModeChange()

    Panel
      id: consoleContentPanel
      background-color: #0a0c10b0
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: consoleTextEdit.top
      margin-bottom: 3
      focusable: false
      $on:
        anchors.right: parent.horizontalCenter
      $!on:
        anchors.right: parent.right

      ScrollablePanel
        id: consoleBuffer
        anchors.fill: parent
        margin-right: 16
        vertical-scrollbar: consoleScrollBar
        layout:
          type: verticalBox
          align-bottom: true
        inverted-scroll: true
        padding: 3

      VerticalScrollBar
        id: consoleScrollBar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        step: 20
        pixels-scroll: true

    Panel
      id: consoleReadyOnlyPanel
      background-color: #0a0c10b0
      anchors.top: parent.top
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.bottom: consoleTextEdit.top
      margin-bottom: 3
      margin-left: 2
      focusable: false
      visible: false

      ScrollablePanel
        id: consoleReadyOnlyBuffer
        anchors.fill: parent
        margin-right: 16
        vertical-scrollbar: consoleReadyOnlyScrollBar
        layout:
          type: verticalBox
          align-bottom: true
        inverted-scroll: true
        padding: 3

      VerticalScrollBar
        id: consoleReadyOnlyScrollBar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        step: 20
        pixels-scroll: true

  ConsoleTabBar
    id: consoleTabBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 24
    margin-left: 22
    movable: false
    phantom: true

  ConsoleIconButton
    id: prevChannelButton
    size: 20 22
    image-clip: 351 17 18 17
    anchors.left: parent.left
    anchors.top: parent.top
    visible: true

  NewConsoleIconButton
    id: readOnly
    size: 1 1
    visible: false
    anchors.right: parent.right
    anchors.top: parent.top

  ConsoleIconButton
    id: exivaOption
    size: 1 1
    visible: false
    anchors.right: parent.right
    anchors.top: parent.top

  ConsoleIconButton
    id: ignoreButton
    size: 1 1
    visible: false
    anchors.right: parent.right
    anchors.top: parent.top

  ConsoleIconButton
    id: channelsButton
    size: 20 20
    image-clip: 16 0 16 16
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 2
    margin-right: 2
    @onClick: g_game.requestChannels()

  ConsoleIconButton
    id: closeChannelButton
    size: 20 20
    image-clip: 160 0 16 16
    anchors.right: channelsButton.left
    anchors.top: channelsButton.top
    margin-right: 2
    visible: false
    @onClick: removeCurrentTab()

  ConsoleIconButton
    id: nextChannelButton
    size: 20 22
    image-clip: 351 0 18 17
    anchors.right: closeChannelButton.left
    anchors.top: parent.top
    margin-right: 2
    visible: true
