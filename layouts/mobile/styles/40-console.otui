// Clean-room Dark-Glass Mobile Console overrides preserving all AstraClient Chat child IDs.
ConsoleTabBar < MoveableTabBar
  height: 28
  padding: 0 4
  border-width-top: 0
  margin-top: 2
  margin-right: 0

ConsoleTabBarButton < UIButton
  size: 28 26
  font: mobile-hud-12
  background-color: #0e1424cc
  border-width: 1
  border-color: #ffffff24
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.bottom: parent.bottom
  color: #9aa5ba
  text-offset: 0 0
  margin-bottom: 0
  padding-left: 12
  padding-right: 12
  &tabWidth: 96

  $checked:
    color: #ffd96a
    background-color: #202a42ee
    border-color: #e8b83ecc

  $on !checked:
    color: #ff7b72

ConsolePanel < Panel
  id: consolePanel
  anchors.fill: parent
  margin-top: 2
  image-source: /images/mobile_ui/panel_glass
  image-border: 10
  padding: 4

  Panel
    id: parentPanel
    background-color: #050912b0
    border-width: 1
    border-color: #ffffff1a
    anchors.top: next.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 2
    padding: 4

    Button
      id: toggleChat
      !tooltip: tr('Enable/disable chat')
      !text: tr('Chat On')
      size: 74 30
      font: mobile-hud-12
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-bottom: 1
      @onClick: toggleChat()

    TextEditCipsoft
      id: consoleTextEdit
      font: mobile-input-14
      color: #f4f0e4
      image-source: /images/mobile_ui/input_idle
      image-border: 8
      padding: 5 8 4 8
      anchors.top: sayModeButton.top
      anchors.left: sayModeButton.right
      anchors.right: prev.left
      anchors.bottom: parent.bottom
      height: 30
      margin-left: 4
      margin-right: 4
      shift-navigation: true
      max-length: 255
      text-auto-submit: true
      $focus:
        image-source: /images/mobile_ui/input_focus

    ConsoleIconButton
      id: sayModeButton
      icon: /images/game/console/say
      !tooltip: tr('Adjust volume')
      &sayMode: 2
      size: 30 30
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-left: 2
      margin-bottom: 1
      @onClick: sayModeChange()

    Panel
      id: consoleContentPanel
      background-color: #04070ec0
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: consoleTextEdit.top
      margin-bottom: 4
      margin-left: 1
      margin-top: 1
      focusable: false
      $on:
        anchors.right: parent.horizontalCenter
      $!on:
        anchors.right: parent.right

      ScrollablePanel
        id: consoleBuffer
        anchors.fill: parent
        margin-right: 16
        vertical-scrollbar: consoleScrollBar
        layout:
          type: verticalBox
          align-bottom: true
        inverted-scroll: true
        padding: 4

      VerticalScrollBar
        id: consoleScrollBar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-top: 2
        margin-right: 2
        margin-bottom: 2
        step: 24
        pixels-scroll: true

    Panel
      id: consoleReadyOnlyPanel
      background-color: #04070ec0
      anchors.top: parent.top
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.bottom: consoleTextEdit.top
      margin-bottom: 4
      margin-left: 3
      margin-top: 1
      focusable: false
      visible: false

      ScrollablePanel
        id: consoleReadyOnlyBuffer
        anchors.fill: parent
        margin-right: 16
        vertical-scrollbar: consoleReadyOnlyScrollBar
        layout:
          type: verticalBox
          align-bottom: true
        inverted-scroll: true
        padding: 4

      VerticalScrollBar
        id: consoleReadyOnlyScrollBar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-top: 2
        margin-right: 2
        margin-bottom: 2
        step: 24
        pixels-scroll: true

  ConsoleTabBar
    id: consoleTabBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 28
    margin-top: 1
    margin-left: 24
    movable: true
    phantom: true
    tab-draggable: true
    tab-todrag: readOnly

  ConsoleIconButton
    id: prevChannelButton
    size: 22 24
    image-clip: 351 17 18 17
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 2
    visible: true
    !tooltip: tr('Move channels to the right')
    $pressed:
      image-clip: 369 17 18 17

  NewConsoleIconButton
    id: readOnly
    size: 1 1
    visible: false
    anchors.right: parent.right
    anchors.top: parent.top

  ConsoleIconButton
    id: exivaOption
    size: 22 22
    image-clip: 351 50 16 16
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 3
    margin-right: 2
    @onClick: if modules.game_exiva_options then modules.game_exiva_options.onRequestExivaOptions() end
    $on:
      image-clip: 351 50 16 16
    $!on:
      image-clip: 351 34 16 16
    $pressed:
      image-clip: 351 66 16 16
    $pressed !on:
      image-clip: 351 34 16 16

  ConsoleIconButton
    id: ignoreButton
    size: 22 22
    image-clip: 48 0 16 16
    anchors.right: prev.left
    anchors.top: prev.top
    margin-right: 2
    @onClick: modules.game_console.Communication:onClickIgnoreButton()
    $pressed:
      image-clip: 48 16 16 16

  ConsoleIconButton
    id: channelsButton
    size: 22 22
    image-clip: 16 0 16 16
    anchors.right: prev.left
    anchors.top: prev.top
    margin-right: 2
    @onClick: g_game.requestChannels()
    $pressed:
      image-clip: 16 16 16 16

  ConsoleIconButton
    id: closeChannelButton
    size: 22 22
    image-clip: 160 0 16 16
    anchors.right: prev.left
    anchors.top: prev.top
    margin-right: 2
    visible: false
    @onClick: removeCurrentTab()
    $pressed:
      image-clip: 160 16 16 16

  ConsoleIconButton
    id: nextChannelButton
    size: 22 24
    image-clip: 351 0 18 17
    anchors.right: prev.left
    anchors.top: parent.top
    margin-top: 2
    margin-right: 2
    visible: true
    $pressed:
      image-clip: 369 0 18 17
