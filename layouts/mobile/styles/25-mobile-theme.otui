// Clean-room Mobile Obsidian + Smoked Glass + Brushed Gold Global Theme.
// Loaded ONLY when layout == 'mobile' (zero impact on Desktop Full).

MainWindow < UIWindow
  font: mobile-title-18
  color: #f6d475
  size: 320 240
  opacity: 1
  padding-top: 38
  padding-left: 16
  padding-right: 16
  padding-bottom: 14
  image-source: /images/mobile_ui/panel_gold
  image-border: 12
  text-offset: 0 9
  text-align: top
  draggable: true
  anchors.centerIn: parent

  $disabled:
    color: #8f96a6

StaticMainWindow < MainWindow
  draggable: false

Button < UIButton
  font: mobile-btn-15
  color: #f3eedc
  size: 112 36
  text-offset: 0 0
  text-align: center
  image-source: /images/mobile_ui/btn_dark
  image-color: #ffffffff
  image-clip: 0 0 128 48
  image-border: 10
  padding: 4 12 4 12
  opacity: 1.0
  change-cursor-image: false

  $hover !disabled:
    image-clip: 0 48 128 48
    color: #ffd96a

  $pressed:
    image-clip: 0 96 128 48
    text-offset: 0 1
    color: #ffd96a

  $on:
    image-clip: 0 48 128 48
    color: #ffd96a

  $disabled:
    color: #9ba3b488
    opacity: 0.6

TextEdit < UITextEdit
  font: mobile-input-14
  color: #f4f0e4
  size: 160 36
  text-offset: 0 0
  opacity: 1
  padding: 8 10 6 10
  image-source: /images/mobile_ui/input_idle
  image-border: 10
  selection-color: #ffffff
  selection-background-color: #2478d4cc
  change-cursor-image: false

  $focus:
    image-source: /images/mobile_ui/input_focus

  $disabled:
    color: #8f96a688
    opacity: 0.6

CheckBox < UICheckBox
  font: mobile-hud-12
  size: 22 22
  text-align: left
  text-offset: 28 1
  color: #e9e2ce
  image-color: #ffffffff
  image-rect: 0 0 22 22
  image-source: /images/mobile_ui/checkbox
  image-clip: 0 0 24 24
  change-cursor-image: false

  $checked !disabled:
    image-clip: 0 24 24 24
    color: #fff6dc

  $disabled:
    image-clip: 0 48 24 24
    color: #9ba3b488

ComboBox < UIComboBox
  font: mobile-input-14
  color: #f3eedc
  size: 140 36
  text-offset: 10 0
  text-align: left
  image-source: /images/mobile_ui/btn_dark
  image-clip: 0 0 128 48
  image-border: 10
  padding-right: 26

  $hover !disabled:
    image-clip: 0 48 128 48
    color: #ffd96a

  $on:
    image-clip: 0 48 128 48
    color: #ffd96a

  $disabled:
    color: #9ba3b488
    opacity: 0.6

ComboBoxPopupMenu < UIPopupMenu
  background-color: #090e19f5
  border-width: 1
  border-color: #e8b83ebb
  padding: 4

ComboBoxPopupMenuButton < UIButton
  height: 36
  font: mobile-input-14
  color: #f3eedc
  text-align: left
  text-offset: 10 0
  background-color: alpha

  $hover:
    background-color: #e8b83e38
    color: #ffd96a

  $pressed:
    background-color: #e8b83e55
    color: #ffffff

HorizontalSeparator < UIWidget
  height: 1
  background-color: #e8b83e44
  phantom: true
  focusable: false

VerticalSeparator < UIWidget
  width: 1
  background-color: #ffffff28
  phantom: true
  focusable: false
