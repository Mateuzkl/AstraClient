// Clean-room Classic Dark-Charcoal Mobile Scrollbars.
VerticalScrollBarSlider < UIButton
  id: sliderButton
  anchors.centerIn: parent
  size: 12 40
  background-color: #7c8492cc
  border-width: 1
  border-color: #aab2c0cc

  $hover !disabled:
    background-color: #a6aebccc

  $pressed:
    background-color: #d6cca8ee

VerticalScrollBar < UIScrollBar
  orientation: vertical
  width: 16
  height: 60
  pixels-scroll: true
  background-color: #0e1014b8
  border-width: 1
  border-color: #484e58aa

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    size: 16 1
    visible: false

  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    size: 16 1
    visible: false

  VerticalScrollBarSlider

HorizontalScrollBarSlider < UIButton
  id: sliderButton
  anchors.centerIn: parent
  size: 40 12
  background-color: #7c8492cc
  border-width: 1
  border-color: #aab2c0cc

  $hover !disabled:
    background-color: #a6aebccc

  $pressed:
    background-color: #d6cca8ee

HorizontalScrollBar < UIScrollBar
  orientation: horizontal
  height: 16
  width: 60
  pixels-scroll: true
  background-color: #0e1014b8
  border-width: 1
  border-color: #484e58aa

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    size: 1 16
    visible: false

  UIButton
    id: incrementButton
    anchors.top: parent.top
    anchors.right: parent.right
    size: 1 16
    visible: false

  HorizontalScrollBarSlider
