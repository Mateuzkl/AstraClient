// Clean-room Obsidian + Gold Mobile ScrollBar override.
VerticalScrollBar < UIScrollBar
  orientation: vertical
  width: 10
  height: 48
  pixels-scroll: true
  background-color: #070b1499
  border-width: 1
  border-color: #ffffff1c

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    size: 10 0
    visible: false

  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    size: 10 0
    visible: false

  UIButton
    id: sliderButton
    anchors.centerIn: parent
    size: 8 28
    minimum: 24
    background-color: #c8a24aaa
    border-width: 1
    border-color: #f6d47588

    $pressed:
      background-color: #f6d475ee

HorizontalScrollBar < UIScrollBar
  orientation: horizontal
  width: 48
  height: 10
  pixels-scroll: true
  background-color: #070b1499
  border-width: 1
  border-color: #ffffff1c

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    size: 0 10
    visible: false

  UIButton
    id: incrementButton
    anchors.top: parent.top
    anchors.right: parent.right
    size: 0 10
    visible: false

  UIButton
    id: sliderButton
    anchors.centerIn: parent
    size: 28 8
    minimum: 24
    background-color: #c8a24aaa
    border-width: 1
    border-color: #f6d47588

    $pressed:
      background-color: #f6d475ee
