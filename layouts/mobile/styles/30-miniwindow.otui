// Clean-room Translucent Dark-Charcoal Mobile MiniWindows (floating cleanly over full-screen map).
MiniWindow < UIMiniWindow
  font: mobile-hud-12
  icon-rect: 5 3 16 16
  width: 174
  height: 186
  text-offset: 24 3
  text-align: topLeft
  image-source: /images/mobile_ui/panel_window
  image-border: 8
  image-border-top: 22
  image-border-bottom: 6
  focusable: false
  color: #e6e9ef
  &minimizedHeight: 24

  $on:
    image-border-bottom: 4

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 2
    margin-left: 2
    margin-top: 2
    size: 168 20
    phantom: true

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 3
    size: 18 18
    icon-source: /images/mobile_ui/icon_close
    icon-rect: 3 3 12 12
    background-color: #242830cc
    border-width: 1
    border-color: #5c6370aa
    $hover:
      background-color: #9e2d32dd
    $pressed:
      background-color: #c2383eee

  UIButton
    id: minimizeButton
    anchors.top: closeButton.top
    anchors.right: closeButton.left
    margin-right: 3
    size: 18 18
    font: mobile-hud-12
    color: #d6dae2
    text: -
    background-color: #242830cc
    border-width: 1
    border-color: #5c6370aa
    $on:
      text: +

  UIButton
    id: lockButton
    anchors.top: minimizeButton.top
    anchors.right: minimizeButton.left
    margin-right: 3
    size: 18 18
    visible: false

  UIButton
    id: upButton
    anchors.top: minimizeButton.top
    anchors.right: minimizeButton.left
    margin-right: 3
    size: 18 18
    font: mobile-hud-12
    color: #e2e6ec
    text: ^
    background-color: #242830cc
    border-width: 1
    border-color: #5c6370aa
    visible: false

  VerticalScrollBar
    id: miniwindowScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 24
    margin-top: 23
    margin-right: 2
    margin-bottom: 4
    pixels-scroll: true

    $!on:
      width: 0

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 4
    minimum: 48
    margin-left: 3
    margin-right: 3
    background: #ffffff22

  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    size: 6 6
    margin-left: 2
    margin-bottom: 2
    phantom: true

MiniWindowContents < ScrollablePanel
  id: contentsPanel
  anchors.fill: parent
  anchors.right: miniwindowScrollBar.left
  margin-left: 4
  margin-bottom: 4
  margin-top: 23
  margin-right: 2
  vertical-scrollbar: miniwindowScrollBar
  background-color: alpha

MiniWindowHeader < Panel
  id: miniwindowHeader
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  margin-top: 22
  margin-left: 4
  margin-right: 4
  background-color: #16191ecc

BorderlessGameWindow < UIWindow
  focusable: false
  margin: 2
