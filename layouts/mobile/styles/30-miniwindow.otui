// Sleek Obsidian + Gold Mobile MiniWindow overrides preserving all AstraClient child IDs.
MiniWindow < UIMiniWindow
  font: mobile-hud-12
  color: #f3d988
  icon-rect: 6 6 14 14
  width: 212
  height: 224
  text-offset: 24 4
  text-align: topLeft
  image-source: /images/mobile_ui/panel_miniwindow
  image-border: 10
  image-border-top: 26
  image-border-bottom: 10
  focusable: false
  &minimizedHeight: 28
  icon-offset-y: 0

  $on:
    image-border-top: 26
    image-border-bottom: 10
    image-border: 10

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 4
    margin-left: 4
    margin-top: 2
    height: 24
    phantom: true

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 4
    margin-right: 5
    size: 18 18
    image-source: /images/ui/miniwindow_buttons
    image-clip: 29 1 12 12
    tooltip: Close this window
    tooltip-delayed: true

    $hover:
      image-clip: 29 15 12 12

    $pressed:
      image-clip: 29 29 12 12

  UIButton
    id: minimizeButton
    anchors.top: closeButton.top
    anchors.right: closeButton.left
    margin-right: 3
    size: 18 18
    image-source: /images/ui/miniwindow_buttons
    image-clip: 1 1 12 12
    tooltip: Maximise or minimise window
    tooltip-delayed: true

    $hover:
      image-clip: 1 15 12 12

    $pressed:
      image-clip: 1 29 12 12

    $on:
      image-clip: 15 1 12 12

    $on hover:
      image-clip: 15 15 12 12

    $on pressed:
      image-clip: 15 29 12 12

  UIButton
    id: filterBattleButton
    anchors.top: lockButton.top
    anchors.right: lockButton.left
    margin-right: 4
    size: 18 18
    image-source: /images/ui/miniwindow_buttons
    image-clip: 99 1 12 12
    $hover:
      image-clip: 99 15 12 12
    $pressed:
      image-clip: 99 29 12 12
    $on:
      image-clip: 99 29 12 12

  UIButton
    id: redirectBattleButton
    anchors.top: prev.top
    anchors.right: prev.left
    margin-right: 3
    size: 18 18
    image-source: /images/ui/miniwindow_buttons
    image-clip: 57 1 12 12

    $hover:
      image-clip: 57 15 12 12

    $pressed:
      image-clip: 57 29 12 12

    $on:
      image-clip: 57 29 12 12

  UIButton
    id: extraBattleButton
    anchors.top: prev.top
    anchors.right: prev.left
    margin-right: 3
    size: 18 18
    image-source: /images/ui/miniwindow_buttons
    image-clip: 113 1 12 12

    $hover:
      image-clip: 113 15 12 12

    $pressed:
      image-clip: 113 29 12 12

    $on:
      image-clip: 113 29 12 12

  UIButton
    id: redirectButton
    anchors.top: extraButton.top
    anchors.right: extraButton.left
    margin-right: 3
    size: 18 18
    image-source: /images/ui/miniwindow_buttons
    image-clip: 57 1 12 12

    $hover:
      image-clip: 57 15 12 12

    $pressed:
      image-clip: 57 29 12 12

    $on:
      image-clip: 57 29 12 12

  UIButton
    id: lockButton
    anchors.top: minimizeButton.top
    anchors.right: minimizeButton.left
    margin-right: 3
    size: 18 18
    image-source: /images/ui/miniwindow_buttons
    image-clip: 71 1 12 12
    tooltip: Lock or unlock window
    tooltip-delayed: true

    $hover:
      image-clip: 71 15 12 12

    $pressed:
      image-clip: 71 29 12 12

    $on:
      image-clip: 85 1 12 12

    $on hover:
      image-clip: 85 15 12 12

    $on pressed:
      image-clip: 85 29 12 12

  UIButton
    id: extraButton
    anchors.top: lockButton.top
    anchors.right: lockButton.left
    margin-right: 4
    size: 18 18
    image-source: /images/ui/miniwindow_buttons
    image-clip: 113 1 12 12

    $hover:
      image-clip: 113 15 12 12

    $pressed:
      image-clip: 113 29 12 12

    $on:
      image-clip: 113 29 12 12

  UIButton
    id: filterContainer
    anchors.top: lockButton.top
    anchors.right: lockButton.left
    margin-right: 3
    size: 18 18
    image-source: /images/ui/miniwindow_buttons
    image-clip: 113 1 12 12

    $hover:
      image-clip: 113 15 12 12

    $pressed:
      image-clip: 113 29 12 12

    $on:
      image-clip: 113 29 12 12

  VerticalScrollBar
    id: miniwindowScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 22
    margin-top: 26
    margin-right: 4
    margin-bottom: 6
    pixels-scroll: true

    $!on:
      width: 0

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 8
    minimum: 56
    margin-left: 6
    margin-right: 6
    background: #e8b83e44

MiniWindowContents < ScrollablePanel
  id: contentsPanel
  anchors.fill: parent
  anchors.right: miniwindowScrollBar.left
  margin-left: 5
  margin-bottom: 8
  margin-top: 27
  margin-right: 3
  vertical-scrollbar: miniwindowScrollBar

HeadlessMiniWindow < MiniWindow
