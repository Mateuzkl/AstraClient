ComboBoxPopupScrollMenuButton < UIButton
  height: 17
  font: $var-cip-font
  text-align: left
  text-offset: 4 0
  color: $var-text-cip-color
  background-color: alpha
  margin: 1

  $hover !disabled:
    color: #f4f4f4
    background-color: #86868750

  $disabled:
    color: #dfdfdf88

ComboBoxPopupScrollMenu < UIPopupScrollMenu
  image-source: /images/ui/combobox_square
  image-clip: 0 60 98 20
  image-border: 1

ComboBoxPopupMenuButton < UIButton
  height: 17
  font: $var-cip-font
  text-align: left
  text-offset: 4 0
  color: $var-text-cip-color
  background-color: alpha
  margin: 1

  $hover !disabled:
    color: #f4f4f4
    background-color: #86868750

  $disabled:
    color: #dfdfdf88

ComboBoxPopupMenu < UIPopupMenu
  image-source: /images/ui/combobox_square
  image-clip: 0 60 98 20
  image-border: 1

ComboBox < UIComboBox
  font: $var-cip-font
  color: $var-text-cip-color
  // O texto e centralizado e o recuo existe para compensar a seta da direita,
  // que ocupa image-border-right: 21. Centralizar na area sem a seta pede
  // metade dela, -10, e nao -15. Os 5px a mais empurravam o texto para fora
  // pela ESQUERDA - por isso as opcoes longas invadiam o rotulo anterior em vez
  // de encostar na propria seta.
  text-offset: -10 2
  size: 91 20
  image-source: /images/ui/combobox_square
  image-border: 3
  image-border-right: 21
  image-clip: 0 0 91 20

  $hover !disabled:
    image-clip: 0 0 91 20

  $on:
    image-clip: 0 40 91 20

  $disabled:
    color: #dfdfdf88
    opacity: 0.8
  
  $checked:
    image-clip: 0 20 91 20

ComboBoxRoundedPopupScrollMenuButton < UIButton
  height: 23
  font: verdana-11px-antialised
  text-align: left
  text-offset: 4 0
  color: #ebbf90
  background-color: alpha

  $hover !disabled:
    color: #ffffff
    background-color: #355d89

  $disabled:
    color: #dfdfdf88

ComboBoxRoundedPopupScrollMenu < UIPopupScrollMenu
  image-source: /images/ui/combobox_rounded
  image-clip: 0 69 91 23
  image-border: 3

ComboBoxRoundedPopupMenuButton < UIButton
  height: 23
  font: verdana-11px-antialised
  text-align: left
  text-offset: 4 0
  color: #ebbf90
  background-color: alpha

  $hover !disabled:
    color: #ffffff
    background-color: #355d89

  $disabled:
    color: #dfdfdf88

ComboBoxRoundedPopupMenu < UIPopupMenu
  image-source: /images/ui/combobox_rounded
  image-clip: 0 69 91 23
  image-border: 3

ComboBoxRounded < ComboBox
  image-source: /images/ui/combobox_rounded
  image-border: 3
