// ========== ADDON/MOUNT BONUS SYSTEM DESIGN (CipSoft-12 dark theme) ==========
// Self-contained: reuses GLOBAL bases + $var-* tokens + /images/ui/* skins so it does
// not depend on game_tasks load order. Mirrors the proven Task* look.

// --- Tab button (flat; $on = selected. Lua drives setOn) ---
AmTab < UIButton
  focusable: false
  height: 22
  font: $var-cip-font
  text-align: center
  text-offset: 0 0
  image-source: none
  background-color: #4d4d4d
  border-width: 1
  color: $var-text-cip-color

  $hover !on !disabled:
    background-color: #4d4d4d
    color: $var-text-cip-color-white

  $on:
    background-color: #363636
    text-offset: 1 1
    color: $var-text-cip-color-white

  $pressed:
    background-color: #363636
    text-offset: 1 1

  $disabled:
    color: #dfdfdf88
    opacity: 0.8

// --- Standard flat action button ---
AmButton < UIButton
  focusable: false
  text-align: center
  height: 20
  background-color: #4d4d4d
  border-width: 1
  color: $var-text-cip-color
  font: $var-cip-font

  $hover !disabled:
    background-color: #4d4d4d

  $pressed:
    background-color: #363636
    text-offset: 1 1

  $disabled:
    color: #dfdfdf88
    opacity: 0.8

// --- Blue "buy" button: reuses the client's blue button skin (/images/ui/buttons-blue),
// --- white text. A UIButton cannot embed an image in its text, so callers add a child coin
// --- sprite anchored right; padding-right reserves room so the centered text + coin read as
// --- one "price [coin]" tag. ---
AmBuyButton < UIButton
  focusable: false
  font: $var-cip-font
  color: #ffffff
  height: 20
  image-source: /images/ui/buttons-blue
  image-clip: 0 0 43 20
  image-border: 1

  $pressed:
    image-clip: 0 20 43 20

  $disabled:
    color: #ffffffaa
    opacity: 0.8

// --- Vertical scrollbar (copied from the proven Task scrollbar; /images/ui/scrollbar) ---
AmScrollSlider < UIButton
  id: sliderButton
  anchors.centerIn: parent
  size: 12 12
  minimum: 12
  image-source: /images/ui/scrollbar
  image-border: 6
  image-clip: 0 24 12 14
  opacity: 1

  $disabled:
    opacity: 0

AmScrollBar < UIScrollBar
  orientation: vertical
  width: 12
  height: 39
  image-source: /images/ui/scrollbar
  image-clip: 24 0 12 74
  image-border: 1
  pixels-scroll: true

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    size: 12 12
    image-source: /images/ui/scrollbar
    image-clip: 0 0 12 12
    $pressed:
      image-clip: 12 0 12 12

  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 12 12
    image-source: /images/ui/scrollbar
    image-clip: 0 12 12 12
    $pressed:
      image-clip: 12 12 12 12

  AmScrollSlider

// --- Catalog card: wrapped name, looktype preview, scrollable bonus box, 2 buttons ---
AmCard < Panel
  size: 176 184
  focusable: false
  phantom: false
  background-color: #3f3f3f
  border-width: 1

  Label
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    margin-left: 4
    margin-right: 4
    height: 26
    text-align: center
    text-wrap: true
    font: $var-cip-font
    color: $var-text-cip-color-white
    phantom: true

  UICreature
    id: preview
    size: 56 56
    anchors.top: name.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    phantom: true

  // Plain (non-scroll) bonus text: fixed area, wrapped, truncated in Lua so it never
  // overflows the card (the full list is in the Details panel). No nested UIScrollArea
  // per card -> far fewer widgets and no clip/overlap.
  Label
    id: bonus
    anchors.top: preview.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonRow.top
    margin-top: 4
    margin-left: 5
    margin-right: 5
    margin-bottom: 4
    text-align: center
    text-wrap: true
    font: $var-cip-font
    color: $var-text-cip-color-green
    phantom: true

  Panel
    id: buttonRow
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 4
    height: 20

    AmButton
      id: details
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      size: 72 20
      text: Details

    AmButton
      id: obtain
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4
      size: 72 20
      text: Obtain
      color: $var-text-cip-color-green

    AmBuyButton
      id: buyBtn
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4
      size: 72 20
      visible: false

      // price + coin kept as a tight group, centered (margin-left -8 ~= -(coin+gap)/2 so the
      // whole "number [coin]" reads centered regardless of the number's width).
      Label
        id: price
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        margin-left: -8
        font: $var-cip-font
        color: #ffffff
        text-auto-resize: true
        phantom: true

      UIWidget
        id: buyCoin
        anchors.left: price.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 3
        size: 12 12
        image-source: /images/store/icon-tibiacointransferable
        phantom: true

    Label
      id: ownedLabel
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4
      size: 72 20
      text-align: center
      font: $var-cip-font
      color: #58c458
      text: Owned
      visible: false
      phantom: true

// --- One bonus line inside a Bonuses box (wraps; width set from Lua) ---
AmBonusLine < Label
  text-wrap: true
  text-auto-resize: true
  font: $var-cip-font
  color: $var-text-cip-color
  margin-bottom: 3

// --- Search box ---
AmSearch < TextEdit
  font: $var-cip-font
  color: $var-text-cip-color
  height: 18
  text-align: LeftCenter
  image-source: /images/ui/textedit
  image-border: 1
  selection-background-color: #808080
  padding-top: 1
  padding-bottom: 1
  padding-left: 6
  padding-right: 6
  placeholder-color: #70707088
