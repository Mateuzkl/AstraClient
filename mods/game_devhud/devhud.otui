// ===== Dev/QA HUD (test server only) — dark theme matching game_casino/game_craft =====
// Shell + reusable control styles. The launcher button is parented to the game map
// panel from Lua; each tab (tabs/*.lua) builds its rows inside `contentArea` on demand.
// All wiring (onClick/onEscape) is done in Lua, so no callbacks live here.

// --- Corner launcher button (bottom-right of the game map): a normal grey top
//     button with the gear/options icon ---
DevHudLauncher < TopToggleButton
  size: 72 72
  icon-source: /images/topbuttons/options
  icon-rect: 12 12 48 48
  !tooltip: tr('Dev / QA tools (test server)')

// --- Tab button (flat; $on = selected, driven from Lua via setOn) ---
DevHudTab < UIButton
  focusable: false
  height: 22
  width: 96
  font: $var-cip-font
  text-align: center
  image-source: none
  background-color: #4d4d4d
  border-width: 1
  color: $var-text-cip-color

  $hover !on:
    color: $var-text-cip-color-white

  $on:
    background-color: #363636
    color: $var-text-cip-color-white

// --- Standard flat button (Apply / Add) ---
DevHudButton < UIButton
  focusable: false
  text-align: center
  height: 20
  background-color: #4d4d4d
  border-width: 1
  color: $var-text-cip-color
  font: $var-cip-font

  $hover !disabled:
    color: $var-text-cip-color-white

  $pressed:
    background-color: #363636
    text-offset: 1 1

  $disabled:
    color: #dfdfdf88
    opacity: 0.8

// --- Section header label ---
DevHudSection < Label
  font: $var-cip-font
  color: $var-text-cip-color-white
  text-auto-resize: true
  margin-top: 6
  margin-bottom: 2

// --- Left-aligned field label (fixed width so rows line up) ---
DevHudRowLabel < Label
  font: $var-cip-font
  color: $var-text-cip-color
  text-align: left
  phantom: true

// --- One control row (children positioned by anchors from Lua) ---
DevHudRow < Panel
  height: 22

// --- Numeric stepper preset ---
DevHudSpin < SpinBox
  width: 80
  height: 20

// --- Per-tab container (grows to fit its rows so the ScrollablePanel can scroll) ---
DevHudTabPanel < Panel
  layout:
    type: verticalBox
    spacing: 4
    fit-children: true

// --- Validated numeric text input (Lua restricts to digits) ---
DevHudInput < TextEdit
  height: 20

// --- Equipment-set slot (a UIItem; Lua makes it selectable/editable to open the
//     item selector, and sets a slot background image) ---
DevHudSlot < Item
  size: 34 34
  virtual: true
  border-width: 1
  border-color: #2a2a2a

// --- Secondary tab button (used inside the Items tab, below the set) ---
DevHudSubTab < UIButton
  focusable: false
  height: 20
  width: 90
  font: $var-cip-font
  text-align: center
  image-source: none
  background-color: #404040
  border-width: 1
  color: $var-text-cip-color

  $hover !on:
    color: $var-text-cip-color-white

  $on:
    background-color: #2b2b2b
    color: $var-text-cip-color-white

// --- One row of the "give items" list (sprite + name + X1/X10) ---
DevHudItemRow < UIWidget
  height: 38
  focusable: false
  border-width: 1
  border-color: #1e1e1e
  background-color: #ffffff08

// --- Card for the outfit/mount grid: creature preview + name + Grant/Revoke ---
DevHudCard < UIWidget
  size: 104 122
  background-color: #3f3f3f
  border-width: 1
  border-color: #1e1e1e

  UICreature
    id: preview
    size: 64 64
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    phantom: true

  Label
    id: name
    anchors.top: preview.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: act.top
    text-align: center
    text-wrap: true
    font: $var-cip-font
    color: $var-text-cip-color
    phantom: true

  DevHudButton
    id: act
    height: 20
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 4
    margin-right: 4
    margin-bottom: 4

// --- Grid container: one page of cards (flow computes the column count) ---
DevHudGrid < Panel
  layout:
    type: grid
    cell-size: 104 122
    cell-spacing: 6
    flow: true

// --- Item picker window (right-click a set slot to edit it): name search +
//     results list + preview + tier/upgrade (Lua disables what the item can't take) ---
DevHudPickerWindow < NewMainWindow
  id: devHudPicker
  !text: tr('Select item')
  size: 340 470
  visible: false

  TextEdit
    id: search
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: searchBtn.left
    margin-right: 6
    height: 20

  DevHudButton
    id: searchBtn
    anchors.top: parent.top
    anchors.right: parent.right
    width: 72
    height: 20
    text: Search

  DevHudButton
    id: cancelBtn
    text: Cancel
    width: 80
    height: 22
    anchors.bottom: parent.bottom
    anchors.right: parent.right

  DevHudButton
    id: okBtn
    text: OK
    width: 80
    height: 22
    anchors.bottom: parent.bottom
    anchors.right: cancelBtn.left
    margin-right: 6

  DevHudRowLabel
    id: upgradeLabel
    text: Upgrade +N
    width: 90
    anchors.left: parent.left
    anchors.bottom: okBtn.top
    margin-bottom: 8

  SpinBox
    id: upgradeSpin
    width: 74
    anchors.left: upgradeLabel.right
    anchors.verticalCenter: upgradeLabel.verticalCenter

  DevHudRowLabel
    id: tierLabel
    text: Tier (0-10)
    width: 90
    anchors.left: parent.left
    anchors.bottom: upgradeLabel.top
    margin-bottom: 6

  SpinBox
    id: tierSpin
    width: 74
    anchors.left: tierLabel.right
    anchors.verticalCenter: tierLabel.verticalCenter

  Item
    id: preview
    size: 34 34
    virtual: true
    anchors.left: parent.left
    anchors.bottom: tierLabel.top
    margin-bottom: 8

  DevHudRowLabel
    id: itemName
    anchors.left: preview.right
    anchors.right: parent.right
    anchors.verticalCenter: preview.verticalCenter
    margin-left: 8

  ScrollablePanel
    id: results
    anchors.top: search.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: preview.top
    margin-top: 6
    margin-bottom: 8
    vertical-scrollbar: resultsScroll
    layout:
      type: verticalBox
      spacing: 2

  VerticalScrollBar
    id: resultsScroll
    anchors.top: results.top
    anchors.bottom: results.bottom
    anchors.right: parent.right
    step: 24
    pixels-scroll: true

// ===== Main window =====
DevHudWindow < NewMainWindow
  id: devHudWindow
  !text: tr('Dev / QA Tools')
  size: 700 640
  visible: false

  // --- Tab selector (one tab per registered tab) ---
  Panel
    id: tabSelector
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 22
    layout:
      type: horizontalBox
      spacing: 2

  // --- Active tab content (each tab builds its rows here; scrolls if tall) ---
  ScrollablePanel
    id: contentArea
    anchors.top: tabSelector.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: footerBar.top
    margin-top: 8
    margin-bottom: 6
    margin-right: 4
    vertical-scrollbar: contentScroll
    layout:
      type: verticalBox
      spacing: 4

  VerticalScrollBar
    id: contentScroll
    anchors.top: contentArea.top
    anchors.bottom: contentArea.bottom
    anchors.right: parent.right
    step: 24
    pixels-scroll: true

  // --- Footer: last-action status + close ---
  Panel
    id: footerBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 24

    Button
      id: closeButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 70 22
      text: Close

    Label
      id: statusLabel
      anchors.left: parent.left
      anchors.right: closeButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      text-auto-resize: false
      color: $var-text-cip-color
      font: $var-cip-font
