PerkShapingOptionsDialog < UIMessageBox
  id: perkShapingOptionsDialog
  size: 600 567
  image-source: /images/ui/window-high
  image-border: 25
  text: "Perk Shaping Options"
  font: $var-cip-font
  text-offset: 0 1
  color: #909090
  anchors.centerIn: parent
  draggable: false
  padding: 29 16 16 16
  @onEscape: modules.game_proficiency.WeaponProficiency:onPerkShapingOptionsDialogEscape()

  TextEdit
    id: shapingOptionsSearchEdit
    size: 568 20
    anchors.top: parent.top
    anchors.left: parent.left
    placeholder: Type to search
    placeholder-color: #6E706F
    placeholder-offset: 1 -1
    padding-right: 18
    padding-top: 3
    @onTextChange: modules.game_proficiency.WeaponProficiency:onPerkShapingOptionsSearchChange(self:getText())

  UIWidget
    id: shapingOptionsSearchClearButton
    size: 18 18
    anchors.right: shapingOptionsSearchEdit.right
    anchors.verticalCenter: shapingOptionsSearchEdit.verticalCenter
    margin-right: 1
    image-source: /images/ui/button-erase-18x18-up
    image-color: white
    @onClick: modules.game_proficiency.WeaponProficiency:onPerkShapingOptionsSearchClear()
    $pressed:
      image-source: /images/ui/buttons/button-clear-18x18-down

  UIWidget
    id: shapingOptionsListContainer
    size: 568 450
    anchors.top: shapingOptionsSearchEdit.bottom
    anchors.left: parent.left
    margin-top: 11
    image-source: /images/ui/1pixel-down-frame
    image-border: 1

    UIWidget
      id: shapingOptionsListHeader
      height: 16
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right

      UIWidget
        anchors.fill: parent
        margin: 1
        background-color: #363636

      Label
        !text: tr('Perk')
        font: $var-cip-font-new
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        margin-left: 2
        margin-top: 1
        color: #C0C0C0
        width: 153

      VerticalSeparator
        id: shapingOptionsHeaderSeparator1
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        margin-left: 153
        margin-top: 1
        margin-bottom: 1

      Label
        !text: tr('Effect at Rank 0')
        font: $var-cip-font-new
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: shapingOptionsHeaderSeparator1.right
        margin-left: 2
        margin-top: 1
        color: #C0C0C0
        width: 203

      VerticalSeparator
        id: shapingOptionsHeaderSeparator2
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        margin-left: 353
        margin-top: 1

      Label
        !text: tr('Effect at Rank 10')
        font: $var-cip-font-new
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: shapingOptionsHeaderSeparator2.right
        margin-left: 2
        margin-top: 1
        color: #C0C0C0
        width: 214

    HorizontalSeparator
      id: shapingOptionsHeaderListSeparator
      anchors.top: shapingOptionsListHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 0
      margin-left: 1
      margin-right: 1

    UIScrollArea
      id: shapingOptionsList
      vertical-scrollbar: shapingOptionsListScrollbar
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 1
      margin-left: 1
      margin-bottom: 1
      margin-right: 13
      background-color: #404040
      layout:
        type: verticalBox
        spacing: 0

    VerticalScrollBar
      id: shapingOptionsListScrollbar
      anchors.top: shapingOptionsList.top
      anchors.right: shapingOptionsList.right
      anchors.bottom: shapingOptionsList.bottom
      margin: 1
      margin-right: -12
      margin-top: -16
      margin-bottom: 0
      step: 20
      pixels-scroll: true

  HorizontalSeparator
    anchors.top: shapingOptionsListContainer.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 11

  UIWidget
    id: shapingOptionsDustBalance
    size: 104 20
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    image-source: /images/ui/button-verydarkgrey-down
    image-border: 3
    focusable: false
    phantom: true

    UIWidget
      id: shapingOptionsDustBalanceIcon
      size: 9 6
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-top: 1
      margin-right: 3
      image-source: /images/icons/icon-currency-dust
      tooltip: Dust
      fixed-size: true

    Label
      id: shapingOptionsDustBalanceText
      anchors.right: shapingOptionsDustBalanceIcon.left
      anchors.verticalCenter: parent.verticalCenter
      margin-top: 1
      margin-right: 2
      !text: tr('0/0')
      font: $var-cip-font
      color: #c0c0c0
      text-align: right
      text-auto-resize: true

  Button
    id: shapingOptionsCloseButton
    size: 43 20
    text-offset: 0 0
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Close')
    @onClick: modules.game_proficiency.WeaponProficiency:onPerkShapingOptionsClose()

ModifyConfirmDialog < UIMessageBox
  size: 356 100
  image-source: /images/ui/window-high
  image-border: 10
  &minimizedHeight: 17
  anchors.centerIn: parent
  draggable: false
  padding: 1 16 16 16
  @onEscape: modules.game_proficiency.WeaponProficiency:onModifySubDialogEscape()
  @onEnter: modules.game_proficiency.WeaponProficiency:onModifyConfirmDialogEnter()

  $on:
    image-border-bottom: 2

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    height: 18
    phantom: true

  Label
    id: title
    font: $var-cip-font
    text-align: center
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-offset: 0 -1
    height: 18
    margin-right: 2
    color: #909090

  Label
    id: contentText
    font: $var-cip-font-lowspace
    color: #c0c0c0
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: separator.top
    text-offset: -1 1
    text-align: left
    text-wrap: true

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: noButton.top
    margin-bottom: 11

  Button
    id: yesButton
    size: 43 20
    text-offset: 0 0
    !text: tr('Yes')
    anchors.right: noButton.left
    anchors.bottom: parent.bottom
    margin-right: 6

  Button
    id: noButton
    size: 43 20
    text-offset: 0 0
    !text: tr('No')
    anchors.right: parent.right
    anchors.bottom: parent.bottom

