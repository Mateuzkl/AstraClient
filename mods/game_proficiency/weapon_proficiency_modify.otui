ShapeSideButton < UIButton
  size: 92 26
  anchors.left: parent.left
  margin-left: 7
  focusable: false
  change-cursor-image: true
  cursor: pointer
  font: $var-cip-font-new
  color: #c0c0c0
  text-offset: -1 1
  image-source: /images/ui/button-grey-up
  image-border: 5
  image-clip: 0 0 98 40
  $pressed:
    image-source: /images/ui/button-grey-down
    image-clip: 0 0 98 40
    text-offset: 0 2

ShapeDustCostPanel < UIWidget
  size: 52 26
  image-source: /images/ui/button-verydarkgrey-down
  image-border: 3
  focusable: false
  phantom: true

  Panel
    id: costContainer
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    height: 16
    margin-top: 1
    layout:
      type: horizontalBox
      spacing: 1
      fit-children: true

    Label
      id: costText
      !text: tr('0')
      font: $var-cip-font
      color: #c0c0c0
      text-align: center
      text-auto-resize: true

    UIWidget
      id: costIcon
      size: 9 6
      image-source: /images/icons/icon-currency-dust
      fixed-size: true
      tooltip: Dust

ShapeOrbCostPanel < UIWidget
  size: 52 26
  image-source: /images/ui/button-verydarkgrey-down
  image-border: 3
  focusable: false
  phantom: true

  Panel
    id: costContainer
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    height: 16
    margin-top: 1
    layout:
      type: horizontalBox
      spacing: 1
      fit-children: true

    Label
      id: costText
      !text: tr('1')
      font: $var-cip-font
      color: #c0c0c0
      text-align: center
      text-auto-resize: true

    UIWidget
      id: costIcon
      size: 12 11
      image-source: /images/icons/icon_lunar_ascension_orb_currency
      fixed-size: true
      tooltip: Lunar Ascension Orbs

ShapeDialog < UIMessageBox
  size: 500 341
  image-source: /images/ui/window-high
  image-border: 25
  text: "Shape"
  font: $var-cip-font
  text-offset: 0 1
  color: #909090
  anchors.centerIn: parent
  draggable: false
  padding: 29 16 16 16
  @onEscape: modules.game_proficiency.WeaponProficiency:onModifySubDialogEscape()

  UIWidget
    id: leftWindow
    size: 278 254
    anchors.left: parent.left
    anchors.top: parent.top
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 25

    Label
      id: leftTitle
      font: $var-cip-font
      color: #909090
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1

    UIWidget
      id: perkPreview
      size: 80 80
      anchors.left: parent.left
      anchors.top: leftTitle.bottom
      margin-left: 99
      margin-top: 16

      UIWidget
        id: icon
        size: 64 64
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        image-source: /images/game/proficiency/icons-weaponmastery
        image-clip: 0 0 32 32
        phantom: true

      UIWidget
        id: border
        size: 76 76
        phantom: true
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        image-source: /images/game/proficiency/border-weaponmasterytreeicons-active

      UIWidget
        id: iconPerks
        size: 32 32
        anchors.top: icon.top
        anchors.right: icon.right
        margin-top: -16
        margin-right: -16
        visible: false
        phantom: true
        image-source: /images/game/wheel/icons-skillwheel-smallperks
        image-clip: 0 0 16 16

      UIWidget
        id: manipulateRank
        size: 32 32
        anchors.bottom: icon.bottom
        anchors.left: icon.left
        margin-bottom: -16
        margin-left: -16
        visible: false
        phantom: true
        image-source: /images/game/proficiency/backdrop_manipulation_rank
        Label
          id: rankValue
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.verticalCenter: parent.verticalCenter
          text-align: center
          color: #c0c0c0
          font: $var-cip-font
          margin-right: 1
          text-auto-resize: true
          phantom: true

    UIWidget
      id: perkBonusFrame
      size: 264 119
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: perkPreview.bottom
      margin-top: 19
      image-source: /images/ui/1pixel-down-frame
      image-border: 3
      border-width: 0
      background-color: #363636
      padding: 6 5 6 5

      Label
        id: perkBonusText
        anchors.fill: parent
        font: $var-cip-font-lowspace
        color: #c0c0c0
        text-align: topLeft
        text-wrap: true

  UIWidget
    id: rightWindow
    size: 180 254
    anchors.top: leftWindow.top
    anchors.left: leftWindow.right
    margin-left: 11
    image-source: /images/ui/2pixel_up_frame_borderimage
    image-border: 4

    UIWidget
      id: forgeIcon
      size: 40 40
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 43
      image-source: /images/icons_big/icon_forge
      image-clip: 0 0 20 20
      phantom: true

    UIButton
      id: shapeInfoButton
      size: 30 30
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 7
      margin-right: 7
      focusable: false
      change-cursor-image: true
      cursor: pointer
      image-source: /images/ui/button-grey-up
      image-border: 5
      image-clip: 0 0 98 40
      icon-source: /images/icons_big/icon-info-list
      icon-offset: 0 0
      tooltip: Show all perk shaping options
      @onClick: modules.game_proficiency.WeaponProficiency:onShapeInfoButtonClick()
      $pressed:
        image-source: /images/ui/button-grey-down
        image-clip: 0 0 98 40
        icon-offset: 1 1

    ShapeSideButton
      id: shapeRefineButton
      anchors.bottom: shapeMaximiseButton.top
      margin-bottom: 6
      !text: tr('Refine')

    ShapeDustCostPanel
      id: shapeRefineCost
      anchors.left: shapeRefineButton.right
      anchors.verticalCenter: shapeRefineButton.verticalCenter
      margin-left: 6

    ShapeSideButton
      id: shapeMaximiseButton
      anchors.bottom: shapeReshapeButton.top
      margin-bottom: 6
      !text: tr('Maximise')

    ShapeOrbCostPanel
      id: shapeMaximiseCost
      anchors.left: shapeMaximiseButton.right
      anchors.verticalCenter: shapeMaximiseButton.verticalCenter
      margin-left: 6

    ShapeSideButton
      id: shapeReshapeButton
      anchors.bottom: shapeClearButton.top
      margin-bottom: 6
      !text: tr('Reshape')

    ShapeDustCostPanel
      id: shapeReshapeCost
      anchors.left: shapeReshapeButton.right
      anchors.verticalCenter: shapeReshapeButton.verticalCenter
      margin-left: 6

    UIWidget
      id: shapeReshapeHelp
      size: 12 12
      anchors.verticalCenter: shapeReshapeButton.verticalCenter
      anchors.right: parent.right
      margin-right: 7
      image-source: /images/icons/show_gui_help_grey
      tooltip: Reshaping allows you to replace your current shaped perk.<br>You will be presented with 3 different perks, each with the same rank as your current perk.<br>If you like neither option, you can keep your current perk.

    UIWidget
      id: shapeMaximiseHelp
      size: 12 12
      anchors.verticalCenter: shapeMaximiseButton.verticalCenter
      anchors.right: parent.right
      margin-right: 7
      image-source: /images/icons/show_gui_help_grey
      tooltip: Refine this perk to the maximum rank of 10 to create its most powerful version.

    UIWidget
      id: shapeRefineHelp
      size: 12 12
      anchors.verticalCenter: shapeRefineButton.verticalCenter
      anchors.right: parent.right
      margin-right: 7
      image-source: /images/icons/show_gui_help_grey
      tooltip: Each time you refine a perk, its rank increases by 1, also boosting its power. The maximum rank is 10.

    UIButton
      id: shapeClearButton
      size: 149 26
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-bottom: 7
      margin-left: 7
      focusable: false
      change-cursor-image: true
      cursor: pointer
      font: $var-cip-font-new
      color: #c0c0c0
      text-offset: -1 1
      !text: tr('Clear')
      image-source: /images/ui/button-grey-up
      image-border: 5
      image-clip: 0 0 98 40
      $pressed:
        image-source: /images/ui/button-grey-down
        image-clip: 0 0 98 40
        text-offset: 0 2

    UIWidget
      id: shapeClearHelp
      size: 12 12
      anchors.bottom: shapeClearButton.bottom
      anchors.right: parent.right
      margin-right: 7
      margin-bottom: 7
      image-source: /images/icons/show_gui_help_grey
      tooltip: Clearing a perk will reset it to its initial state. You will lose all shaping applied to this perk.<br>You can modify and shape this perk again by paying the associated costs.

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: leftWindow.bottom
    margin-top: 11

  UIWidget
    id: shapeDustBalance
    size: 104 20
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    image-source: /images/ui/button-verydarkgrey-down
    image-border: 3
    focusable: false
    phantom: true

    UIWidget
      id: shapeDustBalanceIcon
      size: 9 6
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-top: 1
      margin-right: 3
      image-source: /images/icons/icon-currency-dust
      tooltip: Dust
      fixed-size: true

    Label
      id: shapeDustBalanceText
      anchors.right: shapeDustBalanceIcon.left
      anchors.verticalCenter: parent.verticalCenter
      margin-top: 1
      margin-right: 2
      !text: tr('0/0')
      font: $var-cip-font
      color: #c0c0c0
      text-align: right
      text-auto-resize: true

  UIWidget
    id: shapeOrbBalance
    size: 52 20
    anchors.left: shapeDustBalance.right
    anchors.bottom: parent.bottom
    margin-left: 11
    image-source: /images/ui/button-verydarkgrey-down
    image-border: 3
    focusable: false
    phantom: true

    UIWidget
      id: shapeOrbBalanceIcon
      size: 12 11
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-top: 1
      margin-right: 3
      image-source: /images/icons/icon_lunar_ascension_orb_currency
      tooltip: Lunar Ascension Orbs
      fixed-size: true

    Label
      id: shapeOrbBalanceText
      anchors.right: shapeOrbBalanceIcon.left
      anchors.verticalCenter: parent.verticalCenter
      margin-top: 1
      margin-right: 2
      !text: tr('0')
      font: $var-cip-font
      color: #c0c0c0
      text-align: right
      text-auto-resize: true

  Button
    id: closeButton
    size: 43 20
    text-offset: 0 0
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Close')

ReshapeActionButton < UIButton
