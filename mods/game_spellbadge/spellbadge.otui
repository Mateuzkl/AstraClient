// ========== Spell Badge window (CipSoft-12 dark theme, matches game_casino/game_tasks) ==========
// Styles are defined above the window so g_ui.displayUI('spellbadge') has them
// without a separate importStyle. The window itself is the single root instance;
// SpellBadgeConfirm is a STYLE instantiated on demand from Lua. Reuses GLOBAL bases
// + $var-* tokens.

// --- Standard flat button (Upgrade / Discover / confirm), like CraftButton/CasinoButton ---
SpellBadgeButton < UIButton
  focusable: false
  text-align: center
  height: 24
  background-color: #4d4d4d
  border-width: 1
  color: $var-text-cip-color
  font: $var-cip-font

  $hover !disabled:
    background-color: #4d4d4d
    color: $var-text-cip-color-white

  $pressed:
    background-color: #363636
    text-offset: 1 1

  $disabled:
    color: #dfdfdf88
    opacity: 0.7

// --- Top strip cell: badge sprite (name tooltip, set in Lua) + owned count beside it.
//     Wide enough for the count to reach 3 digits (e.g. "x999") without spilling into
//     the next cell; larger values are abbreviated to 'k' in Lua (renderStrip). ---
SpellBadgeStripCell < UIWidget
  size: 60 30
  phantom: false

  UIItem
    id: stripItem
    size: 26 26
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    virtual: true
    draggable: false

  Label
    id: stripCount
    anchors.left: stripItem.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    text-align: left
    font: $var-cip-font
    color: $var-text-cip-color
    text: 'x0'

// --- One badge card: sprite + level, name + bonus + per-level gain + awakened + Upgrade ---
SpellBadgeRow < UIWidget
  height: 82
  focusable: true
  background-color: #2b2b2b
  border-width: 1
  border-color: #0f0f0f

  $focus:
    background-color: #3a3a3a
    border-color: #6d6d6d

  // sprite slot + level badge
  UIWidget
    id: iconBox
    size: 40 40
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    image-source: /images/ui/item
    phantom: true

    UIItem
      id: item
      size: 32 32
      anchors.centerIn: parent
      virtual: true
      phantom: true
      draggable: false

  // Upgrade button (right)
  SpellBadgeButton
    id: upgradeButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    width: 90
    height: 26
    !text: tr('Upgrade')

  Label
    id: costLabel
    anchors.right: upgradeButton.left
    anchors.top: parent.top
    margin-top: 10
    margin-right: 10
    width: 110
    text-align: right
    text-auto-resize: false
    font: $var-cip-font
    color: $var-text-cip-color
    text: ''

  Label
    id: chargesLabel
    anchors.right: upgradeButton.left
    anchors.bottom: parent.bottom
    margin-bottom: 10
    margin-right: 10
    width: 110
    text-align: right
    text-auto-resize: false
    font: $var-cip-font
    color: $var-text-cip-color-grey
    text: ''

  Label
    id: nameLabel
    anchors.top: parent.top
    anchors.left: iconBox.right
    anchors.right: costLabel.left
    margin-left: 12
    margin-top: 7
    margin-right: 8
    text-align: left
    text-auto-resize: false
    font: $var-cip-font
    color: $var-text-cip-color-white
    text: ''

  Label
    id: bonusLabel
    anchors.top: nameLabel.bottom
    anchors.left: iconBox.right
    anchors.right: costLabel.left
    margin-left: 12
    margin-top: 3
    margin-right: 8
    text-align: left
    text-auto-resize: false
    font: $var-cip-font
    color: $var-text-cip-color-green
    text: ''

  // what each upgrade grants (per-level gain)
  Label
    id: perLevelLabel
    anchors.top: bonusLabel.bottom
    anchors.left: iconBox.right
    anchors.right: costLabel.left
    margin-left: 12
    margin-top: 3
    margin-right: 8
    text-align: left
    text-auto-resize: false
    font: $var-cip-font
    color: $var-text-cip-color-grey
    text: ''

  // progress bar toward the awakened unlock (level / start-level)
  UIWidget
    id: progressBg
    anchors.left: iconBox.right
    anchors.bottom: parent.bottom
    margin-left: 12
    margin-bottom: 10
    height: 6
    width: 140
    background-color: #00000070
    border-width: 1
    border-color: #000000
    phantom: true

    UIWidget
      id: progressFill
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin: 1 0 1 1
      width: 0
      background-color: #3fbbca
      phantom: true

  Label
    id: awakenedLabel
    anchors.left: progressBg.right
    anchors.verticalCenter: progressBg.verticalCenter
    margin-left: 10
    text-align: left
    text-auto-resize: true
    font: $var-cip-font
    color: $var-text-cip-color-blue
    text: ''

  // info "i" -> hover explains awakened for THIS spell (tooltip set in Lua)
  UIWidget
    id: infoIcon
    size: 14 14
    anchors.left: awakenedLabel.right
    anchors.verticalCenter: awakenedLabel.verticalCenter
    margin-left: 6
    image-source: /images/ui/info

// --- Kind header shown in the list when the "All" tab groups every badge ---
SpellBadgeGroupHeader < Label
  height: 18
  margin-top: 2
  text-align: left
  font: $var-cip-font
  color: $var-text-cip-color-orange
  text: ''
  phantom: true

// --- Reusable confirm dialog (Upgrade / Discover) with a "don't show again" checkbox.
//     STYLE only: instantiated from Lua via g_ui.createWidget. Buttons are wired in Lua. ---
SpellBadgeConfirm < NewMainWindow
  id: spellBadgeConfirm
  !text: tr('Confirm')
  size: 400 212
  focusable: true

  Label
    id: confirmMessage
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: confirmSkip.top
    margin-top: 8
    margin-left: 12
    margin-right: 12
    margin-bottom: 8
    text-align: center
    text-wrap: true
    font: $var-cip-font
    color: $var-text-cip-color
    text: ''

  CheckBox
    id: confirmSkip
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: confirmSep.top
    margin-bottom: 12
    size: 320 16
    font: $var-cip-font
    !text: tr("Don't show this confirmation again")

  // Divider sits right on top of the button row, separating it from the content above.
  HorizontalSeparator
    id: confirmSep
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: confirmActions.top
    margin-left: 12
    margin-right: 12
    margin-bottom: 6

  Panel
    id: confirmActions
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 12
    margin-right: 12
    margin-bottom: 16
    height: 24

    SpellBadgeButton
      id: confirmNo
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 94
      height: 24
      !text: tr('Close')

    SpellBadgeButton
      id: confirmYes
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 94
      height: 24
      color: $var-text-cip-color-orange
      !text: tr('Confirm')

// ========== Main window (root instance, loaded by g_ui.displayUI) ==========
NewMainWindow
  id: spellBadgeWindow
  !text: tr('Spell Badges')
  size: 640 634
  @onEscape: modules.game_spellbadge.close()

  // --- Header: gold (left) + mysterious badge + Discover (right) ---
  Panel
    id: headerBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 8
    margin-right: 8
    margin-top: 4
    height: 26

    Panel
      id: goldBox
      size: 156 24
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      image-source: /images/game/prey/balanceBg

      UIItem
        id: goldIcon
        size: 20 20
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 3
        virtual: true
        phantom: true

      Label
        id: goldLabel
        anchors.left: parent.left
        anchors.right: prev.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        margin-right: 4
        text-align: right
        font: $var-cip-font
        color: $var-text-cip-color
        text: '0'

    SpellBadgeButton
      id: discoverButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 128
      height: 24
      !text: tr('Discover badge')

    Panel
      id: mysteriousBox
      size: 150 24
      anchors.right: discoverButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8
      image-source: /images/game/prey/balanceBg

      UIItem
        id: mysteriousIcon
        size: 20 20
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 3
        virtual: true
        phantom: true

      Label
        id: mysteriousLabel
        anchors.left: prev.right
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        margin-right: 6
        text-align: left
        font: $var-cip-font
        color: $var-text-cip-color
        text: 'x0'

    // Transient reveal feedback: the obtained badge sprite + green "+1", popped to the
    // LEFT of the mysterious-badge count on a successful Discover, then faded to
    // transparent over 2s (Lua doDiscover -> playDiscoverFx). Phantom = purely visual.
    Panel
      id: discoverFx
      size: 42 22
      anchors.right: mysteriousBox.left
      anchors.verticalCenter: mysteriousBox.verticalCenter
      margin-right: 6
      phantom: true
      visible: false

      UIItem
        id: discoverFxItem
        size: 20 20
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        virtual: true
        phantom: true

      Label
        id: discoverFxLabel
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2
        text-align: left
        font: $var-cip-font
        color: $var-text-cip-color-green
        text: +1
        phantom: true

  // --- "Your badge charges" strip: every vocation badge sprite + owned count ---
  Label
    id: stripTitle
    anchors.top: headerBar.bottom
    anchors.left: parent.left
    margin-left: 10
    margin-top: 8
    text-auto-resize: true
    font: $var-cip-font
    color: $var-text-cip-color-grey
    !text: tr('Your badge charges')

  Panel
    id: badgeStrip
    anchors.top: stripTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 8
    margin-right: 8
    margin-top: 3
    height: 30
    // grid + flow wraps the badges onto a new line once they exceed the panel width
    // (fit-children grows the panel height so the separator/list below shift down).
    layout:
      type: grid
      cell-size: 60 30
      cell-spacing: 2
      flow: true
      fit-children: true

  HorizontalSeparator
    id: stripSep
    anchors.top: badgeStrip.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 8
    margin-right: 8
    margin-top: 6

  // --- Footer: Close button ---
  Panel
    id: footerBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-right: 8
    height: 36

    Button
      id: closeButton
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-bottom: 8
      size: 70 22
      !text: tr('Close')
      font: cipsoftFont
      @onClick: modules.game_spellbadge.close()

  // --- Scrollable list of ALL badges the vocation can use (grouped by kind header) ---
  ScrollablePanel
    id: badgeList
    anchors.top: stripSep.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: footerBar.top
    margin-top: 10
    margin-left: 8
    margin-bottom: 8
    margin-right: 18
    vertical-scrollbar: badgeScroll
    layout:
      type: verticalBox
      spacing: 6

  VerticalScrollBar
    id: badgeScroll
    anchors.top: badgeList.top
    anchors.bottom: badgeList.bottom
    anchors.right: parent.right
    margin-right: 6
    step: 48
    pixels-scroll: true

  // --- Empty / status message shown over the list area ---
  Label
    id: statusLabel
    anchors.top: stripSep.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 24
    text-align: center
    text-wrap: true
    font: $var-cip-font
    color: $var-text-cip-color-grey
    text: ''
