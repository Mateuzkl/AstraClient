DamagePanel < UIWidget
  id: damagePanel
  size: 157 11
  margin-top: 2
  UIWidget
    id: icon
    size: 9 9
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-left: 2
  Label
    id: desc
    text-align: right
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    text-auto-resize: true
    color: $var-text-cip-color
    font: $var-cip-font
    margin-right: 2

NoDataLabel < Label
  id: type
  height: 15
  !text: tr('No Data')
  text-auto-resize: true
  color: $var-text-cip-color
  font: $var-cip-font

MiniWindow
  id: impactAnalyserMiniWindow
  &type: 'impactAnalyser'
  !text: tr('Impact Analyser')
  height: 200
  icon: /images/icons/icon-progressanalyser-widget
  @onExtra: modules.game_analyser.onImpactExtra(g_window.getMousePosition())
  &save: true
  &autoOpen: false

  ScrollablePanel
    id: contentsPanel
    anchors.fill: parent
    margin: 16 18 5 5
    vertical-scrollbar: miniwindowScrollBar
    Label
      !text: tr('Damage')
      anchors.top: parent.top
      anchors.left: parent.left
      text-auto-resize: true
      color: $var-text-cip-color-white
      font: $var-cip-font
    Label
      id: dmgLabel
      !text: tr('Total:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: dmg
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: maxDpsLabel
      !text: tr('Max-DPS:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: maxDps
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: highLabel
      !text: tr('All-Time High:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: allTimeHigh
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    HorizontalSeparator
      id: separatorAllTimeHigh
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5

    Label
      id: dpsLabel
      !text: tr('DPS:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: dps
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    HorizontalSeparator
      id: separatorDps
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7

    Label
      id: damageTypeLabel
      !text: tr('Damage Types')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: $var-text-cip-color-white
      font: $var-cip-font

    ScrollablePanel
      id: dmgTypes
      width: 145
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      layout:
        type: verticalBox
        fit-children: true

    HorizontalSeparator
      id: separatorDmgType
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7

    Label
      id: healingLabel
      !text: tr('Healing')
      anchors.top: separatorDmgType.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: $var-text-cip-color-white
      font: $var-cip-font

    Label
      id: hpsLabel
      !text: tr('Total:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: hpsTotal
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: maxHpsLabel
      !text: tr('Max-HPS:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: maxHps
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: highLabel
      !text: tr('All-Time High:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: allTimeHighHealing
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    HorizontalSeparator
      id: separatorAllTimeHighHealing
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5

    Label
      id: hpsLabelGauge
      !text: tr('HPS:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: hps
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder
    size: 14 14
    margin-left: 2
    margin-bottom: 2

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 80
    margin-left: 3
    margin-right: 3
