LootItem < UIItem
  size: 32 32
  virtual: true
  show-count: false
  virtual-count: true
  font: verdana-11px-rounded
  tooltip-delayed: true

  Label
    id: countLabel
    size: 32 13
    font: verdana-9px-rounded
    color: #ffffff
    text-align: right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 1
    phantom: true

MiniWindow
  id: supplyAnalyserMiniWindow
  &type: 'wasteAnalyser'
  !text: tr('Supply Analyser')
  height: 160
  icon: /images/icons/icon-wasteanalyser-widget
  &save: true
  &autoOpen: false
  @onExtra: modules.game_analyser.onSupplyExtra(g_window.getMousePosition())

  ScrollablePanel
    id: contentsPanel
    anchors.fill: parent
    margin: 16 18 5 5
    vertical-scrollbar: miniwindowScrollBar
    Label
      id: goldLabel
      !text: tr('Gold Value:')
      anchors.top: parent.top
      anchors.left: parent.left
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /game_cyclopedia/images/ui/gold
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 3

    Label
      id: gold
      !text: tr('0')
      anchors.top: parent.top
      anchors.right: prev.left
      margin-right: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: perHourLabel
      !text: tr('Per Hour:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /game_cyclopedia/images/ui/gold
      anchors.top: prev.top
      anchors.right: parent.right
      margin-top: 3

    Label
      id: goldHour
      !text: tr('0')
      anchors.top: perHourLabel.top
      anchors.right: prev.left
      margin-right: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    HorizontalSeparator
      id: separator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5

    Panel
      id: lootedItems
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      visible: false
      layout:
        type: grid
        cell-size: 32 32
        cell-spacing: 3
        num-columns: 4

  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder
    size: 14 14
    margin-left: 2
    margin-bottom: 2

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 64
    margin-left: 3
    margin-right: 3
