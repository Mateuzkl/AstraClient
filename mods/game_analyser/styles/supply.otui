LootItem < UIItem
  size: 32 32
  virtual: true
  show-count: false
  virtual-count: true
  font: verdana-11px-rounded
  tooltip-delayed: true

MiniWindow
  id: supplyAnalyserMiniWindow
  &type: 'wasteAnalyser'
  !text: tr('Supply')
  height: 225
  icon: /images/icons/icon-wasteanalyser-widget
  &save: true
  &autoOpen: false
  @onExtra: modules.game_analyser.onSupplyExtra(g_window.getMousePosition())

  ScrollablePanel
    id: contentsPanel
    anchors.fill: parent
    margin: 16 18 5 5
    vertical-scrollbar: miniwindowScrollBar
    Label
      id: goldLabel
      !text: tr('Gold Value:')
      anchors.top: parent.top
      anchors.left: parent.left
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /game_cyclopedia/images/ui/gold
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 3

    Label
      id: gold
      !text: tr('0')
      anchors.top: parent.top
      anchors.right: prev.left
      margin-right: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: perHourLabel
      !text: tr('Per Hour:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /game_cyclopedia/images/ui/gold
      anchors.top: prev.top
      anchors.right: parent.right
      margin-top: 3

    Label
      id: goldHour
      !text: tr('0')
      anchors.top: perHourLabel.top
      anchors.right: prev.left
      margin-right: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    HorizontalSeparator
      id: separator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5

    Panel
      id: lootedItems
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      visible: false
      layout:
        type: grid
        cell-size: 32 32
        cell-spacing: 3
        num-columns: 4

    HorizontalSeparator
      id: separatorLootedItems
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      visible: false

    Label
      id: targetLabel
      !text: tr('Target:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    UIWidget
      id: goldLabelIcon
      size: 9 9
      image-auto-resize: true
      image-source: /game_cyclopedia/images/ui/gold
      anchors.top: prev.top
      anchors.right: parent.right
      margin-top: 3

    Label
      id: goldTarget
      !text: tr('0')
      anchors.top: targetLabel.top
      anchors.right: prev.left
      margin-right: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    UIWidget
      id: supplyTargetBG
      size: 152 11
      image-auto-resize: true
      image-source: /images/game/analyzer/targetBG
      anchors.top: prev.bottom
      anchors.right: parent.right
      margin-top: 5

      UIWidget
        id: supplyArrow
        size: 9 8
        image-auto-resize: true
        image-source: /images/game/analyzer/arrow
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        margin-bottom: -2
        margin-left: 71

    HorizontalSeparator
      id: separatorGauge
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7

    UIWidget
      id: supplyGraphBG
      size: 129 83
      image-auto-resize: true
      image-source: /images/game/analyzer/graphBG
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-left: 15
      margin-top: 14

    UIGraph
      id: graphPanel
      capacity: 3600
      background-color: #231815
      color: red
      size: 129 83
      anchors.top: prev.top
      anchors.left: prev.left
      show-labels: false
      image-source: /images/game/analyzer/graphBG

    UIWidget
      id: graphHorizontal
      size: 140 9
      image-auto-resize: true
      image-source: /images/game/analyzer/graphHorizontal
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-left: 7
      margin-top: 5

  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder
    size: 14 14
    margin-left: 2
    margin-bottom: 2

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 64
    margin-left: 3
    margin-right: 3
