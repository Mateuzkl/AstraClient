MainWindow
  id: lureSettingsWindow
  size: 300 180
  image-source: /images/ui/login/login_frame
  image-border: 16
  text: Lure Config
  draggable: true
  @onEscape: self:destroy()

  Panel
    id: lureSettingsPanel
    anchors.fill: parent
    anchors.bottom: buttonOk.top
    padding: 10
    margin-bottom: 5

    HelperCheckBox
      id: lureDebug
      anchors.top: parent.top
      anchors.left: parent.left
      !text: 'Lure Debug'
      text-horizontal-auto-resize: true
      color: #C0C0C0
      margin-left: 5
      text-offset: 16 -2

    UIWidget
      id: checkXLabel
      font: verdana-11px-monochrome
      !text: 'Check X Area (1-6):'
      text-align: left
      phantom: true
      anchors.top: lureDebug.bottom
      anchors.left: parent.left
      margin-top: 15
      margin-left: 5
      color: #C0C0C0

    HelperTextEdit
      id: checkX
      size: 55 20
      anchors.right: parent.right
      anchors.verticalCenter: checkXLabel.verticalCenter
      margin-right: 15
      color: #c0c0c0
      @onTextChange: |
        local value = modules.game_helper.validatePercentInput(self, 1, 6, 6)
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" or tonumber(text) == nil or tonumber(text) < 1 or tonumber(text) > 6 then
            self:setText("6")
          end
        end

    UIWidget
      id: checkYLabel
      font: verdana-11px-monochrome
      !text: 'Check Y Area (1-4):'
      text-align: left
      phantom: true
      anchors.top: checkXLabel.bottom
      anchors.left: parent.left
      margin-top: 15
      margin-left: 5
      color: #C0C0C0

    HelperTextEdit
      id: checkY
      size: 55 20
      anchors.right: parent.right
      anchors.verticalCenter: checkYLabel.verticalCenter
      margin-right: 15
      color: #c0c0c0
      @onTextChange: |
        local value = modules.game_helper.validatePercentInput(self, 1, 4, 4)
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" or tonumber(text) == nil or tonumber(text) < 1 or tonumber(text) > 4 then
            self:setText("4")
          end
        end

  HelperButton
    id: buttonOk
    anchors.bottom: parent.bottom
    anchors.right: buttonApply.left
    margin: 10
    margin-right: 5
    text: OK
    size: 80 20
    @onClick: |
      modules.game_helper.hunting_recorderModule.saveLureSettings(self:getParent())

  HelperButton
    id: buttonApply
    anchors.bottom: parent.bottom
    anchors.right: buttonCancel.left
    margin: 10
    margin-right: 5
    text: Apply
    size: 80 20
    @onClick: |
      modules.game_helper.hunting_recorderModule.saveLureSettings(self:getParent(), true)

  HelperButton
    id: buttonCancel
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin: 10
    text: Cancel
    size: 80 20
    @onClick: self:getParent():destroy()
