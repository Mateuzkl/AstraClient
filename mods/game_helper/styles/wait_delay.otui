MainWindow
  id: waitDelayWindow
  size: 280 120
  text: Wait Delay (ms)
  draggable: true
  @onEscape: self:destroy()

  Label
    id: descLabel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 10
    margin-left: 10
    text: Delay (0 - 60000 ms):
    font: $var-cip-font
    color: $var-text-cip-color

  HelperTextEdit
    id: delayInput
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 8
    margin-right: 10
    width: 80
    height: 22
    text: 1000

  HelperButton
    id: buttonOk
    anchors.top: delayInput.bottom
    anchors.right: parent.right
    margin-top: 12
    margin-right: 10
    width: 80
    height: 22
    text: OK
    color: $var-text-cip-color

  HelperButton
    id: buttonCancel
    anchors.top: delayInput.bottom
    anchors.right: buttonOk.left
    margin-top: 12
    margin-right: 5
    width: 80
    height: 22
    text: Cancel
    color: $var-text-cip-color
    @onClick: self:getParent():destroy()
