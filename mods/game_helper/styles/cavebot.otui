CavebotWindow < MiniWindow
  id: cavebotWindow
  !text: tr('Cavebot')
  height: 400
  width: 600
  @onClose: modules.game_helper.toggleCavebot()
  &save: true

  MiniWindowContents
    ScrollablePanel
      id: cavebotPanel
      anchors.fill: parent
      vertical-scrollbar: cavebotScrollBar

      // Top buttons panel
      Panel
        id: topButtonsPanel
        height: 35
        anchors.top: parent.top
        anchors.left: parent.left  
        anchors.right: parent.right
        margin: 5

        HelperButton
          id: recordButton
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin: 2
          !text: tr('Record')
          @onClick: modules.game_helper.toggleCavebotRecording()

        HelperButton
          id: playButton
          anchors.left: recordButton.right
          anchors.verticalCenter: parent.verticalCenter
          margin: 2
          margin-left: 5
          !text: tr('Play')
          @onClick: modules.game_helper.toggleCavebotPlaying()

        HelperButton
          id: pauseButton
          anchors.left: playButton.right
          anchors.verticalCenter: parent.verticalCenter
          margin: 2
          margin-left: 5
          !text: tr('Pause')
          @onClick: modules.game_helper.pauseCavebot()

        HelperButton
          id: stopButton
          anchors.left: pauseButton.right
          anchors.verticalCenter: parent.verticalCenter
          margin: 2
          margin-left: 5
          !text: tr('Stop')
          @onClick: modules.game_helper.stopCavebot()

        HelperButton
          id: clearButton
          anchors.right: waypointCount.left
          anchors.verticalCenter: parent.verticalCenter
          margin: 2
          margin-right: 10
          !text: tr('Clear')
          @onClick: modules.game_helper.clearCavebot()

        Label
          id: waypointCount
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          margin-right: 10
          !text: tr('Waypoints: 0')
          font: verdana-11px-monochrome
          color: #ffffff
          text-auto-resize: true

      // Map preview panel
      Panel
        id: mapPreviewPanel
        height: 200
        anchors.top: topButtonsPanel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 5 5 0 5
        background-color: #00000040
        image-repeated: true
        image-border: 2

        Label
          id: mapTitle
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 5
          !text: tr('Map Preview [Floor 7] - 0 waypoints')
          font: verdana-11px-monochrome
          color: #ffffff
          text-auto-resize: true

        UIWidget
          id: mapCanvas
          anchors.top: mapTitle.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          margin: 5
          background-color: #2a2a2a
          border: 1 black

      // Settings and Sessions panels
      Panel
        id: bottomPanel
        height: 150
        anchors.top: mapPreviewPanel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 5 5 5 5

        // Settings Panel
        Panel
          id: settingsPanel
          width: 250
          anchors.left: parent.left
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          margin: 5
          background-color: #00000040
          image-repeated: true
          image-border: 2

          Label
            id: settingsTitle
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 5
            !text: tr('Settings')
            font: verdana-11px-monochrome
            color: #ffffff
            text-auto-resize: true

          Label
            anchors.top: settingsTitle.bottom
            anchors.left: parent.left
            margin-top: 10
            margin-left: 10
            !text: tr('Walk Speed:')
            font: verdana-11px-monochrome
            color: #ffffff
            text-auto-resize: true

          SpinBox
            id: walkSpeedSpinBox
            anchors.top: prev.top
            anchors.right: parent.right
            margin-right: 10
            margin-top: -3
            size: 60 20
            minimum: 1
            maximum: 10
            value: 5

          Label
            anchors.top: prev.bottom
            anchors.left: parent.left
            margin-top: 10
            margin-left: 10
            !text: tr('Ignore Creatures:')
            font: verdana-11px-monochrome
            color: #ffffff
            text-auto-resize: true

          SpinBox
            id: ignoreCreaturesSpinBox
            anchors.top: prev.top
            anchors.right: parent.right
            margin-right: 10
            margin-top: -3
            size: 60 20
            minimum: 0
            maximum: 20
            value: 8

          HelperCheckBox
            id: lureCheck
            anchors.top: prev.bottom
            anchors.left: parent.left
            margin-top: 10
            margin-left: 10
            !text: tr('Lure Creatures')
            font: verdana-11px-monochrome
            color: #ffffff
            text-offset: 20 0

        // Sessions Panel  
        Panel
          id: sessionsPanel
          anchors.left: settingsPanel.right
          anchors.right: parent.right
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          margin: 5 5 5 0
          background-color: #00000040
          image-repeated: true
          image-border: 2

          Label
            id: sessionsTitle
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 5
            !text: tr('Sessions')
            font: verdana-11px-monochrome
            color: #ffffff
            text-auto-resize: true

          TextList
            id: sessionsList
            anchors.top: sessionsTitle.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            height: 80
            margin: 5 10 0 10
            background-color: #2a2a2a
            border: 1 black
            font: verdana-11px-monochrome
            color: #ffffff

          Panel
            id: sessionButtonsPanel
            height: 25
            anchors.top: sessionsList.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin: 5 10 5 10

            HelperButton
              id: newSessionButton
              anchors.left: parent.left
              margin: 2
              !text: tr('New')
              @onClick: modules.game_helper.newCavebotSession()

            HelperButton
              id: saveSessionButton
              anchors.left: prev.right
              margin: 2
              margin-left: 5
              !text: tr('Save')
              @onClick: modules.game_helper.saveCavebotSession()

            HelperButton
              id: loadSessionButton
              anchors.left: prev.right
              margin: 2
              margin-left: 5
              !text: tr('Load')
              @onClick: modules.game_helper.loadCavebotSession()

            HelperButton
              id: deleteSessionButton
              anchors.right: parent.right
              margin: 2
              !text: tr('Delete')
              @onClick: modules.game_helper.deleteCavebotSession()

        // Settings panel (left side)
        Panel
          id: settingsPanel
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.bottom: parent.bottom
          width: 280
          background-color: #00000040
          image-repeated: true
          image-border: 2

          Label
            id: settingsTitle
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 5
            !text: tr('Settings')
            font: verdana-11px-monochrome
            color: #c0c0c0

          Panel
            id: settingsContent
            anchors.top: settingsTitle.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            margin: 5

            Label
              id: waypointsLabel
              anchors.top: parent.top
              anchors.left: parent.left
              margin-top: 5
              !text: tr('Waypoints')
              font: verdana-11px-monochrome
              color: #c0c0c0

            Label
              id: editingLabel
              anchors.top: waypointsLabel.bottom
              anchors.left: parent.left
              margin-top: 10
              !text: tr('Editing waypoint: #1')
              font: verdana-11px-monochrome
              color: #c0c0c0

            Label
              id: creaturesToStopLabel
              anchors.top: editingLabel.bottom
              anchors.left: parent.left
              margin-top: 10
              !text: tr('Creatures to stop:')
              font: verdana-11px-monochrome
              color: #c0c0c0

            SpinBox
              id: creaturesToStop
              anchors.top: creaturesToStopLabel.bottom
              anchors.left: parent.left
              margin-top: 5
              size: 60 20
              minimum: 0
              maximum: 20

            UIButton
              id: creaturesToStopInfo
              size: 12 12
              anchors.left: creaturesToStop.right
              anchors.verticalCenter: creaturesToStop.verticalCenter
              margin-left: 5
              image-source: /mods/game_wheel/images/icon_info.png

            Label
              id: creaturesToWalkLabel
              anchors.top: creaturesToStop.bottom
              anchors.left: parent.left
              margin-top: 10
              !text: tr('Creatures to walk:')
              font: verdana-11px-monochrome
              color: #c0c0c0

            SpinBox
              id: creaturesToWalk
              anchors.top: creaturesToWalkLabel.bottom
              anchors.left: parent.left
              margin-top: 5
              size: 60 20
              minimum: 0
              maximum: 20

            UIButton
              id: creaturesToWalkInfo
              size: 12 12
              anchors.left: creaturesToWalk.right
              anchors.verticalCenter: creaturesToWalk.verticalCenter
              margin-left: 5
              image-source: /mods/game_wheel/images/icon_info.png

            Label
              id: finishKillLabel
              anchors.top: creaturesToWalk.bottom
              anchors.left: parent.left
              margin-top: 10
              !text: tr("Don't walk if X mobs HP below Y%:")
              font: verdana-11px-monochrome
              color: #c0c0c0

            SpinBox
              id: finishKillMobCount
              anchors.top: finishKillLabel.bottom
              anchors.left: parent.left
              margin-top: 5
              size: 50 20
              minimum: 0
              maximum: 20

            Label
              id: finishKillSep
              anchors.left: finishKillMobCount.right
              anchors.verticalCenter: finishKillMobCount.verticalCenter
              margin-left: 6
              !text: tr('mobs <')
              font: verdana-11px-monochrome
              color: #c0c0c0

            SpinBox
              id: finishKillHpPct
              anchors.left: finishKillSep.right
              anchors.verticalCenter: finishKillMobCount.verticalCenter
              margin-left: 6
              size: 50 20
              minimum: 0
              maximum: 100

            Label
              id: finishKillPctLabel
              anchors.left: finishKillHpPct.right
              anchors.verticalCenter: finishKillHpPct.verticalCenter
              margin-left: 4
              !text: tr('% HP')
              font: verdana-11px-monochrome
              color: #c0c0c0

        // Sessions panel (right side)
        Panel
          id: sessionsPanel
          anchors.top: parent.top
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          anchors.left: settingsPanel.right
          margin-left: 5
          background-color: #00000040
          image-repeated: true
          image-border: 2

          Label
            id: sessionsTitle
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 5
            !text: tr('Sessions')
            font: verdana-11px-monochrome
            color: #c0c0c0

          Panel
            id: sessionsContent
            anchors.top: sessionsTitle.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            margin: 5

            TextList
              id: sessionsList
              anchors.top: parent.top
              anchors.left: parent.left
              anchors.right: parent.right
              height: 80
              vertical-scrollbar: sessionsScrollBar

            HelperScrollBar
              id: sessionsScrollBar
              anchors.top: sessionsList.top
              anchors.bottom: sessionsList.bottom
              anchors.right: parent.right
              step: 14
              pixels-scroll: true

            Panel
              id: sessionButtons
              height: 25
              anchors.top: sessionsList.bottom
              anchors.left: parent.left
              anchors.right: parent.right
              margin-top: 5

              HelperButton
                id: newSessionButton
                anchors.left: parent.left
                anchors.top: parent.top
                margin: 2
                !text: tr('New')
                @onClick: modules.game_helper.newCavebotSession()

              HelperTextEdit
                id: sessionNameEdit
                anchors.left: newSessionButton.right
                anchors.right: parent.right
                anchors.top: parent.top
                height: 25
                margin-left: 5
                !placeholder: tr('Type to search')

    HelperScrollBar
      id: cavebotScrollBar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 14
      pixels-scroll: true