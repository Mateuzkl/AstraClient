NewMainWindow
  id: shooterSettingsPopup
  !text: tr('Add Shooter Rule')
  size: 360 300
  image-source: /images/ui/login/login_frame
  image-border: 16
  @onEscape: modules.game_helper.closeShooterSettingsPopup()

  Panel
    id: contentPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonsPanel.top
    margin-bottom: 5
    padding: 10

    Label
      id: popupTitleLabel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      !text: tr('Add Shooter Rule')
      font: verdana-11px-monochrome
      color: #c0c0c0
      text-auto-resize: true

    Panel
      id: actionRow
      anchors.top: popupTitleLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      margin-top: 12

      Label
        id: actionTypeLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 70
        !text: tr('Action:')
        font: verdana-11px-monochrome
        color: #c0c0c0

      HelperComboBox
        id: actionTypeCombo
        anchors.left: actionTypeLabel.right
        anchors.verticalCenter: parent.verticalCenter
        size: 90 20

    Panel
      id: spellRow
      anchors.top: actionRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 36
      margin-top: 8

      Label
        id: spellLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 70
        !text: tr('Spell:')
        font: verdana-11px-monochrome
        color: #c0c0c0

      HelperButton
        id: spellSelectButton
        anchors.left: spellLabel.right
        anchors.verticalCenter: parent.verticalCenter
        width: 148
        height: 18
        !text: tr('Select Spell')
        font: verdana-11px-monochrome

      UIButton
        id: spellPreviewButton
        anchors.left: spellSelectButton.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        size: 34 34
        image-source: /images/game/actionbar/slot-actionbar.png

    Panel
      id: runeRow
      anchors.top: actionRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 36
      margin-top: 8
      visible: false

      Label
        id: runeLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 70
        !text: tr('Rune:')
        font: verdana-11px-monochrome
        color: #c0c0c0

      HelperTextEdit
        id: runeIdInput
        anchors.left: runeLabel.right
        anchors.verticalCenter: parent.verticalCenter
        size: 70 18
        color: #c0c0c0
        font: verdana-11px-monochrome

      UIButton
        id: runePreviewButton
        anchors.left: runeIdInput.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        size: 34 34
        image-source: /images/game/actionbar/slot-actionbar.png

      UIWidget
        id: runeInfoIcon
        anchors.left: runePreviewButton.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        size: 12 12
        color: #C0C0C0
        image-source: /images/icons/show_gui_help_grey
        !tooltip: tr('Left/right click to configure rune')

      Label
        id: runeNameLabel
        anchors.left: runeInfoIcon.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        anchors.right: parent.right
        !text: tr('')
        font: verdana-11px-monochrome
        color: #c0c0c0
        text-wrap: true

    Panel
      id: creaturesRow
      anchors.top: runeRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      margin-top: 8

      Label
        id: creaturesLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 70
        !text: tr('Creatures:')
        font: verdana-11px-monochrome
        color: #c0c0c0

      HelperComboBox
        id: creaturesCombo
        anchors.left: creaturesLabel.right
        anchors.verticalCenter: parent.verticalCenter
        size: 90 20

      HelperCheckBox
        id: needTargetCheck
        anchors.left: creaturesCombo.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 14
        width: 110
        !text: tr('Need Target')
        text-offset: 17 0
        change-cursor-image: false
        font: verdana-11px-monochrome
        color: #c0c0c0

    Panel
      id: runePotionPriorityRow
      anchors.top: creaturesRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 22
      margin-top: 6
      visible: false

      HelperCheckBox
        id: prioritizeRuneOverPotionCheck
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        anchors.right: parent.right
        !text: tr('Prioritize Rune over Potion')
        text-offset: 17 0
        change-cursor-image: false
        font: verdana-11px-monochrome
        color: #c0c0c0

    Panel
      id: harmonyRow
      anchors.top: runePotionPriorityRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      margin-top: 8

      Label
        id: minHarmonyLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 70
        !text: tr('Harmony:')
        font: verdana-11px-monochrome
        color: #c0c0c0

      HelperComboBox
        id: minHarmonyCombo
        anchors.left: minHarmonyLabel.right
        anchors.verticalCenter: parent.verticalCenter
        size: 90 20

  Panel
    id: buttonsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 30
    margin-left: 8
    margin-right: 8
    margin-bottom: 8

    HelperButton
      id: cancelButton
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 52 22
      !text: tr('Cancel')
      font: verdana-11px-monochrome
      @onClick: modules.game_helper.closeShooterSettingsPopup()

    HelperButton
      id: saveButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 52 22
      !text: tr('Add')
      font: verdana-11px-monochrome
      @onClick: modules.game_helper.saveShooterSettingsPopup()
