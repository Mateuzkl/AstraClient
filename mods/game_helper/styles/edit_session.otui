MainWindow
  id: editSessionWindow
  size: 260 120
  text: Edit Session Name
  draggable: true
  @onEscape: self:destroy()

  Label
    id: nameLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    text: Enter new session name:
    text-align: center

  HelperTextEdit
    id: nameText
    anchors.top: nameLabel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8
    width: 230
    height: 22

  HelperButton
    id: buttonOk
    anchors.top: nameText.bottom
    anchors.left: parent.left
    margin-top: 4
    margin-left: 10
    width: 80
    height: 22
    text: OK

  HelperButton
    id: buttonCancel
    anchors.top: nameText.bottom
    anchors.right: parent.right
    margin-top: 4
    margin-right: 10
    width: 80
    height: 22
    text: Cancel