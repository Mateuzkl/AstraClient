NewMainWindow
  id: keyEditNewWindow
  size: 400 240
  @onEscape: self:getParent():destroy()

  Panel
    id: contentPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonsPanel.top
    margin-bottom: 5
    padding: 10

    Label
      id: popupTitleLabel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      !text: tr('Edit Primary Key')
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true

    Label
      id: mode
      anchors.top: popupTitleLabel.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 12
      font: $var-cip-font
      text-align: center
      color: $var-text-cip-color-grey
      text: Mode: "Chat Off"
      text-auto-resize: true

    FlatPanel
      id: keyCombo
      anchors.top: mode.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      height: 33
      font: $var-cip-font
      text-align: center
      color: $var-text-cip-color

    Label
      id: info
      anchors.top: keyCombo.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-wrap: true
      text-auto-resize: true

    Label
      id: alone
      anchors.top: info.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: $var-cip-font
      color: $var-text-cip-color-grey
      !text: tr("This action must be bound to a single key.")
      visible: false

    Label
      id: used
      anchors.top: info.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: $var-cip-font
      text-align: center
      color: $var-text-cip-color-light-red
      !text: tr("This hotkey is already in use.")
      visible: false

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonsPanel.top
    margin-left: 8
    margin-right: 8
    margin-bottom: 5

  Panel
    id: buttonsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 30
    margin-left: 8
    margin-right: 8
    margin-bottom: 8

    HelperButton
      id: cancel
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 52 22
      !text: tr('Cancel')

    HelperButton
      id: clear
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      size: 52 22
      !text: tr('Clear')

    HelperButton
      id: ok
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 52 22
      !text: tr('Ok')
