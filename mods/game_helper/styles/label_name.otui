MainWindow
  id: labelNameWindow
  size: 280 120
  image-source: /images/ui/login/login_frame
  image-border: 16
  text: Label Name
  draggable: true
  @onEscape: self:destroy()

  Label
    id: nameLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    margin-left: 10
    text: Enter label name:
    font: verdana-11px-monochrome
    color: #C0C0C0

  HelperTextEdit
    id: nameText
    anchors.top: nameLabel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8
    width: 250
    height: 22

  HelperButton
    id: buttonOk
    anchors.top: nameText.bottom
    anchors.right: parent.right
    margin-top: 8
    margin-right: 10
    width: 80
    height: 22
    text: OK
    font: verdana-11px-monochrome
    color: #c0c0c0

  HelperButton
    id: buttonCancel
    anchors.top: nameText.bottom
    anchors.right: buttonOk.left
    margin-top: 8
    margin-right: 5
    width: 80
    height: 22
    text: Cancel
    font: verdana-11px-monochrome
    color: #c0c0c0
    @onClick: self:getParent():destroy()
