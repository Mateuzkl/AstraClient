MainWindow
  id: labelNameWindow
  size: 280 120
  text: Label Name
  draggable: true
  @onEscape: self:destroy()

  Label
    id: nameLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    margin-left: 10
    text: Enter label name:
    font: $var-cip-font
    color: $var-text-cip-color

  HelperTextEdit
    id: nameText
    anchors.top: nameLabel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8
    width: 250
    height: 22

  HelperButton
    id: buttonOk
    anchors.top: nameText.bottom
    anchors.right: parent.right
    margin-top: 8
    margin-right: 10
    width: 80
    height: 22
    text: OK
    color: $var-text-cip-color

  HelperButton
    id: buttonCancel
    anchors.top: nameText.bottom
    anchors.right: buttonOk.left
    margin-top: 8
    margin-right: 5
    width: 80
    height: 22
    text: Cancel
    color: $var-text-cip-color
    @onClick: self:getParent():destroy()
