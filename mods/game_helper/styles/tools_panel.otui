ToolsPanel < Panel
  anchors.fill: parent
  Panel
    id: staminaToolsPanel
    height: 140
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    Label
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Stamina & Conditions')
      font: $var-main-font
      color: #AAAAAA
      text-auto-resize: true
    Label
      id: autoStaminaTitle
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 6
      margin-left: 10
      !text: tr('Auto Stamina')
      color: $var-text-color
      font: $var-main-font
      text-auto-resize: true
    UIButton
      id: staminaFoodButton0
      size: 34 34
      anchors.top: autoStaminaTitle.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 10
      image-source: /images/game/actionbar/actionbarslot
      !tooltip: tr('Click, then select the stamina item in game')
      @onClick: selectAutoStaminaItem()
    CheckBox
      id: enableStaminaFood0
      anchors.top: staminaFoodButton0.top
      anchors.left: staminaFoodButton0.right
      margin-left: 5
      width: 60
      !text: tr('Enable')
      color: $var-text-color
      font: $var-main-font
      text-offset: 13 0
      @onCheckChange: toggleAutoStamina(self:isChecked())
    Label
      id: staminaThresholdLabel
      anchors.top: enableStaminaFood0.bottom
      anchors.left: staminaFoodButton0.right
      margin-top: 5
      margin-left: 5
      text: 'Use at: 00:30'
      color: $var-text-color
      font: $var-main-font
      text-auto-resize: true
    HorizontalScrollBar
      id: staminaThresholdScroll
      anchors.top: staminaFoodButton0.bottom
      anchors.left: parent.left
      anchors.right: parent.horizontalCenter
      margin-top: 5
      margin-left: 10
      margin-right: 5
      minimum: 0
      maximum: 2520
      step: 10
    VerticalSeparator
      anchors.top: autoStaminaTitle.top
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 8
    Label
      id: paralyzeCureTitle
      anchors.top: autoStaminaTitle.top
      anchors.left: parent.horizontalCenter
      margin-left: 10
      !text: tr('Cure Paralyze')
      color: $var-text-color
      font: $var-main-font
      text-auto-resize: true
    UIButton
      id: paralyzeCureButton0
      size: 34 34
      anchors.top: paralyzeCureTitle.bottom
      anchors.left: parent.horizontalCenter
      margin-top: 5
      margin-left: 10
      image-source: /images/game/actionbar/actionbarslot
      !tooltip: tr('Click to select a spell')
      @onClick: assignTrainingSpell(self, false, true)
    CheckBox
      id: enableParalyzeCure0
      anchors.top: paralyzeCureButton0.top
      anchors.left: paralyzeCureButton0.right
      margin-left: 5
      width: 60
      !text: tr('Enable')
      color: $var-text-color
      font: $var-main-font
      text-offset: 13 0
      @onCheckChange: toggleParalyzeCure(self:isChecked())

  Panel
    id: automationPanel
    height: 165
    anchors.top: staminaToolsPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    margin-right: 4
    margin-top: 5
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    Label
      id: automationTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Automation')
      font: $var-main-font
      color: #AAAAAA
      text-auto-resize: true
    Panel
      id: automationContent
      anchors.top: automationTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 7 8 7 8
      CheckBox
        id: autoPartyInvite
        width: 145
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Party Invite')
        font: $var-main-font
        color: $var-text-color
        text-offset: 13 0
        @onCheckChange: modules.game_helper.tools.toggleAutoPartyInvite(self:isChecked())
      CheckBox
        id: autoPartyAccept
        width: 145
        anchors.top: parent.top
        anchors.left: parent.horizontalCenter
        !text: tr('Party Accept')
        font: $var-main-font
        color: $var-text-color
        text-offset: 13 0
        @onCheckChange: modules.game_helper.tools.toggleAutoPartyAccept(self:isChecked())
      Label
        anchors.top: autoPartyInvite.bottom
        anchors.left: parent.left
        margin-top: 6
        !text: tr('Invite players:')
        font: $var-main-font
        color: $var-text-color
        text-auto-resize: true
      Label
        anchors.top: autoPartyAccept.bottom
        anchors.left: parent.horizontalCenter
        margin-top: 6
        !text: tr('Trusted leader:')
        font: $var-main-font
        color: $var-text-color
        text-auto-resize: true
      TextEdit
        id: autoPartyPlayer1
        height: 18
        anchors.right: parent.horizontalCenter
        margin-right: 12
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 3
        @onTextChange: modules.game_helper.tools.updateAutoPartySettings()
      TextEdit
        id: autoPartyLeader
        height: 18
        anchors.right: parent.right
        margin-right: 4
        anchors.top: prev.top
        anchors.left: parent.horizontalCenter
        @onTextChange: modules.game_helper.tools.updateAutoPartySettings()
      TextEdit
        id: autoPartyPlayer2
        height: 18
        anchors.right: parent.horizontalCenter
        margin-right: 12
        anchors.top: autoPartyPlayer1.bottom
        anchors.left: parent.left
        margin-top: 3
        @onTextChange: modules.game_helper.tools.updateAutoPartySettings()
      CheckBox
        id: antiIdle
        width: 145
        anchors.verticalCenter: autoPartyPlayer2.verticalCenter
        anchors.left: parent.horizontalCenter
        !text: tr('Anti Idle')
        !tooltip: tr('After 5 minutes without moving or turning, rotates the character every 15 seconds.')
        font: $var-main-font
        color: $var-text-color
        text-offset: 13 0
        @onCheckChange: modules.game_helper.tools.toggleAntiIdle(self:isChecked())
      TextEdit
        id: autoPartyPlayer3
        height: 18
        anchors.right: parent.horizontalCenter
        margin-right: 12
        anchors.top: autoPartyPlayer2.bottom
        anchors.left: parent.left
        margin-top: 3
        @onTextChange: modules.game_helper.tools.updateAutoPartySettings()
      TextEdit
        id: autoPartyPlayer4
        height: 18
        anchors.right: parent.horizontalCenter
        margin-right: 12
        anchors.top: autoPartyPlayer3.bottom
        anchors.left: parent.left
        margin-top: 3
        @onTextChange: modules.game_helper.tools.updateAutoPartySettings()
      CheckBox
        id: showLookItemId
        width: 145
        anchors.verticalCenter: autoPartyPlayer4.verticalCenter
        anchors.left: parent.horizontalCenter
        !text: tr('Look Item ID')
        !tooltip: tr('Adds a separate Item ID message to Server Log whenever you look at an item.')
        font: $var-main-font
        color: $var-text-color
        text-offset: 13 0
        @onCheckChange: modules.game_helper.tools.toggleShowLookItemId(self:isChecked())

  Panel
    id: botHudPanel
    height: 165
    anchors.top: staminaToolsPanel.bottom
    anchors.left: automationPanel.right
    anchors.right: parent.right
    margin-top: 5
    margin-left: 5
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    Label
      id: botHudTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Bot HUD Dashboard')
      font: $var-main-font
      color: #AAAAAA
    CheckBox
      id: enableBotHud
      anchors.top: botHudTitle.bottom
      anchors.left: parent.left
      margin-top: 8
      margin-left: 10
      width: 120
      !text: tr('Show Bot HUD')
      text-offset: 13 0
      @onCheckChange: modules.game_helper.tools.updateBotHudSettings()
    Label
      id: botHudSizeLabel
      anchors.verticalCenter: enableBotHud.verticalCenter
      anchors.left: parent.horizontalCenter
      !text: tr('HUD:')
      color: $var-text-color
    ComboBox
      id: botHudSize
      size: 90 18
      anchors.verticalCenter: enableBotHud.verticalCenter
      anchors.left: botHudSizeLabel.right
      margin-left: 5
      @onOptionChange: modules.game_helper.tools.updateBotHudSettings()
      @onSetup: |
        self:addOption('Compact')
        self:addOption('Normal')
        self:addOption('Wide')
        self:setCurrentOption('Normal')
    CheckBox
      id: hudShowCavebot
      anchors.top: enableBotHud.bottom
      anchors.left: parent.left
      margin-top: 8
      margin-left: 10
      width: 120
      !text: tr('Cavebot')
      text-offset: 13 0
      @onCheckChange: modules.game_helper.tools.updateBotHudSettings()
    CheckBox
      id: hudShowTargeting
      anchors.top: enableBotHud.bottom
      anchors.left: parent.horizontalCenter
      margin-top: 8
      width: 120
      !text: tr('Targeting')
      text-offset: 13 0
      @onCheckChange: modules.game_helper.tools.updateBotHudSettings()
    CheckBox
      id: hudShowEquipment
      anchors.top: hudShowCavebot.bottom
      anchors.left: parent.left
      margin-top: 6
      margin-left: 10
      width: 120
      !text: tr('Equipment')
      text-offset: 13 0
      @onCheckChange: modules.game_helper.tools.updateBotHudSettings()
    CheckBox
      id: hudShowTimers
      anchors.top: hudShowTargeting.bottom
      anchors.left: parent.horizontalCenter
      margin-top: 6
      width: 120
      !text: tr('Timers')
      text-offset: 13 0
      @onCheckChange: modules.game_helper.tools.updateBotHudSettings()
    CheckBox
      id: hudShowHaste
      anchors.top: hudShowEquipment.bottom
      anchors.left: parent.left
      margin-top: 6
      margin-left: 10
      width: 130
      !text: tr('Haste / Mana')
      text-offset: 13 0
      @onCheckChange: modules.game_helper.tools.updateBotHudSettings()
    CheckBox
      id: hudShowPlayer
      anchors.top: hudShowTimers.bottom
      anchors.left: parent.horizontalCenter
      margin-top: 6
      width: 120
      !text: tr('Player Stats')
      text-offset: 13 0
      @onCheckChange: modules.game_helper.tools.updateBotHudSettings()
    CheckBox
      id: hudShowAutomation
      anchors.top: hudShowHaste.bottom
      anchors.left: parent.left
      margin-top: 6
      margin-left: 10
      width: 120
      !text: tr('Automation')
      text-offset: 13 0
      @onCheckChange: modules.game_helper.tools.updateBotHudSettings()
    CheckBox
      id: hudShowWaypoints
      anchors.top: hudShowPlayer.bottom
      anchors.left: parent.horizontalCenter
      margin-top: 6
      width: 130
      !text: tr('Waypoint Markers')
      text-offset: 13 0
      @onCheckChange: modules.game_helper.tools.updateBotHudSettings()

  // Third Panel - Paladin Only (Quiver Refill)
  Panel
    id: paladinPanel
    height: 95
    anchors.top: automationPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    margin-left: 5
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    visible: false
    Label
      id: paladinTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Quiver Refill')
      font: $var-main-font
      color: #AAAAAA
      text-auto-resize: true
    UITooltipGrey
      id: quiverHelpIcon
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 3
      margin-right: 8
      !tooltip: tr('Automatically equip ammunition when quiver count\nis below minimum until refill value is reached.')
    Panel
      id: paladinContent
      anchors.top: paladinTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 8 8 8 8
      UIButton
        id: quiverAmmoItem
        size: 34 34
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: modules.game_helper.tools.assignQuiverAmmo(self)
        !tooltip: tr('Click to select ammunition item')
      Label
        id: minLabel
        anchors.top: parent.top
        anchors.left: quiverAmmoItem.right
        margin-left: 8
        margin-top: 2
        !text: tr('Min:')
        font: $var-main-font
        color: $var-text-color
        text-auto-resize: true
      TextEdit
        id: quiverMinValue
        size: 45 20
        anchors.top: parent.top
        anchors.left: minLabel.right
        margin-left: 5
        margin-top: 0
        text: 50
        text-align: center
      Label
        id: refillLabel
        anchors.top: parent.top
        anchors.left: quiverMinValue.right
        margin-left: 10
        margin-top: 2
        !text: tr('Refill:')
        font: $var-main-font
        color: $var-text-color
        text-auto-resize: true
      TextEdit
        id: quiverRefillValue
        size: 45 20
        anchors.top: parent.top
        anchors.left: refillLabel.right
        margin-left: 5
        margin-top: 0
        text: 100
        text-align: center
      CheckBox
        id: enableQuiverRefill
        width: 100
        anchors.top: quiverAmmoItem.bottom
        anchors.left: parent.left
        !text: tr('Enable')
        margin-top: 8
        font: $var-main-font
        color: $var-text-color
        text-offset: 13 0
        @onCheckChange: modules.game_helper.tools.toggleQuiverRefill(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
          color: $var-text-cip-color

  // Fourth Panel - Sorcerer/Druid Only (Magic Shield)
  Panel
    id: magePanel
    height: 95
    anchors.top: automationPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    margin-left: 5
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    visible: false
    Label
      id: mageTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Magic Shield')
      font: $var-main-font
      color: #AAAAAA
      text-auto-resize: true
    UITooltipGrey
      id: mageHelpIcon
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 3
      margin-right: 8
      !tooltip: tr('Automatically cast utamo vita when HP is low.\nExana vita when HP is high.')
    Panel
      id: mageContent
      anchors.top: mageTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 8 8 8 8

      // Utamo Vita Row
      CheckBox
        id: enableUtamoVita
        width: 140
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 3
        !text: tr('Utamo Vita HP <')
        font: $var-main-font
        color: $var-text-color
        text-offset: 13 0
        @onCheckChange: modules.game_helper.tools.toggleUtamoVita(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
          color: $var-text-cip-color
      TextEdit
        id: utamoHpPercent
        size: 40 18
        anchors.verticalCenter: enableUtamoVita.verticalCenter
        anchors.left: enableUtamoVita.right
        margin-left: 5
        text: 80
        text-align: center
      Label
        id: utamoPercentLabel
        anchors.verticalCenter: utamoHpPercent.verticalCenter
        anchors.left: utamoHpPercent.right
        margin-left: 3
        text: %
        font: $var-main-font
        color: $var-text-color
        text-auto-resize: true
      // Exana Vita Row
      CheckBox
        id: enableExanaVita
        width: 140
        anchors.top: enableUtamoVita.bottom
        anchors.left: parent.left
        margin-top: 8
        !text: tr('Exana Vita HP >')
        font: $var-main-font
        color: $var-text-color
        text-offset: 13 0
        @onCheckChange: modules.game_helper.tools.toggleExanaVita(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
          color: $var-text-cip-color
      TextEdit
        id: exanaHpPercent
        size: 40 18
        anchors.verticalCenter: enableExanaVita.verticalCenter
        anchors.left: enableExanaVita.right
        margin-left: 5
        text: 90
        text-align: center
      Label
        id: exanaPercentLabel
        anchors.verticalCenter: exanaHpPercent.verticalCenter
        anchors.left: exanaHpPercent.right
        margin-left: 3
        text: %
        font: $var-main-font
        color: $var-text-color
        text-auto-resize: true
