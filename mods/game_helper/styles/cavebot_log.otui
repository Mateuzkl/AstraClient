CavebotLogBtn < Button

CavebotLogEntry < UILabel
  background-color: alpha
  text-align: left
  text-offset: 4 0
  color: $var-text-cip-color
  font: $var-cip-font
  text-auto-resize: true
  text-wrap: true

CavebotLogWindow < UIWidget
  id: cavebotLogWindow
  size: 540 200
  draggable: false
  phantom: false
  focusable: true
  background-color: #00000000
  @onEscape: self:destroy()

  UIWidget
    id: dragArea
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 36
    phantom: false

    Label
      id: titleLabel
      !text: 'Cavebot Log'
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      font: $var-cip-font
      color: $var-text-cip-color-yellow
      text-align: center
      phantom: true

  Panel
    id: contentPanel
    anchors.top: dragArea.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    padding: 8
    phantom: true

    UIWidget
      id: logFrame
      image-source: /images/ui/panel_flat
      image-border: 1
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: buttonsPanel.top
      margin-bottom: 6

      ScrollablePanel
        id: logList
        vertical-scrollbar: logScrollBar
        padding: 4
        background-color: alpha
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-right: 14
        layout:
          type: verticalBox
          spacing: 0

      HelperScrollBar
        id: logScrollBar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-right: 2
        margin-top: 2
        margin-bottom: 2
        step: 16
        pixels-scroll: true

    Panel
      id: buttonsPanel
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      layout:
        type: horizontalBox
        align-right: true
        spacing: 5

      CavebotLogBtn
        id: copyLogButton
        !text: 'Copy All'
        size: 70 22
        @onClick: modules.game_helper.hunting_recorderModule.copyCavebotLog()

      CavebotLogBtn
        id: clearLogButton
        !text: 'Clear'
        size: 70 22
        @onClick: modules.game_helper.hunting_recorderModule.clearCavebotLog()

      CavebotLogBtn
        id: closeLogButton
        !text: 'Close'
        size: 70 22
        @onClick: modules.game_helper.hunting_recorderModule.closeCavebotLog()
