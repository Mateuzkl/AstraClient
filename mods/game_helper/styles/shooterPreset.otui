NewMainWindow
  id: window
  anchors.horizontalCenter: parent.horizontalCenter
  !text: tr('Add shooter preset')
  font: verdana-11px-monochrome
  color: #c0c0c0
  size: 360 121
  image-source: /images/ui/login/login_frame
  image-border: 16
  @onClose:
  @onEscape: self:hide()

  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 14 12 12 12

    UIWidget
      id: text
      size: 213 11
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 1
      image-source: /images/optionstab/name-label
    UIWidget
      id: warning
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 10
      image-source: /images/ui/show-gui-help-orange.png
      visible: false
      !tooltip: tr('')

    HelperTextEdit
      id: target
      size: 328 16
      focusable: true
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      max-length: 22
      margin-top: 6

    HorizontalSeparator
      id: separator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 11

    HelperButton
      id: cancelButton
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Cancel')
      size: 43 20

    HelperButton
      id: okButton
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      margin-right: 10
      !text: tr('Ok')
      size: 43 20
