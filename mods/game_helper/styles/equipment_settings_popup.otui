NewMainWindow
  id: equipmentSettingsPopup
  !text: tr('Add Equipment')
  size: 332 392
  image-source: /images/ui/login/login_frame
  image-border: 16
  @onEscape: modules.game_helper.closeEquipmentSettingsPopup()

  Panel
    id: contentPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonsPanel.top
    margin-bottom: 5
    padding: 10

    Label
      id: popupTitleLabel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      !text: tr('Add Equipment')
      font: verdana-11px-monochrome
      color: #c0c0c0
      text-auto-resize: true

    Panel
      id: whenRow
      anchors.top: popupTitleLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      margin-top: 12

      Label
        id: whenLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 45
        !text: tr('When:')
        font: verdana-11px-monochrome
        color: #c0c0c0

      HelperComboBox
        id: conditionMetric1
        anchors.left: whenLabel.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2
        size: 68 20

      HelperComboBox
        id: conditionJoinMode
        anchors.left: conditionMetric1.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        size: 74 20

      HelperComboBox
        id: conditionMetric2
        anchors.left: conditionJoinMode.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        size: 68 20

    Panel
      id: isRow
      anchors.top: whenRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      margin-top: 6

      Label
        id: isLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 45
        !text: tr('Is:')
        font: verdana-11px-monochrome
        color: #c0c0c0

      HelperComboBox
        id: conditionOperator1
        anchors.left: isLabel.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2
        size: 56 20

      HelperTextEdit
        id: conditionValue1
        anchors.left: conditionOperator1.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        size: 45 18
        color: #c0c0c0
        font: verdana-11px-monochrome
        @onTextChange: modules.game_helper.onEquipmentPopupConditionValueChange(self)

      HelperComboBox
        id: conditionOperator2
        anchors.left: conditionValue1.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        size: 56 20

      HelperTextEdit
        id: conditionValue2
        anchors.left: conditionOperator2.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        size: 42 18
        color: #c0c0c0
        font: verdana-11px-monochrome
        @onTextChange: modules.game_helper.onEquipmentPopupConditionValueChange(self)

    Panel
      id: itemRow
      anchors.top: isRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 34
      margin-top: 6

      Label
        id: itemLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 45
        !text: tr('Item:')
        font: verdana-11px-monochrome
        color: #c0c0c0

      UIButton
        id: itemPreviewButton
        anchors.left: itemLabel.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 0
        size: 34 34
        image-source: /images/game/actionbar/slot-actionbar.png

      UIWidget
        id: itemInfoIcon
        anchors.left: itemPreviewButton.right
        anchors.top: itemPreviewButton.top
        margin-left: 6
        size: 12 12
        color: #C0C0C0
        image-source: /images/icons/show_gui_help_grey
        !tooltip: tr('Only ring and amulet ids are accepted')

      Label
        id: itemNameLabel
        anchors.left: itemInfoIcon.right
        anchors.top: itemPreviewButton.top
        margin-left: 4
        !text: tr('')
        font: verdana-11px-monochrome
        color: #c0c0c0
        text-auto-resize: true

      Label
        id: slotHintLabel
        anchors.left: itemInfoIcon.right
        anchors.bottom: itemPreviewButton.bottom
        margin-left: 4
        !text: tr('')
        font: verdana-11px-monochrome
        color: #a0a0a0
        text-auto-resize: true

    Panel
      id: tierRow
      anchors.top: itemRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 22
      margin-top: 6

      Label
        id: tierLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 45
        !text: tr('Tier:')
        font: verdana-11px-monochrome
        color: #c0c0c0

      HelperTextEdit
        id: tierInput
        anchors.left: tierLabel.right
        anchors.verticalCenter: parent.verticalCenter
        size: 45 18
        color: #c0c0c0
        font: verdana-11px-monochrome
        @onTextChange: modules.game_helper.onEquipmentPopupTierTextChange(self)

      Label
        id: rarityLabel
        anchors.left: tierInput.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 14
        width: 48
        !text: tr('Rarity:')
        font: verdana-11px-monochrome
        color: #c0c0c0

      HelperComboBox
        id: rarityCombo
        anchors.left: rarityLabel.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2
        size: 108 20

    Panel
      id: fromRow
      anchors.top: tierRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 22
      margin-top: 8

      Label
        id: fromLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 45
        !text: tr('From:')
        font: verdana-11px-monochrome
        color: #c0c0c0

      HelperCheckBox
        id: sourceHotkeyCheck
        anchors.left: fromLabel.right
        anchors.verticalCenter: parent.verticalCenter
        width: 74
        !text: tr('Hotkey')
        text-offset: 17 0
        change-cursor-image: false
        color: #c0c0c0
        font: verdana-11px-monochrome
        @onCheckChange: modules.game_helper.onEquipmentPopupSourceToggle('Hotkey', self:isChecked())

      HelperCheckBox
        id: sourceBackpackCheck
        anchors.left: sourceHotkeyCheck.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        width: 88
        !text: tr('Backpack')
        text-offset: 17 0
        change-cursor-image: false
        color: #c0c0c0
        font: verdana-11px-monochrome
        @onCheckChange: modules.game_helper.onEquipmentPopupSourceToggle('Backpack', self:isChecked())

    Panel
      id: actionRow
      anchors.top: fromRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 22
      margin-top: 6

      Label
        id: actionLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 45
        !text: tr('Action:')
        font: verdana-11px-monochrome
        color: #c0c0c0

      HelperCheckBox
        id: actionEquipCheck
        anchors.left: actionLabel.right
        anchors.verticalCenter: parent.verticalCenter
        width: 70
        !text: tr('Equip')
        text-offset: 17 0
        change-cursor-image: false
        color: #c0c0c0
        font: verdana-11px-monochrome
        @onCheckChange: modules.game_helper.onEquipmentPopupActionToggle('Equip', self:isChecked())

      HelperCheckBox
        id: actionUnequipCheck
        anchors.left: actionEquipCheck.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        width: 78
        !text: tr('Unequip')
        text-offset: 17 0
        change-cursor-image: false
        color: #c0c0c0
        font: verdana-11px-monochrome
        @onCheckChange: modules.game_helper.onEquipmentPopupActionToggle('Unequip', self:isChecked())

    Panel
      id: dontExecuteRow
      anchors.top: actionRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 34
      margin-top: 6

      HelperCheckBox
        id: dontExecuteIfEquippedCheck
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 162
        !text: tr("Don't Execute If Equipped")
        text-offset: 17 0
        change-cursor-image: false
        color: #c0c0c0
        font: verdana-11px-monochrome
        @onCheckChange: modules.game_helper.onEquipmentPopupDontExecuteToggle(self:isChecked())

      UIButton
        id: dontExecuteItemButton0
        anchors.left: dontExecuteIfEquippedCheck.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        size: 34 34
        image-source: /images/game/actionbar/slot-actionbar.png

      UIButton
        id: dontExecuteItemButton1
        anchors.left: dontExecuteItemButton0.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        size: 34 34
        image-source: /images/game/actionbar/slot-actionbar.png

      UIWidget
        id: dontExecuteInfoIcon
        anchors.left: dontExecuteItemButton1.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        size: 12 12
        color: #C0C0C0
        image-source: /images/icons/show_gui_help_grey
        !tooltip: tr('Skip this rule while that item id is currently equipped')

    Panel
      id: conditionsTitleRow
      anchors.top: dontExecuteRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 18
      margin-top: 8

      Label
        id: conditionsLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        !text: tr('Conditions:')
        font: verdana-11px-monochrome
        color: #c0c0c0
        text-auto-resize: true

      UIWidget
        id: conditionsInfoIcon
        anchors.left: conditionsLabel.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        size: 12 12
        color: #C0C0C0
        image-source: /images/icons/show_gui_help_grey
        !tooltip: tr('Optional extra condition flags saved in this rule')

    Panel
      id: conditionsRow1
      anchors.top: conditionsTitleRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 18
      margin-top: 2

      HelperCheckBox
        id: conditionDrunkCheck
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 68
        !text: tr('Drunk')
        text-offset: 17 0
        change-cursor-image: false
        color: #c0c0c0
        font: verdana-11px-monochrome

      HelperCheckBox
        id: conditionRootedCheck
        anchors.left: conditionDrunkCheck.right
        anchors.verticalCenter: parent.verticalCenter
        width: 70
        !text: tr('Rooted')
        text-offset: 17 0
        change-cursor-image: false
        color: #c0c0c0
        font: verdana-11px-monochrome

      HelperCheckBox
        id: conditionFearedCheck
        anchors.left: conditionRootedCheck.right
        anchors.verticalCenter: parent.verticalCenter
        width: 70
        !text: tr('Feared')
        text-offset: 17 0
        change-cursor-image: false
        color: #c0c0c0
        font: verdana-11px-monochrome

    Panel
      id: conditionsRow2
      anchors.top: conditionsRow1.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 18
      margin-top: 2

      HelperCheckBox
        id: conditionParalyzedCheck
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 78
        !text: tr('Paralyzed')
        text-offset: 17 0
        change-cursor-image: false
        color: #c0c0c0
        font: verdana-11px-monochrome

      HelperCheckBox
        id: conditionPzCheck
        anchors.left: conditionParalyzedCheck.right
        anchors.verticalCenter: parent.verticalCenter
        width: 40
        !text: tr('PZ')
        text-offset: 17 0
        change-cursor-image: false
        color: #c0c0c0
        font: verdana-11px-monochrome

      HelperCheckBox
        id: conditionNonPzCheck
        anchors.left: conditionPzCheck.right
        anchors.verticalCenter: parent.verticalCenter
        width: 58
        !text: tr('Non-PZ')
        text-offset: 17 0
        change-cursor-image: false
        color: #c0c0c0
        font: verdana-11px-monochrome

      HelperCheckBox
        id: conditionDrowningCheck
        anchors.left: conditionNonPzCheck.right
        anchors.verticalCenter: parent.verticalCenter
        width: 74
        !text: tr('Drowning')
        text-offset: 17 0
        change-cursor-image: false
        color: #c0c0c0
        font: verdana-11px-monochrome

    Panel
      id: conditionsRow3
      anchors.top: conditionsRow2.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 18
      margin-top: 2

      HelperCheckBox
        id: conditionUtamoVitaCheck
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 96
        !text: tr('Utamo Vita')
        text-offset: 17 0
        change-cursor-image: false
        color: #c0c0c0
        font: verdana-11px-monochrome

  Panel
    id: buttonsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 30
    margin-left: 8
    margin-right: 8
    margin-bottom: 8

    HelperButton
      id: cancelButton
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 52 22
      !text: tr('Cancel')
      font: verdana-11px-monochrome
      @onClick: modules.game_helper.closeEquipmentSettingsPopup()

    HelperButton
      id: saveButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 52 22
      !text: tr('Add')
      font: verdana-11px-monochrome
      @onClick: modules.game_helper.saveEquipmentSettingsPopup()
