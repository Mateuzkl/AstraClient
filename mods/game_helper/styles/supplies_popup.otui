      text-auto-resize: true
      anchors.bottom: supplyButton9.bottom
      anchors.right: supplyButton9.right
      margin-right: 2
      margin-bottom: 1
      visible: false

    HelperTextEdit
      id: minSupply9
      size: 55 20
      anchors.left: supplyCount9.right
      anchors.verticalCenter: supplyButton9.verticalCenter
      margin-left: 15
      color: #c0c0c0
      valid-characters: 0123456789
      @onTextChange: |
        modules.game_helper.validatePercentInput(self, 0, 10000, 0)
        modules.game_helper.hunting_recorderModule.onSupplySettingChange(9, 'minSupply', self:getText())
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" then self:setText("0") end
        end

