MainWindow
  id: suppliesPopup
  size: 530 500
  image-source: /images/ui/login/login_frame
  image-border: 16
  text: Cavebot Supplies
  draggable: true
  @onEscape: self:destroy()

  Panel
    id: suppliesPanel
    anchors.fill: parent
    anchors.bottom: buttonClose.top
    padding: 10
    margin-bottom: 2

    UIWidget
      id: headerMinLabel
      font: verdana-11px-monochrome
      !text: 'Min:'
      text-align: left
      phantom: true
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 75
      color: #C0C0C0

    UIWidget
      id: headerBuyLabel
      font: verdana-11px-monochrome
      !text: 'Buy:'
      text-align: left
      phantom: true
      anchors.top: parent.top
      anchors.left: headerMinLabel.right
      margin-left: 73
      color: #C0C0C0

    UIWidget
      id: headerMinLabel2
      font: verdana-11px-monochrome
      !text: 'Min:'
      text-align: left
      phantom: true
      anchors.top: parent.top
      anchors.left: headerBuyLabel.right
      margin-left: 88
      color: #C0C0C0

    UIWidget
      id: headerBuyLabel2
      font: verdana-11px-monochrome
      !text: 'Buy:'
      text-align: left
      phantom: true
      anchors.top: parent.top
      anchors.left: headerMinLabel2.right
      margin-left: 73
      color: #C0C0C0

    UIWidget
      id: supply1Label
      font: verdana-11px-monochrome
      !text: 'Supply #1:'
      text-align: left
      phantom: true
      anchors.top: headerMinLabel.bottom
      anchors.left: parent.left
      margin-top: 10
      margin-left: 5
      color: #C0C0C0

    UIButton
      id: supplyButton1
      size: 34 34
      anchors.top: supply1Label.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 5
      image-source: /images/game/actionbar/slot-actionbar.png
      @onMouseRelease: modules.game_helper.hunting_recorderModule.createSupplyMenu(1)

    Label
      id: supplyCount1
      font: verdana-7px-rounded
      !text: '0'
      color: white
      text-border: 1
      text-border-color: #000000
      text-auto-resize: true
      anchors.bottom: supplyButton1.bottom
      anchors.right: supplyButton1.right
      margin-right: 2
      margin-bottom: 1
      visible: false

    HelperTextEdit
      id: minSupply1
      size: 55 20
      anchors.left: supplyCount1.right
      anchors.verticalCenter: supplyButton1.verticalCenter
      margin-left: 15
      color: #c0c0c0
      valid-characters: 0123456789
      @onTextChange: |
        modules.game_helper.validatePercentInput(self, 0, 10000, 0)
        modules.game_helper.hunting_recorderModule.onSupplySettingChange(1, 'minSupply', self:getText())
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" then self:setText("0") end
        end

    UIWidget
      id: minHelp1
      anchors.left: minSupply1.right
      anchors.verticalCenter: supplyButton1.verticalCenter
      color: #C0C0C0
      image-source: /images/icons/show_gui_help_grey
      size: 12 12
      margin-left: 5
      !tooltip: tr('Minimum quantity before restocking')

    HelperTextEdit
      id: buySupply1
      size: 55 20
      anchors.left: minHelp1.right
      anchors.verticalCenter: supplyButton1.verticalCenter
      margin-left: 10
      color: #c0c0c0
      valid-characters: 0123456789
      @onTextChange: |
        modules.game_helper.validatePercentInput(self, 0, 10000, 0)
        modules.game_helper.hunting_recorderModule.onSupplySettingChange(1, 'buySupply', self:getText())
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" then self:setText("0") end
        end

    UIWidget
      id: buyHelp1
      anchors.left: buySupply1.right
      anchors.verticalCenter: supplyButton1.verticalCenter
      color: #C0C0C0
      image-source: /images/icons/show_gui_help_grey
      size: 12 12
      margin-left: 5
      !tooltip: tr('Quantity to buy when restocking')

