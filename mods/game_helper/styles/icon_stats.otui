    size: 34 34
    border-width: 1
    border-color: #FF0000
    phantom: false
    focusable: true
    virtual: true

  Panel
    id: bottomMargin
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 1
    height: 0
    width: 1

  VerticalSeparator
    id: vSeparator1
    height: 34
    visible: false

  VerticalSeparator
    id: vSeparator2
    height: 34
    visible: false

  VerticalSeparator
    id: vSeparator3
    height: 34
