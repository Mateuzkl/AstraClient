IconStats < HeadlessWindow
  id: iconStatsWindow
  size: 44 348
  background-color: #4d4d4d
  border-width: 1

  HorizontalSeparator
    id: separator1
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    width: 34

  HorizontalSeparator
    id: separator2
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    width: 34

  Item
    id: healingIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 5
    size: 34 34
    border-width: 2
    border-color: $var-text-cip-color-light-red
    phantom: false
    focusable: true
    virtual: true
    $on:
      border-color: #4dd62a

  Item
    id: healFriendIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    size: 34 34
    border-width: 2
    border-color: $var-text-cip-color-light-red
    phantom: false
    focusable: true
    virtual: true
    $on:
      border-color: #4dd62a

  Item
    id: equipmentIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    size: 34 34
    border-width: 2
    border-color: $var-text-cip-color-light-red
    phantom: false
    focusable: true
    virtual: true
    $on:
      border-color: #4dd62a

  Item
    id: tankModeIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    size: 34 34
    border-width: 2
    border-color: $var-text-cip-color-light-red
    phantom: false
    focusable: true
    virtual: true
    $on:
      border-color: #4dd62a

  Item
    id: targetingIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    size: 34 34
    border-width: 2
    border-color: $var-text-cip-color-light-red
    phantom: false
    focusable: true
    virtual: true
    $on:
      border-color: #4dd62a

  Item
    id: shooterIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    size: 34 34
    border-width: 2
    border-color: $var-text-cip-color-light-red
    phantom: false
    focusable: true
    virtual: true
    $on:
      border-color: #4dd62a

  Item
    id: cavebotIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    size: 34 34
    border-width: 2
    border-color: $var-text-cip-color-light-red
    phantom: false
    focusable: true
    virtual: true
    $on:
      border-color: #4dd62a

  Item
    id: timerIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    size: 34 34
    border-width: 2
    border-color: $var-text-cip-color-light-red
    phantom: false
    focusable: true
    virtual: true
    $on:
      border-color: #4dd62a

  HorizontalSeparator
    id: separator3
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    width: 34

  Item
    id: helperIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    size: 34 34
    border-width: 2
    border-color: $var-text-cip-color-light-red
    phantom: false
    focusable: true
    virtual: true
    $on:
      border-color: #4dd62a

  Panel
    id: bottomMargin
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 1
    height: 0
    width: 1

  VerticalSeparator
    id: vSeparator1
    height: 34
    visible: false

  VerticalSeparator
    id: vSeparator2
    height: 34
    visible: false

  VerticalSeparator
    id: vSeparator3
    height: 34
    visible: false
