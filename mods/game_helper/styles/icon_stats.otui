// ========== ICON STATS BAR — Koliseu native restyle ==========
// Floating helper icon bar. Wears the native Tibia window frame
// (/images/ui/window) instead of the flat #4d4d4d AmonOT box. Modules that own
// presets get a per-icon arrow BUTTON that opens a preset-picker flyout. The
// last slot (helper master toggle) is an ON/OFF label, not an item icon.
// Icon layout is driven from helper.lua (resize/reorganize*); the padding here
// must match the geometry constants there.

// --- One module icon slot (green = active, red = inactive; survives hover via
//     the border-guard installed in icon_stats.lua) ---
IconStatsSlot < Item
  size: 34 34
  border-width: 1
  border-color: $var-text-cip-color-light-red
  phantom: false
  focusable: true
  virtual: true
  $on:
    border-color: #4dd62a

  // Active-preset indicator (only shown from Lua on preset-owning icons):
  // the currently selected preset number, bottom-right like an item count.
  Label
    id: presetBadge
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 1
    margin-right: 1
    text-auto-resize: true
    text-align: center
    font: count-badge
    color: #ffe066
    background-color: #000000cc
    phantom: true
    visible: false

// --- Master helper toggle: ON (green) / OFF (red) text, not an item sprite.
//     Text is set from Lua (never in the style) so hover re-apply can't wipe
//     it; $on drives the green, base the red. ---
IconStatsToggle < UIButton
  size: 34 34
  border-width: 1
  border-color: #f75f5f
  background-color: #1e1e1eff
  color: #f75f5f
  font: $var-cip-font
  text-align: center
  focusable: true

  $on:
    border-color: #4dd62a
    color: #4dd62a

  $hover:
    background-color: #2a2a2aff

// --- Preset arrow BUTTON: a small framed button sitting just OUTSIDE the icon
//     edge, with a native arrow glyph. Size/side/glyph are set from Lua. ---
IconStatsPresetArrow < UIButton
  size: 16 22
  background-color: #33333cff
  border-width: 1
  border-color: #6a6a72
  focusable: false

  $hover:
    background-color: #45454f
    border-color: #a6a6b0

  $pressed:
    background-color: #26262c

  UIWidget
    id: glyph
    anchors.centerIn: parent
    size: 12 21
    image-source: /images/ui/arrow_horizontal
    image-clip: 12 0 12 21
    image-color: #e8e8e8
    phantom: true

// --- Preset picker flyout: native window frame. Panel-based (no window chrome/
//     drag/sound). The title is a Label pinned inside the header strip; the
//     preset grid is offset below it from Lua. ---
IconStatsPresetFlyout < Panel
  image-source: /images/ui/window
  image-border: 4
  image-border-top: 17
  padding: 0
  focusable: false
  phantom: false

  Label
    id: flyoutTitle
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 15
    margin-top: 1
    text-align: center
    font: $var-cip-font
    color: $var-text-cip-color-grey
    phantom: true

// --- One preset square inside the flyout. The active preset gets the green
//     $on border (set from Lua). $hover only touches the background so it never
//     fights the green border (states are additive per-property). ---
IconStatsPresetOption < UIButton
  size: 34 34
  border-width: 1
  border-color: #2a2a2a
  background-color: #1e1e1eff
  focusable: false

  $hover:
    background-color: #333333ff

  $on:
    border-color: #4dd62a

  Label
    id: label
    anchors.centerIn: parent
    font: $var-cip-font
    color: $var-text-cip-color
    text-auto-resize: true
    phantom: true

// ---------------------------------------------------------------------------

IconStats < HeadlessWindow
  id: iconStatsWindow
  image-source: /images/ui/window
  image-border: 4
  image-border-top: 17
  image-border-bottom: 4
  padding-top: 18
  padding-left: 10
  padding-right: 10
  padding-bottom: 8
  size: 54 348

  IconStatsSlot
    id: healingIcon
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 5

  IconStatsSlot
    id: healFriendIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2

  IconStatsSlot
    id: equipmentIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2

  IconStatsSlot
    id: tankModeIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2

  IconStatsSlot
    id: targetingIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2

  IconStatsSlot
    id: shooterIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2

  IconStatsToggle
    id: cavebotIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2

  IconStatsSlot
    id: timerIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2

  HorizontalSeparator
    id: separator3
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    width: 34

  IconStatsToggle
    id: helperIcon
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4

  Panel
    id: bottomMargin
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 1
    height: 0
    width: 1

  VerticalSeparator
    id: vSeparator3
    height: 34
    visible: false
