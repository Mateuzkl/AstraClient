MainWindow
  id: gotoWaypointWindow
  size: 480 360
  text: Goto - Saltar para Label
  draggable: true
  @onEscape: self:destroy()

  Panel
    id: settingsPanel
    anchors.fill: parent
    anchors.bottom: buttonOk.top
    padding: 10
    margin-bottom: 5

    # Description
    Label
      id: descLabel
      font: $var-cip-font
      !text: 'Salta para um label especifico quando a condicao\nfor atendida durante a execucao do cavebot.'
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 5
      color: $var-text-cip-color

    UIWidget
      id: infoIcon
      anchors.right: parent.right
      anchors.top: parent.top
      color: $var-text-cip-color
      image-source: /images/icons/show_gui_help_grey
      size: 12 12
      margin-right: 15
      tooltip: O Goto permite criar loops e desvios condicionais no cavebot. Use labels para marcar pontos de destino no seu waypoint. Exemplo: Se stamina < 800, voltar para o label "refill"

    HorizontalSeparator
      id: sep1
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: descLabel.bottom
      margin-top: 10

    # Label Name Section
    Label
      id: labelNameLabel
      font: $var-cip-font
      !text: 'Nome do Label de destino:'
      anchors.top: sep1.bottom
      anchors.left: parent.left
      margin-top: 8
      margin-left: 5
      color: $var-text-cip-color

    UIWidget
      id: labelHelpIcon
      anchors.right: parent.right
      anchors.top: labelNameLabel.bottom
      color: $var-text-cip-color
      image-source: /images/icons/show_gui_help_grey
      size: 12 12
      margin-right: 15
      margin-top: 10
      tooltip: Digite o nome exato do label para onde deseja saltar. O label deve existir na lista de waypoints.

    HelperTextEdit
      id: labelEdit
      anchors.top: labelNameLabel.bottom
      anchors.left: parent.left
      anchors.right: labelHelpIcon.left
      margin-top: 5
      margin-left: 5
      margin-right: 5
      height: 20
      color: $var-text-cip-color

    HorizontalSeparator
      id: sep2
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: labelEdit.bottom
      margin-top: 10

    # Condition Section
    Label
      id: condLabel
      font: $var-cip-font
      !text: 'Condicao de salto:'
      anchors.top: sep2.bottom
      anchors.left: parent.left
      margin-top: 8
      margin-left: 5
      color: $var-text-cip-color

    UIWidget
      id: condHelpIcon
      anchors.right: parent.right
      anchors.verticalCenter: condLabel.verticalCenter
      color: $var-text-cip-color
      image-source: /images/icons/show_gui_help_grey
      size: 12 12
      margin-right: 15
      tooltip: Escolha quando o salto deve acontecer - Sempre: Salta incondicionalmente, Stamina <: Salta se stamina menor que valor, Stamina >: Salta se stamina maior que valor

    # Option 1: Always
    UIWidget
      id: opt1Container
      anchors.top: condLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 20
      margin-top: 10

      HelperCheckBox
        id: optionNone
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        !text: 'Saltar sempre (sem condicao)'
        color: $var-text-cip-color
        margin-left: 5
        text-offset: 16 -2
        font: $var-cip-font
        text-auto-resize: true

      UIWidget
        id: opt1HelpIcon
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        color: $var-text-cip-color
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        margin-right: 15
        tooltip: Salta para o label toda vez que passar por este waypoint, sem verificar nenhuma condicao.

    # Option 2: Less than
    UIWidget
      id: opt2Container
      anchors.top: opt1Container.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 20
      margin-top: 10

      HelperCheckBox
        id: optionLess
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        !text: 'Saltar se stamina menor que'
        color: $var-text-cip-color
        margin-left: 5
        text-offset: 16 -2
        font: $var-cip-font
        text-auto-resize: true

      UIWidget
        id: opt2HelpIcon
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        color: $var-text-cip-color
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        margin-right: 15
        tooltip: Salta quando stamina for menor que o valor. Util para voltar ao refill quando stamina baixa.

      HelperTextEdit
        id: staminaLess
        anchors.right: opt2HelpIcon.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 5
        size: 55 20
        color: $var-text-cip-color
        @onTextChange: |
          local value = modules.game_helper.validatePercentInput(self, 0, 42, 39)
        @onFocusChange: |
          if not self:isFocused() then
            local text = self:getText()
            if text == "" or tonumber(text) == nil or tonumber(text) < 0 or tonumber(text) > 42 then
              self:setText("39")
            end
          end

    # Option 3: Greater than
    UIWidget
      id: opt3Container
      anchors.top: opt2Container.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 20
      margin-top: 10

      HelperCheckBox
        id: optionGreater
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        !text: 'Saltar se stamina maior que'
        color: $var-text-cip-color
        margin-left: 5
        text-offset: 16 -2
        font: $var-cip-font
        text-auto-resize: true

      UIWidget
        id: opt3HelpIcon
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        color: $var-text-cip-color
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        margin-right: 15
        tooltip: Salta quando stamina for maior que o valor. Util para retornar a hunt apos refill completo.

      HelperTextEdit
        id: staminaGreater
        anchors.right: opt3HelpIcon.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 5
        size: 55 20
        color: $var-text-cip-color
        @onTextChange: |
          local value = modules.game_helper.validatePercentInput(self, 0, 42, 42)
        @onFocusChange: |
          if not self:isFocused() then
            local text = self:getText()
            if text == "" or tonumber(text) == nil or tonumber(text) < 0 or tonumber(text) > 42 then
              self:setText("42")
            end
          end

  # Buttons
  HelperButton
    id: buttonOk
    anchors.bottom: parent.bottom
    anchors.right: buttonCancel.left
    margin: 10
    margin-right: 5
    text: OK
    size: 80 20
    color: $var-text-cip-color
    @onClick: modules.game_helper.hunting_recorderModule.saveGotoWaypoint(self:getParent())

  HelperButton
    id: buttonCancel
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin: 10
    text: Cancel
    size: 80 20
    color: $var-text-cip-color
    @onClick: self:getParent():destroy()
