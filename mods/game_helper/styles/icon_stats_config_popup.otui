          font: verdana-11px-monochrome
          color: #c0c0c0
          text-auto-resize: true
          width: 120

        HelperCheckBox
          id: iconStatsCavebotConfigVisible
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 165
          size: 20 20
          @onCheckChange: modules.game_helper.onIconStatsConfigVisibilityChange('cavebotIcon', self:isChecked())
          change-cursor-image: false

      Panel
        id: iconStatsTimerConfigRow
        width: 100%
        height: 28
        layout:
          type: anchor

        Label
          id: iconStatsTimerConfigLabel
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          !text: tr('Timer')
          font: verdana-11px-monochrome
          color: #c0c0c0
          text-auto-resize: true
          width: 120

        HelperCheckBox
          id: iconStatsTimerConfigVisible
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 165
          size: 20 20
          @onCheckChange: modules.game_helper.onIconStatsConfigVisibilityChange('timerIcon', self:isChecked())
          change-cursor-image: false

      Panel
        id: iconStatsHelperConfigRow
        width: 100%
        height: 28
        layout:
          type: anchor

        Label
          id: iconStatsHelperConfigLabel
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          !text: tr('Helper')
          font: verdana-11px-monochrome
          color: #c0c0c0
          text-auto-resize: true
          width: 120

        HelperCheckBox
          id: iconStatsHelperConfigVisible
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
