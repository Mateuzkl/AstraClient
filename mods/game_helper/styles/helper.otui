    text-align: center
    !text: tr('No')
    font: verdana-11px-monochrome
    color: #c0c0c0

HealingRuleRow < Panel
  width: 260
  height: 34
  margin-top: 2
  layout:
    type: anchor

  UIButton
    id: statusIcon
    image-auto-resize: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    image-source: /images/helper/disabled

  Label
    id: idLabel
    width: 18
    anchors.left: statusIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    !text: tr('1')
    font: verdana-11px-monochrome
    color: #c0c0c0

  Panel
    id: itemCell
    size: 34 34
    anchors.left: idLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

    Panel
      id: spellMarker
      anchors.fill: parent
      margin: 1
      background-color: #202020
      visible: false

    UIButton
      id: itemButton
      anchors.fill: parent
      image-source: /images/game/actionbar/slot-actionbar.png

    Label
      id: itemCount
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-right: 2
      margin-bottom: 1
      !text: tr('0')
      font: verdana-7px-rounded
      color: white
      text-border: 1
      text-border-color: #000000
      text-auto-resize: true
      visible: false

  HelperRemoveButton
    id: removeButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2

  HelperSettingsButton
    id: settingsButton
    anchors.right: removeButton.left
    anchors.verticalCenter: removeButton.verticalCenter
    margin-right: 2

  Label
    id: nameLabel
    width: 140
    anchors.left: itemCell.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    !text: tr('Name')
    font: verdana-11px-monochrome
    color: #c0c0c0

  Label
    id: whenLabel
    anchors.left: nameLabel.right
    anchors.right: settingsButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    margin-right: 6
    height: 30
    !text: tr('HP %% <= 80')
    font: verdana-11px-monochrome
    color: #c0c0c0
    text-wrap: true

AlarmsPanel < Panel
  layout:
    type: verticalBox
    fit-children: true

  Panel
    id: alarmsMainPanel
    height: 520
    image-source: /images/ui/login/login_frame
    image-border: 12

    Label
      id: alarmsTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      !text: tr('Alarms')
      font: verdana-11px-monochrome
      color: #808080
      text-auto-resize: true

    Panel
      id: alarmsList
      anchors.top: alarmsTitle.bottom
      anchors.left: parent.left
      anchors.right: alarmOptions.left
      anchors.bottom: parent.bottom
      margin-top: 10
      margin-left: 10
      margin-right: 5
      margin-bottom: 10
      layout:
        type: verticalBox
        spacing: 5

      HelperCheckBox
        id: alarmDamageTaken
        width: 200
        !text: tr('Damage Taken')
        font: verdana-11px-monochrome
        color: #c0c0c0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmDamageTaken', self:isChecked())
        $hover !disabled:
          color: #c0c0c0

      Panel
        id: alarmLowHealthRow
        height: 20
        layout:
          type: anchor

        HelperCheckBox
          id: alarmLowHealth
          width: 150
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          !text: tr('Low Health')
          font: verdana-11px-monochrome
          color: #c0c0c0
          change-cursor-image: false
          @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmLowHealth', self:isChecked())
          $hover !disabled:
            color: #c0c0c0

        HelperTextEdit
          id: alarmLowHealthInput
          size: 50 20
          anchors.left: alarmLowHealth.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 10
          padding-top: 3
          color: #c0c0c0
          text-horizontal-margin: 3
          text-vertical-margin: 3
          font: verdana-11px-monochrome
          auto-focus: false
          text: 50
          max-length: 3
          @onTextChange: |
            modules.game_helper.validatePercentInput(self, 0, 100, 50)
            modules.game_helper.onAlarmLowHealthThresholdChange(self:getText())

        Label
          id: alarmLowHealthLabel
          anchors.left: alarmLowHealthInput.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          !text: tr('HP %%')
          font: verdana-11px-monochrome
          color: #c0c0c0

      HelperCheckBox
        id: alarmMonsterOnScreen
        width: 200
        !text: tr('Monster On Screen')
        font: verdana-11px-monochrome
        color: #c0c0c0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmMonsterOnScreen', self:isChecked())
        $hover !disabled:
          color: #c0c0c0

      HelperCheckBox
        id: alarmPlayerOnScreen
        width: 200
        !text: tr('Player On Screen')
        font: verdana-11px-monochrome
        color: #c0c0c0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmPlayerOnScreen', self:isChecked())
        $hover !disabled:
          color: #c0c0c0

      HelperCheckBox
        id: alarmPlayerSkullOnScreen
        width: 200
        !text: tr('Player Skull On Screen')
        font: verdana-11px-monochrome
        color: #c0c0c0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmPlayerSkullOnScreen', self:isChecked())
        $hover !disabled:
          color: #c0c0c0

      HelperCheckBox
        id: alarmPlayerAttack
        width: 200
        !text: tr('Player Attack')
        font: verdana-11px-monochrome
        color: #c0c0c0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmPlayerAttack', self:isChecked())
        $hover !disabled:
          color: #c0c0c0

      HelperCheckBox
        id: alarmEnemyOnScreen
        width: 200
        !text: tr('Enemy On Screen')
        font: verdana-11px-monochrome
        color: #c0c0c0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmEnemyOnScreen', self:isChecked())
        $hover !disabled:
          color: #c0c0c0

    Panel
      id: alarmOptions
      anchors.top: alarmsTitle.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 250
      margin-top: 10
      margin-right: 10
      margin-bottom: 10
      layout:
        type: anchor

      Label
        id: alarmOptionsTitle
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Notify Configuration')
        font: verdana-11px-monochrome
        color: #C0C0C0
        text-auto-resize: true

      HelperCheckBox
        id: alarmSoundAlert
        anchors.top: alarmOptionsTitle.bottom
        anchors.left: parent.left
        width: 200
        margin-top: 8
        !text: tr('Sound Alert')
        font: verdana-11px-monochrome
        color: #c0c0c0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmSoundAlert', self:isChecked())
        $hover !disabled:
          color: #c0c0c0

      HelperCheckBox
        id: alarmWindowsBarFlash
        anchors.top: alarmSoundAlert.bottom
        anchors.left: parent.left
        width: 200
        margin-top: 5
        !text: tr('Bring Window to Front')
        font: verdana-11px-monochrome
        color: #c0c0c0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmWindowsBarFlash', self:isChecked())
        $hover !disabled:
          color: #c0c0c0

SettingsPanel < Panel
  layout:
    type: verticalBox
    fit-children: true
  
  Panel
    id: settingsMainPanel
    height: 580
    image-source: /images/ui/login/login_frame
    image-border: 12
    
    Label
      id: settingsTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      !text: tr('Settings')
      font: verdana-11px-monochrome
      color: #808080
      text-auto-resize: true

    Panel
      id: settingsSubTabBar
      anchors.top: settingsTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 28
      margin-top: 8
      margin-left: 10
      margin-right: 10
      layout:
        type: horizontalBox
        spacing: 2

      HelperButton
        id: settingsSubTabGeneral
        width: 172
        margin-top: 2
        margin-left: 0
        !text: tr('General')
        checked: true
        @onClick: modules.game_helper.selectSettingsSubTab('general')

      HelperButton
        id: settingsSubTabIconStats
        width: 172
        margin-top: 2
        !text: tr('Icon Stats')
        @onClick: modules.game_helper.selectSettingsSubTab('iconStats')

      HelperButton
        id: settingsSubTabEngine
        width: 172
        margin-top: 2
        margin-right: 2
        !text: tr('Engine')
        @onClick: modules.game_helper.selectSettingsSubTab('engine')

