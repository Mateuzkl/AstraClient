      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 52 22
      !text: tr('Cancel')
      font: verdana-11px-monochrome
      @onClick: modules.game_helper.closeUtamoVitaSettings()

    HelperButton
      id: saveButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 52 22
      !text: tr('Save')
      font: verdana-11px-monochrome
      @onClick: modules.game_helper.saveUtamoVitaSettings()
