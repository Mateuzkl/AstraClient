PlayerName < Label
  focusable: true
  height: 15
  font: $var-main-font
  color: #AAAAAA

  $focus:
    background-color: $var-textlist-odd
    color: $var-text-cip-color-highlight
  $!focus:
    background-color: alpha
    color: $var-text-cip-color

PotionItem < UIItem
  size: 32 32
  phantom: true
  draggable: false
  virtual: true
  priceable: false
  anchors.top: parent.top
  anchors.left: parent.left

RuneItem < UIItem
  size: 32 32
  phantom: true
  draggable: false
  virtual: true
  priceable: false
  anchors.top: parent.top
  anchors.left: parent.left

FoodItem < UIItem
  size: 32 32
  phantom: true
  draggable: false
  virtual: true
  priceable: false
  anchors.top: parent.top
  anchors.left: parent.left

SpecialFoodRow < Panel
  height: 36
  focusable: false

  UIButton
    id: slot
    size: 34 34
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 2
    image-source: /images/game/actionbar/actionbarslot
    !tooltip: tr('Right click to assign or remove an item')

  CheckBox
    id: enable
    width: 12
    anchors.verticalCenter: slot.verticalCenter
    anchors.left: slot.right
    margin-left: 3
    change-cursor-image: false
    !tooltip: tr('Enable this slot')

  UIButton
    id: rmvPercent
    size: 10 24
    anchors.verticalCenter: slot.verticalCenter
    anchors.left: enable.right
    margin-left: 3
    image-source: /images/ui/percent-buttons
    image-clip: 0 0 10 24
    $hover !pressed:
      image-clip: 0 24 10 24
    $pressed:
      image-clip: 0 48 10 24

  FlatPanel
    id: percentBg
    size: 38 24
    image-source: /images/ui/percentBg
    anchors.verticalCenter: slot.verticalCenter
    anchors.left: rmvPercent.right
    margin-left: 1

    Label
      id: percentLabel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 4
      font: $var-main-font
      color: $var-text-color
      text-auto-resize: true

  UIButton
    id: addPercent
    size: 10 24
    anchors.verticalCenter: slot.verticalCenter
    anchors.left: percentBg.right
    margin-left: 1
    image-source: /images/ui/percent-buttons
    image-clip: 10 0 10 24
    $hover !pressed:
      image-clip: 10 24 10 24
    $pressed:
      image-clip: 10 48 10 24

  UIButton
    id: addPriority
    size: 10 24
    anchors.verticalCenter: slot.verticalCenter
    anchors.right: parent.right
    margin-right: 2
    image-source: /images/ui/percent-buttons
    image-clip: 10 0 10 24
    $hover !pressed:
      image-clip: 10 24 10 24
    $pressed:
      image-clip: 10 48 10 24

  FlatPanel
    id: priorityBg
    size: 24 24
    image-source: /images/ui/percentBg
    anchors.verticalCenter: slot.verticalCenter
    anchors.right: addPriority.left
    margin-right: 1

    Label
      id: priorityLabel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 4
      font: $var-main-font
      color: $var-text-color
      text-auto-resize: true

  UIButton
    id: rmvPriority
    size: 10 24
    anchors.verticalCenter: slot.verticalCenter
    anchors.right: priorityBg.left
    margin-right: 1
    image-source: /images/ui/percent-buttons
    image-clip: 0 0 10 24
    $hover !pressed:
      image-clip: 0 24 10 24
    $pressed:
      image-clip: 0 48 10 24

SpecialFoodsWindow < MainWindow
  id: specialFoodsWindow
  size: 470 265
  !text: tr('Special Foods')
  @onEscape: modules.game_helper.specialFoodsClose()

  Panel
    id: hpFoodsPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: specialFoodsSeparator.top
    width: 215
    margin-top: 1
    margin-bottom: 5
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18

    Label
      id: hpTitle
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 3
      margin-left: 5
      !text: tr('HP Items')
      font: $var-main-font
      color: #d94a3a
      text-auto-resize: true

    Label
      id: hpPriorityHeader
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 3
      margin-right: 5
      !text: tr('Priority')
      font: $var-main-font
      color: $var-text-color
      text-auto-resize: true

    Panel
      id: hpFoodRows
      anchors.top: hpTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 3
      margin-bottom: 3
      layout:
        type: verticalBox
        spacing: 3

  Panel
    id: manaFoodsPanel
    anchors.top: parent.top
    anchors.left: hpFoodsPanel.right
    anchors.right: parent.right
    anchors.bottom: specialFoodsSeparator.top
    margin-top: 1
    margin-left: 5
    margin-bottom: 5
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18

    Label
      id: manaTitle
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 3
      margin-left: 5
      !text: tr('Mana Items')
      font: $var-main-font
      color: #3a8ad9
      text-auto-resize: true

    Label
      id: manaPriorityHeader
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 3
      margin-right: 5
      !text: tr('Priority')
      font: $var-main-font
      color: $var-text-color
      text-auto-resize: true

    Panel
      id: manaFoodRows
      anchors.top: manaTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 3
      margin-bottom: 3
      layout:
        type: verticalBox
        spacing: 3

  HorizontalSeparator
    id: specialFoodsSeparator
    anchors.bottom: closeSpecialFoods.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 5

  Button
    id: closeSpecialFoods
    size: 60 20
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 2
    text: Close
    @onClick: modules.game_helper.specialFoodsClose()

HealingPanel < Panel
  anchors.fill: parent
  Panel
    id: healingPanel
    height: 180
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: manaTrainingPanel.left
    margin-right: 8
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18

    Label
      id: title
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      !text: tr('Auto Healing Helper')
      font: $var-main-font
      color: #AAAAAA
      text-auto-resize: true

    Panel
      id: spellHealingPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: separator.left
      anchors.bottom: parent.bottom
      margin: 5 5 5 5

      Label
        id: healingLabel
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Spell Healing')
        font: $var-main-font
        color: $var-text-color
        text-auto-resize: true

      UIButton
        id: spellButton0
        size: 34 34
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        !tooltip: tr('Click to select a Spell')

      UIButton
        id: rmvPercentButton0
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-top: 3
        margin-left: 5
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updateHealingPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24

      FlatPanel
        id: spellPercentBg0
        size: 42 24
        image-source: /images/ui/percentBg
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        Label
          id: spellPercentLabel0
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('80%%')
          font: $var-main-font
          color: $var-text-color
          text-auto-resize: true

      UIButton
        id: addPercentButton0
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updateHealingPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24

      UITooltipGrey
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        !tooltip: tr('Cast a healing spell when your health reaches the defined percentage.')

      UIButton
        id: spellButton1
        size: 34 34
        anchors.top: spellButton0.bottom
        anchors.left: parent.left
        margin-top: 5
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        !tooltip: tr('Click to select a Spell')

      UIButton
        id: rmvPercentButton1
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-top: 3
        margin-left: 5
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updateHealingPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24

      FlatPanel
        id: spellPercentBg1
        size: 42 24
        image-source: /images/ui/percentBg
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        Label
          id: spellPercentLabel1
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('80%%')
          font: $var-main-font
          color: $var-text-color
          text-auto-resize: true

      UIButton
        id: addPercentButton1
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updateHealingPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24

      UITooltipGrey
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        !tooltip: tr('Cast a healing spell when your health reaches the defined percentage.')

      UIButton
        id: spellButton2
        size: 34 34
        anchors.top: spellButton1.bottom
        anchors.left: parent.left
        margin-top: 5
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        !tooltip: tr('Click to select a Spell')
        visible: false

      UIButton
        id: rmvPercentButton2
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-top: 3
        margin-left: 5
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        visible: false
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updateHealingPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24

      FlatPanel
        id: spellPercentBg2
        size: 42 24
        image-source: /images/ui/percentBg
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        visible: false
        Label
          id: spellPercentLabel2
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('80%%')
          font: $var-main-font
          color: $var-text-color
          text-auto-resize: true

      UIButton
        id: addPercentButton2
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        visible: false
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updateHealingPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24

      UITooltipGrey
        id: thirdSpellHelp
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        visible: false
        !tooltip: tr('Cast a healing spell when your health reaches the defined percentage.')

    VerticalSeparator
      id: separator
      anchors.top: title.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5

    Panel
      id: potionHealingPanel
      height: 100
      anchors.top: title.bottom
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 5 5 5 5

      Label
        id: healingLabel
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Potion Healing')
        font: $var-main-font
        color: $var-text-color
        text-auto-resize: true

      UIButton
        id: potionButton0
        size: 34 34
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onHoverChange: updateButton(self)
        @onMouseRelease: updateButton(self)

      UIButton
        id: rmvPotionPercentButton0
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-top: 3
        margin-left: 5
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updatePotionPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24

      FlatPanel
        id: potionPercentBg
        size: 42 24
        image-source: /images/ui/percentBg
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        Label
          id: potionPercentLabel0
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('50%%')
          font: $var-main-font
          color: $var-text-color
          text-auto-resize: true

      UIButton
        id: addPotionPercentButton0
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updatePotionPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24

      UITooltipGrey
        id: priority0
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        @onClick: onCheckPotionPriority(self)
        !tooltip: tr('Click to toggle between Health (red) and Mana (blue) healing priority.')

      UIButton
        id: potionButton1
        size: 34 34
        anchors.top: potionButton0.bottom
        anchors.left: parent.left
        margin-top: 5
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onHoverChange: updateButton(self)
        @onMouseRelease: updateButton(self)

      UIButton
        id: rmvPotionPercentButton1
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-top: 3
        margin-left: 5
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updatePotionPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24

      FlatPanel
        id: potionPercentBg
        size: 42 24
        image-source: /images/ui/percentBg
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        Label
          id: potionPercentLabel1
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('50%%')
          font: $var-main-font
          color: $var-text-color
          text-auto-resize: true

      UIButton
        id: addPotionPercentButton1
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updatePotionPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24

      UITooltipGrey
        id: priority1
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        @onClick: onCheckPotionPriority(self)
        !tooltip: tr('Click to toggle between Health (red) and Mana (blue) healing priority.')

      UIButton
        id: potionButton2
        size: 34 34
        anchors.top: potionButton1.bottom
        anchors.left: parent.left
        margin-top: 5
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onHoverChange: updateButton(self)
        @onMouseRelease: updateButton(self)
        visible: false

      UIButton
        id: rmvPotionPercentButton2
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-top: 3
        margin-left: 5
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updatePotionPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24

      FlatPanel
        id: potionPercentBg2
        size: 42 24
        image-source: /images/ui/percentBg
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        Label
          id: potionPercentLabel2
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('50%%')
          font: $var-main-font
          color: $var-text-color
          text-auto-resize: true

      UIButton
        id: addPotionPercentButton2
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updatePotionPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24

      UITooltipGrey
        id: priority2
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        @onClick: onCheckPotionPriority(self)
        !tooltip: tr('Click to toggle between Health (red) and Mana (blue) healing priority.')

  Panel
    id: manaTrainingPanel
    width: 200
    height: 180
    anchors.top: parent.top
    anchors.right: parent.right
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    padding: 12
    Label
      anchors.top: parent.top
      anchors.left: parent.left
      !text: tr('Mana Training')
      font: $var-main-font
      color: $var-text-color
      text-auto-resize: true
    UIButton
      id: spellTrainingButton0
      size: 34 34
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 7
      margin-left: 2
      image-source: /images/game/actionbar/actionbarslot
      !tooltip: tr('Click to select a Spell')
    CheckBox
      id: enableTraining0
      width: 60
      anchors.top: prev.top
      anchors.left: spellTrainingButton0.right
      !text: tr('Enable')
      margin-left: 5
      font: $var-main-font
      color: $var-text-color
      text-offset: 13 0
      change-cursor-image: false
      $hover !disabled:
        color: $var-text-cip-color
      @onCheckChange: modules.game_helper.onEnableTraining(self:getId(), self:isChecked())

    ComboBox
      id: spellTrainingPercent0
      size: 67 20
      anchors.top: prev.bottom
      anchors.left: spellTrainingButton0.right
      margin-top: 2
      margin-left: 5
      color: $var-text-color
      @onOptionChange: updateTrainingPercent('spellTrainingButton0', self:getCurrentOption().text:match("%d+"))
      @onSetup: |
        for i = 10, 100, 10 do
          self:addOption(i .. "%")
        end
        self:setCurrentOption("100%")
    UITooltipGrey
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 5
      margin-top: 4
      !tooltip: tr('Cast a spell when your mana reaches the defined percentage to avoid regeneration waste.')

  Button
    id: specialFoodsButton
    height: 24
    anchors.top: healingPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    !text: tr('Special Foods')
    font: $var-main-font
    @onClick: modules.game_helper.specialFoodsOpen()

  Panel
    id: namedSioPanel
    height: 110
    anchors.top: specialFoodsButton.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 7
    image-source: /images/ui/button-grey-up
    image-border: 5
    enabled: true
    visible: false

    CheckBox
      id: enableNamedSio
      width: 185
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 6
      margin-left: 8
      !text: tr('Auto Heal Friend')
      font: $var-main-font
      color: $var-text-color
      text-offset: 13 0
      change-cursor-image: false
      @onCheckChange: modules.game_helper.onNamedSioEnabled(self:isChecked())
      $hover !disabled:
        color: $var-text-cip-color

    Label
      id: namedSioHpLabel
      anchors.top: enableNamedSio.top
      anchors.right: namedSioHpPercent.left
      margin-right: 4
      !text: tr('HP <')
      font: $var-main-font
      color: #AAAAAA
      text-auto-resize: true

    TextEdit
      id: namedSioHpPercent
      size: 32 18
      anchors.top: enableNamedSio.top
      anchors.right: parent.right
      margin-right: 20
      text: 90
      text-align: center
      @onTextChange: modules.game_helper.onNamedSioPercent(self:getText())

    Label
      id: namedSioPercentLabel
      anchors.verticalCenter: namedSioHpPercent.verticalCenter
      anchors.left: namedSioHpPercent.right
      margin-left: 2
      text: %
      font: $var-main-font
      color: $var-text-color
      text-auto-resize: true

    Label
      id: namedSioNameHint
      anchors.top: enableNamedSio.bottom
      anchors.left: parent.left
      margin-top: 6
      margin-left: 8
      !text: tr('Enter name, or several: Player1, Player2')
      font: $var-main-font
      color: #AAAAAA
      text-auto-resize: true

    TextEdit
      id: namedSioPlayerName
      height: 18
      anchors.top: namedSioNameHint.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 8
      margin-right: 8
      color: $var-text-color
      font: $var-main-font
      !tooltip: tr('Names separated by comma, example: Flecio, Drucio')
      @onTextChange: modules.game_helper.onNamedSioName(self:getText())

    Label
      id: namedSioSpellLabel
      anchors.verticalCenter: namedSioSpell.verticalCenter
      anchors.left: parent.left
      margin-left: 8
      !text: tr('Spell')
      font: $var-main-font
      color: #AAAAAA
      text-auto-resize: true

    ComboBox
      id: namedSioSpell
      size: 120 18
      anchors.top: namedSioPlayerName.bottom
      anchors.right: parent.right
      margin-top: 6
      margin-right: 8
      color: $var-text-color
      font: $var-main-font
      !tooltip: tr('Which heal to cast on the listed names')
      @onOptionChange: modules.game_helper.onNamedSioSpell(self:getCurrentOption().text)
      @onSetup: |
        self:addOption("Exura Sio")
        self:addOption("Exura Gran Sio")
        self:setCurrentOption("Exura Sio")

