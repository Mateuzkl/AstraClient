UtilitySettingsWindow < NewMainWindow
  id: utilitySettingsWindow
  !text: tr('Utility Spell Settings')
  size: 400 295
  font: $var-cip-font
  color: $var-text-cip-color-white
  text-offset: 0 1
  @onEscape: self:destroy()

  Panel
    id: settingsPanel
    anchors.fill: parent
    anchors.bottom: buttonOk.top
    padding: 10
    margin-bottom: 5
    margin-top: 2

    UIWidget
      id: titleLabel
      font: $var-cip-font
      !text: tr('Configure Utility Conditions')
      text-horizontal-auto-resize: true
      phantom: true
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 5
      color: $var-text-cip-color

    HorizontalSeparator
      id: titleSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: titleLabel.bottom
      margin-top: 3

    UIWidget
      id: boxRuleLabel
      font: $var-cip-font
      !text: tr('Box rule:')
      text-align: left
      phantom: true
      anchors.top: titleSeparator.bottom
      anchors.left: parent.left
      margin-top: 8
      margin-left: 5
      color: $var-text-cip-color

    HelperComboBox
      id: boxRule
      size: 175 20
      anchors.right: boxRuleHelp.left
      anchors.verticalCenter: boxRuleLabel.verticalCenter
      margin-right: 5

    UIWidget
      id: boxRuleHelp
      anchors.right: parent.right
      anchors.verticalCenter: boxRuleLabel.verticalCenter
      color: $var-text-cip-color
      image-source: /images/icons/show_gui_help_grey
      size: 12 12
      margin-right: 15
      tooltip: Controls if the spell should only be cast when surrounded ("in box"), only when not surrounded, or always.

    UIWidget
      id: minMobsLabel
      font: $var-cip-font
      !text: tr('Min Mobs (0-99):')
      text-align: left
      phantom: true
      anchors.top: boxRuleLabel.bottom
      anchors.left: parent.left
      margin-top: 15
      margin-left: 5
      color: $var-text-cip-color

    HelperTextEdit
      id: minMobs
      size: 55 20
      anchors.right: minMobsHelp.left
      anchors.verticalCenter: minMobsLabel.verticalCenter
      margin-right: 5
      padding-top: 3
      color: $var-text-cip-color-white
      text-align: center
      only-number: true
      @onTextChange: modules.game_helper.validatePercentInput(self, 0, 99, 0)
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" then
            self:setText("0")
          end
        end

    UIWidget
      id: minMobsHelp
      anchors.right: parent.right
      anchors.verticalCenter: minMobsLabel.verticalCenter
      color: $var-text-cip-color
      image-source: /images/icons/show_gui_help_grey
      size: 12 12
      margin-right: 15
      tooltip: Minimum number of monsters nearby to cast the spell.

    UIWidget
      id: maxMobsLabel
      font: $var-cip-font
      !text: tr('Max Mobs (0-99):')
      text-align: left
      phantom: true
      anchors.top: minMobsLabel.bottom
      anchors.left: parent.left
      margin-top: 15
      margin-left: 5
      color: $var-text-cip-color

    HelperTextEdit
      id: maxMobs
      size: 55 20
      anchors.right: maxMobsHelp.left
      anchors.verticalCenter: maxMobsLabel.verticalCenter
      margin-right: 5
      padding-top: 3
      color: $var-text-cip-color-white
      text-align: center
      only-number: true
      @onTextChange: modules.game_helper.validatePercentInput(self, 0, 99, 99)
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" then
            self:setText("99")
          end
        end

    UIWidget
      id: maxMobsHelp
      anchors.right: parent.right
      anchors.verticalCenter: maxMobsLabel.verticalCenter
      color: $var-text-cip-color
      image-source: /images/icons/show_gui_help_grey
      size: 12 12
      margin-right: 15
      tooltip: Maximum number of monsters nearby to cast the spell.

    UIWidget
      id: minHealthLabel
