// ========== HELPER DESIGN SYSTEM (entergame-charlist style) ==========

HelperSpellCdIcon < UIWidget
  size: 20 20
  image-size: 20 20
  focusable: false

HelperSpellCdProgress < UIProgressRect
  background: #585858AA
  percent: 100
  focusable: false

// --- Standard Button ---
HelperButton < Button
  focusable: false
  text-align: center
  height: 28
  image-source: none
  background-color: #4d4d4d
  border-width: 1
  color: #dfdfdf
  color: $var-text-cip-color
  font: $var-cip-font

  $hover !disabled:
    background-color: #4d4d4d

  $pressed:
    background-color: #363636
    text-offset: 1 1

  $disabled:
    color: #dfdfdf88
    opacity: 0.8

  $checked:
    background-color: #363636
    text-offset: 1 1
    color: $var-text-cip-color-white

// --- Side Menu Navigation Button ---
HelperSideMenuButton < Button
  focusable: false
  text-align: left
  text-offset: 10 0
  height: 26
  background-color: #4d4d4d
  
  color: $var-text-cip-color-grey

  $hover !disabled:
    image-clip: 0 0 43 20
    color: #dfdfdf

  $pressed:
    
    text-offset: 11 1

  $checked:
    
    text-offset: 11 1
    color: $var-text-cip-color-white

  $disabled:
    color: #dfdfdf88
    opacity: 0.8

// --- Text Input ---
HelperTextEdit < TextEdit
  font: $var-cip-font
  color: $var-text-cip-color
  height: 22
  text-align: LeftCenter
  image-source: /images/ui/textedit
  image-border: 1
  selection-background-color: #808080
  padding-top: 1
  padding-bottom: 1
  padding-left: 6
  padding-right: 6

  $disabled:
    color: #27272788
    opacity: 0.5

// --- ComboBox ---
HelperComboBoxPopupMenuButton < UIButton
  height: 20
  font: $var-cip-font
  text-align: left
  text-offset: 3 0
  color: $var-text-cip-color
  background-color: alpha

  $hover !disabled:
    color: #f4f4f4
    background-color: #86868750

  $disabled:
    color: #dfdfdf88

HelperComboBoxPopupMenu < UIPopupMenu
  image-source: /images/ui/combobox_square
  image-clip: 0 60 98 20
  image-border: 1
  padding: 2

HelperComboBoxPopupScrollMenuButton < UIButton
  height: 20
  font: $var-cip-font
  text-align: left
  text-offset: 6 0
  color: $var-text-cip-color
  background-color: alpha

  $hover !disabled:
    color: #f4f4f4
    background-color: #86868750

  $disabled:
    color: #dfdfdf88

HelperComboBoxPopupScrollMenu < UIPopupScrollMenu
  image-source: /images/ui/combobox_square
  image-clip: 0 60 98 20
  image-border: 1
  padding: 2

HelperComboBox < UIComboBox
  font: $var-cip-font
  color: $var-text-cip-color
  text-offset: -22 0
  text-align: center
  height: 22
  image-source: /images/ui/combobox_square
  image-border: 3
  image-border-right: 21
  image-clip: 0 0 91 20

  $hover !disabled:
    image-clip: 0 0 91 20

  $on:
    image-clip: 0 40 91 20

  $disabled:
    color: #dfdfdf88
    opacity: 0.8

  $checked:
    image-clip: 0 20 91 20

  UIWidget
    id: arrowIcon
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 5
    size: 7 7
    image-source: /images/ui/icon-arrow7x7-down
    phantom: true

// --- Vertical Scrollbar (standard kit) ---
HelperScrollSlider < UIButton
  id: sliderButton
  anchors.centerIn: parent
  size: 12 12
  minimum: 12
  image-source: /images/ui/scrollbar
  image-border: 6
  image-clip: 0 24 12 14
  opacity: 1

  $disabled:
    opacity: 0

HelperScrollBar < UIScrollBar
  orientation: vertical
  width: 12
  height: 39
  image-source: /images/ui/scrollbar
  image-clip: 24 0 12 74
  image-border: 1
  pixels-scroll: true

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    size: 12 12
    image-source: /images/ui/scrollbar
    image-clip: 0 0 12 12
    $pressed:
      image-clip: 12 0 12 12

  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 12 12
    image-source: /images/ui/scrollbar
    image-clip: 0 12 12 12
    $pressed:
      image-clip: 12 12 12 12

  HelperScrollSlider

// --- Separator (1px line) ---
HelperSeparator < HorizontalSeparator
  height: 2
  phantom: true

// --- Sub-panel Frame ---
HelperSubPanel < FlatPanel
  padding: 8

// --- CheckBox (standard kit) ---
HelperCheckBox < CheckBox
  size: 13 13
  text-align: left
  text-offset: 14 -2
  text-auto-resize: true
  font: $var-cip-font
  color: $var-text-cip-color
  image-source: /images/ui/checkbox
  image-rect: 0 0 13 13

  $hover !disabled:
    color: $var-text-cip-color-white

  $!checked:
    image-clip: 0 0 12 12

  $checked:
    image-clip: 0 12 12 12

  $disabled:
    color: $var-text-cip-color-grey

// --- Icon Button (small, image-only) ---
HelperIconButton < UIButton
  focusable: false
  size: 16 16
  image-color: $var-text-cip-color-grey

  $hover !disabled:
    image-color: $var-text-cip-color-white

  $pressed:
    image-color: $var-text-cip-color-grey

  $disabled:
    image-color: #b0b0b066

// --- Row Remove Button (X) ---
HelperRemoveButton < Button
  focusable: false
  size: 20 20
  background-color: #4d4d4d
  image-clip: 0 0 43 20
  image-border: 1
  text: X
  font: cipsoftFont
  color: $var-text-cip-color-light-red
  text-align: center
  text-offset: 0 -1

  $hover !disabled:
    image-clip: 0 0 43 20
    color: $var-text-cip-color-light-red

  $pressed:
    image-clip: 0 20 43 20
    color: $var-text-cip-color-light-red
    text-offset: 1 0

  $disabled:
    color: $var-text-cip-color-light-red
    opacity: 0.6

// --- Row Settings Button ---
HelperSettingsButton < Button
  focusable: false
  size: 20 20
  background-color: #4d4d4d
  image-clip: 0 0 43 20
  image-border: 1
  text: ...
  font: cipsoftFont
  color: $var-text-cip-color-grey
  text-align: center
  text-offset: 0 -2

  $hover !disabled:
    image-clip: 0 0 43 20
    color: $var-text-cip-color-white

  $pressed:
    image-clip: 0 20 43 20
    color: $var-text-cip-color-grey
    text-offset: 1 -1

  $disabled:
    color: $var-text-cip-color-grey
    opacity: 0.6

// ========== END HELPER DESIGN SYSTEM ==========

PlayerName < Label
  focusable: true
  height: 15
  font: $var-cip-font
  color: $var-text-cip-color-grey

  $focus:
    background-color: #ffffff18
    color: $var-text-cip-color-highlight
  $!focus:
    background-color: alpha
    color: $var-text-cip-color

ProfileListLabel < Label
  height: 18
  background-color: alpha
  text-align: left
  text-offset: 3 0
  color: $var-text-cip-color
  font: $var-cip-font
  focusable: true
  &updateOnStates: |
    function(self)
      -- Apply selection background color when focused (mesmo que cavebot list)
      if self:isFocused() then
        self:setBackgroundColor("#ffffff18")
      else
        -- Use base background color when not focused
        if self.baseBackgroundColor then
          self:setBackgroundColor(self.baseBackgroundColor)
        end
      end
    end
  @onFocusChange: |
    self:updateOnStates()
    if self:isFocused() then
      modules.game_helper.onProfileItemFocused(self)
    end

  $focus:
    background-color: #ffffff18

  UIWidget
    id: bottomBorder
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 1
    background-color: #ffffff10
    phantom: true

ListRowLabel < Label
  focusable: true
  height: 18
  font: $var-cip-font
  color: $var-text-cip-color
  text-offset: 5 0
  background-color: alpha

  $focus:
    background-color: #ffffff18
    color: $var-text-cip-color-white
  $!focus:
    background-color: alpha
    color: $var-text-cip-color

PotionItem < UIItem
  size: 32 32
  phantom: true
  draggable: false
  virtual: true
  priceable: false
  anchors.top: parent.top
  anchors.left: parent.left

RuneItem < UIItem
  size: 32 32
  phantom: true
  draggable: false
  virtual: true
  priceable: false
  anchors.top: parent.top
  anchors.left: parent.left

EquipmentItem < UIItem
  size: 32 32
  phantom: true
  draggable: false
  virtual: true
  priceable: false
  anchors.top: parent.top
  anchors.left: parent.left

HelperPreviewItem < UIItem
  size: 18 18
  draggable: false
  virtual: true

EquipmentSwapRuleRow < Panel
  width: 260
  height: 34
  margin-top: 2
  layout:
    type: anchor

  UIButton
    id: statusIcon
    image-auto-resize: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    image-source: /images/helper/disabled

  Label
    id: idLabel
    width: 18
    anchors.left: statusIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    !text: tr('1')
    font: $var-cip-font
    color: $var-text-cip-color

  Panel
    id: itemCell
    size: 34 34
    anchors.left: idLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

    UIButton
      id: itemButton
      anchors.fill: parent
      image-source: /images/game/actionbar/slot-actionbar.png

    Label
      id: itemCount
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-right: 2
      margin-bottom: 1
      !text: tr('0')
      font: verdana-7px-rounded
      color: white
      text-border: 1
      text-border-color: #000000
      text-auto-resize: true
      visible: false

  HelperRemoveButton
    id: removeButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2

  HelperSettingsButton
    id: settingsButton
    anchors.right: removeButton.left
    anchors.verticalCenter: removeButton.verticalCenter
    margin-right: 2

  Label
    id: summaryLabel
    anchors.left: itemCell.right
    anchors.right: settingsButton.left
    anchors.verticalCenter: itemCell.verticalCenter
    margin-left: 5
    margin-right: 6
    height: 30
    !text: tr('Equip if ...')
    font: $var-cip-font
    color: $var-text-cip-color
    text-wrap: true

HealingPanel < Panel
  layout:
    type: verticalBox
    fit-children: true

  Panel
    id: healingSubTabBar
    height: 24
    visible: false
    layout:
      type: horizontalBox
      spacing: 2

    HelperButton
      id: healingSubTabHealing
      width: 200
      margin-top: 2
      margin-left: 0
      !text: tr('Healing')
      checked: true
      @onClick: modules.game_helper.selectHealingSubTab('healing')

    HelperButton
      id: healingSubTabMagicShield
      width: 200
      margin-top: 2
      !text: tr('Magic Shield')
      visible: false
      @onClick: modules.game_helper.selectHealingSubTab('magicShield')

    HelperButton
      id: healingSubTabEnergyRing
      width: 200
      margin-top: 2
      margin-right: 2
      !text: tr('Energy Ring')
      visible: false
      @onClick: modules.game_helper.selectHealingSubTab('energyRing')

  Panel
    id: healingPresetsPanel
    height: 76
    background-color: #3f3f3f
    border-width: 1
    padding: 3
    HelperComboBox
      id: healingPresets
      size: 180 20
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 2
      margin-top: 3
      color: $var-text-cip-color
      text-offset: -5 2
      @onOptionChange: toggleHealingPreset(self)
    UIButton
      id: healingCopyPresetButton
      size: 20 20
      anchors.top: healingPresets.bottom
      anchors.left: healingPresets.left
      margin-top: 4
      image-source: /images/helper/copy.png
      image-clip: 0 0 20 20
      $pressed:
        image-clip: 20 0 20 20
      !tooltip: tr('Copy config from another preset to the current preset.')
      @onClick: copyHealingPresetToCurrent(self)
    Label
      id: healingPrevPresetKeyLabel
      anchors.top: parent.top
      anchors.right: parent.right
      margin-right: 5
      margin-top: 3
      width: 45
      !text: tr('None')
      font: $var-cip-font
      color: $var-text-cip-color-grey
    HelperButton
      id: healingPrevPresetSetKey
      height: 20
      text-horizontal-auto-resize: true
      anchors.top: parent.top
      anchors.right: healingPrevPresetKeyLabel.left
      margin-right: 5
      margin-top: 3
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to switch to the previous preset.')
      @onClick: modules.game_helper.editIconStatsKeybind('Previous Healing Preset')
    Label
      id: healingPrevPresetLabel
      anchors.top: parent.top
      anchors.right: healingPrevPresetSetKey.left
      margin-right: 6
      margin-top: 3
      
      !text: tr('Previous')
      font: $var-cip-font
      color: $var-text-cip-color
    HelperButton
      id: healingRmvPresetButton
      size: 75 20
      anchors.top: healingCopyPresetButton.top
      anchors.left: healingCopyPresetButton.right
      margin-left: 5
      !text: tr('Clear')
      !tooltip: tr('Clear the current preset.')
      @onClick: removeHealingPreset()
    HelperButton
      id: healingRenameButton
      size: 75 20
      anchors.top: healingRmvPresetButton.top
      anchors.left: healingRmvPresetButton.right
      margin-left: 7
      !text: tr('Rename')
      !tooltip: tr('Rename the current preset.')
      @onClick: sendHealingRenameOrAddWindow(true)
    Label
      id: healingNextPresetKeyLabel
      anchors.top: healingRmvPresetButton.top
      anchors.right: parent.right
      margin-right: 5
      margin-top: 2
      width: 45
      !text: tr('None')
      font: $var-cip-font
      color: $var-text-cip-color-grey
    HelperButton
      id: healingNextPresetSetKey
      text-horizontal-auto-resize: true
      height: 20
      anchors.top: healingRmvPresetButton.top
      anchors.right: healingNextPresetKeyLabel.left
      margin-right: 5
      margin-top: 1
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to switch to the next preset.')
      @onClick: modules.game_helper.editIconStatsKeybind('Next Healing Preset')
    Label
      id: healingNextPresetLabel
      anchors.top: healingRmvPresetButton.top
      anchors.right: healingNextPresetSetKey.left
      margin-right: 6
      margin-top: 2
      width: 30
      !text: tr('Next')
      font: $var-cip-font
      color: $var-text-cip-color
    Label
      id: healingActivatePresetKeyLabel
      anchors.top: healingRmvPresetButton.top
      anchors.right: healingNextPresetLabel.left
      margin-right: 48
      margin-top: 2
      width: 45
      !text: tr('None')
      font: $var-cip-font
      color: $var-text-cip-color-grey
    HelperButton
      id: healingActivatePresetSetKey
      text-horizontal-auto-resize: true
      anchors.top: healingRmvPresetButton.top
      anchors.right: healingActivatePresetKeyLabel.left
      height: 20
      margin-right: 5
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to activate this preset directly.')
      @onClick: modules.game_helper.editPresetActivateKeybind('healing')
    Label
      id: healingActivatePresetTitleLabel
      anchors.bottom: healingActivatePresetSetKey.top
      anchors.left: healingActivatePresetSetKey.left
      margin-bottom: 10
      !text: tr('Activate Preset:')
      font: $var-cip-font
      color: $var-text-cip-color

    HelperButton
      id: healingSaveButton
      size: 120 20
      visible: false
      anchors.top: healingPresets.top
      anchors.right: parent.right
      !text: tr('New Preset')
      image-source: /images/ui/buttons-blue
      margin: 2
      margin-right: 5
      !tooltip: tr('Create a new preset.')
      @onClick: sendHealingRenameOrAddWindow(false)

  Panel
    id: healingPanel
    height: 504
    background-color: #3f3f3f
    border-width: 1

    Label
      id: title
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      !text: tr('Auto Healing Helper')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true

    HelperCheckBox
      id: enableAutoHealing
      width: 130
      anchors.top: prev.bottom
      anchors.left: parent.left
      !text: tr('Enable')
      margin-left: 5
      margin-top: 7
      font: $var-cip-font
      color: $var-text-cip-color
      change-cursor-image: false
      $hover !disabled:
        color: $var-text-cip-color
      @onCheckChange: modules.game_helper.onEnableAutoHealing(self:isChecked())

    HorizontalSeparator
      id: separatorAutoHealing
      anchors.top: enableAutoHealing.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 5
      margin-right: 5

    Panel
      id: healingRulesPanel
      anchors.top: separatorAutoHealing.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 5 5 5 5

      Label
        id: healingRulesTitle
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Healing Rules')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

      HelperButton
        id: addHealingRuleButton
        size: 86 20
        anchors.right: parent.right
        anchors.verticalCenter: healingRulesTitle.verticalCenter
        !text: tr('Add Healing')
        @onClick: modules.game_helper.openAddHealingRulePopup()

      Panel
        id: healingRulesHeader
        anchors.top: healingRulesTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 18
        margin-top: 4
        margin-left: 7
        margin-right: 19
        layout:
          type: anchor

        Label
          id: healingStateSpacer
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          width: 15
          !text: tr('')
          font: $var-cip-font
          color: $var-text-cip-color

        Label
          id: healingIdHeader
          anchors.left: healingStateSpacer.right
          anchors.verticalCenter: parent.verticalCenter
          width: 18
          !text: tr('ID')
          font: $var-cip-font
          color: $var-text-cip-color

        Label
          id: healingIconHeader
          anchors.left: healingIdHeader.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 4
          width: 34
          !text: tr('Act')
          font: $var-cip-font
          color: $var-text-cip-color

        Label
          id: healingNameHeader
          anchors.left: healingIconHeader.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 8
          width: 140
          !text: tr('Name')
          font: $var-cip-font
          color: $var-text-cip-color

        Label
          id: healingWhenHeader
          anchors.left: healingNameHeader.right
          anchors.right: healingEditHeader.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 6
          margin-right: 6
          !text: tr('Rule')
          font: $var-cip-font
          color: $var-text-cip-color

        Label
          id: healingEditHeader
          anchors.right: healingDelHeader.left
          anchors.verticalCenter: parent.verticalCenter
          margin-right: 2
          width: 20
          !text: tr('')
          font: $var-cip-font
          color: $var-text-cip-color

        Label
          id: healingDelHeader
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          margin-right: 2
          width: 18
          !text: tr('')
          font: $var-cip-font
          color: $var-text-cip-color

      UIScrollArea
        id: healingRulesList
        anchors.top: healingRulesHeader.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 2
        margin-left: 5
        margin-right: 19
        margin-bottom: 5
        background-color: #3a3939
        border-width: 1
        layout:
          type: verticalBox
          spacing: 3
        vertical-scrollbar: healingRulesScroll

      HelperScrollBar
        id: healingRulesScroll
        anchors.top: healingRulesHeader.bottom
        anchors.bottom: parent.bottom
        margin-top: 2
        margin-bottom: 5
        anchors.right: parent.right
        margin-right: 5
        width: 12

    Panel
      id: spellHealingPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: separator.left
      anchors.bottom: parent.bottom
      margin: 5 5 5 5
      visible: false

      Label
        id: healingLabel
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Spell Healing')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

      UIButton
        id: spellButton0
        size: 34 34
        anchors.top: healingLabel.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/slot-actionbar.png
        border-width: 1
        border-color: #3f3f3f
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)

      HelperTextEdit
        id: spellPercentInput0
        size: 55 20
        anchors.top: prev.top
        anchors.left: prev.right
        margin-top: 3
        margin-left: 5
        padding-top: 3
        color: $var-text-cip-color
        !placeholder: tr('80')
        @onTextChange: |
          local value = modules.game_helper.validatePercentInput(self, 1, 100, 80)
          if value then
            modules.game_helper.updateHealingPercentInput(0, value)
          end
        @onFocusChange: |
          if not self:isFocused() then
            local text = self:getText()
            if text == "" or tonumber(text) == nil or tonumber(text) < 1 or tonumber(text) > 100 then
              self:setText("80")
              modules.game_helper.updateHealingPercentInput(0, 80)
            end
          end

      UIButton
        id: spellPriority0
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        image-source: /images/ui/show-gui-help-orange.png
        @onClick: onCheckSpellPriority(self)
        !tooltip: tr('This spell is healing health...')

      Label
        id: spellHealingPriorityLabel
        anchors.top: healingLabel.top
        anchors.left: spellPercentInput0.right
        margin-left: 5
        !text: tr('Priority')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

      Label
        id: spellHealingTypeLabel
        anchors.top: healingLabel.top
        anchors.left: spellOrderPriority0.right
        margin-left: 5
        !text: tr('Type')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

      HelperComboBox
        id: spellOrderPriority0
        size: 53 20
        anchors.top: spellPercentInput0.top
        anchors.left: spellPercentInput0.right
        margin-left: 5
        font: $var-cip-font
        color: $var-text-cip-color
        @onOptionChange: modules.game_helper.updateHealingSpellPriority(self:getId():match("%d+"), self:getCurrentOption().text:match("%d+"))
        @onSetup: |
          self:addOption("1st")
          self:addOption("2nd")
          self:addOption("3rd")
          self:addOption("4th")
          self:setCurrentOption("1st")

      HelperComboBox
        id: spellType0
        size: 50 20
        anchors.top: spellOrderPriority0.top
        anchors.left: prev.right
