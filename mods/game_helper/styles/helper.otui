        font: verdana-11px-monochrome
        color: #c0c0c0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onEnableGuildUHHeal(self, self:isChecked())
      HelperCheckBox
        id: enableScreenUHHeal
        width: 100
        anchors.top: enableGuildUHHeal.bottom
        anchors.left: parent.left
        margin-top: 2
        margin-left: 0
        !text: tr('Heal Screen')
        font: verdana-11px-monochrome
        color: #c0c0c0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onEnableScreenUHHeal(self, self:isChecked())
      Label
        id: hpPercentLabel
        anchors.top: parent.top
        anchors.left: parent.horizontalCenter
        margin-left: -25
        !text: 'HP %:'
        font: verdana-11px-monochrome
        color: #c0c0c0
        width: 62
        text-align: right
      Label
        id: priorityLabel
        anchors.top: parent.top
        anchors.left: hpPercentLabel.right
        margin-left: 25
        !text: tr('Prior:')
        font: verdana-11px-monochrome
        color: #c0c0c0
        width: 38
      UIWidget
        size: 12 12
        anchors.top: priorityLabel.top
        anchors.left: priorityLabel.right
        margin-top: 2
        image-source: /mods/game_wheel/images/icon_info.png
        !tooltip: tr('Lowest priority number will be healed first.')

      Label
        anchors.top: hpPercentLabel.bottom
        anchors.left: hpPercentLabel.left
        margin-top: 5
        !text: tr('EK:')
        font: verdana-11px-monochrome
        color: #c0c0c0
        width: 25
      HelperTextEdit
        id: uhKnightPercent
        size: 58 18
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        padding-top: 2
        color: #c0c0c0
        font: verdana-11px-monochrome
        @onTextChange: |
          local value = modules.game_helper.validatePercentInput(self, 0, 100, 90)
          if value ~= nil then
            modules.game_helper.onUHVocationPercentChange(8, tostring(value))
          end
        @onFocusChange: |
          if not self:isFocused() then
            local text = self:getText()
            if text == "" or tonumber(text) == nil or tonumber(text) < 0 or tonumber(text) > 100 then
              self:setText("90")
              modules.game_helper.onUHVocationPercentChange(8, "90")
            end
          end
      HelperComboBox
        id: uhKnightPriority
        size: 55 24
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 2
        color: #c0c0c0
        font: verdana-11px-monochrome
        @onOptionChange: modules.game_helper.onUHVocationPriorityChange(8, self:getCurrentOption().text)
        @onSetup: |
          for i = 1, 5 do
            self:addOption(tostring(i))
          end
          self:setCurrentOption("1")
      Label
        anchors.top: uhKnightPriority.bottom
        anchors.left: hpPercentLabel.left
        margin-top: 2
        !text: tr('RP:')
        font: verdana-11px-monochrome
        color: #c0c0c0
        width: 25
      HelperTextEdit
        id: uhPaladinPercent
        size: 58 18
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        padding-top: 2
        color: #c0c0c0
        font: verdana-11px-monochrome
        @onTextChange: |
          local value = modules.game_helper.validatePercentInput(self, 0, 100, 90)
          if value ~= nil then
            modules.game_helper.onUHVocationPercentChange(7, tostring(value))
          end
        @onFocusChange: |
          if not self:isFocused() then
            local text = self:getText()
            if text == "" or tonumber(text) == nil or tonumber(text) < 0 or tonumber(text) > 100 then
              self:setText("90")
              modules.game_helper.onUHVocationPercentChange(7, "90")
            end
          end
      HelperComboBox
        id: uhPaladinPriority
        size: 55 24
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 2
        color: #c0c0c0
        font: verdana-11px-monochrome
        @onOptionChange: modules.game_helper.onUHVocationPriorityChange(7, self:getCurrentOption().text)
        @onSetup: |
          for i = 1, 5 do
            self:addOption(tostring(i))
          end
          self:setCurrentOption("2")
      Label
        anchors.top: uhPaladinPriority.bottom
        anchors.left: hpPercentLabel.left
        margin-top: 2
        !text: tr('MS:')
        font: verdana-11px-monochrome
        color: #c0c0c0
        width: 25
      HelperTextEdit
        id: uhSorcererPercent
        size: 58 18
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        padding-top: 2
        color: #c0c0c0
        font: verdana-11px-monochrome
        @onTextChange: |
          local value = modules.game_helper.validatePercentInput(self, 0, 100, 90)
          if value ~= nil then
            modules.game_helper.onUHVocationPercentChange(5, tostring(value))
          end
        @onFocusChange: |
          if not self:isFocused() then
            local text = self:getText()
