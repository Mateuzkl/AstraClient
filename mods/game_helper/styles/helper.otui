      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 10
        margin-top: 4
        image-source: /mods/game_wheel/images/icon_info.png
        !tooltip: tr('Select an attack rune to be used on monsters or targets.\nIf the rune is single target, it will be used on individual enemies.\nFor area runes, the system will choose the best target\nto hit the maximum number of creatures.')

      UIButton
        id: runeShooterButton1
        size: 34 34
        anchors.top: runeShooterButton0.bottom
        anchors.left: runeShooterButton0.left
        margin-top: 10
        image-source: /images/game/actionbar/slot-actionbar.png
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)
      Label
        id: runeShooterButton1Count
