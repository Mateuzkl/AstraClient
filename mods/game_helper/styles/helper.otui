    Label
      id: itemCount
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-right: 2
      margin-bottom: 1
      !text: tr('0')
      font: verdana-7px-rounded
      color: white
      text-border: 1
      text-border-color: #000000
      text-auto-resize: true
      visible: false

  HelperRemoveButton
    id: removeButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2

  HelperSettingsButton
    id: settingsButton
    anchors.right: removeButton.left
    anchors.verticalCenter: removeButton.verticalCenter
    margin-right: 2

  Label
    id: cooldownLabel
    width: 88
    anchors.right: settingsButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    height: 18
    !text: tr('1 Minutes')
    font: verdana-11px-monochrome
    color: #c0c0c0

  Label
    id: actionLabel
    width: 44
    anchors.right: cooldownLabel.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    height: 18
    !text: tr('Use')
    font: verdana-11px-monochrome
    color: #c0c0c0

  Label
    id: itemWordsLabel
    anchors.left: itemCell.right
    anchors.right: actionLabel.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    margin-right: 6
    height: 18
    !text: tr('Item')
    font: verdana-11px-monochrome
    color: #c0c0c0

