          margin-left: 3
          font: verdana-11px-monochrome
          color: #c0c0c0
          @onCheckChange: modules.game_helper.onLevelSpyToggle('mobs', self:isChecked())
          change-cursor-image: false
          $hover !disabled:
            color: #c0c0c0

