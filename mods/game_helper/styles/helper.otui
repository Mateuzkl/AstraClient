        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Heal Settings')
        font: verdana-11px-monochrome
        color: #c0c0c0
        text-auto-resize: true
      HelperCheckBox
        id: enableSio0
        width: 100
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 5
        margin-left: 0
        !text: tr('Enable')
        font: verdana-11px-monochrome
        color: #c0c0c0
