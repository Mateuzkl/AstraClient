      color: #c0c0c0
      !placeholder: tr('80')
      @onTextChange: |
        local value = modules.game_helper.validatePercentInput(self, 0, 100, 80)
        if value then
          modules.game_helper.updateUtamoPercentInput(0, value)
        end
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" or tonumber(text) == nil or tonumber(text) < 0 or tonumber(text) > 100 then
            self:setText("80")
            modules.game_helper.updateUtamoPercentInput(0, 80)
          end
        end

    HelperCheckBox
      id: magicPotion
      anchors.left: utamoVita.left
      anchors.top: utamoVita.bottom
      margin-top: 10
      !text: tr("Magic Potion")
      text-auto-resize: true
      font: verdana-11px-monochrome
      color: #c0c0c0
      @onCheckChange: toggleMagicPotion(self, self:isChecked())

    UIItem
      id: magicPotionIcon
      size: 18 18
      anchors.left: exanaVita.right
      anchors.verticalCenter: magicPotion.verticalCenter
      margin-left: 6
      virtual: true
      focusable: false
      phantom: true

    HelperSettingsButton
      id: magicPotionSettingsBtn
      anchors.verticalCenter: magicPotion.verticalCenter
      anchors.left: exanaVitaIcon.right
      margin-left: 5
      @onClick: modules.game_helper.openMagicPotionSettings()
        
    HelperCheckBox
      id: exanaVita
      anchors.left: utamoVita.left
      anchors.top: magicPotion.bottom
      margin-top: 10
      !text: tr("Auto Exana Vita")
      text-auto-resize: true
      font: verdana-11px-monochrome
      color: #c0c0c0
      @onCheckChange: toggleExanaVita(self, self:isChecked())

    UIWidget
      id: exanaVitaIcon
      size: 18 18
      image-size: 18 18
      anchors.left: exanaVita.right
      anchors.verticalCenter: exanaVita.verticalCenter
      margin-left: 6
      focusable: false
      phantom: true

    HelperTextEdit
      id: exanaPercentInput0
      size: 55 20
      anchors.verticalCenter: exanaVita.verticalCenter
      anchors.right: parent.right
      margin-right: 10
      padding-top: 3
      color: #c0c0c0
      !placeholder: tr('80')
      @onTextChange: |
        local value = modules.game_helper.validatePercentInput(self, 0, 100, 80)
        if value then
          modules.game_helper.updateExanaPercentInput(0, value)
        end
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" or tonumber(text) == nil or tonumber(text) < 0 or tonumber(text) > 100 then
            self:setText("80")
            modules.game_helper.updateExanaPercentInput(0, 80)
          end
        end

    HelperCheckBox
      id: exanaVitaWaitUtamoCD
