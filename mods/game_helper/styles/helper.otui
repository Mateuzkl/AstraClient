  image-border: 16
  @onEscape: self:destroy()

  Panel
    id: settingsPanel
    anchors.fill: parent
    anchors.bottom: buttonOk.top
    padding: 10
    margin-bottom: 5
    margin-top: 2

    UIWidget
      id: titleLabel
      font: verdana-11px-monochrome
      !text: tr('Configure Exeta Res Conditions')
      text-horizontal-auto-resize: true
      phantom: true
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 5
      color: #C0C0C0

    HorizontalSeparator
      id: titleSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: titleLabel.bottom
      margin-top: 3

    UIWidget
      id: minMobsLabel
      font: verdana-11px-monochrome
      !text: tr('Min Mobs Around (1-9):')
      text-align: left
      phantom: true
      anchors.top: titleSeparator.bottom
      anchors.left: parent.left
      margin-top: 8
      margin-left: 5
      color: #C0C0C0

    HelperTextEdit
      id: minMobs
      size: 55 20
      anchors.right: minMobsHelp.left
      anchors.verticalCenter: minMobsLabel.verticalCenter
      margin-right: 5
      padding-top: 3
      color: #e8e8f0
      text-align: center
      only-number: true
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" then
            self:setText("1")
            return
          end
          local value = tonumber(text)
          if not value or value < 1 or value > 9 then
            self:setText("1")
          end
        end

    UIWidget
      id: minMobsHelp
      anchors.right: parent.right
      anchors.verticalCenter: minMobsLabel.verticalCenter
      color: #C0C0C0
