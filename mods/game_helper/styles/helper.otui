  Panel
    id: enableButtons
    height: 65
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    image-source: /images/ui/2pixel-up-frame-borderimage
    image-border: 10
    padding: 3
    CheckBox
      id: enableAutoTarget
      width: 90
      anchors.top: parent.top
      anchors.left: parent.left
      !text: tr('Auto Target')
      margin-left: 2
      margin-top: 7
      font: $var-cip-font
      color: $var-text-cip-color
      text-offset: 13 -3
      @onCheckChange: toggleAutoTarget(self)
      change-cursor-image: false
      $hover !disabled:
      color: #c0c0c0
    ComboBox
      id: autoTargetMode
      size: 50 15
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 7
      margin-top: -1
      color: $var-text-cip-color
      text-offset: -20 0
      @onOptionChange: modules.game_helper.updateAutoTargetMode(self:getCurrentOption().text)
      @onSetup: |
        self:addOption("A")
        self:addOption("B")
        self:addOption("C")
        self:addOption("D")
        self:addOption("E")
        self:addOption("F")
        self:addOption("G")
        self:addOption("H")
        self:addOption("I")
        self:setCurrentOption("A")
    UIWidget
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 10
      margin-top: 1
      image-source: /images/skin/show-gui-help-grey
      !tooltip: tr('Mode A = Prioritizes the closest target\nMode B = Prioritizes the farthest target\nMode C = Prioritizes target with the lowest health\nMode D = Prioritizes target with the highest health\nMode E = Prioritizes the best target to throw runes (diamond arrows for paladins)\nMode F = Attacks the closest target, prioritizing the one with the lowest health\nMode G = Prioritizes the closest target with the highest health\nMode H = Prioritizes the farthest target with the lowest health\nMode I = Prioritizes the farthest target with the highest health')
    Button
      id: setKeyAutoTargetButton
      size: 43 15
      anchors.top: prev.top
      anchors.left: prev.right
      !text: tr('Set Key')
      margin-left: 20
      margin-top: -2
      @onClick: manageHotkeys("Enable/Disable Auto Target")
    UIWidget
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 10
      margin-top: 1
      image-source: /images/skin/show-gui-help-grey
      !tooltip: tr('Choose a hotkey to toggle auto target on/off.')
    CheckBox
      id: enableMagicShooter
      width: 160
      anchors.top: prev.bottom
      anchors.left: parent.left
      !text: tr('Enable Shooter Helper')
      margin-left: 2
      margin-top: 8
      font: $var-cip-font
      color: $var-text-cip-color
      text-offset: 13 -3
      @onCheckChange: toggleMagicShooter(self)
      change-cursor-image: false
      $hover !disabled:
      color: #c0c0c0
    Button
      id: setKeyMSButton
      size: 43 15
      anchors.top: prev.top
      anchors.left: prev.right
      !text: tr('Set Key')
      margin-left: 27
      margin-top: -2
      @onClick: manageHotkeys("Enable/Disable Magic Shooter")
    UIWidget
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 10
      margin-top: 1
      image-source: /images/skin/show-gui-help-grey
      !tooltip: tr('Choose a hotkey to toggle Caster on/off.')
    Button
      id: setKeyDisableButton
      height: 15
      anchors.top: setKeyMSButton.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 2
      margin-right: 32
      image-source: /images/ui/buttons-blue
      !text: tr('Set Key (Target/Shooter)')
      color: $var-text-cip-color-white
      @onClick: manageHotkeys("Enable/Disable Target and Magic Shooter")
    UIWidget
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 10
      margin-top: 1
      image-source: /images/skin/show-gui-help-grey
      !tooltip: tr('Choose a hotkey to toggle Caster and Target on/off.')
      
NewHeadlessWindow
  id: helperWindow
  anchors.horizontalCenter: parent.horizontalCenter
  size: 295 365
  @onEscape: hide()
  UIWidget
    size: 145 56
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: -33
    image-source: /images/game/tutorial/backdrop_crest
    phantom: true

  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 15 13 17 13
    Panel
      id: optionsTabBar
      height: 36
      image-source: /images/game/destiny_wheel/menuBg
      image-border: 1
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 12
      Button
        id: healingMenu
        anchors.top: parent.top
        anchors.left: parent.left
        size: 34 34
        margin-left: 1
        margin-top: 1
        image-source: /images/ui/helper
        image-clip: 0 170 34 34
        $hover !checked:
          size: 34 34
          image-clip: 0 170 34 34
        $pressed:
          size: 34 34
          image-clip: 0 204 34 34
        $checked:
          size: 134 34
          image-clip: 0 0 134 34
        @onClick: loadMenu('healingMenu')
      Button
        id: toolsMenu
        anchors.top: parent.top
        anchors.left: prev.right
        size: 34 34
        margin-left: 1
        margin-top: 1
        image-source: /images/ui/helper
        image-clip: 34 170 34 34
        $hover !checked:
          size: 34 34
          image-clip: 34 170 34 34
        $pressed:
          size: 34 34
          image-clip: 34 204 34 34
        $checked:
          size: 134 34
          image-clip: 0 34 134 34
        @onClick: loadMenu('toolsMenu')
      Button
        id: shooterMenu
        anchors.top: parent.top
        anchors.left: prev.right
        size: 34 34
        margin-left: 1
        margin-top: 1
        image-source: /images/ui/helper
        image-clip: 68 170 34 34
        visible: true
        enabled: true
        $hover !checked:
          size: 34 34
          image-clip: 68 170 34 34
        $pressed:
          size: 34 34
          image-clip: 68 204 34 34
        $checked:
          size: 134 34
          image-clip: 0 68 134 34
        @onClick: loadMenu('shooterMenu')
      Button
        id: cavebotMenu
        anchors.top: parent.top
        anchors.left: prev.right
        size: 34 34
        margin-left: 1
        margin-top: 1
        image-source: /images/ui/helper
        image-clip: 102 170 34 34
        $hover !checked:
          size: 34 34
          image-clip: 102 170 34 34
        $pressed:
          size: 34 34
          image-clip: 102 204 34 34
        $checked:
          size: 134 34
          image-clip: 0 102 134 34
        @onClick: loadMenu('cavebotMenu')
      Button
        id: scriptingMenu
        anchors.top: parent.top
        anchors.left: prev.right
        size: 34 34
        margin-left: 1
        margin-top: 1
        image-source: /images/ui/helper
        image-clip: 136 170 34 34
        $hover !checked:
          size: 34 34
          image-clip: 136 170 34 34
        $pressed:
          size: 34 34
          image-clip: 136 204 34 34
        $checked:
          size: 134 34
          image-clip: 0 136 134 34
        @onClick: loadMenu('scriptingMenu')

    HealingPanel
      id: healingPanel
      anchors.top: optionsTabBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      visible: false

    ToolsPanel
      id: toolsPanel
      anchors.top: optionsTabBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      visible: false

    ShooterPanel
      id: shooterPanel
      anchors.top: optionsTabBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      visible: false

    HorizontalSeparator
      id: separator
      anchors.bottom: next.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 7

    Button
      id: close
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Close')
      size: 43 20
      @onClick: hide()

    Button
      id: tracker
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      margin-right: 5
      !text: tr('Helper Stats')
      size: 73 20
      @onClick: toggleHelperTracker()

    Label
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-bottom: 8
      !text: tr('Helper Status:')
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true

    Label
      id: helperStatusLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      !text: tr('Status')
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true

    UIButton
      id: helperStatus
      size: 12 9
      anchors.bottom: prev.bottom
      anchors.left: prev.right
      margin-left: 5
      margin-bottom: 2
      image-source: /images/store/icon-yes
      @onClick: botStatus()
      !tooltip: tr(' - Helper Status: [ENABLED]')

    Button
      id: setKeyHelperButton
      size: 41 15
      anchors.bottom: prev.bottom
      anchors.left: prev.right
      margin-left: 5
      margin-bottom: -3
      !text: tr('Set Key')
      @onClick: manageHotkeys("Enable/Disable Helper")