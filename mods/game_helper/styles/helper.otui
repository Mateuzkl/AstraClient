          font: verdana-11px-monochrome
          color: #c0c0c0
          text-auto-resize: true

        HelperComboBox
          id: windowOpacityCombo
          size: 100 20
          anchors.left: windowOpacityLabel.right
          anchors.verticalCenter: parent.verticalCenter
