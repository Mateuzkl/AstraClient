        margin-top: 10
        margin-left: 10
        margin-right: 10
        layout:
          type: anchor

        HelperCheckBox
          id: showInfosOnClient
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          width: 200
          !text: tr('Show infos on client')
          font: verdana-11px-monochrome
