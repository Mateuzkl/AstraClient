      Label
        id: minHarmonyLabel
        anchors.top: parent.top
        anchors.left: sep3.right
        margin-left: 5
        !text: tr('Min Harmony')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
        visible: false

      UIButton
        id: attackSpellButton0
        size: 34 34
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 20
        margin-left: 2
        image-source: /images/game/actionbar/slot-actionbar.png
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)

      HelperComboBox
        id: countMinCreature0
        size: 50 20
        anchors.top: prev.top
        anchors.left: sep0.right
        margin-left: 19
        margin-top: 10
        color: $var-text-cip-color
        @onOptionChange: modules.game_helper.updateMagicShooterCreatures(self:getId(), self:getId():match("%d+"), self:getCurrentOption().text)
        @onSetup: |
          self:addOption("0")
          self:addOption("1")
          self:addOption("1+")
          self:addOption("2+")
          self:addOption("3+")
          self:addOption("4+")
          self:addOption("5+")
          self:addOption("6+")
          self:addOption("7+")
          self:addOption("8+")
          self:addOption("9+")
          self:addOption("10+")
          self:setCurrentOption("1+")

      HelperCheckBox
        id: conditionSetting0
        width: 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 7
        change-cursor-image: false
        !tooltip: tr('Cast if have +1 creatures')
        visible: false
        @onCheckChange: toggleForceCast(self:getId():match("%d+"), self:isChecked())

      HelperComboBox
        id: priority0
        size: 53 20
        anchors.top: countMinCreature0.top
        anchors.left: countMinCreature0.right
        margin-left: 18
        font: $var-cip-font
        color: $var-text-cip-color
