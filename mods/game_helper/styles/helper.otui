        font: verdana-7px-rounded
        color: white
        text-border: 1
        text-border-color: #000000
        text-auto-resize: true
        visible: false
      HelperComboBox
        id: countMinCreature1
        size: 50 20
        anchors.top: runeShooterButton1.top
        anchors.left: runeShooterButton1.right
        margin-left: 19
        margin-top: 3
        color: #c0c0c0
        @onOptionChange: modules.game_helper.updateRuneShooterCreatures(self:getId(), self:getId():match("%d+"), self:getCurrentOption().text)
        @onSetup: |
          self:addOption("1")
          self:addOption("1+")
          self:addOption("2+")
          self:addOption("3+")
          self:addOption("4+")
          self:addOption("5+")
          self:addOption("6+")
          self:addOption("7+")
          self:addOption("8+")
          self:addOption("9+")
          self:addOption("10+")
          self:setCurrentOption("1+")
      HelperCheckBox
        id: conditionSetting1
        width: 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 7
        change-cursor-image: false
        !tooltip: tr('Cast if have +1 creatures')
        visible: false
        @onCheckChange: toggleForceRuneCast(self:getId():match("%d+"), self:isChecked())
      HelperComboBox
        id: runePriority1
        size: 55 24
        anchors.top: countMinCreature1.top
        anchors.left: prev.right
        margin-left: 17
        font: verdana-11px-monochrome
        color: #c0c0c0
        @onOptionChange: modules.game_helper.updateRuneShooterPriority(self:getId():match("%d+"), self:getCurrentOption().text:match("%d+"))
        @onSetup: |
          self:addOption("1st")
          self:addOption("2nd")
          self:addOption("3rd")
          self:addOption("4th")
          self:addOption("5th")
          self:addOption("6th")
          self:addOption("7th")
          self:setCurrentOption("1st")
      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 10
        margin-top: 4
        image-source: /mods/game_wheel/images/icon_info.png
        !tooltip: tr('Select an attack rune to be used on monsters or targets.\nIf the rune is single target, it will be used on individual enemies.\nFor area runes, the system will choose the best target\nto hit the maximum number of creatures.')
  Panel
    id: enableButtonsLegacy
    height: 0
    visible: false
    image-source: /images/ui/login/login_frame
    image-border: 16
    padding: 3
    HelperCheckBox
      id: enableMagicShooterLegacy
      width: 163
      anchors.top: parent.top
      anchors.left: parent.left
      !text: tr('Enable Shooter Helper')
      margin-left: 2
      margin-top: 8
      font: verdana-11px-monochrome
      color: #c0c0c0
      @onCheckChange: toggleMagicShooter(self)
      change-cursor-image: false
      $hover !disabled:
        color: #c0c0c0

TargetModeSelector < HeadlessWindow
  id: targetModeSelector
  size: 420 536
  anchors.centerIn: parent
  image-source: /images/ui/login/login_frame
  image-border: 16
  @onEscape: modules.game_helper.closeTargetModeSelector()

  Label
    id: titleLabel
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 12
    !text: tr('Select Attack Mode')
    font: verdana-11px-monochrome
    color: #808080
    text-auto-resize: true

  Panel
    id: modesPanel
    anchors.top: titleLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin: 10 15 8 15
    layout:
      type: verticalBox
      spacing: 4

    HelperButton
      id: modeA
      !text: tr('Mode A - Prioritize closest target')
      @onClick: modules.game_helper.selectTargetMode('A')

    HelperButton
      id: modeB
      !text: tr('Mode B - Prioritize farthest target')
      @onClick: modules.game_helper.selectTargetMode('B')

    HelperButton
      id: modeC
      !text: tr('Mode C - Prioritize target with lowest health')
      @onClick: modules.game_helper.selectTargetMode('C')

    HelperButton
      id: modeD
      !text: tr('Mode D - Prioritize target with highest health')
      @onClick: modules.game_helper.selectTargetMode('D')

    HelperButton
      id: modeE
      height: 44
      text-wrap: true
      !text: tr('Mode E - Prioritize best target for runes (diamond arrows for paladins)')
      @onClick: modules.game_helper.selectTargetMode('E')

    HelperButton
      id: modeF
      !text: tr('Mode F - Attack closest target, prioritizing lowest health')
      @onClick: modules.game_helper.selectTargetMode('F')

    HelperButton
      id: modeG
      !text: tr('Mode G - Prioritize closest target with highest health')
      @onClick: modules.game_helper.selectTargetMode('G')

    HelperButton
      id: modeH
      !text: tr('Mode H - Prioritize farthest target with lowest health')
      @onClick: modules.game_helper.selectTargetMode('H')

    HelperButton
      id: modeI
      !text: tr('Mode I - Prioritize farthest target with highest health')
      @onClick: modules.game_helper.selectTargetMode('I')

    HelperButton
      id: modeJ
      !text: tr('Mode J - Chain Mode for Mages')
      @onClick: modules.game_helper.selectTargetMode('J')

    HelperButton
      id: modeK
      !text: tr('Mode K - Chain Mode for Monks')
      @onClick: modules.game_helper.selectTargetMode('K')

  HelperButton
    id: closeButton
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 12
    width: 120
    !text: tr('Close')
    @onClick: modules.game_helper.closeTargetModeSelector()

TargetingPanel < Panel
  layout:
    type: verticalBox
    fit-children: true

  Panel
    id: targetingPresetsPanel
    height: 76
    image-source: /images/ui/login/login_frame
    image-border: 16
    padding: 3
    HelperComboBox
      id: targetingPresets
      size: 180 20
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 2
      margin-top: 3
      color: #c0c0c0
      text-offset: -5 2
      @onOptionChange: toggleTargetingPreset(self)
    UIButton
      id: targetingCopyPresetButton
      size: 20 20
      anchors.top: targetingPresets.bottom
      anchors.left: targetingPresets.left
      margin-top: 4
      image-source: /images/helper/copy.png
      image-clip: 0 0 20 20
      $pressed:
        image-clip: 20 0 20 20
      !tooltip: tr('Copy config from another preset to the current preset.')
      @onClick: copyTargetingPresetToCurrent(self)
    Label
      id: targetingPrevPresetKeyLabel
      anchors.top: parent.top
      anchors.right: parent.right
      margin-right: 5
      margin-top: 3
      width: 45
      !text: tr('None')
      font: verdana-11px-monochrome
      color: #808080
    HelperButton
      id: targetingPrevPresetSetKey
      size: 55 24
      anchors.top: parent.top
      anchors.right: targetingPrevPresetKeyLabel.left
      margin-top: 3
      margin-right: 5
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to switch to the previous preset.')
      @onClick: modules.game_helper.editIconStatsKeybind('Previous Targeting Preset')
    Label
      id: targetingPrevPresetLabel
      anchors.top: parent.top
      anchors.right: targetingPrevPresetSetKey.left
      margin-right: 6
      margin-top: 3
      width: 50
      !text: tr('Previous')
      font: verdana-11px-monochrome
      color: #c0c0c0
    HelperButton
      id: targetingRmvPresetButton
      size: 75 24
      anchors.top: targetingCopyPresetButton.top
      anchors.left: targetingCopyPresetButton.right
      margin-left: 5
      !text: tr('Clear')
      !tooltip: tr('Clear the current preset.')
      @onClick: removeTargetingPreset()
    HelperButton
      id: targetingRenameButton
      size: 75 24
      anchors.top: targetingRmvPresetButton.top
      anchors.left: targetingRmvPresetButton.right
      margin-left: 7
      !text: tr('Rename')
      !tooltip: tr('Rename the current preset.')
      @onClick: sendTargetingRenameOrAddWindow(true)
    Label
      id: targetingNextPresetKeyLabel
      anchors.top: targetingRmvPresetButton.top
      anchors.right: parent.right
      margin-right: 5
      margin-top: 2
      width: 45
      !text: tr('None')
      font: verdana-11px-monochrome
      color: #808080
    HelperButton
      id: targetingNextPresetSetKey
      size: 55 24
      anchors.top: targetingRmvPresetButton.top
      anchors.right: targetingNextPresetKeyLabel.left
      margin-right: 5
      margin-top: 1
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to switch to the next preset.')
      @onClick: modules.game_helper.editIconStatsKeybind('Next Targeting Preset')
    Label
      id: targetingNextPresetLabel
      anchors.top: targetingRmvPresetButton.top
      anchors.right: targetingNextPresetSetKey.left
      margin-right: 6
      margin-top: 2
      width: 30
      !text: tr('Next')
      font: verdana-11px-monochrome
      color: #c0c0c0
    Label
      id: targetingActivatePresetKeyLabel
      anchors.top: targetingRmvPresetButton.top
      anchors.right: targetingNextPresetLabel.left
      margin-right: 48
      margin-top: 2
      width: 45
      !text: tr('None')
      font: verdana-11px-monochrome
      color: #808080
    HelperButton
      id: targetingActivatePresetSetKey
      size: 55 24
      anchors.top: targetingRmvPresetButton.top
      anchors.right: targetingActivatePresetKeyLabel.left
      margin-right: 5
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to activate this preset directly.')
      @onClick: modules.game_helper.editPresetActivateKeybind('targeting')
    Label
      id: targetingActivatePresetTitleLabel
      anchors.bottom: targetingActivatePresetSetKey.top
      anchors.left: targetingActivatePresetSetKey.left
      margin-bottom: 10
      !text: tr('Activate Preset:')
      font: verdana-11px-monochrome
      color: #c0c0c0

    HelperButton
      id: targetingSaveButton
      size: 120 20
      visible: false
      anchors.top: targetingPresets.top
      anchors.right: parent.right
      !text: tr('New Preset')
      image-source: /images/ui/buttons-blue
      margin: 2
      margin-right: 5
      !tooltip: tr('Create a new preset.')
      @onClick: sendTargetingRenameOrAddWindow(false)

  Panel
    id: autoTargetBox
    height: 354
    image-source: /images/ui/login/login_frame
    image-border: 12
    
    Label
      id: autoTargetTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      !text: tr('Auto Target')
      font: verdana-11px-monochrome
      color: #808080
      text-auto-resize: true

    HelperButton
      id: importDefaultTargeting
      size: 110 20
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 4
      margin-right: 8
      !text: tr('Import Default')
      !tooltip: tr('Reset this tab to the default profile for your vocation.')
      @onClick: modules.game_helper.importTabDefaults('targeting')

    HelperCheckBox
      id: enableAutoTarget
      width: 93
      anchors.top: autoTargetTitle.bottom
      anchors.left: parent.left
      !text: tr('Enable')
      margin-left: 10
      margin-top: 10
      font: verdana-11px-monochrome
      color: #c0c0c0
      @onCheckChange: toggleAutoTarget(self)
      change-cursor-image: false
      $hover !disabled:
        color: #c0c0c0
    
    Label
      id: modeLabel
      anchors.top: enableAutoTarget.bottom
      anchors.left: parent.left
      margin-left: 10
      margin-top: 8
      !text: tr('Mode:')
      font: verdana-11px-monochrome
      color: #c0c0c0
      text-auto-resize: true

    HelperButton
      id: autoTargetModeDisplay
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 2
      !text: tr('Mode A - Prioritize closest target')
      font: verdana-11px-monochrome
      @onClick: modules.game_helper.openTargetModeSelector()

    Label
      id: maxTargetDistanceLabel
      anchors.top: autoTargetModeDisplay.bottom
      anchors.left: parent.left
      margin-left: 10
      margin-top: 10
      !text: tr('Max Target Distance:')
      font: verdana-11px-monochrome
      color: #c0c0c0
      text-auto-resize: true

    UIWidget
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 5
      image-source: /mods/game_wheel/images/icon_info.png
      !tooltip: tr('Distancia maxima (em sqm) para targetar criaturas.\nPadrao: 7 para Sorcerer/Druid/Paladin, 1 para Knight/Monk')

    HelperTextEdit
      id: maxTargetDistanceInput
      size: 55 22
      anchors.top: maxTargetDistanceLabel.bottom
      anchors.left: parent.left
      margin: 5 10 0 10
      color: #c0c0c0
      @onTextChange: |
        local value = modules.game_helper.validatePercentInput(self, 1, 10, 7)
        if value then
          modules.game_helper.updateMaxTargetDistance(value)
        end
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" or tonumber(text) == nil or tonumber(text) < 1 or tonumber(text) > 10 then
            self:setText("7")
          end
        end

    HelperCheckBox
      id: prioritizeBossCheckBox
      anchors.top: maxTargetDistanceLabel.bottom
      anchors.left: maxTargetDistanceInput.right
      margin-left: 10
      margin-top: 5
      !text: tr('Prioritize Boss')
      text-auto-resize: true
      font: verdana-11px-monochrome
      color: #c0c0c0
      @onCheckChange: modules.game_helper.updatePrioritizeBoss(self:isChecked())

    Label
      id: attackPositionLabel
      anchors.top: maxTargetDistanceLabel.top
      anchors.left: prioritizeBossCheckBox.right
      margin-left: 15
      !text: tr('Attack Position:')
      font: verdana-11px-monochrome
      color: #c0c0c0
      text-auto-resize: true

    HelperComboBox
      id: attackPositionCombo
      size: 105 22
      anchors.top: maxTargetDistanceLabel.bottom
      anchors.left: attackPositionLabel.left
      margin-top: 5
      font: verdana-11px-monochrome
      color: #c0c0c0
      @onOptionChange: modules.game_helper.updateAttackPosition(self:getCurrentOption().data)
      @onSetup: |
        self:addOption("Do nothing", 1)
        self:addOption("Chase", 2)
        self:addOption("Distance", 3)
        self:addOption("Diagonal", 4)
        self:setCurrentIndex(1)

    Label
      id: attackDistanceLabel
      anchors.top: maxTargetDistanceLabel.bottom
      anchors.left: attackPositionCombo.right
      margin-left: 5
      margin-top: 8
      !text: tr('SQMs:')
      font: verdana-11px-monochrome
      color: #c0c0c0
      text-auto-resize: true
      visible: false

    HelperTextEdit
      id: attackDistanceInput
      size: 35 22
      anchors.top: maxTargetDistanceLabel.bottom
      anchors.left: attackDistanceLabel.right
      margin-top: 5
      margin-left: 3
      color: #c0c0c0
      visible: false
      @onTextChange: |
        local value = modules.game_helper.validatePercentInput(self, 1, 5, 1)
        if value then
          modules.game_helper.updateAttackDistance(value)
        end
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" or tonumber(text) == nil or tonumber(text) < 1 or tonumber(text) > 5 then
            self:setText("1")
          end
        end

    Label
      id: ignoreMobsLabel
      anchors.top: maxTargetDistanceInput.bottom
      anchors.left: parent.left
      margin-left: 10
      margin-top: 10
      !text: tr('Ignore Mobs (separate by comma):')
      font: verdana-11px-monochrome
      color: #c0c0c0
      text-auto-resize: true
    
    UIWidget
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 5
      image-source: /mods/game_wheel/images/icon_info.png
      !tooltip: tr('Enter the names of mobs you want to ignore, separated by comma.\nExample: Rat, Dragon, Demon')
    
    HelperTextEdit
      id: ignoredMobsInput
      anchors.top: ignoreMobsLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 5 10 10 10
      height: 22
      font: verdana-11px-monochrome
      color: #c0c0c0
      placeholder: Rat, Dragon, Demon
      @onTextChange: modules.game_helper.updateIgnoredMobs(self:getText())

    Label
      id: priorityMobsLabel
      anchors.top: ignoredMobsInput.bottom
      anchors.left: parent.left
      margin-left: 10
      margin-top: 10
      !text: tr('Prioritize Mobs (separate by comma):')
      font: verdana-11px-monochrome
      color: #c0c0c0
      text-auto-resize: true

    UIWidget
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 5
      image-source: /mods/game_wheel/images/icon_info.png
      !tooltip: tr('Enter the names of mobs you want to prioritize in attack, separated by comma.\nThese mobs will be attacked before the normal attack mode.\nExample: Ancient Scarab, Hero')

    HelperTextEdit
      id: priorityMobsInput
      anchors.top: priorityMobsLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 5 10 10 10
      height: 22
      font: verdana-11px-monochrome
      color: #c0c0c0
      placeholder: Ancient Scarab, Hero
      @onTextChange: modules.game_helper.updatePriorityMobs(self:getText())

    HelperCheckBox
      id: pauseCavebotOnMobCheck
      anchors.top: priorityMobsInput.bottom
      anchors.left: parent.left
      margin-left: 10
      margin-top: 10
      !text: tr('Pause Cavebot on Mob')
      text-auto-resize: true
      font: verdana-11px-monochrome
      color: #c0c0c0
      @onCheckChange: modules.game_helper.togglePauseCavebotOnMob(self)
      !tooltip: tr('Pause cavebot when a mob from the list is detected within max target distance.\nResumes automatically once the mob is gone.')

    UIWidget
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 5
      margin-top: 4
      image-source: /mods/game_wheel/images/icon_info.png
      !tooltip: tr('When enabled, the cavebot pauses if any mob below is on screen within max target distance.\nAuto target stays on, so you keep attacking. Cavebot resumes after killing the mob.')

    HelperTextEdit
      id: pauseCavebotOnMobInput
      anchors.top: pauseCavebotOnMobCheck.bottom
