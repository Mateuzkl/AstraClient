          change-cursor-image: false
          @onCheckChange: modules.game_helper.onShowInfosOnClientChange(self:isChecked())

        UIWidget
          size: 12 12
          anchors.verticalCenter: parent.verticalCenter
          anchors.right: parent.right
          margin-right: 10
          image-source: /mods/game_wheel/images/icon_info.png
