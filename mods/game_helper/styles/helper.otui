FriendHealPanel < Panel
  layout:
    type: verticalBox
    fit-children: true
  Panel
    id: sioSpellPanel
    height: 50
    image-source: /images/ui/login/login_frame
    image-border: 12
    visible: false
    HelperButton
      id: importDefaultFriendheal
      size: 110 20
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 4
      margin-right: 8
      !text: tr('Import Default')
      !tooltip: tr('Reset this tab to the default profile for your vocation.')
      @onClick: modules.game_helper.importTabDefaults('friendheal')
    Label
      id: sioSpellTitle
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      margin-left: 10
      !text: tr('Sio Spell')
      font: verdana-11px-monochrome
      color: #808080
      text-auto-resize: true
    UIButton
      id: sioSpellButton
      size: 34 34
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: prev.right
      margin-left: 8
      image-source: /images/game/actionbar/slot-actionbar.png
      @onClick: modules.game_helper.assignSioSpell(self, false)
      @onMouseRelease: modules.game_helper.assignSioSpell(self, false)
    Label
      id: sioSpellName
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: prev.right
      anchors.right: parent.right
