        margin-left: 0
        !text: tr('Heal Party')
        font: verdana-11px-monochrome
        color: #c0c0c0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onEnablePartyUHHeal(self, self:isChecked())
      HelperCheckBox
        id: enableGuildUHHeal
        width: 100
