HuntingPanel < Panel
  layout:
    type: verticalBox
    fit-children: true

  Panel
    id: huntingSubTabBar
    height: 24
    layout:
      type: horizontalBox
      spacing: 2

    HelperButton
      id: huntingSubTabTargeting
      width: 170
      margin-top: 2
      margin-left: 0
      !text: tr('Targeting')
      checked: true
      @onClick: modules.game_helper.selectHuntingSubTab('targeting')

    HelperButton
      id: huntingSubTabShooter
      width: 170
      margin-top: 2
      !text: tr('Shooter')
      @onClick: modules.game_helper.selectHuntingSubTab('shooter')

    HelperButton
      id: huntingSubTabCavebot
      width: 170
      margin-top: 2
      margin-right: 2
      !text: tr('Cavebot')
      @onClick: modules.game_helper.selectHuntingSubTab('cavebot')

  TargetingPanel
    id: huntingTargetingContent
    visible: true

  ShooterPanel
    id: huntingShooterContent
    visible: false

  CaveBotUI
    id: huntingCavebotContent
    size: 850 552
    visible: false

    Panel
      id: caveHeader
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      layout:
        type: horizontalBox
        fit-children: false
        cell-spacing: 6

    Panel
      id: caveContainer
      anchors.top: caveHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      layout:
        type: anchor

TimerPanel < Panel
  layout:
    type: verticalBox
    fit-children: true

  Panel
    id: timerContentPanel
    height: 556
    background-color: #3f3f3f
    border-width: 1

    Label
      id: timerTitle
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10
      !text: tr('Timer')
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true

    HelperCheckBox
      id: enableTimerModule
      width: 100
      anchors.top: timerTitle.bottom
      anchors.left: timerTitle.left
      margin-top: 8
      !text: tr('Enable')
      font: $var-cip-font
      color: $var-text-cip-color
      change-cursor-image: false
      $hover !disabled:
        color: $var-text-cip-color
      @onCheckChange: modules.game_helper.onEnableTimerModule(self:isChecked())

    HelperButton
      id: addTimerRuleButton
      size: 76 20
      anchors.verticalCenter: enableTimerModule.verticalCenter
      anchors.right: parent.right
      margin-right: 10
      !text: tr('Add Timer')
      @onClick: modules.game_helper.openAddTimerRulePopup()

    HorizontalSeparator
      id: timerSeparator
      anchors.top: enableTimerModule.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 5
      margin-right: 5

    Panel
      id: timerListHeader
      anchors.top: timerSeparator.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 18
      margin-top: 4
      margin-left: 7
      margin-right: 19
      layout:
        type: anchor

      Label
        id: timerStateSpacer
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 20
        !text: tr('')
        font: $var-cip-font
        color: $var-text-cip-color

      Label
        id: idHeader
        anchors.left: timerStateSpacer.right
        anchors.verticalCenter: parent.verticalCenter
        width: 18
        !text: tr('ID')
        font: $var-cip-font
        color: $var-text-cip-color

      Label
        id: iconHeader
        anchors.left: idHeader.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        width: 34
        !text: tr('CD')
        font: $var-cip-font
        color: $var-text-cip-color

      Label
        id: textHeader
        anchors.left: iconHeader.right
        anchors.right: typeHeader.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        margin-right: 6
        !text: tr('Text')
        font: $var-cip-font
        color: $var-text-cip-color

      Label
        id: typeHeader
        anchors.right: intervalHeader.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 6
        width: 44
        !text: tr('Type')
        font: $var-cip-font
        color: $var-text-cip-color

      Label
        id: intervalHeader
        anchors.right: editHeader.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 6
        width: 88
        !text: tr('Interval')
        font: $var-cip-font
        color: $var-text-cip-color

      Label
        id: editHeader
        anchors.right: delHeader.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 2
        width: 20
        !text: tr('')
        font: $var-cip-font
        color: $var-text-cip-color

      Label
        id: delHeader
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 2
        width: 18
        !text: tr('')
        font: $var-cip-font
        color: $var-text-cip-color

    UIScrollArea
      id: timerList
      padding: 5
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: timerListHeader.bottom
      anchors.bottom: parent.bottom
      margin-top: 2
      margin-left: 5
      margin-right: 19
      margin-bottom: 5
      layout:
        type: verticalBox
        spacing: 3
      vertical-scrollbar: timerListScroll

    HelperScrollBar
      id: timerListScroll
      anchors.top: timerListHeader.bottom
      anchors.bottom: parent.bottom
      margin-top: 2
      margin-bottom: 5
      anchors.right: parent.right
      margin-right: 5
      width: 12

TimerRuleRow < Panel
  width: 260
  height: 34
  margin-top: 2
  layout:
    type: anchor

  UIButton
    id: statusIcon
    image-auto-resize: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    image-source: /images/helper/disabled

  Label
    id: idLabel
    width: 18
    anchors.left: statusIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    !text: tr('1')
    font: $var-cip-font
    color: $var-text-cip-color

  Panel
    id: itemCell
    size: 34 34
    anchors.left: idLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

    Panel
      id: textCooldownBox
      anchors.fill: parent
      margin: 1
      background-color: #202020
      visible: false

    UIButton
      id: itemButton
      anchors.fill: parent
      image-source: /images/game/actionbar/slot-actionbar.png

    Label
      id: itemCount
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-right: 2
      margin-bottom: 1
      !text: tr('0')
      font: verdana-7px-rounded
      color: white
      text-border: 1
      text-border-color: #000000
      text-auto-resize: true
      visible: false

  HelperRemoveButton
    id: removeButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2

  HelperSettingsButton
    id: settingsButton
    anchors.right: removeButton.left
    anchors.verticalCenter: removeButton.verticalCenter
    margin-right: 2

  Label
    id: cooldownLabel
    width: 88
    anchors.right: settingsButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    height: 18
    !text: tr('1 Minutes')
    font: $var-cip-font
    color: $var-text-cip-color

  Label
    id: actionLabel
    width: 44
    anchors.right: cooldownLabel.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    height: 18
    !text: tr('Use')
    font: $var-cip-font
    color: $var-text-cip-color

  Label
    id: itemWordsLabel
    anchors.left: itemCell.right
    anchors.right: actionLabel.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    margin-right: 6
    height: 18
    !text: tr('Item')
    font: $var-cip-font
    color: $var-text-cip-color

ShooterRuleRow < Panel
  width: 260
  height: 34
  margin-top: 2
  layout:
    type: anchor

  UIButton
    id: statusIcon
    image-auto-resize: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    image-source: /images/helper/disabled

  Label
    id: idLabel
    width: 18
    anchors.left: statusIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    !text: tr('1')
    font: $var-cip-font
    color: $var-text-cip-color

  Panel
    id: itemCell
    size: 34 34
    anchors.left: idLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

    UIButton
      id: itemButton
      anchors.fill: parent
      image-source: /images/game/actionbar/slot-actionbar.png

  HelperRemoveButton
    id: removeButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2

  HelperSettingsButton
    id: settingsButton
    anchors.right: removeButton.left
    anchors.verticalCenter: removeButton.verticalCenter
    margin-right: 2

  Label
    id: nameLabel
    width: 140
    anchors.left: itemCell.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    !text: tr('Name')
    font: $var-cip-font
    color: $var-text-cip-color

  Label
    id: ruleLabel
    anchors.left: nameLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 90
    height: 30
    !text: tr('1+')
    font: $var-cip-font
    color: $var-text-cip-color
    text-wrap: true

  Label
    id: targetLabel
    anchors.left: ruleLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 64
    width: 42
    text-align: center
    !text: tr('No')
    font: $var-cip-font
    color: $var-text-cip-color

HealingRuleRow < Panel
  width: 260
  height: 34
  margin-top: 2
  layout:
    type: anchor

  UIButton
    id: statusIcon
    image-auto-resize: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    image-source: /images/helper/disabled

  Label
    id: idLabel
    width: 18
    anchors.left: statusIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    !text: tr('1')
    font: $var-cip-font
    color: $var-text-cip-color

  Panel
    id: itemCell
    size: 34 34
    anchors.left: idLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

    Panel
      id: spellMarker
      anchors.fill: parent
      margin: 1
      background-color: #202020
      visible: false

    UIButton
      id: itemButton
      anchors.fill: parent
      image-source: /images/game/actionbar/slot-actionbar.png

    Label
      id: itemCount
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-right: 2
      margin-bottom: 1
      !text: tr('0')
      font: verdana-7px-rounded
      color: white
      text-border: 1
      text-border-color: #000000
      text-auto-resize: true
      visible: false

  HelperRemoveButton
    id: removeButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2

  HelperSettingsButton
    id: settingsButton
    anchors.right: removeButton.left
    anchors.verticalCenter: removeButton.verticalCenter
    margin-right: 2

  Label
    id: nameLabel
    width: 140
    anchors.left: itemCell.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    !text: tr('Name')
    font: $var-cip-font
    color: $var-text-cip-color

  Label
    id: whenLabel
    anchors.left: nameLabel.right
    anchors.right: settingsButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    margin-right: 6
    height: 30
    !text: tr('HP %% <= 80')
    font: $var-cip-font
    color: $var-text-cip-color
    text-wrap: true

AlarmsPanel < Panel
  layout:
    type: verticalBox
    fit-children: true

  Panel
    id: alarmsMainPanel
    height: 520
    background-color: #3f3f3f
    border-width: 1

    Label
      id: alarmsTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      !text: tr('Alarms')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true

    Panel
      id: alarmsList
      anchors.top: alarmsTitle.bottom
      anchors.left: parent.left
      anchors.right: alarmOptions.left
      anchors.bottom: parent.bottom
      margin-top: 10
      margin-left: 10
      margin-right: 5
      margin-bottom: 10
      layout:
        type: verticalBox
        spacing: 5

      HelperCheckBox
        id: alarmDamageTaken
        width: 200
        !text: tr('Damage Taken')
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmDamageTaken', self:isChecked())
        $hover !disabled:
          color: $var-text-cip-color

      Panel
        id: alarmLowHealthRow
        height: 20
        layout:
          type: anchor

        HelperCheckBox
          id: alarmLowHealth
          width: 150
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          !text: tr('Low Health')
          font: $var-cip-font
          color: $var-text-cip-color
          change-cursor-image: false
          @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmLowHealth', self:isChecked())
          $hover !disabled:
            color: $var-text-cip-color

        HelperTextEdit
          id: alarmLowHealthInput
          size: 50 20
          anchors.left: alarmLowHealth.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 10
          padding-top: 3
          color: $var-text-cip-color
          text-horizontal-margin: 3
          text-vertical-margin: 3
          font: $var-cip-font
          auto-focus: false
          text: 50
          max-length: 3
          @onTextChange: |
            modules.game_helper.validatePercentInput(self, 0, 100, 50)
            modules.game_helper.onAlarmLowHealthThresholdChange(self:getText())

        Label
          id: alarmLowHealthLabel
          anchors.left: alarmLowHealthInput.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          !text: tr('HP %%')
          font: $var-cip-font
          color: $var-text-cip-color

      HelperCheckBox
        id: alarmMonsterOnScreen
        width: 200
        !text: tr('Monster On Screen')
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmMonsterOnScreen', self:isChecked())
        $hover !disabled:
          color: $var-text-cip-color

      HelperCheckBox
        id: alarmPlayerOnScreen
        width: 200
        !text: tr('Player On Screen')
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmPlayerOnScreen', self:isChecked())
        $hover !disabled:
          color: $var-text-cip-color

      HelperCheckBox
        id: alarmPlayerSkullOnScreen
        width: 200
        !text: tr('Player Skull On Screen')
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmPlayerSkullOnScreen', self:isChecked())
        $hover !disabled:
          color: $var-text-cip-color

      HelperCheckBox
        id: alarmPlayerAttack
        width: 200
        !text: tr('Player Attack')
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmPlayerAttack', self:isChecked())
        $hover !disabled:
          color: $var-text-cip-color

      HelperCheckBox
        id: alarmEnemyOnScreen
        width: 200
        !text: tr('Enemy On Screen')
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmEnemyOnScreen', self:isChecked())
        $hover !disabled:
          color: $var-text-cip-color

    Panel
      id: alarmOptions
      anchors.top: alarmsTitle.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 250
      margin-top: 10
      margin-right: 10
      margin-bottom: 10
      layout:
        type: anchor

      Label
        id: alarmOptionsTitle
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Notify Configuration')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

      HelperCheckBox
        id: alarmSoundAlert
        anchors.top: alarmOptionsTitle.bottom
        anchors.left: parent.left
        width: 200
        margin-top: 8
        !text: tr('Sound Alert')
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmSoundAlert', self:isChecked())
        $hover !disabled:
          color: $var-text-cip-color

      HelperCheckBox
        id: alarmWindowsBarFlash
        anchors.top: alarmSoundAlert.bottom
        anchors.left: parent.left
        width: 200
        margin-top: 5
        !text: tr('Bring Window to Front')
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onAlarmCheckboxChange('alarmWindowsBarFlash', self:isChecked())
        $hover !disabled:
          color: $var-text-cip-color

SettingsPanel < Panel
  layout:
    type: verticalBox
    fit-children: true
  
  Panel
    id: settingsMainPanel
    height: 580
    background-color: #3f3f3f
    border-width: 1
    
    Label
      id: settingsTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      !text: tr('Settings')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true

    Panel
      id: settingsSubTabBar
      anchors.top: settingsTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      margin-top: 8
      margin-left: 10
      margin-right: 10
      layout:
        type: horizontalBox
        spacing: 2

      HelperButton
        id: settingsSubTabGeneral
        width: 172
        margin-top: 2
        margin-left: 0
        !text: tr('General')
        checked: true
        @onClick: modules.game_helper.selectSettingsSubTab('general')

      HelperButton
        id: settingsSubTabIconStats
        width: 172
        margin-top: 2
        !text: tr('Icon Stats')
        @onClick: modules.game_helper.selectSettingsSubTab('iconStats')

      HelperButton
        id: settingsSubTabEngine
        width: 172
        margin-top: 2
        margin-right: 2
        !text: tr('Engine')
        @onClick: modules.game_helper.selectSettingsSubTab('engine')

    Panel
      id: settingsGeneralContent
      anchors.top: settingsSubTabBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      layout:
        type: anchor

      Label
        id: helperWindowTitle
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 10
        margin-left: 10
        !text: tr('Helper Window')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

      Panel
        id: helperWindowRow
        anchors.top: helperWindowTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 28
        margin-top: 10
        margin-left: 10
        margin-right: 10
        layout:
          type: anchor

        Label
          id: helperWindowLabel
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 34
          !text: tr('Open Helper Window')
          font: $var-cip-font
          color: $var-text-cip-color
          text-auto-resize: true
          width: 120

        HelperButton
          id: helperWindowSetKey
          text-horizontal-auto-resize: true
          anchors.left: parent.left
          height: 20
          anchors.verticalCenter: parent.verticalCenter
          margin: 2
          margin-left: 187
          !text: tr('Set Key')
          @onClick: modules.game_helper.editIconStatsKeybind('Open Helper')

        Label
          id: helperWindowKeyLabel
          anchors.left: helperWindowSetKey.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 8
          !text: tr('')
          font: $var-cip-font
          color: $var-text-cip-color-grey
          text-auto-resize: true

        UIWidget
          size: 12 12
          anchors.verticalCenter: parent.verticalCenter
          anchors.right: parent.right
          margin-right: 10
          image-source: /mods/game_wheel/images/icon_info.png
          !tooltip: tr('Configure hotkey to open/close Helper window and access configuration panel')

    Panel
      id: settingsIconStatsContent
      anchors.top: settingsSubTabBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      visible: false
      layout:
        type: anchor

      Panel
        id: iconStatsWindowRow
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 28
        margin-top: 10
        margin-left: 10
        margin-right: 10
        layout:
          type: anchor

        HelperCheckBox
          id: iconStatsWindowVisible
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          width: 150
          !text: tr('Icon Stats Window')
          font: $var-cip-font
          color: $var-text-cip-color
          change-cursor-image: false
          @onCheckChange: modules.game_helper.onIconStatsWindowVisibilityChange(self:isChecked())

        UIWidget
          size: 12 12
          anchors.left: iconStatsWindowVisible.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          image-source: /mods/game_wheel/images/icon_info.png
          !tooltip: tr('Enable or disable the Icon Stats window visibility.\nWhen enabled, displays a window with various helper icons\nfor quick access to game features and status indicators.')

        HelperCheckBox
          id: iconStatsLockPosition
          anchors.left: iconStatsWindowVisible.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 30
          width: 140
          !text: tr('Lock Position')
          font: $var-cip-font
          color: $var-text-cip-color
          change-cursor-image: false
          @onCheckChange: modules.game_helper.onIconStatsLockChange(self:isChecked())

        UIWidget
          size: 12 12
          anchors.left: iconStatsLockPosition.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          image-source: /mods/game_wheel/images/icon_info.png
          !tooltip: tr('Lock the Icon Stats window position to prevent\naccidental dragging. When enabled, the window position\nwill be fixed and cannot be moved by dragging.')

        HelperCheckBox
          id: iconStatsHorizontal
          anchors.left: iconStatsLockPosition.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 30
          width: 110
          !text: tr('Horizontal')
          font: $var-cip-font
          color: $var-text-cip-color
          change-cursor-image: false
          @onCheckChange: modules.game_helper.onIconStatsOrientationChange(self:isChecked())

        UIWidget
          size: 12 12
          anchors.left: iconStatsHorizontal.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          image-source: /mods/game_wheel/images/icon_info.png
          !tooltip: tr('Toggle Icon Stats layout between horizontal\nand vertical orientation. When enabled, icons are\narranged horizontally in a row. When disabled,\nicons are stacked vertically in a column.')

      Panel
        id: iconStatsList
        anchors.top: iconStatsWindowRow.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 260
        margin-top: 10
        margin-left: 10
        margin-right: 10
        margin-bottom: 10
        layout:
          type: anchor

        Panel
          id: iconStatsHealingRow
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 28
          layout:
            type: anchor

          Item
            id: iconStatsHealingRowIcon
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 5
            size: 24 24
            virtual: true

          Label
            id: iconStatsHealingLabel
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 34
            !text: tr('Healing')
            font: $var-cip-font
            color: $var-text-cip-color
            text-auto-resize: true
            width: 120

          HelperCheckBox
            id: iconStatsHealing
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 159
            size: 20 20
            @onCheckChange: modules.game_helper.onIconStatsVisibilityChange('healingIcon', self:isChecked())
            change-cursor-image: false

          HelperButton
            id: iconStatsHealingSetKey
            text-horizontal-auto-resize: true
            height: 20
            anchors.left: iconStatsHealing.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 8
            margin: 2
            !text: tr('Set Key')
            @onClick: modules.game_helper.editIconStatsKeybind('Toggle Healing')

          Label
            id: iconStatsHealingKeyLabel
            anchors.left: iconStatsHealingSetKey.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 8
            !text: tr('')
            font: $var-cip-font
            color: $var-text-cip-color-grey
            text-auto-resize: true

          UIWidget
            size: 12 12
            anchors.verticalCenter: iconStatsHealingLabel.verticalCenter
            anchors.right: parent.right
            margin-right: 10
            image-source: /mods/game_wheel/images/icon_info.png
            !tooltip: tr('Toggle auto healing on/off')

        Panel
          id: iconStatsHealFriendRow
          anchors.top: iconStatsHealingRow.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 28
          layout:
            type: anchor

          Item
            id: iconStatsHealFriendRowIcon
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 5
            size: 24 24
            virtual: true

