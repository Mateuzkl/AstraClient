            color: $var-text-cip-color
            text-auto-resize: true
            width: 120

          HelperCheckBox
            id: iconStatsEquipment
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 159
            size: 20 20
            @onCheckChange: modules.game_helper.onIconStatsVisibilityChange('equipmentIcon', self:isChecked())
            change-cursor-image: false

          HelperButton
