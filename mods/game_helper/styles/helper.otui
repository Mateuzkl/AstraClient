    HelperCheckBox
      id: enableEnergyRing
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 8
      margin-top: 28
      !text: tr("Auto Energy Ring")
      text-auto-resize: true
      font: $var-cip-font
