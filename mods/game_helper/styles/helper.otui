ExerciseStaminaSettingsWindow < NewMainWindow
  id: exerciseStaminaSettingsWindow
  !text: tr('Exercise Training - Stamina')
  size: 400 200
  font: $var-cip-font
  color: $var-text-cip-color-white
  text-offset: 0 1
  @onEscape: self:destroy()

  Panel
    id: settingsPanel
    anchors.fill: parent
    anchors.bottom: buttonOk.top
    padding: 10
    margin-bottom: 5
    margin-top: 2

    UIWidget
      id: titleLabel
      font: $var-cip-font
      !text: tr('Gates only the NEXT exercise use.\nDoes not interrupt the current one. 0 = ignore.')
      text-wrap: true
      text-auto-resize: true
      phantom: true
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-left: 5
      margin-right: 5
      color: $var-text-cip-color

    HorizontalSeparator
      id: titleSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: titleLabel.bottom
      margin-top: 3

    UIWidget
      id: minStaminaLabel
      font: $var-cip-font
      !text: tr('Min stamina (hours):')
      text-align: left
      phantom: true
      anchors.top: titleSeparator.bottom
      anchors.left: parent.left
      margin-top: 12
      margin-left: 5
      color: $var-text-cip-color

    HelperTextEdit
      id: minStaminaHours
      size: 55 20
      anchors.right: minStaminaHelp.left
      anchors.verticalCenter: minStaminaLabel.verticalCenter
      margin-right: 5
      padding-top: 3
      color: $var-text-cip-color-white
      text-align: center
      only-number: true
      max-length: 2
      @onTextChange: modules.game_helper.validatePercentInput(self, 0, 42, 0)
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" then
            self:setText("0")
          end
        end

    UIWidget
      id: minStaminaHelp
      anchors.right: parent.right
      anchors.verticalCenter: minStaminaLabel.verticalCenter
      color: $var-text-cip-color
      image-source: /images/icons/show_gui_help_grey
      size: 12 12
      margin-right: 15
      !tooltip: tr('Skip the NEXT exercise use when stamina is AT OR\nABOVE this value (hours). The exercise already in\nprogress is not interrupted. 0 = ignore.')

    UIWidget
      id: maxStaminaLabel
      font: $var-cip-font
      !text: tr('Max stamina (hours):')
      text-align: left
      phantom: true
      anchors.top: minStaminaLabel.bottom
      anchors.left: parent.left
      margin-top: 12
      margin-left: 5
      color: $var-text-cip-color

    HelperTextEdit
      id: maxStaminaHours
      size: 55 20
      anchors.right: maxStaminaHelp.left
      anchors.verticalCenter: maxStaminaLabel.verticalCenter
      margin-right: 5
      padding-top: 3
      color: $var-text-cip-color-white
      text-align: center
      only-number: true
      max-length: 2
      @onTextChange: modules.game_helper.validatePercentInput(self, 0, 42, 0)
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" then
            self:setText("0")
          end
        end

    UIWidget
      id: maxStaminaHelp
      anchors.right: parent.right
      anchors.verticalCenter: maxStaminaLabel.verticalCenter
      color: $var-text-cip-color
      image-source: /images/icons/show_gui_help_grey
      size: 12 12
      margin-right: 15
      !tooltip: tr('Skip the NEXT exercise use when stamina is AT OR\nABOVE this value (hours). The exercise already in\nprogress is not interrupted. 0 = ignore.')

  HelperButton
    id: buttonOk
    anchors.bottom: parent.bottom
    anchors.right: buttonCancel.left
    margin: 2
    margin-bottom: 10
    margin-right: 5
    !text: tr('OK')
    @onClick: modules.game_helper.saveExerciseStaminaSettings()

  HelperButton
    id: buttonCancel
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin: 2
    margin-bottom: 10
    margin-right: 8
    !text: tr('Cancel')
    @onClick: self:getParent():destroy()

ExetaResSettingsWindow < NewMainWindow
  id: exetaResSettingsWindow
  !text: tr('Exeta Res - Settings')
  size: 400 160
  font: $var-cip-font
  color: $var-text-cip-color-white
  text-offset: 0 1
  @onEscape: self:destroy()

  Panel
    id: settingsPanel
    anchors.fill: parent
    anchors.bottom: buttonOk.top
    padding: 10
    margin-bottom: 5
    margin-top: 2

    UIWidget
      id: titleLabel
      font: $var-cip-font
      !text: tr('Configure Exeta Res Conditions')
      text-horizontal-auto-resize: true
      phantom: true
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 5
      color: $var-text-cip-color

    HorizontalSeparator
      id: titleSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: titleLabel.bottom
      margin-top: 3

    UIWidget
      id: minMobsLabel
      font: $var-cip-font
      !text: tr('Min Mobs Around (1-9):')
      text-align: left
      phantom: true
      anchors.top: titleSeparator.bottom
      anchors.left: parent.left
      margin-top: 8
      margin-left: 5
      color: $var-text-cip-color

    HelperTextEdit
      id: minMobs
      size: 55 20
      anchors.right: minMobsHelp.left
      anchors.verticalCenter: minMobsLabel.verticalCenter
      margin-right: 5
      padding-top: 3
      color: $var-text-cip-color-white
      text-align: center
      only-number: true
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" then
            self:setText("1")
            return
          end
          local value = tonumber(text)
          if not value or value < 1 or value > 9 then
            self:setText("1")
          end
        end

    UIWidget
      id: minMobsHelp
      anchors.right: parent.right
      anchors.verticalCenter: minMobsLabel.verticalCenter
      color: $var-text-cip-color
      image-source: /images/icons/show_gui_help_grey
      size: 12 12
      margin-right: 15
      tooltip: Minimum number of monsters around to cast Exeta Res.

  HelperButton
    id: buttonOk
    anchors.bottom: parent.bottom
    anchors.right: buttonCancel.left
    margin: 2
    margin-bottom: 10
    margin-right: 5
    !text: tr('OK')
    @onClick: modules.game_helper.saveExetaResSettings()

  HelperButton
    id: buttonCancel
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin: 2
    margin-bottom: 10
    margin-right: 8
    !text: tr('Cancel')
    @onClick: self:getParent():destroy()

