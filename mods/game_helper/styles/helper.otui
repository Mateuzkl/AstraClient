ProfilesPanel < Panel
  layout:
    type: verticalBox
    fit-children: true

  Panel
    id: profilesMainPanel
    height: 413
    image-source: /images/ui/login/login_frame
    image-border: 12

    Label
      id: profilesTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      !text: tr('Profiles')
      !tooltip: tr('Manage helper profiles.')
      font: verdana-11px-monochrome
      color: #808080
      text-auto-resize: true

    Label
      id: loadedProfileLabel
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      !text: tr('Loaded: None')
      !tooltip: tr('Currently loaded profile (applied settings).')
      font: verdana-11px-monochrome
      color: #4CAF50
      text-auto-resize: true

    Label
      id: selectedProfileLabel
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Selected: None')
      !tooltip: tr('Profile selected in the list. Use Load to apply it.')
      font: verdana-11px-monochrome
      color: #808080
      text-auto-resize: true

    Panel
      id: profilesButtonsPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      margin-top: 5
      margin-left: 10
      margin-right: 10
      layout:
        type: anchor

      HelperButton
        id: newProfileButton
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        width: 62
        !text: tr('New')
        !tooltip: tr('Clear all helper settings to start from scratch (does not delete saved profiles).')
        @onClick: modules.game_helper.confirmNewProfile()

      HelperButton
        id: loadProfileButton
        anchors.top: parent.top
        anchors.left: newProfileButton.right
        anchors.bottom: parent.bottom
        width: 62
        margin-left: 5
        !text: tr('Load')
        !tooltip: tr('Load the selected profile into the helper for viewing/cloning. Does NOT auto-save over it.')
        @onClick: modules.game_helper.loadSelectedProfile()

      HelperButton
        id: cloneProfileButton
        anchors.top: parent.top
        anchors.left: loadProfileButton.right
        anchors.bottom: parent.bottom
        width: 62
        margin-left: 5
        !text: tr('Clone')
        !tooltip: tr('Clone the selected profile under a new name (does not change the source).')
        @onClick: modules.game_helper.cloneSelectedProfile()

      HelperButton
        id: saveProfileButton
        anchors.top: parent.top
        anchors.left: cloneProfileButton.right
        anchors.bottom: parent.bottom
        width: 62
        margin-left: 5
        !text: tr('Save')
        !tooltip: tr('Save the current helper settings as a profile.')
        @onClick: modules.game_helper.saveCurrentProfile()

      HelperButton
        id: restoreProfileButton
        anchors.top: parent.top
        anchors.left: saveProfileButton.right
        anchors.bottom: parent.bottom
        width: 70
        margin-left: 5
        !text: tr('Restore')
        !tooltip: tr('Restore an older version of the selected profile from .bak.1 / .bak.2 / .bak.3')
        @onClick: modules.game_helper.openRestoreProfileDialog()

      HelperButton
        id: deleteProfileButton
        anchors.top: parent.top
        anchors.left: restoreProfileButton.right
        anchors.bottom: parent.bottom
        width: 62
        margin-left: 5
        !text: tr('Delete')
        !tooltip: tr('Delete the selected profile from disk. Goes to .trash for 7 days (recoverable).')
        @onClick: modules.game_helper.deleteSelectedProfile()

      HelperButton
        id: openFolderButton
        anchors.top: parent.top
        anchors.left: deleteProfileButton.right
        anchors.bottom: parent.bottom
        width: 88
        margin-left: 5
        !text: tr('Open Folder')
        !tooltip: tr('Open the profiles folder on disk.')
        @onClick: modules.game_helper.openProfilesFolder()

      HelperButton
        id: reloadProfilesButton
        anchors.top: parent.top
        anchors.left: openFolderButton.right
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 5
        !text: tr('Reload')
        !tooltip: tr('Reload profiles from disk and refresh the list.')
        @onClick: modules.game_helper.reloadProfilesList()

    Panel
      id: profilesListsContainer
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 5 10 10 10
      layout:
        type: anchor

      Label
        id: profilesNameListTitle
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 140
        !text: tr('Character Profiles')
        font: verdana-11px-monochrome
        color: #808080
        text-auto-resize: true

      Label
        id: profilesVocationListTitle
        anchors.top: parent.top
        anchors.right: parent.right
        margin-right: 30
        !text: tr('Vocation Profiles')
        font: verdana-11px-monochrome
        color: #808080
        text-auto-resize: true

      UIWidget
        id: profilesSpacer
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-left: 100
        width: 1
        phantom: true

      TextList
        id: profilesListBox
        anchors.top: profilesNameListTitle.bottom
        anchors.left: parent.left
        anchors.right: profilesSpacer.left
        anchors.bottom: parent.bottom
        margin-top: 3
        margin-right: 5
        vertical-scrollbar: profilesListScrollBar
        background-color: #00000040
        padding: 0
        !tooltip: tr('Left-click to select. Right-click for import options.')

      HelperScrollBar
        id: profilesListScrollBar
        anchors.top: profilesListBox.top
        anchors.bottom: profilesListBox.bottom
        anchors.right: profilesListBox.right
        step: 18
        pixels-scroll: true

      TextList
        id: profilesVocationListBox
        anchors.top: profilesVocationListTitle.bottom
        anchors.left: profilesSpacer.right
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 3
        margin-left: 5
        vertical-scrollbar: profilesVocationScrollBar
        background-color: #00000040
        padding: 0
        !tooltip: tr('Vocation profiles (1 per vocation). Named global-<vocation>.')

      HelperScrollBar
        id: profilesVocationScrollBar
        anchors.top: profilesVocationListBox.top
        anchors.bottom: profilesVocationListBox.bottom
        anchors.right: profilesVocationListBox.right
        step: 18
        pixels-scroll: true

  Panel
    id: autoLoadProfilePanel
    height: 160
    margin-top: 7
    image-source: /images/ui/login/login_frame
    image-border: 12

    Label
      id: autoLoadTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      !text: tr('Auto Load & Save Profile')
      !tooltip: tr('Configure automatic profile loading on login and auto-saving while playing.')
      font: verdana-11px-monochrome
      color: #808080
      text-auto-resize: true

    HelperCheckBox
      id: enableAutoLoadProfile
      width: 200
      anchors.top: prev.bottom
      anchors.left: parent.left
      !text: tr('Enable Auto Load')
      !tooltip: tr('Automatically load a profile when you log in.')
      margin-left: 10
      margin-top: 10
      font: verdana-11px-monochrome
      color: #c0c0c0
      @onCheckChange: modules.game_helper.onEnableAutoLoadProfile(self:isChecked())
      change-cursor-image: false
      $hover !disabled:
        color: #c0c0c0

    HelperCheckBox
      id: autoLoadByName
      width: 200
      anchors.top: prev.bottom
      anchors.left: parent.left
      !text: tr('By Character Name')
      !tooltip: tr('Load the profile that matches your character name.')
      margin-left: 10
      margin-top: 8
      font: verdana-11px-monochrome
      color: #c0c0c0
      @onCheckChange: modules.game_helper.onAutoLoadByNameChange(self:isChecked())
      change-cursor-image: false
      $hover !disabled:
        color: #c0c0c0

    HelperCheckBox
      id: autoLoadByVocation
      width: 200
      anchors.top: autoLoadByName.bottom
      anchors.left: parent.left
      !text: tr('By Vocation')
      !tooltip: tr('Load the vocation profile named global-<vocation>.')
      margin-left: 10
      margin-top: 5
      font: verdana-11px-monochrome
      color: #c0c0c0
      @onCheckChange: modules.game_helper.onAutoLoadByVocationChange(self:isChecked())
      change-cursor-image: false
      $hover !disabled:
        color: #c0c0c0

    HelperCheckBox
      id: enableAutoSaveProfile
      width: 200
      anchors.top: enableAutoLoadProfile.top
      anchors.left: enableAutoLoadProfile.left
      !text: tr('Enable Auto Save')
      !tooltip: tr('Automatically save your profile whenever you change a setting.')
      margin-left: 360
      margin-top: 0
      font: verdana-11px-monochrome
      color: #c0c0c0
      @onCheckChange: modules.game_helper.onEnableAutoSaveProfile(self:isChecked())
      change-cursor-image: false
      $hover !disabled:
        color: #c0c0c0

    Label
      id: lastSaveInfoLabel
      anchors.top: enableAutoSaveProfile.bottom
      anchors.left: enableAutoSaveProfile.left
      margin-top: 14
      margin-left: 18
      !text: tr('Last save: never this session')
      !tooltip: tr('Time of the last successful profile save.')
      font: verdana-11px-monochrome
      color: #808080
      text-auto-resize: true

HeadlessWindow
  id: helperWindow
  anchors.centerIn: parent
  size: 780 700
  minimum-size: 780 700
  image-source: /images/ui/login/login_frame
  image-border: 16
  layout:
    type: verticalBox
    fit-children: true
  @onEscape: hide()

  UIWidget
    height: 64
    margin-top: 5
    phantom: true

    UIWidget
      id: header
      anchors.centerIn: parent
      size: 123 63
      phantom: true
      image-source: /images/helper/amonot
      image-smooth: true

  UIWidget
    height: 60
    phantom: true

    Label
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 8
      margin-left: 13
      !text: tr('Helper Status:')
      font: verdana-11px-monochrome
      color: #c0c0c0
      text-auto-resize: true

    Label
      id: helperStatusLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-left: 13
      margin-top: 2
      !text: tr('Status')
      font: verdana-11px-monochrome
      color: #c0c0c0
      text-auto-resize: true

    UIButton
      id: helperStatus
      size: 12 9
      anchors.bottom: prev.bottom
      anchors.left: prev.right
      margin-left: 5
      margin-bottom: 2
      image-source: /images/store/icon-yes
      @onClick: botStatus()
      !tooltip: tr(' - Helper Status: [ENABLED]')

    Label
      id: currentProfileLabel
      anchors.top: helperStatusLabel.bottom
      anchors.left: parent.left
      margin-left: 13
      margin-top: 5
      !text: tr('Profile: None')
      font: verdana-11px-monochrome
      color: #808080
      text-auto-resize: true

    UIButton
      id: close
      anchors.top: parent.top
      anchors.right: parent.right
      margin-right: 14
      margin-top: 3
      size: 32 32
      image-source: /images/ui/login/login_frame
      image-border: 8
      background-color: #0f0f13d0
      text: X
      font: verdana-11px-monochrome
      color: #cc4444
      text-align: center
      text-offset: 0 -1
      @onClick: hide()
      !tooltip: tr('Close')
      $hover !disabled:
        background-color: #16161bdc
        color: #ff5555
      $pressed:
        background-color: #09090ccc
        color: #aa3333
        text-offset: 1 1

    UIButton
      id: iconStats
      anchors.top: parent.top
      anchors.right: close.left
      margin-right: 3
      margin-top: 3
      size: 32 32
      image-source: /images/ui/login/login_frame
      image-border: 8
      background-color: #0f0f13d0
      text: |||
      font: verdana-11px-monochrome
      color: #a0a0a0
      text-align: center
      text-offset: 0 -1
      @onClick: modules.game_helper.toggleIconStats()
      !tooltip: tr('Toggle Icon Stats')
      $hover !disabled:
        background-color: #16161bdc
        color: #d8d8e0
      $pressed:
        background-color: #09090ccc
        color: #909098
        text-offset: 1 1

    HelperComboBox
      id: mainLanguageCombo
      anchors.top: iconStats.bottom
      anchors.right: close.right
      margin-top: 10
      margin-right: -1
      size: 66 20
      color: #c0c0c0
      text-offset: -5 2
      @onOptionChange: modules.game_helper.onHelperLanguageChange(self)

  Panel
    id: contentPanel
    height: 580
    margin: 0 13 17 13
    
    Panel
      id: sideMenu
      width: 130
      height: 580
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 12
      margin-left: 0
      padding: 6
      image-source: /images/ui/login/login_frame
      image-border: 12
      layout:
        type: anchor
      
      Panel
        id: sideMenuButtons
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: antiBotModeButton.top
        layout:
          type: verticalBox
          spacing: 2
      
        HelperButton
          id: healingMenu
          text: Healing
          margin: 2
          @onClick: loadMenu('healingMenu')

        HelperButton
          id: friendMenu
          text: Heal Friend
          margin: 2
          @onClick: loadMenu('friendMenu')

        HelperButton
          id: toolsMenu
          text: Tools
          margin: 2
          @onClick: loadMenu('toolsMenu')

        HelperButton
          id: equipmentMenu
          text: Equipment
          margin: 2
          @onClick: loadMenu('equipmentMenu')

        HelperButton
          id: huntingMenu
          text: Hunting
          margin: 2
          @onClick: loadMenu('huntingMenu')

        HelperButton
          id: profilesMenu
          text: Profiles
          margin: 2
          @onClick: loadMenu('profilesMenu')

        HelperButton
          id: settingsMenu
          text: Settings
          margin: 2
          @onClick: loadMenu('settingsMenu')

      AntiBotModeButton
        id: antiBotModeButton
        text: AntiBot Mode
        margin: 2
        anchors.bottom: saveCurrentProfileButton.top
        anchors.left: parent.left
        anchors.right: parent.right
        @onClick: modules.game_antibot.antibot.toggleAntibotMode()

      HelperButton
        id: saveCurrentProfileButton
        text: Quick Save
        margin: 2
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        @onClick: modules.game_helper.saveCurrentProfileQuick()

    Panel
      id: mainContent
      anchors.top: parent.top
      anchors.left: sideMenu.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 12
      margin-left: 5
      layout:
        type: verticalBox
        
      HealingPanel
        id: healingPanel
        visible: false

      ToolsPanel
        id: toolsPanel
        visible: false

      HuntingPanel
        id: huntingPanel
        visible: false

      EquipmentPanel
        id: equipmentPanel
        visible: false

      FriendHealPanel
        id: friendHealPanel
        visible: false

      ProfilesPanel
        id: profilesPanel
        visible: false

      SettingsPanel
        id: settingsPanel
        visible: false

ActionAssignWindow < NewMainWindow
  id: actionAssignWindow
  size: 300 150
  !text: tr('Assign Hotkey')
  @onEscape: self:destroy()
  
  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 12
    
    Label
      id: instructionLabel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 15 15 40 15
      text-align: center
      font: verdana-11px-monochrome
      color: #c0c0c0
      !text: tr('Press any key to assign...')
      multiline: true
      word-wrap: true

    Label
      id: warning
      anchors.top: instructionLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 10 20 40 20
      text-align: center
      font: verdana-11px-monochrome
      color: #ff6666
      visible: false
      multiline: true
      word-wrap: true
      !text: tr('')
      
    HelperButton
      id: buttonOk
      anchors.bottom: parent.bottom
      anchors.right: parent.horizontalCenter
      margin: 2
      margin-right: 5
      !text: tr('OK')
      enabled: false
      
    HelperButton
      id: buttonCancel
      anchors.bottom: parent.bottom
      anchors.left: parent.horizontalCenter
      margin: 2
      margin-left: 5
      !text: tr('Cancel')

