          @onOptionChange: modules.game_helper.onWindowOpacityChange(self)

        UIWidget
          size: 12 12
          anchors.verticalCenter: parent.verticalCenter
          anchors.right: parent.right
          margin-right: 10
          image-source: /mods/game_wheel/images/icon_info.png
          !tooltip: tr('Change the opacity/transparency of all helper windows.\nLower values make windows more transparent.')

    Panel
      id: settingsIconStatsContent
      anchors.top: settingsSubTabBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      visible: false
      layout:
        type: anchor

      Panel
