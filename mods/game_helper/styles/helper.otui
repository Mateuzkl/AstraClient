    id: buttonOk
    anchors.bottom: parent.bottom
    anchors.right: buttonCancel.left
    margin: 2
    margin-bottom: 10
    margin-right: 5
    !text: tr('OK')
    @onClick: modules.game_helper.saveExetaResSettings()

  HelperButton
    id: buttonCancel
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin: 2
    margin-bottom: 10
    margin-right: 8
