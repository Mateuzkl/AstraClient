        font: verdana-11px-monochrome
        color: #c0c0c0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onEnableUH(self, self:isChecked())
      HelperCheckBox
        id: enablePartyUHHeal
        width: 100
        anchors.top: enableUH0.bottom
        anchors.left: parent.left
