      anchors.right: minMobsHelp.left
      anchors.verticalCenter: minMobsLabel.verticalCenter
      margin-right: 5
      padding-top: 3
      color: #e8e8f0
      text-align: center
      only-number: true
      @onTextChange: modules.game_helper.validatePercentInput(self, 0, 99, 0)
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" then
            self:setText("0")
          end
        end

    UIWidget
      id: minMobsHelp
      anchors.right: parent.right
      anchors.verticalCenter: minMobsLabel.verticalCenter
      color: #C0C0C0
