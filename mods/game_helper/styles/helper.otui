    image-border: 12
    enabled: true
    visible: false

    Label
      id: shieldTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Magic Shield Helper')
      font: verdana-11px-monochrome
      color: #808080
      text-auto-resize: true

    HelperCheckBox
      id: utamoVita
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 8
      margin-top: 30
      !text: tr("Auto Utamo")
      text-auto-resize: true
      font: verdana-11px-monochrome
      color: #c0c0c0
      @onCheckChange: toggleUtamoVita(self, self:isChecked())

    UIWidget
      id: utamoVitaIcon
      size: 18 18
      image-size: 18 18
      anchors.left: exanaVita.right
      anchors.verticalCenter: utamoVita.verticalCenter
      margin-left: 6
      focusable: false
      phantom: true

    HelperSettingsButton
      id: utamoVitaSettingsBtn
      anchors.verticalCenter: utamoVita.verticalCenter
      anchors.left: exanaVitaIcon.right
      margin-left: 5
      @onClick: modules.game_helper.openUtamoVitaSettings()

    HelperTextEdit
      id: utamoPercentInput0
      size: 55 20
      anchors.verticalCenter: utamoVita.verticalCenter
      anchors.right: parent.right
      margin-right: 10
