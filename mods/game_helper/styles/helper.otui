ShooterPanel < Panel
  layout:
    type: verticalBox
    fit-children: true
  Panel
    id: shooterMainPanel
    height: 35
    background-color: #3f3f3f
    border-width: 1
    Label
      id: shooterMainTitle
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 8
      margin-left: 15
      !text: tr('Shooter Helper')
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true
    HelperCheckBox
      id: enableShooterModule
      width: 100
      anchors.top: parent.top
      anchors.right: parent.right
      !text: tr('Enable')
      margin-top: 8
      margin-right: 10
      font: $var-cip-font
      color: $var-text-cip-color
      change-cursor-image: false
      $hover !disabled:
        color: $var-text-cip-color
      @onCheckChange: modules.game_helper.onEnableShooterModule(self:isChecked())

  Panel
    id: presetsPanel
    height: 76
    background-color: #3f3f3f
    border-width: 1
    padding: 3
    HelperComboBox
      id: presets
      size: 180 20
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 2
      margin-top: 3
      color: $var-text-cip-color
      text-offset: -5 2
      @onOptionChange: toggleShooterPreset(self)
    UIButton
      id: copyPresetButton
      size: 20 20
      anchors.top: presets.bottom
      anchors.left: presets.left
      margin-top: 4
      image-source: /images/helper/copy.png
      image-clip: 0 0 20 20
      $pressed:
        image-clip: 20 0 20 20
      !tooltip: tr('Copy config from another preset to the current preset.')
      @onClick: copyShooterPresetToCurrent(self)
    Label
      id: prevPresetKeyLabel
      anchors.top: parent.top
      anchors.right: parent.right
      margin-right: 5
      margin-top: 3
      width: 45
      !text: tr('None')
      font: $var-cip-font
      color: $var-text-cip-color-grey
    HelperButton
      id: prevPresetSetKey
      text-horizontal-auto-resize: true
      height: 20
      anchors.top: parent.top
      anchors.right: prevPresetKeyLabel.left
      margin-top: 3
      margin-right: 5
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to switch to the previous preset.')
      @onClick: modules.game_helper.editIconStatsKeybind('Previous Shooter Preset')
    Label
      id: prevPresetLabel
      anchors.top: parent.top
      anchors.right: prevPresetSetKey.left
      margin-right: 6
      margin-top: 3
      width: 58
      !text: tr('Previous')
      font: $var-cip-font
      color: $var-text-cip-color
    HelperButton
      id: rmvPresetButton
      size: 75 20
      anchors.top: copyPresetButton.top
      anchors.left: copyPresetButton.right
      margin-left: 5
      !text: tr('Clear')
      !tooltip: tr('Clear the current preset.')
      @onClick: removeProfile()
    HelperButton
      id: renameButton
      size: 75 20
      anchors.top: rmvPresetButton.top
      anchors.left: rmvPresetButton.right
      margin-left: 7
      !text: tr('Rename')
      !tooltip: tr('Rename the current preset.')
      @onClick: sendRenameOrAddWindow(true)
    Label
      id: nextPresetKeyLabel
      anchors.top: rmvPresetButton.top
      anchors.right: parent.right
      margin-right: 5
      margin-top: 2
      width: 45
      !text: tr('None')
      font: $var-cip-font
      color: $var-text-cip-color-grey
    HelperButton
      id: nextPresetSetKey
      text-horizontal-auto-resize: true
      height: 20
      anchors.top: rmvPresetButton.top
      anchors.right: nextPresetKeyLabel.left
      margin-right: 5
      margin-top: 1
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to switch to the next preset.')
      @onClick: modules.game_helper.editIconStatsKeybind('Next Shooter Preset')
    Label
      id: nextPresetLabel
      anchors.top: rmvPresetButton.top
      anchors.right: nextPresetSetKey.left
      margin-right: 6
      margin-top: 2
      width: 30
      !text: tr('Next')
      font: $var-cip-font
      color: $var-text-cip-color
    Label
      id: activatePresetKeyLabel
      anchors.top: rmvPresetButton.top
      anchors.right: nextPresetLabel.left
      margin-right: 48
      margin-top: 2
      width: 45
      !text: tr('None')
      font: $var-cip-font
      color: $var-text-cip-color-grey
    HelperButton
      id: activate
      height: 20
      text-horizontal-auto-resize: true
      anchors.top: rmvPresetButton.top
      anchors.right: activatePresetKeyLabel.left
      margin-right: 5
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to activate this preset directly.')
      @onClick: modules.game_helper.editPresetActivateKeybind('shooter')
    Label
      id: shooterActivatePresetTitleLabel
      anchors.bottom: activate.top
      anchors.left: activate.left
      margin-bottom: 10
      !text: tr('Activate Preset:')
      font: $var-cip-font
      color: $var-text-cip-color

    HelperButton
      id: saveButton
      size: 120 20
      visible: false
      anchors.top: presets.top
      anchors.right: parent.right
      !text: tr('New Preset')
      image-source: /images/ui/buttons-blue
      margin: 2
      margin-right: 5
      !tooltip: tr('Create a new preset.')
      @onClick: sendRenameOrAddWindow(false)

  Panel
    id: shooterRulesPanel
    height: 471
    margin-top: 5
    background-color: #3f3f3f
    border-width: 1

    Label
      id: shooterPanelTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      !text: tr('Magic Shooter Helper')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true

    Panel
      id: enableButtons
      anchors.top: shooterPanelTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 20
      margin-top: 7

      HelperCheckBox
        id: enableMagicShooter
        width: 130
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        !text: tr('Enable')
        margin-left: 5
        font: $var-cip-font
        color: $var-text-cip-color
        @onCheckChange: toggleMagicShooter(self)
        change-cursor-image: false
        $hover !disabled:
          color: $var-text-cip-color

      UIWidget
        id: attackCdDebugIcon
        size: 20 20
        image-size: 20 20
        image-source: /images/game/spells/cooldowns
        image-clip: 0 0 20 20
        anchors.left: enableMagicShooter.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        focusable: false
        !tooltip: tr('Attack Cooldown (debug)')
        $on:
          image-clip: 0 20 20 20

        UIProgressRect
          id: attackCdDebugProgress
          anchors.fill: parent
          background: #585858AA
          percent: 100
          focusable: false

      UIWidget
        id: healingCdDebugIcon
        size: 20 20
        image-size: 20 20
        image-source: /images/game/spells/cooldowns
        image-clip: 20 0 20 20
        anchors.left: attackCdDebugIcon.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        focusable: false
        !tooltip: tr('Healing Cooldown (debug)')
        $on:
          image-clip: 20 20 20 20

        UIProgressRect
          id: healingCdDebugProgress
          anchors.fill: parent
          background: #585858AA
          percent: 100
          focusable: false

      UIWidget
        id: supportCdDebugIcon
        size: 20 20
        image-size: 20 20
        image-source: /images/game/spells/cooldowns
        image-clip: 40 0 20 20
        anchors.left: healingCdDebugIcon.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        focusable: false
        !tooltip: tr('Support Cooldown (debug)')
        $on:
          image-clip: 40 20 20 20

        UIProgressRect
          id: supportCdDebugProgress
          anchors.fill: parent
          background: #585858AA
          percent: 100
          focusable: false

      Panel
        id: spellCdDebugPanel
        anchors.left: supportCdDebugIcon.right
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        height: 20
        margin-left: 8
        margin-right: 5
        layout:
          type: horizontalBox
          spacing: 4
        focusable: false

    HorizontalSeparator
      id: separatorShooterRules
      anchors.top: enableButtons.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 5
      margin-right: 5

    Panel
      id: shooterRulesContent
      anchors.top: separatorShooterRules.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 5 5 5 5

      Label
        id: shooterRulesTitle
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Shooter Rules')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

      HelperButton
        id: addShooterRuleButton
        size: 126 20
        anchors.right: parent.right
        anchors.verticalCenter: shooterRulesTitle.verticalCenter
        !text: tr('Add Magic Shooter')
        @onClick: modules.game_helper.openAddShooterRulePopup()

      Panel
        id: shooterRulesHeader
        anchors.top: shooterRulesTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 18
        margin-top: 4
        margin-left: 7
        margin-right: 19
        layout:
          type: anchor

        Label
          id: shooterStateSpacer
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          width: 15
          !text: tr('')
          font: $var-cip-font
          color: $var-text-cip-color

        Label
          id: shooterIdHeader
          anchors.left: shooterStateSpacer.right
          anchors.verticalCenter: parent.verticalCenter
          width: 18
          !text: tr('ID')
          font: $var-cip-font
          color: $var-text-cip-color

        Label
          id: shooterActHeader
          anchors.left: shooterIdHeader.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 4
          width: 34
          !text: tr('Act')
          font: $var-cip-font
          color: $var-text-cip-color

        Label
          id: shooterNameHeader
          anchors.left: shooterActHeader.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 8
          width: 140
          !text: tr('Name')
          font: $var-cip-font
          color: $var-text-cip-color

        Label
          id: shooterRuleHeader
          anchors.left: shooterNameHeader.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 6
          width: 90
          !text: tr('Mobs Amount')
          font: $var-cip-font
          color: $var-text-cip-color

        Label
          id: shooterTargetHeader
          anchors.left: shooterRuleHeader.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 64
          width: 42
          text-align: center
          !text: tr('Target')
          font: $var-cip-font
          color: $var-text-cip-color

        Label
          id: shooterEditHeader
          anchors.right: shooterDelHeader.left
          anchors.verticalCenter: parent.verticalCenter
          margin-right: 2
          width: 20
          !text: tr('')
          font: $var-cip-font
          color: $var-text-cip-color

        Label
          id: shooterDelHeader
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          margin-right: 2
          width: 18
          !text: tr('')
          font: $var-cip-font
          color: $var-text-cip-color

      UIScrollArea
        id: shooterRulesList
        anchors.top: shooterRulesHeader.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 2
        margin-left: 5
        margin-right: 19
        margin-bottom: 5
        layout:
          type: verticalBox
          spacing: 3
        vertical-scrollbar: shooterRulesScroll

      HelperScrollBar
        id: shooterRulesScroll
        anchors.top: shooterRulesHeader.bottom
        anchors.bottom: parent.bottom
        margin-top: 2
        margin-bottom: 5
        anchors.right: parent.right
        margin-right: 5
        width: 12

  Panel
    id: spellPanel
    height: 0
    margin-top: 5
    visible: false
    background-color: #3f3f3f
    border-width: 1
    Label
      id: toolsTitle
