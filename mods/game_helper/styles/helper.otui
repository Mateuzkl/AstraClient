// ========== HELPER DESIGN SYSTEM (entergame-charlist style) ==========

HelperSpellCdIcon < UIWidget
  size: 20 20
  image-size: 20 20
  focusable: false

HelperSpellCdProgress < UIProgressRect
  background: #585858AA
  percent: 100
  focusable: false

// --- Standard Button ---
HelperButton < UIButton
  focusable: false
  font: verdana-11px-monochrome
  text-align: center
  text-offset: 0 0
  height: 28
  image-source: /images/ui/login/login_frame
  image-border: 8
  background-color: #0f0f13d0
  color: #c0c0c0

  $hover !disabled:
    background-color: #16161bdc
    color: #d8d8e0

  $pressed:
    background-color: #09090ccc
    text-offset: 1 1
    color: #909098

  $disabled:
    color: #c0c0c044
    opacity: 0.6

  $checked:
    background-color: #22222af0
    color: #ffffff

AntiBotModeButton < HelperButton
  $on:
    background-color: #1f7a2eee
    color: #eaffe8

  $on $hover:
    background-color: #259138ee
    color: #ffffff

// --- Side Menu Navigation Button ---
HelperSideMenuButton < UIButton
  focusable: false
  font: verdana-11px-monochrome
  text-align: left
  text-offset: 10 0
  height: 26
  image-source: /images/ui/login/login_frame
  image-border: 8
  background-color: #0a0a0fd0
  color: #a0a0a0

  $hover !disabled:
    background-color: #16161bdc
    color: #d8d8e0

  $pressed:
    background-color: #09090ccc
    text-offset: 11 1
    color: #909098

  $checked:
    background-color: #22222af0
    color: #ffffff

  $disabled:
    color: #c0c0c044
    opacity: 0.6

// --- Text Input ---
HelperTextEdit < TextEdit
  font: verdana-11px-monochrome
  color: #c0c0c8
  height: 22
  image-source: /images/ui/login/input
  image-border: 3
  padding-top: 4
  padding-bottom: 3
  padding-left: 6
  padding-right: 6

  $focus:
    image-source: /images/ui/login/input_focused

  $disabled:
    color: #60606088
    opacity: 0.8

// --- ComboBox ---
HelperComboBoxPopupMenuButton < UIButton
  height: 20
  font: verdana-11px-monochrome
  text-align: left
  text-offset: 6 0
  color: #a0a0a0
  background-color: alpha

  $hover !disabled:
    color: #e0e0e0
    background-color: #ffffff12

  $disabled:
    color: #60606088

HelperComboBoxPopupMenu < UIPopupMenu
  background-color: #151518f0
  border-width: 1
  border-color: #c0c0c030
  image-source:
  padding: 2

HelperComboBoxPopupScrollMenuButton < UIButton
  height: 20
  font: verdana-11px-monochrome
  text-align: left
  text-offset: 6 0
  color: #a0a0a0
  background-color: alpha

  $hover !disabled:
    color: #e0e0e0
    background-color: #ffffff12

  $disabled:
    color: #60606088

HelperComboBoxPopupScrollMenu < UIPopupScrollMenu
  background-color: #151518f0
  border-width: 1
  border-color: #c0c0c030
  image-source:
  padding: 2

HelperComboBox < UIComboBox
  font: verdana-11px-monochrome
  color: #c0c0c0
  text-offset: -5 0
  text-align: center
  height: 22
  image-source: /images/ui/login/input
  image-border: 3

  $hover !disabled:
    image-source: /images/ui/login/input_focused

  $on:
    image-source: /images/ui/login/input_focused

  $disabled:
    color: #60606088
    opacity: 0.8

  UIWidget
    id: arrowIcon
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 5
    size: 7 7
    image-source: /images/ui/icon-arrow7x7-down
    phantom: true

// --- Minimal Scrollbar (6px) ---
HelperScrollSlider < UIButton
  id: sliderButton
  anchors.centerIn: parent
  size: 4 32
  minimum: 20
  background-color: #c0c0c040
  border-radius: 2

  $hover:
    background-color: #c0c0c070

  $pressed:
    background-color: #c0c0c090

HelperScrollBar < UIScrollBar
  orientation: vertical
  width: 6
  height: 39
  background-color: #ffffff08
  pixels-scroll: true

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    size: 0 0
    visible: false

  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 0 0
    visible: false

  HelperScrollSlider

// --- Separator (1px line) ---
HelperSeparator < UIWidget
  height: 1
  background-color: #a0a0b040
  phantom: true

// --- Sub-panel Frame ---
HelperSubPanel < Panel
  image-source: /images/ui/login/login_frame
  image-border: 12
  padding: 8

// --- CheckBox (dark premium style) ---
HelperCheckBox < UICheckBox
  height: 12
  text-align: left
  text-offset: 18 1
  text-auto-resize: true
  font: verdana-11px-monochrome
  color: #c0c0c0
  image-source: /images/ui/checkbox-unchecked
  image-color: #b0b0b0
  image-rect: 0 0 12 12
  change-cursor-image: false

  $hover !disabled:
    color: #d8d8e0
    image-color: #d0d0d0

  $!checked:
    image-source: /images/ui/checkbox-unchecked

  $checked !disabled:
    image-source: /images/ui/checkbox-checked
    image-color: #c0c0c0

  $checked disabled:
    image-source: /images/ui/checkbox-checked-disabled
    image-color: #808080

  $disabled:
    color: #c0c0c044
    image-color: #60606088

// --- Icon Button (small, image-only) ---
HelperIconButton < UIButton
  focusable: false
  size: 16 16
  image-color: #b0b0b0

  $hover !disabled:
    image-color: #d8d8e0

  $pressed:
    image-color: #909098

  $disabled:
    image-color: #b0b0b066

// --- Row Remove Button (X) ---
HelperRemoveButton < UIButton
  focusable: false
  size: 20 20
  image-source: /images/ui/login/login_frame
  image-border: 6
  background-color: #0f0f13d0
  text: X
  font: verdana-11px-monochrome
  color: #cc4444
  text-align: center
  text-offset: 0 -1

  $hover !disabled:
    background-color: #16161bdc
    color: #ff5555

  $pressed:
    background-color: #09090ccc
    color: #aa3333
    text-offset: 1 0

  $disabled:
    color: #cc444444
    opacity: 0.6

// --- Row Settings Button ---
HelperSettingsButton < UIButton
  focusable: false
  size: 20 20
  image-source: /images/ui/login/login_frame
  image-border: 6
  background-color: #0f0f13d0
  text: ...
  font: verdana-11px-monochrome
  color: #a0a0a0
  text-align: center
  text-offset: 0 -2

  $hover !disabled:
    background-color: #16161bdc
    color: #d8d8e0

  $pressed:
    background-color: #09090ccc
    color: #909098
    text-offset: 1 -1

  $disabled:
    color: #a0a0a044
    opacity: 0.6

// ========== END HELPER DESIGN SYSTEM ==========

PlayerName < Label
  focusable: true
  height: 15
  font: verdana-11px-monochrome
  color: #808080

  $focus:
    background-color: #ffffff18
    color: #f4f4f4
  $!focus:
    background-color: alpha
    color: #c0c0c0

ProfileListLabel < Label
  height: 18
  background-color: alpha
  text-align: left
  text-offset: 3 0
  color: #C0C0C0
  font: verdana-11px-monochrome
  focusable: true
  &updateOnStates: |
    function(self)
      -- Apply selection background color when focused (mesmo que cavebot list)
      if self:isFocused() then
        self:setBackgroundColor("#ffffff18")
      else
        -- Use base background color when not focused
        if self.baseBackgroundColor then
          self:setBackgroundColor(self.baseBackgroundColor)
        end
      end
    end
  @onFocusChange: |
    self:updateOnStates()
    if self:isFocused() then
      modules.game_helper.onProfileItemFocused(self)
    end

  $focus:
    background-color: #ffffff18

  UIWidget
    id: bottomBorder
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 1
    background-color: #ffffff10
    phantom: true

ListRowLabel < Label
  focusable: true
  height: 18
  font: verdana-11px-monochrome
  color: #c0c0c0
  text-offset: 5 0
  background-color: alpha

  $focus:
    background-color: #ffffff18
    color: #ffffff
  $!focus:
    background-color: alpha
    color: #c0c0c0

PotionItem < UIItem
  size: 32 32
  phantom: true
  draggable: false
  virtual: true
  priceable: false
  anchors.top: parent.top
  anchors.left: parent.left

RuneItem < UIItem
  size: 32 32
  phantom: true
  draggable: false
  virtual: true
  priceable: false
  anchors.top: parent.top
  anchors.left: parent.left

EquipmentItem < UIItem
  size: 32 32
  phantom: true
  draggable: false
  virtual: true
  priceable: false
  anchors.top: parent.top
  anchors.left: parent.left

HelperPreviewItem < UIItem
  size: 18 18
  draggable: false
  virtual: true

EquipmentSwapRuleRow < Panel
  width: 260
  height: 34
  margin-top: 2
  layout:
    type: anchor

  UIButton
    id: statusIcon
    image-auto-resize: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    image-source: /images/helper/disabled

  Label
    id: idLabel
    width: 18
    anchors.left: statusIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    !text: tr('1')
    font: verdana-11px-monochrome
    color: #c0c0c0

  Panel
    id: itemCell
    size: 34 34
    anchors.left: idLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

    UIButton
      id: itemButton
      anchors.fill: parent
      image-source: /images/game/actionbar/slot-actionbar.png

    Label
      id: itemCount
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-right: 2
      margin-bottom: 1
      !text: tr('0')
      font: verdana-7px-rounded
      color: white
      text-border: 1
      text-border-color: #000000
      text-auto-resize: true
      visible: false

  HelperRemoveButton
    id: removeButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2

  HelperSettingsButton
    id: settingsButton
    anchors.right: removeButton.left
    anchors.verticalCenter: removeButton.verticalCenter
    margin-right: 2

  Label
    id: summaryLabel
    anchors.left: itemCell.right
    anchors.right: settingsButton.left
    anchors.verticalCenter: itemCell.verticalCenter
    margin-left: 5
    margin-right: 6
    height: 30
    !text: tr('Equip if ...')
    font: verdana-11px-monochrome
    color: #c0c0c0
    text-wrap: true

HealingPanel < Panel
  layout:
    type: verticalBox
    fit-children: true

  Panel
    id: healingSubTabBar
    height: 24
    visible: false
    layout:
      type: horizontalBox
      spacing: 2

    HelperButton
      id: healingSubTabHealing
      width: 200
      margin-top: 2
      margin-left: 0
      !text: tr('Healing')
      checked: true
      @onClick: modules.game_helper.selectHealingSubTab('healing')

    HelperButton
      id: healingSubTabMagicShield
      width: 200
      margin-top: 2
      !text: tr('Magic Shield')
      visible: false
      @onClick: modules.game_helper.selectHealingSubTab('magicShield')

    HelperButton
      id: healingSubTabEnergyRing
      width: 200
      margin-top: 2
      margin-right: 2
      !text: tr('Energy Ring')
      visible: false
      @onClick: modules.game_helper.selectHealingSubTab('energyRing')

  Panel
    id: healingPresetsPanel
    height: 76
    image-source: /images/ui/login/login_frame
    image-border: 16
    padding: 3
    HelperComboBox
      id: healingPresets
      size: 180 20
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 2
      margin-top: 3
      color: #c0c0c0
      text-offset: -5 2
      @onOptionChange: toggleHealingPreset(self)
    UIButton
      id: healingCopyPresetButton
      size: 20 20
      anchors.top: healingPresets.bottom
      anchors.left: healingPresets.left
      margin-top: 4
      image-source: /images/helper/copy.png
      image-clip: 0 0 20 20
      $pressed:
        image-clip: 20 0 20 20
      !tooltip: tr('Copy config from another preset to the current preset.')
      @onClick: copyHealingPresetToCurrent(self)
    Label
      id: healingPrevPresetKeyLabel
      anchors.top: parent.top
      anchors.right: parent.right
      margin-right: 5
      margin-top: 3
      width: 45
      !text: tr('None')
      font: verdana-11px-monochrome
      color: #808080
    HelperButton
      id: healingPrevPresetSetKey
      size: 55 24
      anchors.top: parent.top
      anchors.right: healingPrevPresetKeyLabel.left
      margin-right: 5
      margin-top: 3
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to switch to the previous preset.')
      @onClick: modules.game_helper.editIconStatsKeybind('Previous Healing Preset')
    Label
      id: healingPrevPresetLabel
      anchors.top: parent.top
      anchors.right: healingPrevPresetSetKey.left
      margin-right: 6
      margin-top: 3
      width: 50
      !text: tr('Previous')
      font: verdana-11px-monochrome
      color: #c0c0c0
    HelperButton
      id: healingRmvPresetButton
      size: 75 24
      anchors.top: healingCopyPresetButton.top
      anchors.left: healingCopyPresetButton.right
      margin-left: 5
      !text: tr('Clear')
      !tooltip: tr('Clear the current preset.')
      @onClick: removeHealingPreset()
    HelperButton
      id: healingRenameButton
      size: 75 24
      anchors.top: healingRmvPresetButton.top
      anchors.left: healingRmvPresetButton.right
      margin-left: 7
      !text: tr('Rename')
      !tooltip: tr('Rename the current preset.')
      @onClick: sendHealingRenameOrAddWindow(true)
    Label
      id: healingNextPresetKeyLabel
      anchors.top: healingRmvPresetButton.top
      anchors.right: parent.right
      margin-right: 5
      margin-top: 2
      width: 45
      !text: tr('None')
      font: verdana-11px-monochrome
      color: #808080
    HelperButton
      id: healingNextPresetSetKey
      size: 55 24
      anchors.top: healingRmvPresetButton.top
      anchors.right: healingNextPresetKeyLabel.left
      margin-right: 5
      margin-top: 1
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to switch to the next preset.')
      @onClick: modules.game_helper.editIconStatsKeybind('Next Healing Preset')
    Label
      id: healingNextPresetLabel
      anchors.top: healingRmvPresetButton.top
      anchors.right: healingNextPresetSetKey.left
      margin-right: 6
      margin-top: 2
      width: 30
      !text: tr('Next')
      font: verdana-11px-monochrome
      color: #c0c0c0
    Label
      id: healingActivatePresetKeyLabel
      anchors.top: healingRmvPresetButton.top
      anchors.right: healingNextPresetLabel.left
      margin-right: 48
      margin-top: 2
      width: 45
      !text: tr('None')
      font: verdana-11px-monochrome
      color: #808080
    HelperButton
      id: healingActivatePresetSetKey
      size: 55 24
      anchors.top: healingRmvPresetButton.top
      anchors.right: healingActivatePresetKeyLabel.left
      margin-right: 5
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to activate this preset directly.')
      @onClick: modules.game_helper.editPresetActivateKeybind('healing')
    Label
      id: healingActivatePresetTitleLabel
      anchors.bottom: healingActivatePresetSetKey.top
      anchors.left: healingActivatePresetSetKey.left
      margin-bottom: 10
      !text: tr('Activate Preset:')
      font: verdana-11px-monochrome
      color: #c0c0c0

    HelperButton
      id: healingSaveButton
      size: 120 20
      visible: false
      anchors.top: healingPresets.top
      anchors.right: parent.right
      !text: tr('New Preset')
      image-source: /images/ui/buttons-blue
      margin: 2
      margin-right: 5
      !tooltip: tr('Create a new preset.')
      @onClick: sendHealingRenameOrAddWindow(false)

  Panel
    id: healingPanel
    height: 504
    image-source: /images/ui/login/login_frame
    image-border: 12

    Label
      id: title
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      !text: tr('Auto Healing Helper')
      font: verdana-11px-monochrome
      color: #808080
      text-auto-resize: true

    HelperCheckBox
      id: enableAutoHealing
      width: 130
      anchors.top: prev.bottom
      anchors.left: parent.left
      !text: tr('Enable')
      margin-left: 5
      margin-top: 7
      font: verdana-11px-monochrome
      color: #c0c0c0
      change-cursor-image: false
      $hover !disabled:
        color: #c0c0c0
      @onCheckChange: modules.game_helper.onEnableAutoHealing(self:isChecked())

    HorizontalSeparator
      id: separatorAutoHealing
      anchors.top: enableAutoHealing.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 5
      margin-right: 5

    Panel
      id: healingRulesPanel
      anchors.top: separatorAutoHealing.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 5 5 5 5

      Label
        id: healingRulesTitle
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Healing Rules')
        font: verdana-11px-monochrome
        color: #c0c0c0
        text-auto-resize: true

      HelperButton
        id: addHealingRuleButton
        size: 86 20
        anchors.right: parent.right
        anchors.verticalCenter: healingRulesTitle.verticalCenter
        !text: tr('Add Healing')
        @onClick: modules.game_helper.openAddHealingRulePopup()

      HelperButton
        id: importDefaultHealing
        size: 110 20
        anchors.right: addHealingRuleButton.left
        anchors.verticalCenter: addHealingRuleButton.verticalCenter
        margin-right: 5
        !text: tr('Import Default')
        !tooltip: tr('Reset this tab to the default profile for your vocation.')
        @onClick: modules.game_helper.importTabDefaults('healing')

      Panel
        id: healingRulesHeader
        anchors.top: healingRulesTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 18
        margin-top: 4
        margin-left: 7
        margin-right: 19
        layout:
          type: anchor

        Label
          id: healingStateSpacer
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          width: 15
          !text: tr('')
          font: verdana-11px-monochrome
          color: #c0c0c0

        Label
          id: healingIdHeader
          anchors.left: healingStateSpacer.right
          anchors.verticalCenter: parent.verticalCenter
          width: 18
          !text: tr('ID')
          font: verdana-11px-monochrome
          color: #c0c0c0

        Label
          id: healingIconHeader
          anchors.left: healingIdHeader.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 4
          width: 34
          !text: tr('Act')
          font: verdana-11px-monochrome
          color: #c0c0c0

        Label
          id: healingNameHeader
          anchors.left: healingIconHeader.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 8
          width: 140
          !text: tr('Name')
          font: verdana-11px-monochrome
          color: #c0c0c0

        Label
          id: healingWhenHeader
          anchors.left: healingNameHeader.right
          anchors.right: healingEditHeader.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 6
          margin-right: 6
          !text: tr('Rule')
          font: verdana-11px-monochrome
          color: #c0c0c0

        Label
          id: healingEditHeader
          anchors.right: healingDelHeader.left
          anchors.verticalCenter: parent.verticalCenter
          margin-right: 2
          width: 20
          !text: tr('')
          font: verdana-11px-monochrome
          color: #c0c0c0

        Label
          id: healingDelHeader
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          margin-right: 2
          width: 18
          !text: tr('')
          font: verdana-11px-monochrome
          color: #c0c0c0

      UIScrollArea
        id: healingRulesList
        anchors.top: healingRulesHeader.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 2
        margin-left: 5
        margin-right: 19
        margin-bottom: 5
        layout:
          type: verticalBox
          spacing: 3
        vertical-scrollbar: healingRulesScroll

      HelperScrollBar
        id: healingRulesScroll
        anchors.top: healingRulesHeader.bottom
        anchors.bottom: parent.bottom
        margin-top: 2
        margin-bottom: 5
        anchors.right: parent.right
        margin-right: 5
        width: 12

    Panel
      id: spellHealingPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: separator.left
      anchors.bottom: parent.bottom
      margin: 5 5 5 5
      visible: false

      Label
        id: healingLabel
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Spell Healing')
        font: verdana-11px-monochrome
        color: #c0c0c0
        text-auto-resize: true

      UIButton
        id: spellButton0
        size: 34 34
        anchors.top: healingLabel.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/slot-actionbar.png
        border-width: 1
        border-color: #3f3f3f
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)

      HelperTextEdit
        id: spellPercentInput0
        size: 55 20
        anchors.top: prev.top
        anchors.left: prev.right
        margin-top: 3
        margin-left: 5
        padding-top: 3
        color: #c0c0c0
        !placeholder: tr('80')
        @onTextChange: |
          local value = modules.game_helper.validatePercentInput(self, 1, 100, 80)
          if value then
            modules.game_helper.updateHealingPercentInput(0, value)
          end
        @onFocusChange: |
          if not self:isFocused() then
            local text = self:getText()
            if text == "" or tonumber(text) == nil or tonumber(text) < 1 or tonumber(text) > 100 then
              self:setText("80")
              modules.game_helper.updateHealingPercentInput(0, 80)
            end
          end

      UIButton
        id: spellPriority0
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        image-source: /images/ui/show-gui-help-orange.png
        @onClick: onCheckSpellPriority(self)
        !tooltip: tr('This spell is healing health...')

      Label
        id: spellHealingPriorityLabel
        anchors.top: healingLabel.top
        anchors.left: spellPercentInput0.right
        margin-left: 5
        !text: tr('Priority')
        font: verdana-11px-monochrome
        color: #c0c0c0
        text-auto-resize: true

      Label
        id: spellHealingTypeLabel
        anchors.top: healingLabel.top
        anchors.left: spellOrderPriority0.right
        margin-left: 5
        !text: tr('Type')
        font: verdana-11px-monochrome
