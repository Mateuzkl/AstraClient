          color: $var-text-cip-color
          text-auto-resize: true
          phantom: true

        HelperTextEdit
          id: engineInput_healing
          size: 70 22
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 215
          editable: true
          padding-top: 3
          color: $var-text-cip-color
          font: $var-cip-font
          only-number: true
          @onFocusChange: |
            if not self:isFocused() then
              modules.game_helper.commitEngineIntervalInput(self, 'healing')
            end
          @onKeyPress: |
            modules.game_helper.handleEngineKeyPress(self, 'healing', keyCode)
          @onTextChange: |
            modules.game_helper.onEngineIntervalTextChanged(self, 'healing')

        Label
          anchors.left: prev.right
