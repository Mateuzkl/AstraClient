      Label
        id: ammoInfiniteLabel
        anchors.top: ammoRefillerItem2.bottom
        anchors.left: ammoRefillerLabel.left
        margin-top: 6
        margin-left: 2
        !text: tr('Ammo Infinite: Off')
        font: verdana-11px-monochrome
        color: #888888
        text-auto-resize: true
        !tooltip: tr('Time remaining on your Ammo Infinite buff (purchased in Game Store).')

  Panel
    id: SpyFollowPanel
    height: 100
    image-source: /images/ui/login/login_frame
    image-border: 12
    margin-top: 5

    VerticalSeparator
      id: spyFollowSeparator
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 5
      margin-bottom: 5

    Panel
      id: AutoFollowPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      anchors.right: spyFollowSeparator.left
      Label
        id: autoFollowTitle
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 1
        !text: tr('Auto Follow')
        font: verdana-11px-monochrome
        color: #808080
        text-auto-resize: true
      Panel
        id: autoFollowContent
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin: 3 3 3 3

        HelperCheckBox
          id: enableAutoFollow
          width: 100
          anchors.top: parent.top
          anchors.left: parent.left
          !text: tr('Enable')
          margin-top: 2
          margin-left: 2
          font: verdana-11px-monochrome
          color: #c0c0c0
          change-cursor-image: false
          $hover !disabled:
            color: #c0c0c0
          @onCheckChange: modules.game_helper.toggleAutoFollow(self:isChecked())

        UIWidget
          id: autoFollowInfo
          size: 12 12
          anchors.top: enableAutoFollow.top
          anchors.left: enableAutoFollow.right
          margin-top: 2
          margin-left: 3
          image-source: /mods/game_wheel/images/icon_info.png
          !tooltip: tr('Follow a player step-by-step.\nSupports stairs, teleports, and wagons.\nUse Ctrl+RightClick on a player to set target.')

        Label
          id: autoFollowTargetLabel
          anchors.top: enableAutoFollow.bottom
          anchors.left: parent.left
          !text: tr('Target:')
          font: verdana-11px-monochrome
          color: #c0c0c0
          text-auto-resize: true
          margin-top: 5
          margin-left: 2

        Label
          id: autoFollowTargetName
          anchors.top: autoFollowTargetLabel.top
          anchors.left: autoFollowTargetLabel.right
          !text: tr('None')
          font: verdana-11px-monochrome
          color: #00ff00
          text-auto-resize: true
          margin-left: 3

        HelperButton
          id: autoFollowClearBtn
          size: 50 24
          anchors.top: autoFollowTargetName.top
          anchors.left: autoFollowTargetName.right
          margin-top: 0
          margin-left: 6
          !text: tr('Clear')
          @onClick: modules.game_helper.clearAutoFollowTarget()

        HelperButton
          id: autoFollowSetKeyBtn
          size: 55 24
          anchors.top: autoFollowSetKeyTitleLabel.bottom
          anchors.left: parent.left
          margin-top: 1
          margin-left: 2
          !text: tr('Set Key')
          !tooltip: tr('Set a hotkey to toggle Auto Follow on/off.')
          @onClick: modules.game_helper.editIconStatsKeybind('Toggle Auto Follow')

        Label
          id: autoFollowKeyLabel
          width: 45
          anchors.top: autoFollowSetKeyBtn.top
          anchors.left: autoFollowSetKeyBtn.right
          margin-left: 4
          margin-top: 1
          !text: tr('None')
          font: verdana-11px-monochrome
          color: #808080

        Label
          id: autoFollowSetKeyTitleLabel
          anchors.top: autoFollowTargetName.bottom
          anchors.left: parent.left
          margin-top: 4
          margin-left: 2
          !text: tr('Activate:')
          font: verdana-11px-monochrome
          color: #c0c0c0

    Panel
      id: LevelSpyPanel
      anchors.top: parent.top
      anchors.left: spyFollowSeparator.right
