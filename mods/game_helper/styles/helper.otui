            id: iconStatsHealFriendLabel
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 34
            !text: tr('Heal Friend')
            font: $var-cip-font
            color: $var-text-cip-color
            text-auto-resize: true
            width: 120

          HelperCheckBox
            id: iconStatsHealFriend
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 159
            size: 20 20
            @onCheckChange: modules.game_helper.onIconStatsVisibilityChange('healFriendIcon', self:isChecked())
            change-cursor-image: false

          HelperButton
            id: iconStatsHealFriendSetKey
            text-horizontal-auto-resize: true
            height: 20
            anchors.left: iconStatsHealFriend.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 8
            margin: 2
            !text: tr('Set Key')
            @onClick: modules.game_helper.editIconStatsKeybind('Toggle Heal Friend')

          Label
            id: iconStatsHealFriendKeyLabel
            anchors.left: iconStatsHealFriendSetKey.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 8
            !text: tr('')
            font: $var-cip-font
            color: $var-text-cip-color-grey
