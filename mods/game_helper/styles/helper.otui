HuntingPanel < Panel
  layout:
    type: verticalBox
    fit-children: true

  Panel
    id: huntingSubTabBar
    height: 28
    layout:
      type: horizontalBox
      spacing: 2

    HelperButton
      id: huntingSubTabTargeting
      width: 170
      margin-top: 2
      margin-left: 0
      !text: tr('Targeting')
      checked: true
      @onClick: modules.game_helper.selectHuntingSubTab('targeting')

    HelperButton
      id: huntingSubTabShooter
      width: 170
      margin-top: 2
      !text: tr('Shooter')
      @onClick: modules.game_helper.selectHuntingSubTab('shooter')

    HelperButton
      id: huntingSubTabCavebot
      width: 170
      margin-top: 2
      margin-right: 2
      !text: tr('Cavebot')
      @onClick: modules.game_helper.selectHuntingSubTab('cavebot')

  TargetingPanel
    id: huntingTargetingContent
    visible: true

  ShooterPanel
    id: huntingShooterContent
    visible: false

  CaveBotUI
    id: huntingCavebotContent
    size: 850 552
    visible: false

    Panel
      id: caveHeader
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      layout:
        type: horizontalBox
        fit-children: false
        cell-spacing: 6

    Panel
      id: caveContainer
      anchors.top: caveHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      layout:
        type: anchor

TimerPanel < Panel
  layout:
    type: verticalBox
    fit-children: true

  Panel
    id: timerContentPanel
    height: 556
    image-source: /images/ui/login/login_frame
    image-border: 12

    Label
      id: timerTitle
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10
      !text: tr('Timer')
      font: verdana-11px-monochrome
      color: #c0c0c0
      text-auto-resize: true

    HelperCheckBox
      id: enableTimerModule
      width: 100
      anchors.top: timerTitle.bottom
      anchors.left: timerTitle.left
      margin-top: 8
      !text: tr('Enable')
      font: verdana-11px-monochrome
      color: #c0c0c0
      change-cursor-image: false
      $hover !disabled:
        color: #c0c0c0
      @onCheckChange: modules.game_helper.onEnableTimerModule(self:isChecked())

    HelperButton
      id: addTimerRuleButton
      size: 76 20
      anchors.verticalCenter: enableTimerModule.verticalCenter
      anchors.right: parent.right
      margin-right: 10
      !text: tr('Add Timer')
      @onClick: modules.game_helper.openAddTimerRulePopup()

    HelperButton
      id: importDefaultTimer
      size: 110 20
      anchors.verticalCenter: addTimerRuleButton.verticalCenter
      anchors.right: addTimerRuleButton.left
      margin-right: 5
      !text: tr('Import Default')
      !tooltip: tr('Reset this tab to the default profile for your vocation.')
      @onClick: modules.game_helper.importTabDefaults('timer')

    HorizontalSeparator
      id: timerSeparator
      anchors.top: enableTimerModule.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 5
      margin-right: 5

    Panel
      id: timerListHeader
      anchors.top: timerSeparator.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 18
      margin-top: 4
      margin-left: 7
      margin-right: 19
      layout:
        type: anchor

      Label
        id: timerStateSpacer
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 20
        !text: tr('')
        font: verdana-11px-monochrome
        color: #c0c0c0

      Label
        id: idHeader
        anchors.left: timerStateSpacer.right
        anchors.verticalCenter: parent.verticalCenter
        width: 18
        !text: tr('ID')
        font: verdana-11px-monochrome
        color: #c0c0c0

      Label
        id: iconHeader
        anchors.left: idHeader.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        width: 34
        !text: tr('CD')
        font: verdana-11px-monochrome
        color: #c0c0c0

      Label
        id: textHeader
        anchors.left: iconHeader.right
        anchors.right: typeHeader.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        margin-right: 6
        !text: tr('Text')
        font: verdana-11px-monochrome
        color: #c0c0c0

      Label
        id: typeHeader
        anchors.right: intervalHeader.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 6
        width: 44
        !text: tr('Type')
        font: verdana-11px-monochrome
        color: #c0c0c0

      Label
        id: intervalHeader
        anchors.right: editHeader.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 6
        width: 88
        !text: tr('Interval')
        font: verdana-11px-monochrome
        color: #c0c0c0

      Label
        id: editHeader
        anchors.right: delHeader.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 2
        width: 20
        !text: tr('')
        font: verdana-11px-monochrome
        color: #c0c0c0

      Label
        id: delHeader
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 2
        width: 18
        !text: tr('')
        font: verdana-11px-monochrome
        color: #c0c0c0

    UIScrollArea
      id: timerList
      padding: 5
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: timerListHeader.bottom
      anchors.bottom: parent.bottom
      margin-top: 2
      margin-left: 5
      margin-right: 19
      margin-bottom: 5
      layout:
        type: verticalBox
        spacing: 3
      vertical-scrollbar: timerListScroll

    HelperScrollBar
      id: timerListScroll
      anchors.top: timerListHeader.bottom
      anchors.bottom: parent.bottom
      margin-top: 2
      margin-bottom: 5
      anchors.right: parent.right
      margin-right: 5
      width: 12

TimerRuleRow < Panel
  width: 260
  height: 34
  margin-top: 2
  layout:
    type: anchor

  UIButton
    id: statusIcon
    image-auto-resize: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    image-source: /images/helper/disabled

  Label
    id: idLabel
    width: 18
    anchors.left: statusIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    !text: tr('1')
    font: verdana-11px-monochrome
    color: #c0c0c0

  Panel
    id: itemCell
    size: 34 34
    anchors.left: idLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

    Panel
      id: textCooldownBox
      anchors.fill: parent
      margin: 1
      background-color: #202020
      visible: false

    UIButton
      id: itemButton
      anchors.fill: parent
