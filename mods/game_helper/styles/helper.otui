      Label
        id: windowOpacityTitle
        anchors.top: showInfosRow.bottom
        anchors.left: parent.left
        margin-top: 15
        margin-left: 10
        !text: tr('Window Opacity')
        font: verdana-11px-monochrome
        color: #C0C0C0
        text-auto-resize: true

      Panel
        id: windowOpacityRow
        anchors.top: windowOpacityTitle.bottom
        anchors.left: parent.left
