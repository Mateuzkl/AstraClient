        color: #c0c0c0
        visible: false
        @onOptionChange: modules.game_helper.updateMagicShooterMinHarmony(self:getId():match("%d+"), self:getCurrentOption().text:match("%d+"))
        @onSetup: |
          self:addOption("0")
          self:addOption("1")
          self:addOption("2")
          self:addOption("3")
          self:addOption("4")
          self:addOption("5")
          self:setCurrentOption("0")

