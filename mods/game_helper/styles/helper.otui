          end
        @onFocusChange: |
          if not self:isFocused() then
            local text = self:getText()
            if text == "" or tonumber(text) == nil or tonumber(text) < 0 or tonumber(text) > 100 then
              self:setText("90")
              modules.game_helper.onUHVocationPercentChange(5, "90")
            end
          end
      HelperComboBox
        id: uhSorcererPriority
        text-horizontal-auto-resize: true
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 2
        color: $var-text-cip-color
        font: $var-cip-font
        @onOptionChange: modules.game_helper.onUHVocationPriorityChange(5, self:getCurrentOption().text)
        @onSetup: |
          for i = 1, 5 do
            self:addOption(tostring(i))
          end
          self:setCurrentOption("3")
      Label
        anchors.top: uhSorcererPriority.bottom
        anchors.left: hpPercentLabel.left
        margin-top: 2
        !text: tr('ED:')
        font: $var-cip-font
        color: $var-text-cip-color
        width: 25
      HelperTextEdit
        id: uhDruidPercent
        size: 58 18
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        padding-top: 2
        color: $var-text-cip-color
        font: $var-cip-font
        @onTextChange: |
          local value = modules.game_helper.validatePercentInput(self, 0, 100, 90)
          if value ~= nil then
            modules.game_helper.onUHVocationPercentChange(6, tostring(value))
          end
        @onFocusChange: |
          if not self:isFocused() then
            local text = self:getText()
            if text == "" or tonumber(text) == nil or tonumber(text) < 0 or tonumber(text) > 100 then
              self:setText("90")
              modules.game_helper.onUHVocationPercentChange(6, "90")
            end
          end
      HelperComboBox
        id: uhDruidPriority
        text-horizontal-auto-resize: true
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 2
        color: $var-text-cip-color
        font: $var-cip-font
        @onOptionChange: modules.game_helper.onUHVocationPriorityChange(6, self:getCurrentOption().text)
        @onSetup: |
          for i = 1, 5 do
            self:addOption(tostring(i))
          end
          self:setCurrentOption("4")
  HelperCheckBox
    id: enableAllFriendHealing
    width: 150
    !text: tr('Enable All Friend Healing')
    margin-left: 5
    margin-top: 5
    font: $var-cip-font
    color: $var-text-cip-color
    change-cursor-image: false
    $hover !disabled:
      color: $var-text-cip-color
    @onCheckChange: modules.game_helper.onEnableAllFriendHealing(self:isChecked())

EquipmentPanel < Panel
  layout:
    type: verticalBox
    fit-children: true

  Panel
    id: equipmentSubTabBar
    height: 24
    layout:
      type: horizontalBox
      spacing: 2

    HelperButton
      id: equipmentSubTabEquipments
      width: 260
      margin-top: 2
      margin-left: 0
      !text: tr('Equipments')
      checked: true
      @onClick: modules.game_helper.selectEquipmentSubTab('equipments')

    HelperButton
      id: equipmentSubTabTankMode
      width: 260
      margin-top: 2
      margin-right: 2
      !text: tr('Tank Mode')
      @onClick: modules.game_helper.selectEquipmentSubTab('tankMode')

  Panel
    id: equipmentPresetsPanel
    height: 76
    background-color: #3f3f3f
    border-width: 1
    padding: 3
    HelperComboBox
      id: equipmentPresets
      size: 180 20
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 2
      margin-top: 3
      color: $var-text-cip-color
      text-offset: -5 2
      @onOptionChange: toggleEquipmentPreset(self)
    UIButton
      id: equipmentCopyPresetButton
      size: 20 20
      anchors.top: equipmentPresets.bottom
      anchors.left: equipmentPresets.left
      margin-top: 4
      image-source: /images/helper/copy.png
      image-clip: 0 0 20 20
      $pressed:
        image-clip: 20 0 20 20
      !tooltip: tr('Copy config from another preset to the current preset.')
      @onClick: copyEquipmentPresetToCurrent(self)
    Label
      id: equipmentPrevPresetKeyLabel
      anchors.top: parent.top
      anchors.right: parent.right
      margin-right: 5
      margin-top: 3
      !text: tr('None')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      width: 45
    HelperButton
      id: equipmentPrevPresetSetKey
      text-horizontal-auto-resize: true
      anchors.top: parent.top
      height: 20
      anchors.right: equipmentPrevPresetKeyLabel.left
      margin-top: 3
      margin-right: 5
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to switch to the previous preset.')
      @onClick: modules.game_helper.editIconStatsKeybind('Previous Equipment Preset')
    Label
      id: equipmentPrevPresetLabel
      anchors.top: parent.top
      anchors.right: equipmentPrevPresetSetKey.left
      margin-top: 3
      margin-right: 6
      width: 58
      !text: tr('Previous')
      font: $var-cip-font
      color: $var-text-cip-color
    HelperButton
      id: equipmentRmvPresetButton
      size: 75 20
      anchors.top: equipmentCopyPresetButton.top
      anchors.left: equipmentCopyPresetButton.right
      margin-left: 5
      !text: tr('Clear')
      !tooltip: tr('Clear the current preset.')
      @onClick: removeEquipmentPreset()
    HelperButton
      id: equipmentRenameButton
      size: 75 20
      anchors.top: equipmentRmvPresetButton.top
      anchors.left: equipmentRmvPresetButton.right
      margin-left: 7
      !text: tr('Rename')
      !tooltip: tr('Rename the current preset.')
      @onClick: sendEquipmentRenameOrAddWindow(true)
    Label
      id: equipmentNextPresetKeyLabel
      anchors.top: equipmentRmvPresetButton.top
      anchors.right: parent.right
      margin-right: 5
      margin-top: 2
      width: 45
      !text: tr('None')
      font: $var-cip-font
      color: $var-text-cip-color-grey
    HelperButton
      id: equipmentNextPresetSetKey
      text-horizontal-auto-resize: true
      height: 20
      anchors.top: equipmentRmvPresetButton.top
      anchors.right: equipmentNextPresetKeyLabel.left
      margin-right: 5
      margin-top: 1
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to switch to the next preset.')
      @onClick: modules.game_helper.editIconStatsKeybind('Next Equipment Preset')
    Label
      id: equipmentNextPresetLabel
      anchors.top: equipmentRmvPresetButton.top
      anchors.right: equipmentNextPresetSetKey.left
      margin-right: 6
      margin-top: 2
      width: 30
      !text: tr('Next')
      font: $var-cip-font
      color: $var-text-cip-color
    Label
      id: equipmentActivatePresetKeyLabel
      anchors.top: equipmentRmvPresetButton.top
      anchors.right: equipmentNextPresetLabel.left
      margin-right: 48
      margin-top: 2
      width: 45
      !text: tr('None')
      font: $var-cip-font
      color: $var-text-cip-color-grey
    HelperButton
      id: equipmentActivatePresetSetKey
      text-horizontal-auto-resize: true
      height: 20
      anchors.top: equipmentRmvPresetButton.top
      anchors.right: equipmentActivatePresetKeyLabel.left
      margin-right: 5
      !text: tr('Set Key')
      !tooltip: tr('Set a hotkey to activate this preset directly.')
      @onClick: modules.game_helper.editPresetActivateKeybind('equipment')
    Label
      id: equipmentActivatePresetTitleLabel
      anchors.bottom: equipmentActivatePresetSetKey.top
      anchors.left: equipmentActivatePresetSetKey.left
      margin-bottom: 10
      !text: tr('Activate Preset:')
      font: $var-cip-font
      color: $var-text-cip-color

    HelperButton
      id: equipmentSaveButton
      size: 120 20
      visible: false
      anchors.top: equipmentPresets.top
      anchors.right: parent.right
      !text: tr('New Preset')
      image-source: /images/ui/buttons-blue
      margin: 2
      margin-right: 5
      !tooltip: tr('Create a new preset.')
      @onClick: sendEquipmentRenameOrAddWindow(false)

  Panel
    id: equipmentSwapPanel
    height: 476
    background-color: #3f3f3f
    border-width: 1

    Label
      id: equipmentSwapTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      !text: tr('Equipment Swap')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true

    HelperCheckBox
      id: enableEquipmentSwap
      width: 130
      anchors.top: prev.bottom
      anchors.left: parent.left
      !text: tr('Enable')
      margin-left: 5
      margin-top: 7
      font: $var-cip-font
      color: $var-text-cip-color
      change-cursor-image: false
      $hover !disabled:
        color: $var-text-cip-color
      @onCheckChange: modules.game_helper.onEnableEquipmentSwap(self:isChecked())

    HorizontalSeparator
      id: separatorEquipmentSwap
      anchors.top: enableEquipmentSwap.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 5
      margin-right: 5

    Panel
      id: equipmentRulesPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 5 5 5 5

      Label
        id: equipmentRulesTitle
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Swap Rules')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

      HelperButton
        id: addEquipmentRuleButton
        anchors.right: parent.right
        anchors.verticalCenter: equipmentRulesTitle.verticalCenter
        text-horizontal-auto-resize: true
        height: 20
        !text: tr('Add Equipment')
        @onClick: modules.game_helper.addEquipmentRule()

      UIScrollArea
        id: equipmentRulesList
        anchors.top: equipmentRulesTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        border-width: 1
        margin-top: 6
        margin-right: 14
        margin-bottom: 5
        layout:
          type: verticalBox
        vertical-scrollbar: equipmentRulesScroll

      HelperScrollBar
        id: equipmentRulesScroll
        anchors.top: equipmentRulesTitle.bottom
        anchors.bottom: parent.bottom
        margin-top: 6
        margin-bottom: 5
        anchors.right: parent.right
        width: 12

  Panel
    id: tankModePanel
    height: 165
    background-color: #3f3f3f
    border-width: 1
    margin-top: 5
    Label
      id: tankModeTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Tank Mode')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true

    Panel
      id: tankModeContent
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 5 5 5 5

      HelperCheckBox
        id: enableTankMode
        width: 130
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Enable Tank Mode')
        margin-left: 5
        margin-top: 5
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        $hover !disabled:
          color: $var-text-cip-color
        @onCheckChange: modules.game_helper.onEnableTankMode(self:isChecked())
      
      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 2
        image-source: /mods/game_wheel/images/icon_info.png
        !tooltip: tr('Mantem sempre equipado o amuleto e anel selecionados para tankar')

      HorizontalSeparator
        id: separatorTankMode
        anchors.top: enableTankMode.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 7

      Panel
        id: tankModeAmuletPanel
        anchors.top: separatorTankMode.bottom
        anchors.left: parent.left
        anchors.right: tankModeSeparator.left
        anchors.bottom: parent.bottom
        margin: 5 5 5 5

        Label
          id: tankModeAmuletTitle
          anchors.top: parent.top
          anchors.left: parent.left
          !text: tr('Tank Amulet')
          font: $var-cip-font
          color: $var-text-cip-color
          text-auto-resize: true

        UIWidget
          size: 12 12
          anchors.top: prev.top
          anchors.left: prev.right
          margin-left: 5
          margin-top: 2
          image-source: /mods/game_wheel/images/icon_info.png
          !tooltip: tr('Select the amulet to keep equipped while Tank Mode is enabled')

        UIButton
          id: tankModeAmuletButton
          size: 34 34
          anchors.top: tankModeAmuletTitle.bottom
          anchors.left: parent.left
          margin-top: 7
          margin-left: 2
          image-source: /images/game/actionbar/slot-actionbar.png
          @onClick: updateButton(self)
          @onMouseRelease: updateButton(self)

        HelperCheckBox
          id: enableTankModeAmulet
          width: 80
          anchors.top: tankModeAmuletButton.top
          anchors.left: tankModeAmuletButton.right
          margin-left: 5
          !text: tr('Enable')
          font: $var-cip-font
          color: $var-text-cip-color
          change-cursor-image: false
          $hover !disabled:
            color: $var-text-cip-color
          @onCheckChange: modules.game_helper.onEnableTankModeAmulet(self:isChecked())
        Label
          id: tankModeAmuletItemCount
          anchors.bottom: tankModeAmuletButton.bottom
          anchors.right: tankModeAmuletButton.right
          margin-right: 2
          margin-bottom: 1
          !text: tr('0')
          font: verdana-7px-rounded
          color: white
          text-border: 1
          text-border-color: #000000
          text-auto-resize: true
          visible: false

        UIWidget
          size: 12 12
          anchors.top: enableTankModeAmulet.top
          anchors.left: enableTankModeAmulet.right
          margin-left: 4
          margin-top: 2
          image-source: /mods/game_wheel/images/icon_info.png
          !tooltip: tr('Equip the selected amulet while Tank Mode is active')

      VerticalSeparator
        id: tankModeSeparator
        anchors.top: separatorTankMode.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        margin-top: 5
        margin-bottom: 5

      Panel
        id: tankModeRingPanel
        anchors.top: tankModeAmuletPanel.top
        anchors.left: tankModeSeparator.right
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin: 0 5 5 5

        Label
          id: tankModeRingTitle
          anchors.top: parent.top
          anchors.left: parent.left
          !text: tr('Tank Ring')
          font: $var-cip-font
          color: $var-text-cip-color
          text-auto-resize: true

        UIWidget
          size: 12 12
          anchors.top: prev.top
          anchors.left: prev.right
          margin-left: 5
          margin-top: 2
          image-source: /mods/game_wheel/images/icon_info.png
          !tooltip: tr('Select the ring to keep equipped while Tank Mode is enabled')

        UIButton
          id: tankModeRingButton
          size: 34 34
          anchors.top: tankModeRingTitle.bottom
          anchors.left: parent.left
          margin-top: 7
          margin-left: 2
          image-source: /images/game/actionbar/slot-actionbar.png
          @onClick: updateButton(self)
          @onMouseRelease: updateButton(self)

        HelperCheckBox
          id: enableTankModeRing
          width: 80
          anchors.top: tankModeRingButton.top
          anchors.left: tankModeRingButton.right
          margin-left: 5
          !text: tr('Enable')
          font: $var-cip-font
          color: $var-text-cip-color
          change-cursor-image: false
          $hover !disabled:
            color: $var-text-cip-color
          @onCheckChange: modules.game_helper.onEnableTankModeRing(self:isChecked())
        Label
          id: tankModeRingItemCount
          anchors.bottom: tankModeRingButton.bottom
          anchors.right: tankModeRingButton.right
          margin-right: 2
          margin-bottom: 1
          !text: tr('0')
          font: verdana-7px-rounded
          color: white
          text-border: 1
          text-border-color: #000000
          text-auto-resize: true
          visible: false

        UIWidget
          size: 12 12
          anchors.top: enableTankModeRing.top
          anchors.left: enableTankModeRing.right
          margin-left: 4
          margin-top: 2
          image-source: /mods/game_wheel/images/icon_info.png
          !tooltip: tr('Equip the selected ring while Tank Mode is active')

        HelperCheckBox
          id: respectEnergyRing
          width: 150
          anchors.top: tankModeRingButton.bottom
          anchors.left: parent.left
          margin-top: 8
          margin-left: 2
          !text: tr('Keep Energy Ring')
          font: $var-cip-font
          color: $var-text-cip-color
          change-cursor-image: false
          $hover !disabled:
            color: $var-text-cip-color
          @onCheckChange: modules.game_helper.onRespectEnergyRing(self:isChecked())
        
        UIWidget
          size: 12 12
          anchors.top: respectEnergyRing.top
          anchors.left: respectEnergyRing.right
          margin-left: 5
          margin-top: 2
          image-source: /mods/game_wheel/images/icon_info.png
          !tooltip: tr('Do not equip selected ring if already equipped with Energy Ring')

ToolsPanel < Panel
  layout:
    type: verticalBox
    fit-children: true

  Panel
    id: toolsSubTabBar
    height: 24
    layout:
      type: horizontalBox
      spacing: 2

    HelperButton
      id: toolsSubTabToolsHelper
      width: 96
      margin-top: 2
      margin-left: 0
      !text: tr('Tools')
      checked: true
      @onClick: modules.game_helper.selectToolsSubTab('toolsHelper')

    HelperButton
      id: toolsSubTabParty
      width: 80
      margin-top: 2
      !text: tr('Party')
      @onClick: modules.game_helper.selectToolsSubTab('party')

    HelperButton
      id: toolsSubTabExtras
      width: 80
      margin-top: 2
      !text: tr('Extras')
      @onClick: modules.game_helper.selectToolsSubTab('extras')

    HelperButton
      id: toolsSubTabTimer
      width: 80
      margin-top: 2
      !text: tr('Timer')
      @onClick: modules.game_helper.selectToolsSubTab('timer')

    HelperButton
      id: toolsSubTabAlarms
      width: 80
      margin-top: 2
      margin-right: 2
      !text: tr('Alarms')
      @onClick: modules.game_helper.selectToolsSubTab('alarms')

  Panel
    id: toolsPanel
    height: 250
    background-color: #3f3f3f
    border-width: 1
    Label
      id: toolsTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Tools Helper')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true
    Panel
      id: firstPanel
      anchors.top: toolsTitle.bottom
      anchors.left: parent.left
      anchors.right: separator1.left
      anchors.bottom: parent.bottom
      margin: 5 5 5 5
      Label
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Mana Training')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
      UIButton
        id: spellTrainingButton0
        size: 34 34
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/slot-actionbar.png
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)
      HelperCheckBox
        id: enableTraining0
        width: 100
        anchors.top: prev.top
        anchors.left: spellTrainingButton0.right
        !text: tr('Enable')
        margin-left: 5
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        $hover !disabled:
          color: $var-text-cip-color
        @onCheckChange: modules.game_helper.onEnableTraining(self:getId(), self:isChecked())

      HelperComboBox
        id: spellTrainingPercent0
        size: 67 20
        anchors.top: prev.bottom
        anchors.left: spellTrainingButton0.right
        margin-top: 2
        margin-left: 5
        color: $var-text-cip-color
        @onOptionChange: updateTrainingPercent('spellTrainingButton0', self:getCurrentOption().text:match("%d+"))
        @onSetup: |
          for i = 10, 100, 10 do
            self:addOption(i .. "%")
          end
          self:setCurrentOption("100%")
      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        image-source: /mods/game_wheel/images/icon_info.png
        !tooltip: tr('Cast a spell when your mana reaches the defined percentage to avoid regeneration waste.')
      HorizontalSeparator
        id: separator
        anchors.top: spellTrainingButton0.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
      Label
        id: toolsLabel
        anchors.top: prev.bottom
        anchors.left: parent.left
        !text: tr('Exercise Training')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
        margin-top: 5
      HelperCheckBox
        id: autoTrainingCheck
        width: 100
        anchors.top: toolsLabel.bottom
        anchors.right: parent.right
        !text: tr('Enable')
        margin-top: 5
        margin-right: 2
        font: $var-cip-font
        color: $var-text-cip-color
        @onCheckChange: checkExerciseEvent()
        change-cursor-image: false
        $hover !disabled:
        color: $var-text-cip-color
      HelperTextEdit
        id: exerciseTrainingIdsEdit
        anchors.top: toolsLabel.bottom
        anchors.left: parent.left
        anchors.right: autoTrainingCheck.left
        margin-top: 5
        margin-left: 2
        margin-right: 8
        height: 22
        padding-top: 3
        color: $var-text-cip-color
        !placeholder: tr('ex.: 28540, 28541')
        @onTextChange: |
          modules.game_helper.onExerciseTrainingIdsTextChange(self)
      HelperSettingsButton
        id: exerciseStaminaSettingsBtn
        anchors.top: exerciseTrainingIdsEdit.bottom
        anchors.right: parent.right
        margin-top: 4
        margin-right: 2
        size: 20 20
        !tooltip: tr('Configure stamina thresholds for Exercise Training.')
        @onClick: modules.game_helper.openExerciseStaminaSettings()
      Panel
        id: exerciseTrainingIdsGrid
        anchors.top: exerciseTrainingIdsEdit.bottom
        anchors.left: parent.left
        anchors.right: exerciseStaminaSettingsBtn.left
        margin-top: 4
        margin-left: 2
        margin-right: 6
        height: 0
        layout:
          type: grid
          cell-size: 18 18
          cell-spacing: 2
          num-columns: 10
          fit-children: true
      HelperComboBox
        id: trainingBox
        size: 67 20
        anchors.top: prev.bottom
        anchors.left: spellTrainingButton0.right
        margin-top: 2
        margin-left: 5
        color: $var-text-cip-color
        enabled: false
        visible: false
        @onSetup: |
          self:addOption("")
          self:setCurrentOption("")
      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        image-source: /mods/game_wheel/images/icon_info.png
        visible: false
      Label
        id: dummiesLabel
        anchors.top: exerciseTrainingIdsGrid.bottom
        anchors.left: parent.left
        !text: tr('Dummies')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
        margin-top: 8
      HelperCheckBox
        id: useDefaultDummiesCheck
        width: 100
        anchors.top: dummiesLabel.bottom
        anchors.right: parent.right
        !text: tr('Defaults')
        !tooltip: tr('Auto-include built-in dummy IDs in addition to your list.')
        margin-top: 7
        margin-right: 2
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        @onCheckChange: |
          modules.game_helper.onDefaultDummiesToggle(self)
        $hover !disabled:
        color: $var-text-cip-color
      HelperTextEdit
        id: dummyTrainingIdsEdit
        anchors.top: dummiesLabel.bottom
        anchors.left: parent.left
        anchors.right: useDefaultDummiesCheck.left
        margin-top: 7
        margin-left: 2
        margin-right: 8
        height: 22
        padding-top: 3
        color: $var-text-cip-color
        !placeholder: tr('ex.: 60251, 60476')
        @onTextChange: |
          modules.game_helper.onDummyTrainingIdsTextChange(self)
      Panel
        id: dummyTrainingIdsGrid
        anchors.top: dummyTrainingIdsEdit.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 2
        margin-right: 2
        height: 0
        layout:
          type: grid
          cell-size: 18 18
          cell-spacing: 2
          num-columns: 10
          fit-children: true
    VerticalSeparator
      id: separator1
      anchors.top: toolsTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5
    Panel
      id: secondPanel
      anchors.top: toolsTitle.bottom
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 5 5 5 5
      Label
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Auto Haste')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
      UIButton
        id: hasteButton0
        size: 34 34
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/slot-actionbar.png
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)
      HelperCheckBox
        id: enableHaste0
        width: 100
        anchors.top: prev.top
        anchors.left: hasteButton0.right
        !text: tr('Enable')
        margin-left: 5
        font: $var-cip-font
        color: $var-text-cip-color
        @onCheckChange: toggleAutoHaste(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
        color: $var-text-cip-color
      HelperCheckBox
        id: castOnPz
        width: 100
        anchors.top: prev.bottom
        anchors.left: hasteButton0.right
        !text: tr('PZ Cast')
        margin-left: 5
        margin-top: 5
        font: $var-cip-font
        color: $var-text-cip-color
        @onCheckChange: toggleAutoHastePz(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
        color: $var-text-cip-color
      Label
        id: cureParalyzeLabel
        anchors.top: parent.top
        anchors.left: enableHaste0.right
        margin-left: 10
        !text: tr('Cure Paralyze')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
      UIButton
        id: cureParalyzeButton0
        size: 34 34
        anchors.top: cureParalyzeLabel.bottom
        anchors.left: cureParalyzeLabel.left
        margin-top: 7
        image-source: /images/game/actionbar/slot-actionbar.png
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)
      HelperCheckBox
        id: enableCureParalyze0
        width: 100
        anchors.top: cureParalyzeButton0.top
        anchors.left: cureParalyzeButton0.right
        !text: tr('Enable')
        margin-left: 5
        font: $var-cip-font
        color: $var-text-cip-color
        @onCheckChange: toggleCureParalyze(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
        color: $var-text-cip-color
      HorizontalSeparator
        id: separator
        anchors.top: hasteButton0.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
      Label
        id: toolsLabel2
        anchors.top: prev.bottom
        anchors.left: parent.left
        !text: tr('Others Tools')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
        margin-top: 5
      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 2
        image-source: /mods/game_wheel/images/icon_info.png
        !tooltip: tr('Some other useful tools to make your gameplay easier.')
      HelperCheckBox
        id: portableTrader
        width: 120
        anchors.top: toolsLabel2.bottom
        anchors.left: parent.left
        !text: tr('Portable Trader')
        margin-top: 7
        margin-left: 2
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        @onCheckChange: modules.game_helper.tooglePortableTrader(self:isChecked())
        $hover !disabled:
          color: $var-text-cip-color
        !tooltip: tr('VIP only.\nAutomatically sells your loot with the Loot Seller when your\nfree capacity drops below the value set below ("cap <=").\nUses it at most once every 20 seconds.')

      Label
        id: portableTraderCapLabel
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 6
        margin-left: 17
        !text: tr('cap <=')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
        !tooltip: tr('Use the Loot Seller when your free capacity is below this value.')

      HelperTextEdit
        id: portableTraderCapInput
        size: 52 20
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 5
        padding-top: 1
        color: $var-text-cip-color
        !placeholder: tr('1000')
        !tooltip: tr('Use the Loot Seller when your free capacity is below this value.')
        @onTextChange: |
          local value = modules.game_helper.validatePercentInput(self, 0, 999999, 1000)
          if value then
            modules.game_helper.updatePortableTraderCap(value)
          end
        @onFocusChange: |
          if not self:isFocused() then
            local text = self:getText()
            if text == "" or tonumber(text) == nil then
              self:setText("1000")
              modules.game_helper.updatePortableTraderCap(1000)
            end
          end

      HelperCheckBox
        id: eatFood
        width: 110
        anchors.top: prev.bottom
        anchors.left: parent.left
        !text: tr('Auto Eat Food')
        margin-top: 7
        margin-left: 2
        font: $var-cip-font
        color: $var-text-cip-color
        @onCheckChange: toggleAutoEat(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
          color: $var-text-cip-color

      HelperCheckBox
        id: autoIncreaseForgeLimit
        width: 150
        anchors.top: prev.bottom
        anchors.left: parent.left
        !text: tr('Auto Increase Forge Limit')
        margin-top: 7
        margin-left: 2
        font: $var-cip-font
        color: $var-text-cip-color
        @onCheckChange: modules.game_helper.toggleAutoIncreaseForgeLimit(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
          color: $var-text-cip-color
        !tooltip: tr('Automatically increases forge dust limit when possible.')

      HelperCheckBox
        id: holdAttack
        width: 150
        anchors.top: prev.bottom
        anchors.left: parent.left
        !text: tr('Hold Attack')
        margin-top: 7
        margin-left: 2
        font: $var-cip-font
        color: $var-text-cip-color
        @onCheckChange: modules.game_helper.toggleHoldAttack(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
          color: $var-text-cip-color
        !tooltip: tr('Keeps attacking the same creature even if it leaves your screen. Press ESC to cancel.')

      Label
        id: holdAttackTargetLabel
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 2
        margin-left: 17
        font: $var-cip-font
        color: $var-text-cip-color-green
        text-auto-resize: true
        !text: ''

      HelperCheckBox
        id: autoReconnect
        width: 150
        anchors.top: prev.bottom
        anchors.left: parent.left
        !text: tr('Auto Reconnect')
        margin-top: 7
        margin-left: 2
        font: $var-cip-font
        color: $var-text-cip-color
        @onCheckChange: modules.game_helper.toggleAutoReconnect(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
          color: $var-text-cip-color
        !tooltip: tr('Automatically logs this character back in after an unexpected\ndisconnection. Saved per character.')

  Panel
    id: SpyFollowPanel
