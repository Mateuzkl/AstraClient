          image-source: /images/game/actionbar/actionbarslot
          @onClick: updateButton(self)
          @onMouseRelease: updateButton(self)
        UIButton
          id: rmvPercentButton4
          size: 10 24
          anchors.top: prev.top
          anchors.left: prev.right
          margin-left: 16
          margin-top: 3
          image-source: /images/ui/percent-buttons
          image-clip: 0 0 10 24
          @onSetup: |
            g_mouse.bindAutoPress(self, function() updateMagicShooterPercent(self:getId()) end, 150)
          $hover !pressed:
            image-clip: 0 0 10 24
          $pressed:
            image-clip: 0 24 10 24
          $disabled:
            image-clip: 0 48 10 24
        FlatPanel
          id: spellPercentBg4
          size: 35 24
          image-source: /images/ui/percentBg
          anchors.top: prev.top
          anchors.left: prev.right
          margin-left: 2
          !tooltip: tr('Mana Percent')
          Label
            id: spellPercentLabel4
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 4
            !text: tr('80%%')
            font: $var-cip-font
            color: $var-text-cip-color
            text-auto-resize: true
            phantom: true
        UIButton
          id: addPercentButton4
          size: 10 24
          anchors.top: prev.top
          anchors.left: prev.right
          margin-left: 2
          image-source: /images/ui/percent-buttons
          image-clip: 10 0 10 24
          @onSetup: |
            g_mouse.bindAutoPress(self, function() updateMagicShooterPercent(self:getId()) end, 150)
          $hover !pressed:
            image-clip: 10 0 10 24
          $pressed:
            image-clip: 10 24 10 24
          $disabled:
            image-clip: 10 48 10 24
        ComboBox
          id: countMinCreature4
          size: 50 24
          anchors.top: prev.top
          anchors.left: prev.right
          margin-left: 18
          color: $var-text-cip-color
          @onOptionChange: modules.game_helper.updateMagicShooterCreatures(self:getId(), self:getId():match("%d+"), self:getCurrentOption().text:match("%d+"))
          @onSetup: |
            self:addOption("1+")
            self:addOption("2+")
            self:addOption("3+")
            self:addOption("4+")
            self:addOption("5+")
            self:addOption("6+")
            self:addOption("7+")
            self:addOption("8+")
            self:addOption("9+")
            self:addOption("10+")
            self:setCurrentOption("1+")
        CheckBox
          id: conditionSetting4
          width: 12
          anchors.top: prev.top
          anchors.left: prev.right
          margin-left: 5
          margin-top: 7
          change-cursor-image: false
          !tooltip: tr('Cast if have +1 creatures')
          visible: false
          @onCheckChange: toggleForceCast(self:getId():match("%d+"), self:isChecked())
        ComboBox
          id: priority4
          size: 53 24
          anchors.top: countMinCreature4.top
          anchors.left: prev.right
          margin-left: 14
          font: Icon-VBold-11px
          color: $var-text-cip-color
          @onOptionChange: modules.game_helper.updateMagicShooterPriority(self:getId():match("%d+"), self:getCurrentOption().text:match("%d+"))
          @onSetup: |
            self:addOption("1st")
            self:addOption("2nd")
            self:addOption("3rd")
            self:addOption("4th")
            self:addOption("5th")
            self:addOption("6th")
            self:addOption("7th")
            self:setCurrentOption("1st")

