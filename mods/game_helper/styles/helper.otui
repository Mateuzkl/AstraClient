        id: enableMasResDruid
        width: 110
        anchors.top: enableMasResSorcerer.bottom
        anchors.left: parent.left
        margin-top: 9
        !text: tr('Druid')
        font: $var-main-font
        color: $var-text-color
        text-offset: 13 0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onEnableVocMasRes('druid', self:isChecked())
      ComboBox
        id: masResPercentDruid
        size: 55 18
        anchors.top: enableMasResDruid.top
        anchors.left: parent.left
        margin-left: 120
        color: $var-text-color
        font: $var-main-font
        @onOptionChange: modules.game_helper.updateVocMasResPercent('druid', self:getCurrentOption().text:match("%d+"))
        @onSetup: |
          for i = 10, 100, 10 do
            if i == 100 then i = 99 end
            self:addOption(i .. "%")
          end
          self:setCurrentOption("90%")
      ComboBox
        id: masResPriorityDruid
        size: 45 18
        anchors.top: enableMasResDruid.top
        anchors.left: parent.left
        margin-left: 200
        color: $var-text-color
        font: $var-main-font
        @onOptionChange: modules.game_helper.updateVocMasResPriority('druid', self:getCurrentOption().text)
        @onSetup: |
          for i = 1, 5 do self:addOption(tostring(i)) end
          self:setCurrentOption("2")

      CheckBox
        id: enableMasResMonk
        width: 110
        anchors.top: enableMasResDruid.bottom
        anchors.left: parent.left
        margin-top: 9
        !text: tr('Monk')
        font: $var-main-font
        color: $var-text-color
        text-offset: 13 0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onEnableVocMasRes('monk', self:isChecked())
      ComboBox
        id: masResPercentMonk
        size: 55 18
        anchors.top: enableMasResMonk.top
        anchors.left: parent.left
        margin-left: 120
        color: $var-text-color
        font: $var-main-font
        @onOptionChange: modules.game_helper.updateVocMasResPercent('monk', self:getCurrentOption().text:match("%d+"))
        @onSetup: |
          for i = 10, 100, 10 do
            if i == 100 then i = 99 end
            self:addOption(i .. "%")
          end
          self:setCurrentOption("90%")
      ComboBox
        id: masResPriorityMonk
        size: 45 18
        anchors.top: enableMasResMonk.top
        anchors.left: parent.left
        margin-left: 200
        color: $var-text-color
        font: $var-main-font
        @onOptionChange: modules.game_helper.updateVocMasResPriority('monk', self:getCurrentOption().text)
        @onSetup: |
          for i = 1, 5 do self:addOption(tostring(i)) end
          self:setCurrentOption("1")

      CheckBox
        id: masResExtended
        width: 200
        anchors.top: enableMasResMonk.bottom
        anchors.left: parent.left
        margin-top: 12
        !text: tr('Extended Area (4x4)')
        font: $var-main-font
        color: $var-text-color
        text-offset: 13 0
        change-cursor-image: false
        !tooltip: tr('Enable if your spell has an enlarged area (4x4 instead of 3x3)')
        @onCheckChange: modules.game_helper.onMasResExtendedChange(self:isChecked())

// ToolsPanel is now defined in styles/tools_panel.otui

ShooterPanel < Panel
  anchors.fill: parent

  MagicShooterPanel
    id: magicShooterPanelContainer
    anchors.fill: parent
