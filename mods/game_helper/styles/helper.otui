FriendHealPanel < Panel
  layout:
    type: verticalBox
    fit-children: true
  Panel
    id: sioSpellPanel
    height: 50
    background-color: #3f3f3f
    border-width: 1
    visible: false
    Label
      id: sioSpellTitle
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      margin-left: 10
      !text: tr('Sio Spell')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true
    UIButton
      id: sioSpellButton
      size: 34 34
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: prev.right
      margin-left: 8
      image-source: /images/game/actionbar/slot-actionbar.png
      @onClick: modules.game_helper.assignSioSpell(self, false)
      @onMouseRelease: modules.game_helper.assignSioSpell(self, false)
    Label
      id: sioSpellName
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: prev.right
      anchors.right: parent.right
      margin-left: 10
      margin-right: 10
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true
      text: exura sio
  Panel
    id: friendHealingPanel
    height: 170
    background-color: #3f3f3f
    border-width: 1
    enabled: true
    visible: false
    Label
      id: friendTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Friend List')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true
    Panel
      id: firstPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: separator1.left
      anchors.bottom: parent.bottom
      margin: 5 5 5 5
      focusable: true
      Label
        id: selectFriendLabel
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Friends (one per line):')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
      MultilineTextEdit
        id: friendListEdit
        anchors.top: selectFriendLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 3
        font: $var-cip-font
        color: $var-text-cip-color
        background-color: #ffffff18
        @onTextChange: modules.game_helper.onFriendListTextChange(self:getText(), false)

    VerticalSeparator
      id: separator1
      anchors.top: friendTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5

    Panel
      id: secondPanel
      anchors.top: friendTitle.bottom
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 5 5 5 5
      Label
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Heal Settings')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
      HelperCheckBox
        id: enableSio0
        width: 100
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 5
        margin-left: 0
        !text: tr('Enable')
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onEnableSio(self, self:isChecked())
      HelperCheckBox
        id: enablePartyHeal
        width: 100
        anchors.top: enableSio0.bottom
        anchors.left: parent.left
        margin-top: 2
        margin-left: 0
        !text: tr('Heal Party')
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onEnablePartyHeal(self, self:isChecked())
      HelperCheckBox
        id: enableGuildHeal
        width: 100
        anchors.top: enablePartyHeal.bottom
        anchors.left: parent.left
        margin-top: 2
        margin-left: 0
        !text: tr('Heal Guild')
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onEnableGuildHeal(self, self:isChecked())
      HelperCheckBox
        id: enableScreenHeal
        width: 100
        anchors.top: enableGuildHeal.bottom
        anchors.left: parent.left
        margin-top: 2
        margin-left: 0
        !text: tr('Heal Screen')
        font: $var-cip-font
        color: $var-text-cip-color
        change-cursor-image: false
        @onCheckChange: modules.game_helper.onEnableScreenHeal(self, self:isChecked())
      Label
        id: hpPercentLabel
        anchors.top: parent.top
        anchors.left: parent.horizontalCenter
        margin-left: -25
        !text: 'HP %:'
        font: $var-cip-font
        color: $var-text-cip-color
        width: 62
        text-align: right
      Label
        id: priorityLabel
        anchors.top: parent.top
        anchors.left: hpPercentLabel.right
        margin-left: 30
        !text: tr('Prior:')
        font: $var-cip-font
        color: $var-text-cip-color
        width: 42
      UIWidget
        size: 12 12
        anchors.top: priorityLabel.top
        anchors.left: priorityLabel.right
        margin-top: 2
        image-source: /mods/game_wheel/images/icon_info.png
        !tooltip: tr('Lowest priority number will be healed first.')
      Label
        anchors.top: hpPercentLabel.bottom
        anchors.left: hpPercentLabel.left
        margin-top: 5
        !text: tr('EK:')
        font: $var-cip-font
        color: $var-text-cip-color
        width: 25
      HelperTextEdit
        id: knightPercent
        size: 58 18
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        padding-top: 2
        color: $var-text-cip-color
        font: $var-cip-font
        @onTextChange: |
          local value = modules.game_helper.validatePercentInput(self, 0, 100, 90)
          if value ~= nil then
            modules.game_helper.onVocationPercentChange(8, tostring(value), false)
          end
        @onFocusChange: |
          if not self:isFocused() then
            local text = self:getText()
            if text == "" or tonumber(text) == nil or tonumber(text) < 0 or tonumber(text) > 100 then
              self:setText("90")
              modules.game_helper.onVocationPercentChange(8, "90", false)
            end
          end
      HelperComboBox
        id: knightPriority
        text-horizontal-auto-resize: true
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 2
        color: $var-text-cip-color
        font: $var-cip-font
        @onOptionChange: modules.game_helper.onVocationPriorityChange(8, self:getCurrentOption().text, false)
        @onSetup: |
          for i = 1, 5 do
            self:addOption(tostring(i))
          end
          self:setCurrentOption("1")
      Label
        anchors.top: knightPriority.bottom
        anchors.left: hpPercentLabel.left
        margin-top: 2
        !text: tr('RP:')
        font: $var-cip-font
        color: $var-text-cip-color
        width: 25
      HelperTextEdit
        id: paladinPercent
        size: 58 18
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        padding-top: 2
        color: $var-text-cip-color
        font: $var-cip-font
        @onTextChange: |
          local value = modules.game_helper.validatePercentInput(self, 0, 100, 90)
          if value ~= nil then
            modules.game_helper.onVocationPercentChange(7, tostring(value), false)
          end
        @onFocusChange: |
          if not self:isFocused() then
            local text = self:getText()
            if text == "" or tonumber(text) == nil or tonumber(text) < 0 or tonumber(text) > 100 then
              self:setText("90")
              modules.game_helper.onVocationPercentChange(7, "90", false)
            end
          end
      HelperComboBox
        id: paladinPriority
        text-horizontal-auto-resize: true
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 2
        color: $var-text-cip-color
        font: $var-cip-font
        @onOptionChange: modules.game_helper.onVocationPriorityChange(7, self:getCurrentOption().text, false)
        @onSetup: |
          for i = 1, 5 do
            self:addOption(tostring(i))
          end
          self:setCurrentOption("2")
      Label
        anchors.top: paladinPriority.bottom
        anchors.left: hpPercentLabel.left
        margin-top: 2
        !text: tr('MS:')
        font: $var-cip-font
        color: $var-text-cip-color
        width: 25
      HelperTextEdit
        id: sorcererPercent
        size: 58 18
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        padding-top: 2
        color: $var-text-cip-color
        font: $var-cip-font
        @onTextChange: |
          local value = modules.game_helper.validatePercentInput(self, 0, 100, 90)
          if value ~= nil then
            modules.game_helper.onVocationPercentChange(5, tostring(value), false)
          end
        @onFocusChange: |
          if not self:isFocused() then
