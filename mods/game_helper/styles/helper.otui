        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)
      Label
        id: runeShooterButton0Count
        anchors.bottom: runeShooterButton0.bottom
        anchors.right: runeShooterButton0.right
        margin-right: 2
        margin-bottom: 1
        !text: tr('0')
        font: verdana-7px-rounded
        color: white
        text-border: 1
        text-border-color: #000000
        text-auto-resize: true
        visible: false
      HelperComboBox
        id: countMinCreature0
        size: 50 20
        anchors.top: runeShooterButton0.top
        anchors.left: runeShooterButton0.right
        margin-left: 19
        margin-top: 3
        color: #c0c0c0
        @onOptionChange: modules.game_helper.updateRuneShooterCreatures(self:getId(), self:getId():match("%d+"), self:getCurrentOption().text)
        @onSetup: |
          self:addOption("1")
          self:addOption("1+")
          self:addOption("2+")
          self:addOption("3+")
          self:addOption("4+")
          self:addOption("5+")
          self:addOption("6+")
          self:addOption("7+")
          self:addOption("8+")
          self:addOption("9+")
          self:addOption("10+")
          self:setCurrentOption("1+")
      HelperCheckBox
        id: conditionSetting0
        width: 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 7
        change-cursor-image: false
        !tooltip: tr('Cast if have +1 creatures')
        visible: false
        @onCheckChange: toggleForceRuneCast(self:getId():match("%d+"), self:isChecked())
      HelperComboBox
        id: runePriority0
        size: 55 24
        anchors.top: countMinCreature0.top
        anchors.left: prev.right
        margin-left: 17
        font: verdana-11px-monochrome
        color: #c0c0c0
        @onOptionChange: modules.game_helper.updateRuneShooterPriority(self:getId():match("%d+"), self:getCurrentOption().text:match("%d+"))
        @onSetup: |
