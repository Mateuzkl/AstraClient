  Panel
    id: equipPanel
    height: 85
    image-source: /images/ui/login/login_frame
    image-border: 12
    margin-top: 5
    Label
      id: equipTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Equip Helper')
      font: verdana-11px-monochrome
      color: #808080
      text-auto-resize: true
    Panel
      id: firstPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: separator1.left
      anchors.bottom: parent.bottom
      margin: 5 5 5 5
      Label
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Auto SSA')
        font: verdana-11px-monochrome
        color: #c0c0c0
        text-auto-resize: true
      UIWidget
        id: autoSSA
        size: 32 32
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
      HelperCheckBox
        id: enableSSA
        width: 100
        anchors.top: prev.top
        anchors.left: autoSSA.right
        !text: tr('Enable')
        margin-left: 5
        font: verdana-11px-monochrome
        color: #c0c0c0
        change-cursor-image: false
        $hover !disabled:
          color: #c0c0c0
        @onCheckChange: modules.game_helper.onEnableSSA(self:getId(), self:isChecked())

      UIWidget
        size: 12 12
        anchors.top: enableSSA.bottom
        anchors.left: autoSSA.right
        margin-left: 5
        margin-top: 5
        image-source: /mods/game_wheel/images/icon_info.png
        !tooltip: tr('Cast a spell when your mana reaches the defined percentage to avoid regeneration waste.')

    VerticalSeparator
      id: separator1
      anchors.top: equipTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5
    Panel
      id: secondPanel
