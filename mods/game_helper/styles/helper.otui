  Panel
    id: shieldHelperPanel
    height: 132
    margin-top: 7
    background-color: #3f3f3f
    border-width: 1
    enabled: true
    visible: false

    Label
      id: shieldTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Magic Shield Helper')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true

    HelperCheckBox
      id: utamoVita
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 8
      margin-top: 30
      !text: tr("Auto Utamo")
      text-auto-resize: true
      font: $var-cip-font
      color: $var-text-cip-color
      @onCheckChange: toggleUtamoVita(self, self:isChecked())

    UIWidget
      id: utamoVitaIcon
      size: 18 18
      image-size: 18 18
      anchors.left: exanaVita.right
      anchors.verticalCenter: utamoVita.verticalCenter
      margin-left: 6
      focusable: false
      phantom: true

    HelperSettingsButton
      id: utamoVitaSettingsBtn
      anchors.verticalCenter: utamoVita.verticalCenter
      anchors.left: exanaVitaIcon.right
      margin-left: 5
      @onClick: modules.game_helper.openUtamoVitaSettings()

    HelperTextEdit
      id: utamoPercentInput0
      size: 55 20
      anchors.verticalCenter: utamoVita.verticalCenter
      anchors.right: parent.right
      margin-right: 10
      padding-top: 3
      color: $var-text-cip-color
      !placeholder: tr('80')
      @onTextChange: |
        local value = modules.game_helper.validatePercentInput(self, 0, 100, 80)
        if value then
          modules.game_helper.updateUtamoPercentInput(0, value)
        end
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" or tonumber(text) == nil or tonumber(text) < 0 or tonumber(text) > 100 then
            self:setText("80")
            modules.game_helper.updateUtamoPercentInput(0, 80)
          end
        end

    HelperCheckBox
      id: magicPotion
      anchors.left: utamoVita.left
      anchors.top: utamoVita.bottom
      margin-top: 10
      !text: tr("Magic Potion")
      text-auto-resize: true
      font: $var-cip-font
      color: $var-text-cip-color
      @onCheckChange: toggleMagicPotion(self, self:isChecked())

    UIItem
      id: magicPotionIcon
      size: 18 18
      anchors.left: exanaVita.right
      anchors.verticalCenter: magicPotion.verticalCenter
      margin-left: 6
      virtual: true
      focusable: false
      phantom: true

    HelperSettingsButton
      id: magicPotionSettingsBtn
      anchors.verticalCenter: magicPotion.verticalCenter
      anchors.left: exanaVitaIcon.right
      margin-left: 5
      @onClick: modules.game_helper.openMagicPotionSettings()
        
    HelperCheckBox
      id: exanaVita
      anchors.left: utamoVita.left
      anchors.top: magicPotion.bottom
      margin-top: 10
      !text: tr("Auto Exana Vita")
      text-auto-resize: true
      font: $var-cip-font
      color: $var-text-cip-color
      @onCheckChange: toggleExanaVita(self, self:isChecked())

    UIWidget
      id: exanaVitaIcon
      size: 18 18
      image-size: 18 18
      anchors.left: exanaVita.right
      anchors.verticalCenter: exanaVita.verticalCenter
      margin-left: 6
      focusable: false
      phantom: true

    HelperTextEdit
      id: exanaPercentInput0
      size: 55 20
      anchors.verticalCenter: exanaVita.verticalCenter
      anchors.right: parent.right
      margin-right: 10
      padding-top: 3
      color: $var-text-cip-color
      !placeholder: tr('80')
      @onTextChange: |
        local value = modules.game_helper.validatePercentInput(self, 0, 100, 80)
        if value then
          modules.game_helper.updateExanaPercentInput(0, value)
        end
      @onFocusChange: |
        if not self:isFocused() then
          local text = self:getText()
          if text == "" or tonumber(text) == nil or tonumber(text) < 0 or tonumber(text) > 100 then
            self:setText("80")
            modules.game_helper.updateExanaPercentInput(0, 80)
          end
        end

    HelperCheckBox
      id: exanaVitaWaitUtamoCD
      anchors.left: exanaVita.left
      anchors.top: exanaVita.bottom
      margin-left: 16
      margin-top: 4
      !text: tr("Wait Utamo CD")
      text-auto-resize: true
      font: $var-cip-font
      color: $var-text-cip-color-grey
      @onCheckChange: toggleExanaVitaWaitUtamoCD(self, self:isChecked())

  Panel
    id: energyRingPanel
    height: 160
    margin-top: 7
    background-color: #3f3f3f
    border-width: 1
    enabled: true
    visible: false

    Label
      id: energyRingTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Energy Ring Helper')
