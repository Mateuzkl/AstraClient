HelperTracker < MiniWindow
  id: helperMiniWindow
  !text: tr('Helper Stats')
  icon: /images/icons/icon-healing
  height: 168
  &type: 'helper'
  MiniWindowContents
    id: contentsPanel
    anchors.fill: parent
    margin: 20 9 5 9
    Label
      id: helperLabel
      anchors.top: parent.top
      anchors.left: parent.left
      !text: tr('General Helper')
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true
    UIWidget
      id: hierarchy
      size: 7 7
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 5
      image-source: /images/ui/hierarchy-branch
      phantom: true
    UIWidget
      id: helperStatus
      size: 155 15
      anchors.top: prev.top
      anchors.left: prev.right
      !text: tr('Inactive')
      margin-top: -3
      margin-left: 5
      font: $var-cip-font
      color: $var-text-cip-store-red
      text-auto-resize: true
      tooltip-delayed: true

    Label
      id: targetLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 3
      !text: tr('Target Helper')
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true
    UIWidget
      id: hierarchy
      size: 7 7
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 5
      image-source: /images/ui/hierarchy-branch
      phantom: true
    UIWidget
      id: targetStatus
      size: 155 15
      anchors.top: prev.top
      anchors.left: prev.right
      !text: tr('Inactive')
      margin-top: -3
      margin-left: 5
      font: $var-cip-font
      color: $var-text-cip-store-red
      text-auto-resize: true
      tooltip-delayed: true

    Label
      id: shooterLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 3
      !text: tr('Shooter Helper')
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true
    UIWidget
      id: hierarchy
      size: 7 7
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 5
      image-source: /images/ui/hierarchy-branch
      phantom: true
    UIWidget
      id: shooterStatus
      size: 155 15
      anchors.top: prev.top
      anchors.left: prev.right
      !text: tr('Inactive')
      margin-top: -3
      margin-left: 5
      font: $var-cip-font
      color: $var-text-cip-store-red
      text-auto-resize: true
      tooltip-delayed: true

    Label
      id: currentPresetLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 3
      !text: tr('Shooter Preset')
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true
    UIWidget
      id: hierarchy
      size: 7 7
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 5
      image-source: /images/ui/hierarchy-branch
      phantom: true
    UIWidget
      id: currentPresetName
      size: 155 15
      anchors.top: prev.top
      anchors.left: prev.right
      !text: tr('No data yet')
      margin-top: -3
      margin-left: 5
      font: $var-cip-font
      color: $var-text-cip-color-green
      text-auto-resize: true
      tooltip-delayed: true

    Label
      id: cavebotLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 3
      !text: tr('Cavebot')
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true
    UIWidget
      id: hierarchy
      size: 7 7
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 5
      image-source: /images/ui/hierarchy-branch
      phantom: true
    UIWidget
      id: cavebotTrackerStatus
      size: 155 15
      anchors.top: prev.top
      anchors.left: prev.right
      !text: tr('Inactive')
      margin-top: -3
      margin-left: 5
      font: $var-cip-font
      color: $var-text-cip-store-red
      text-auto-resize: true
      tooltip-delayed: true

    Button
      id: openHelper
      size: 108 20
      anchors.top: prev.bottom
      anchors.left: parent.left
      !text: tr('Open Helper')
      margin-top: 5
      margin-left: 24
      @onClick: modules.game_helper:show(true)

  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder
    size: 14 14
    margin-left: 2
    margin-bottom: 2
  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 155
    maximum: 155
    margin-left: 3
    margin-right: 3

PlayerName < Label
  focusable: true
  height: 15
  font: $var-cip-font
  color: $var-text-cip-color-grey

  $focus:
    background-color: #484848
    color: #f4f4f4
  $!focus:
    background-color: alpha
    color: #c0c0c0

PotionItem < UIItem
  size: 32 32
  phantom: true
  draggable: false
  virtual: true
  priceable: false
  anchors.top: parent.top
  anchors.left: parent.left

RuneItem < UIItem
  size: 32 32
  phantom: true
  draggable: false
  virtual: true
  priceable: false
  anchors.top: parent.top
  anchors.left: parent.left

HealingPanel < Panel
  anchors.fill: parent
  Panel
    id: healingPanel
    height: 120
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18

    Label
      id: title
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      !text: tr('Auto Healing Helper')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true

    Panel
      id: spellHealingPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: separator.left
      anchors.bottom: parent.bottom
      margin: 5 5 5 5

      Label
        id: healingLabel
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Spell Healing')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

      UIButton
        id: spellButton0
        size: 34 34
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)

      UIButton
        id: rmvPercentButton0
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-top: 3
        margin-left: 5
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updateHealingPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24

      FlatPanel
        id: spellPercentBg0
        size: 42 24
        image-source: /images/ui/percentBg
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        Label
          id: spellPercentLabel0
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('80%%')
          font: $var-cip-font
          color: $var-text-cip-color
          text-auto-resize: true

      UIButton
        id: addPercentButton0
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updateHealingPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24

      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        image-source: /images/skin/show-gui-help-grey
        !tooltip: tr('Cast a healing spell when your health reaches the defined percentage.')

      UIButton
        id: spellButton1
        size: 34 34
        anchors.top: spellButton0.bottom
        anchors.left: parent.left
        margin-top: 5
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)

      UIButton
        id: rmvPercentButton1
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-top: 3
        margin-left: 5
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updateHealingPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24

      FlatPanel
        id: spellPercentBg1
        size: 42 24
        image-source: /images/ui/percentBg
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        Label
          id: spellPercentLabel1
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('80%%')
          font: $var-cip-font
          color: $var-text-cip-color
          text-auto-resize: true

      UIButton
        id: addPercentButton1
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updateHealingPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24

      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        image-source: /images/skin/show-gui-help-grey
        !tooltip: tr('Cast a healing spell when your health reaches the defined percentage.')

      UIButton
        id: spellButton2
        size: 34 34
        anchors.top: spellButton1.bottom
        anchors.left: parent.left
        margin-top: 5
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)

      UIButton
        id: rmvPercentButton2
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-top: 3
        margin-left: 5
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updateHealingPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24

      FlatPanel
        id: spellPercentBg2
        size: 42 24
        image-source: /images/ui/percentBg
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        Label
          id: spellPercentLabel2
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('80%%')
          font: $var-cip-font
          color: $var-text-cip-color
          text-auto-resize: true

      UIButton
        id: addPercentButton2
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updateHealingPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24

      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        image-source: /images/skin/show-gui-help-grey
        !tooltip: tr('Cast a healing spell when your health reaches the defined percentage.')

    VerticalSeparator
      id: separator
      anchors.top: title.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5

    Panel
      id: potionHealingPanel
      height: 100
      anchors.top: title.bottom
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 5 5 5 5

      Label
        id: healingLabel
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Potion Healing')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

      UIButton
        id: potionButton0
        size: 34 34
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onHoverChange: updateButton(self)
        @onMouseRelease: updateButton(self)

      UIButton
        id: rmvPotionPercentButton0
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-top: 3
        margin-left: 5
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updatePotionPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24

      FlatPanel
        id: potionPercentBg
        size: 42 24
        image-source: /images/ui/percentBg
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        Label
          id: potionPercentLabel0
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('50%%')
          font: $var-cip-font
          color: $var-text-cip-color
          text-auto-resize: true

      UIButton
        id: addPotionPercentButton0
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updatePotionPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24

      UIButton
        id: priority0
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        image-source: /images/skin/show-gui-help-grey
        @onClick: onCheckPotionPriority(self)
        !tooltip: tr('')

      UIButton
        id: potionButton1
        size: 34 34
        anchors.top: potionButton0.bottom
        anchors.left: parent.left
        margin-top: 5
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onHoverChange: updateButton(self)
        @onMouseRelease: updateButton(self)

      UIButton
        id: rmvPotionPercentButton1
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-top: 3
        margin-left: 5
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updatePotionPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24

      FlatPanel
        id: potionPercentBg
        size: 42 24
        image-source: /images/ui/percentBg
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        Label
          id: potionPercentLabel1
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('50%%')
          font: $var-cip-font
          color: $var-text-cip-color
          text-auto-resize: true

      UIButton
        id: addPotionPercentButton1
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updatePotionPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24

      UIButton
        id: priority1
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        image-source: /images/skin/show-gui-help-grey
        @onClick: onCheckPotionPriority(self)
        !tooltip: tr('')

      UIButton
        id: potionButton2
        size: 34 34
        anchors.top: potionButton1.bottom
        anchors.left: parent.left
        margin-top: 5
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onHoverChange: updateButton(self)
        @onMouseRelease: updateButton(self)
        visible: false

      UIButton
        id: rmvPotionPercentButton2
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-top: 3
        margin-left: 5
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updatePotionPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24

      FlatPanel
        id: potionPercentBg2
        size: 42 24
        image-source: /images/ui/percentBg
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        Label
          id: potionPercentLabel2
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('50%%')
          font: $var-cip-font
          color: $var-text-cip-color
          text-auto-resize: true

      UIButton
        id: addPotionPercentButton2
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updatePotionPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24

      UIButton
        id: priority2
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        image-source: /images/skin/show-gui-help-grey
        @onClick: onCheckPotionPriority(self)
        !tooltip: tr('')

  Panel
    id: friendHealingPanel
    height: 120
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 7
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    enabled: true
    visible: false
    Label
      id: friendTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Friend Healing Helper')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true
    Panel
      id: firstPanel
      anchors.top: friendTitle.bottom
      anchors.left: parent.left
      anchors.right: separator1.left
      anchors.bottom: parent.bottom
      margin: 4 5 4 5
      focusable: true
      Label
        id: selectFriendLabel
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Heal Priority')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
      TextList
        id: friendList
        height: 50
        anchors.top: selectFriendLabel.bottom
        anchors.left: parent.left
        anchors.right: moveHealUp.left
        margin-top: 4
        margin-right: 3
        padding: 1
        focusable: true
        vertical-scrollbar: friendListScrollBar
        background-color: #484848
      VerticalScrollBar
        id: friendListScrollBar
        anchors.top: friendList.top
        anchors.right: friendList.right
        anchors.bottom: friendList.bottom
        margin: 1 1 1 0
        step: 14
        pixels-scroll: true
      UIWidget
        id: moveHealUp
        size: 14 10
        anchors.top: selectFriendLabel.bottom
        anchors.right: parent.right
        margin-top: 4
        image-source: /images/arrows/icon-uparrow
        cursor: pointer
        opacity: 0.85
        $hover:
          opacity: 1.0
        @onClick: modules.game_helper.moveHealName(self, -1)
        !tooltip: tr('Move selected up (higher priority)')
      UIWidget
        id: moveHealDown
        size: 14 10
        anchors.top: moveHealUp.bottom
        anchors.right: parent.right
        margin-top: 30
        image-source: /images/arrows/icon-downarrow
        cursor: pointer
        opacity: 0.85
        $hover:
          opacity: 1.0
        @onClick: modules.game_helper.moveHealName(self, 1)
        !tooltip: tr('Move selected down (lower priority)')
      ButtonBox
        id: radioPT
        size: 38 18
        anchors.top: friendList.bottom
        anchors.left: parent.left
        margin-top: 6
        !text: tr('PT')
        font: $var-cip-font
        !tooltip: tr('Fill the list with your nearby party members')
      ButtonBox
        id: radioList
        size: 42 18
        anchors.top: radioPT.top
        anchors.left: radioPT.right
        margin-left: 4
        !text: tr('List')
        font: $var-cip-font
        !tooltip: tr('Use a saved manual list of player names')
      Button
        id: addNames
        size: 18 18
        anchors.top: radioPT.top
        anchors.left: radioList.right
        margin-left: 3
        !text: tr('+')
        font: $var-cip-font
        change-cursor-image: true
        cursor: pointer
        @onClick: modules.game_helper.onAddHealNames(self)
        !tooltip: tr('Add players to the list, separated by ","')
      Button
        id: removeNames
        size: 18 18
        anchors.top: radioPT.top
        anchors.left: addNames.right
        margin-left: 3
        !text: tr('-')
        font: $var-cip-font
        change-cursor-image: true
        cursor: pointer
        @onClick: modules.game_helper.onRemoveHealName(self)
        !tooltip: tr('Remove the selected player from the list')

    VerticalSeparator
      id: separator1
      anchors.top: friendTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5

    Panel
      id: secondPanel
      anchors.top: friendTitle.bottom
      anchors.left: separator1.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 6 6 6 6
      CheckBox
        id: enableHeal
        width: 90
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Enable')
        margin-top: 2
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 16 -2
        @onCheckChange: modules.game_helper.onEnableHeal(self, self:isChecked())
        $hover !disabled:
          color: #c0c0c0
      Label
        id: healAtLabel
        anchors.top: enableHeal.bottom
        anchors.left: parent.left
        margin-top: 6
        !text: tr('Heal at life:')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
      UIButton
        id: healRmvPercent
        size: 10 24
        anchors.top: healAtLabel.bottom
        anchors.left: parent.left
        margin-top: 4
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() modules.game_helper.stepHealPercent(self, -1) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24
      FlatPanel
        id: healPercentBg
        size: 42 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percentBg
        Label
          id: healPercentLabel
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('99%%')
          font: $var-cip-font
          color: $var-text-cip-color
          text-auto-resize: true
      UIButton
        id: healAddPercent
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() modules.game_helper.stepHealPercent(self, 1) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24
      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 6
        image-source: /images/skin/show-gui-help-grey
        !tooltip: tr('Heals the highest-priority listed player whose life is below the set value, when in range')
      CheckBox
        id: prioritizeFriend
        anchors.top: healRmvPercent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        text-align: left
        !text: tr('Prioritize HF')
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 16 -1
        @onCheckChange: modules.game_helper.onPrioritizeFriend(self, self:isChecked())
        !tooltip: tr('When checked, healing the listed friend takes priority over healing your own character\nwhenever both your self-heal and a friend-heal condition would trigger a spell at the same time.\nDefault order is your character first, then Exura Gran Sio (if off cooldown), then Sio.')
        $hover !disabled:
          color: #c0c0c0

  Panel
    id: granSioPanel
    height: 120
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 7
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    enabled: true
    visible: false
    Label
      id: friendTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Exura Gran Sio Helper')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true
    Panel
      id: firstPanel
      anchors.top: friendTitle.bottom
      anchors.left: parent.left
      anchors.right: separator1.left
      anchors.bottom: parent.bottom
      margin: 4 5 4 5
      focusable: true
      Label
        id: selectFriendLabel
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Heal Priority')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
      TextList
        id: friendList2
        height: 50
        anchors.top: selectFriendLabel.bottom
        anchors.left: parent.left
        anchors.right: moveHealUp.left
        margin-top: 4
        margin-right: 3
        padding: 1
        focusable: true
        vertical-scrollbar: friendListScrollBar
        background-color: #484848
      VerticalScrollBar
        id: friendListScrollBar
        anchors.top: friendList2.top
        anchors.right: friendList2.right
        anchors.bottom: friendList2.bottom
        margin: 1 1 1 0
        step: 14
        pixels-scroll: true
      UIWidget
        id: moveHealUp
        size: 14 10
        anchors.top: selectFriendLabel.bottom
        anchors.right: parent.right
        margin-top: 4
        image-source: /images/arrows/icon-uparrow
        cursor: pointer
        opacity: 0.85
        $hover:
          opacity: 1.0
        @onClick: modules.game_helper.moveHealName(self, -1)
        !tooltip: tr('Move selected up (higher priority)')
      UIWidget
        id: moveHealDown
        size: 14 10
        anchors.top: moveHealUp.bottom
        anchors.right: parent.right
        margin-top: 30
        image-source: /images/arrows/icon-downarrow
        cursor: pointer
        opacity: 0.85
        $hover:
          opacity: 1.0
        @onClick: modules.game_helper.moveHealName(self, 1)
        !tooltip: tr('Move selected down (lower priority)')
      ButtonBox
        id: radioPT
        size: 38 18
        anchors.top: friendList2.bottom
        anchors.left: parent.left
        margin-top: 6
        !text: tr('PT')
        font: $var-cip-font
        !tooltip: tr('Fill the list with your nearby party members')
      ButtonBox
        id: radioList
        size: 42 18
        anchors.top: radioPT.top
        anchors.left: radioPT.right
        margin-left: 4
        !text: tr('List')
        font: $var-cip-font
        !tooltip: tr('Use a saved manual list of player names')
      Button
        id: addNames
        size: 18 18
        anchors.top: radioPT.top
        anchors.left: radioList.right
        margin-left: 3
        !text: tr('+')
        font: $var-cip-font
        change-cursor-image: true
        cursor: pointer
        @onClick: modules.game_helper.onAddHealNames(self)
        !tooltip: tr('Add players to the list, separated by ","')
      Button
        id: removeNames
        size: 18 18
        anchors.top: radioPT.top
        anchors.left: addNames.right
        margin-left: 3
        !text: tr('-')
        font: $var-cip-font
        change-cursor-image: true
        cursor: pointer
        @onClick: modules.game_helper.onRemoveHealName(self)
        !tooltip: tr('Remove the selected player from the list')

    VerticalSeparator
      id: separator1
      anchors.top: friendTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5

    Panel
      id: secondPanel2
      anchors.top: friendTitle.bottom
      anchors.left: separator1.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 6 6 6 6
      CheckBox
        id: enableHeal
        width: 90
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Enable')
        margin-top: 2
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 16 -2
        @onCheckChange: modules.game_helper.onEnableHeal(self, self:isChecked())
        $hover !disabled:
          color: #c0c0c0
      Label
        id: healAtLabel
        anchors.top: enableHeal.bottom
        anchors.left: parent.left
        margin-top: 6
        !text: tr('Heal at life:')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
      UIButton
        id: healRmvPercent
        size: 10 24
        anchors.top: healAtLabel.bottom
        anchors.left: parent.left
        margin-top: 4
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() modules.game_helper.stepHealPercent(self, -1) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24
      FlatPanel
        id: healPercentBg
        size: 42 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percentBg
        Label
          id: healPercentLabel
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('99%%')
          font: $var-cip-font
          color: $var-text-cip-color
          text-auto-resize: true
      UIButton
        id: healAddPercent
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() modules.game_helper.stepHealPercent(self, 1) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24
      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 6
        image-source: /images/skin/show-gui-help-grey
        !tooltip: tr('Heals the highest-priority listed player whose life is below the set value, when in range')
      CheckBox
        id: prioritizeFriend
        anchors.top: healRmvPercent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        text-align: left
        !text: tr('Prioritize HF')
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 16 -1
        @onCheckChange: modules.game_helper.onPrioritizeFriend(self, self:isChecked())
        !tooltip: tr('When checked, healing the listed friend takes priority over healing your own character\nwhenever both your self-heal and a friend-heal condition would trigger a spell at the same time.\nDefault order is your character first, then Exura Gran Sio (if off cooldown), then Sio.')
        $hover !disabled:
          color: #c0c0c0

// Reusable +/- percent selector matching the Auto-Healing one. Driven from Lua via
// initPercentSelector(widget, value, min, max, step, suffix, onChange) + onPercentStep.
PercentSelector < UIWidget
  size: 66 24
  focusable: false
  phantom: false

  UIButton
    id: rmv
    size: 10 24
    anchors.left: parent.left
    anchors.top: parent.top
    image-source: /images/ui/percent-buttons
    image-clip: 0 0 10 24
    @onSetup: |
      g_mouse.bindAutoPress(self, function() modules.game_helper.onPercentStep(self:getParent(), -1) end, 150)
    $pressed:
      image-clip: 0 24 10 24
    $disabled:
      image-clip: 0 48 10 24

  FlatPanel
    id: bg
    size: 42 24
    image-source: /images/ui/percentBg
    anchors.left: rmv.right
    anchors.top: parent.top
    margin-left: 2
    Label
      id: label
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      !text: '0'
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true

  UIButton
    id: add
    size: 10 24
    anchors.left: bg.right
    anchors.top: parent.top
    margin-left: 2
    image-source: /images/ui/percent-buttons
    image-clip: 10 0 10 24
    @onSetup: |
      g_mouse.bindAutoPress(self, function() modules.game_helper.onPercentStep(self:getParent(), 1) end, 150)
    $pressed:
      image-clip: 10 24 10 24
    $disabled:
      image-clip: 10 48 10 24

ToolsPanel < Panel
  anchors.fill: parent
  Panel
    id: toolsPanel
    height: 225
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    Label
      id: toolsTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Tools Helper')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true
    Panel
      id: firstPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: separator1.left
      anchors.bottom: parent.bottom
      margin: 5 5 5 5
      Label
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Mana Training')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
      UIButton
        id: spellTrainingButton0
        size: 34 34
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)
      CheckBox
        id: enableTraining0
        width: 100
        anchors.top: prev.top
        anchors.left: spellTrainingButton0.right
        !text: tr('Enable')
        margin-left: 5
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 13 -3
        change-cursor-image: false
        $hover !disabled:
          color: #c0c0c0
        @onCheckChange: modules.game_helper.onEnableTraining(self:getId(), self:isChecked())

      ComboBox
        id: spellTrainingPercent0
        size: 67 20
        anchors.top: prev.bottom
        anchors.left: spellTrainingButton0.right
        margin-top: 2
        margin-left: 5
        color: $var-text-cip-color
        @onOptionChange: updateTrainingPercent('spellTrainingButton0', self:getCurrentOption().text:match("%d+"))
        @onSetup: |
          for i = 10, 100, 10 do
            self:addOption(i .. "%")
          end
          self:setCurrentOption("100%")
      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 4
        image-source: /images/skin/show-gui-help-grey
        !tooltip: tr('Cast a spell when your mana reaches the defined percentage to avoid regeneration waste.')
      HorizontalSeparator
        id: separator
        anchors.top: spellTrainingButton0.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
      Label
        id: toolsLabel
        anchors.top: prev.bottom
        anchors.left: parent.left
        !text: tr('Exercise Training')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
        margin-top: 5
      UIButton
        id: autoTrainingItem
        size: 34 34
        anchors.top: toolsLabel.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onHoverChange: updateButton(self)
        @onMouseRelease: updateButton(self)
      CheckBox
        id: autoTrainingCheck
        width: 100
        anchors.top: prev.top
        anchors.left: autoTrainingItem.right
        !text: tr('Enable')
        margin-left: 5
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 13 -3
        @onCheckChange: checkExerciseEvent()
        change-cursor-image: false
        $hover !disabled:
        color: #c0c0c0
    VerticalSeparator
      id: separator1
      anchors.top: toolsTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5
    Panel
      id: secondPanel
      anchors.top: toolsTitle.bottom
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 5 5 5 5
      Label
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Auto Haste')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
      UIButton
        id: hasteButton0
        size: 34 34
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 7
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)
      CheckBox
        id: enableHaste0
        width: 100
        anchors.top: prev.top
        anchors.left: hasteButton0.right
        !text: tr('Enable')
        margin-left: 5
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 13 -3
        @onCheckChange: toggleAutoHaste(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
        color: #c0c0c0
      CheckBox
        id: castOnPz
        width: 100
        anchors.top: prev.bottom
        anchors.left: hasteButton0.right
        !text: tr('PZ Cast')
        margin-left: 5
        margin-top: 5
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 13 -3
        @onCheckChange: toggleAutoHastePz(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
        color: #c0c0c0
      HorizontalSeparator
        id: separator
        anchors.top: hasteButton0.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
      Label
        id: toolsLabel2
        anchors.top: prev.bottom
        anchors.left: parent.left
        !text: tr('Others Tools')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
        margin-top: 5
      UIWidget
        size: 12 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 2
        image-source: /images/skin/show-gui-help-grey
        !tooltip: tr('Some other useful tools to make your gameplay easier.')
      CheckBox
        id: eatFood
        width: 110
        anchors.top: toolsLabel2.bottom
        anchors.left: parent.left
        !text: tr('Auto Eat Food')
        margin-top: 7
        margin-left: 2
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 13 -3
        @onCheckChange: toggleAutoEat(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
          color: #c0c0c0
      CheckBox
        id: reconnect
        width: 110
        anchors.top: prev.bottom
        anchors.left: parent.left
        !text: tr('Auto Reconnect')
        margin-top: 7
        margin-left: 2
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 13 -3
        text-auto-resize: true
        @onCheckChange: toggleReconnect(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
          color: #c0c0c0
      CheckBox
        id: sellLoot
        width: 110
        anchors.top: prev.bottom
        anchors.left: parent.left
        !text: tr('Auto Sell Loot')
        margin-top: 7
        margin-left: 2
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 13 -3
        text-auto-resize: true
        @onCheckChange: modules.game_helper.toggleAutoSellLoot(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
          color: #c0c0c0
      UIWidget
        size: 12 12
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 4
        image-source: /images/skin/show-gui-help-grey
        !tooltip: tr('Automatically uses your Loot Seller when your free capacity\ndrops below 1000, at most once every 20s.\nSelling to NPCs stays manual.')
      CheckBox
        id: autoBless
        width: 110
        anchors.top: sellLoot.bottom
        anchors.left: parent.left
        !text: tr('Auto Bless')
        margin-top: 7
        margin-left: 2
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 13 -3
        text-auto-resize: true
        @onCheckChange: modules.game_helper.toggleAutoBless(self:isChecked())
        change-cursor-image: false
        $hover !disabled:
          color: #c0c0c0
      UIWidget
        size: 12 12
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 4
        image-source: /images/skin/show-gui-help-grey
        !tooltip: tr('Casts !bless whenever you are missing the 5 blessings,\nso an unexpected death never costs you items.\nStrict: it only fires when actually unblessed, and !bless\nis free when you are already fully blessed.')

  // Mage-only magic-shield suite (utamo vita / exana vita / shield potion).
  // Hidden by default; setupMageShield() shows it for sorcerers & druids.
  Panel
    id: mageShieldPanel
    height: 138
    anchors.top: toolsPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    visible: false

    Label
      id: mageShieldTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Magic Shield (Mage)')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true

    CheckBox
      id: msUtamoEnable
      width: 88
      anchors.top: mageShieldTitle.bottom
      anchors.left: parent.left
      margin-top: 14
      margin-left: 10
      !text: tr('Utamo Vita')
      font: $var-cip-font
      color: $var-text-cip-color
      text-offset: 13 -3
      change-cursor-image: false
      @onCheckChange: mageShieldOnCheck('utamo', self:isChecked())
    PercentSelector
      id: msUtamoLife
      anchors.verticalCenter: prev.verticalCenter
      anchors.left: prev.right
      margin-left: 10
      !tooltip: tr('Cast utamo vita when your life is at or below this %%')
    UIButton
      id: msUtamoSettings
      size: 20 20
      anchors.verticalCenter: prev.verticalCenter
      anchors.left: prev.right
      margin-left: 10
      image-source: /images/ui/options-up
      image-clip: 0 0 20 20
      !tooltip: tr('Utamo Vita settings (renew shield)')
      $pressed:
        image-source: /images/ui/options-down
        image-clip: 0 0 20 20
      @onClick: openUtamoSettings()
    Button
      id: msUtamoKey
      size: 41 15
      anchors.verticalCenter: prev.verticalCenter
      anchors.left: prev.right
      margin-left: 10
      !text: tr('Set Key')
      @onClick: mageSetKey('utamo')

    CheckBox
      id: msExanaEnable
      width: 88
      anchors.top: msUtamoEnable.bottom
      anchors.left: parent.left
      margin-top: 18
      margin-left: 10
      !text: tr('Exana Vita')
      font: $var-cip-font
      color: $var-text-cip-color
      text-offset: 13 -3
      change-cursor-image: false
      @onCheckChange: mageShieldOnCheck('exana', self:isChecked())
    PercentSelector
      id: msExanaLife
      anchors.verticalCenter: prev.verticalCenter
      anchors.left: prev.right
      margin-left: 10
      !tooltip: tr('Cast exana vita when your life is above this %% (and shield is up)')
    Button
      id: msExanaKey
      size: 41 15
      anchors.verticalCenter: prev.verticalCenter
      anchors.left: prev.right
      margin-left: 10
      !text: tr('Set Key')
      @onClick: mageSetKey('exana')

    CheckBox
      id: msPotionEnable
      width: 100
      anchors.top: msExanaEnable.bottom
      anchors.left: parent.left
      margin-top: 18
      margin-left: 10
      !text: tr('Shield Potion')
      font: $var-cip-font
      color: $var-text-cip-color
      text-offset: 13 -3
      change-cursor-image: false
      @onCheckChange: mageShieldOnCheck('potion', self:isChecked())
    UIButton
      id: msPotionSettings
      size: 20 20
      anchors.verticalCenter: prev.verticalCenter
      anchors.left: prev.right
      margin-left: 10
      image-source: /images/ui/options-up
      image-clip: 0 0 20 20
      !tooltip: tr('Magic shield potion settings')
      $pressed:
        image-source: /images/ui/options-down
        image-clip: 0 0 20 20
      @onClick: openPotionSettings()

// Utamo Vita settings: renew-shield threshold.
MageShieldSettings < MainWindow
  id: mageShieldSettings
  size: 320 150
  !text: tr('Utamo Vita Settings')
  font: $var-cip-font

  CheckBox
    id: renewCheck
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 18
    !text: tr('Renew the shield when its capacity is low')
    font: $var-cip-font

  PercentSelector
    id: renewBox
    anchors.top: renewCheck.bottom
    anchors.left: parent.left
    margin-top: 10
  Label
    anchors.left: renewBox.right
    anchors.verticalCenter: renewBox.verticalCenter
    margin-left: 6
    !text: tr('Capacity threshold')
    font: $var-cip-font

  Button
    id: cancelButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 60 22
    !text: tr('Cancel')
  Button
    id: saveButton
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 6
    size: 60 22
    !text: tr('Save')

// Magic Shield Potion settings: use conditions.
MageShieldPotionSettings < MainWindow
  id: mageShieldPotionSettings
  size: 340 200
  !text: tr('Magic Shield Potion Settings')
  font: $var-cip-font

  PercentSelector
    id: lifeBox
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 6
  Label
    anchors.left: parent.left
    anchors.verticalCenter: lifeBox.verticalCenter
    !text: tr('Use if life below (%%, 0 = off)')
    font: $var-cip-font

  PercentSelector
    id: shieldBox
    anchors.top: lifeBox.bottom
    anchors.right: parent.right
    margin-top: 6
  Label
    anchors.left: parent.left
    anchors.verticalCenter: shieldBox.verticalCenter
    !text: tr('Use if shield below (%%, 0 = off)')
    font: $var-cip-font

  CheckBox
    id: vitaCdCheck
    anchors.top: shieldBox.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    height: 18
    !text: tr('Use only when Utamo Vita is on cooldown')
    font: $var-cip-font

  CheckBox
    id: fearCheck
    anchors.top: vitaCdCheck.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 18
    !text: tr('Force use when feared')
    font: $var-cip-font

  Button
    id: cancelButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 60 22
    !text: tr('Cancel')
  Button
    id: saveButton
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 6
    size: 60 22
    !text: tr('Save')

// Key-capture window for the Utamo/Exana toggle hotkeys (mirrors CavebotHotkeyWindow).
MageHotkeyWindow < MainWindow
  id: mageHotkeyWindow
  size: 360 188
  !text: tr('Bind Magic Shield Hotkey')
  font: $var-cip-font

  FlatLabel
    id: display
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 33
    margin-top: 8
    text-align: center
    font: $var-cip-font
    color: $var-text-cip-color

  Label
    id: desc
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    text-align: center
    text-wrap: true
    !text: tr('Press a key or combo, then click Ok to bind it to toggle this function.\nClear removes the hotkey.')
    font: $var-cip-font
    color: $var-text-cip-color

  Label
    id: warning
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8
    text-auto-resize: true
    text-align: center
    !text: tr('This hotkey is already in use by another action.')
    font: $var-cip-font
    color: #f75f5f
    visible: false

  HorizontalSeparator
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10

  Button
    id: buttonClose
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 50 21
    !text: tr('Close')

  Button
    id: buttonClear
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    margin-right: 5
    size: 50 21
    !text: tr('Clear')

  Button
    id: buttonOk
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    margin-right: 5
    size: 50 21
    !text: tr('Ok')

ShooterPanel < Panel
  anchors.fill: parent
  Panel
    id: presetsPanel
    height: 52
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    image-source: /images/ui/2pixel-up-frame-borderimage
    image-border: 10
    padding: 3
    Label
      id: presetsLabel
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 2
      margin-top: 3
      !text: tr('Presets:')
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true
    ComboBox
      id: presets
      size: 90 20
      anchors.top: prev.bottom
      anchors.left: prev.left
      margin-top: 7
      color: $var-text-cip-color
      text-offset: -20 0
      @onOptionChange: toggleShooterPreset(self)
    UIButton
      id: rmvPresetButton
      size: 25 20
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 5
      image-source: /images/ui/rmv-button
      image-clip: 0 0 25 20
      !tooltip: tr('Remove Preset')
      $hover !pressed:
        image-clip: 0 0 25 20
      $pressed:
        image-clip: 0 20 25 20
      @onClick: removeProfile()
    Button
      id: setKeyPresetButton
      size: 41 15
      anchors.top: presetsLabel.top
      anchors.left: presetsLabel.right
      !text: tr('Set Key')
      margin-left: 5
      @onClick: manageHotkeys("Change Shooter Preset")
    UIWidget
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 10
      margin-top: 1
      image-source: /images/skin/show-gui-help-grey
      !tooltip: tr('Choose a hotkey to switch the preset.')
    VerticalSeparator
      id: sep1
      anchors.top: prev.top
      anchors.left: prev.right
      anchors.bottom: parent.bottom
      margin-left: 8
      margin-bottom: 5
    Button
      id: renameButton
      size: 120 20
      anchors.top: parent.top
      anchors.right: parent.right
      !text: tr('Rename Preset')
      font: $var-cip-font
      color: $var-text-cip-color
      margin-top: 2
      margin-right: 5
      !tooltip: tr('Rename the current preset.')
      @onClick: sendRenameOrAddWindow(true)
    Button
      id: saveButton
      size: 120 20
      anchors.top: presets.top
      anchors.right: parent.right
      !text: tr('New Preset')
      font: $var-cip-font
      color: $var-text-cip-color
      image-source: /images/ui/buttons-blue
      margin-right: 5
      !tooltip: tr('Create a new preset.')
      @onClick: sendRenameOrAddWindow(false)

  Panel
    id: spellPanel
    height: 163
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 18
    Label
      id: toolsTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 1
      !text: tr('Spell Shooter Helper')
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true
    Panel
      id: firstPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 5 5 5 5
      Label
        id: spellLabel
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Spell')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
      VerticalSeparator
        id: sep0
        anchors.top: prev.top
        anchors.left: prev.right
        anchors.bottom: parent.bottom
        margin-left: 15
        margin-bottom: 5
      Label
        id: manaPercentLabel
        anchors.top: parent.top
        anchors.left: prev.right
        margin-left: 7
        !text: tr('Mana %%')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
      VerticalSeparator
        id: sep1
        anchors.top: prev.top
        anchors.left: prev.right
        anchors.bottom: parent.bottom
        margin-left: 13
        margin-bottom: 5
      Label
        id: creaturesLabel
        anchors.top: parent.top
        anchors.left: prev.right
        margin-left: 7
        !text: tr('Creatures')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true
      VerticalSeparator
        id: sep2
        anchors.top: prev.top
        anchors.left: prev.right
        anchors.bottom: parent.bottom
        margin-left: 5
        margin-bottom: 5
      Label
        id: priorityLabel
        anchors.top: parent.top
        anchors.left: sep2.right
        margin-left: 5
        !text: tr('Priority')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

      UIButton
        id: attackSpellButton0
        size: 34 34
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 20
        margin-left: 2
        image-source: /images/game/actionbar/actionbarslot
        @onClick: updateButton(self)
        @onMouseRelease: updateButton(self)
      UIButton
        id: rmvPercentButton0
        size: 10 24
        anchors.top: prev.top
        anchors.left: sep0.right
        margin-left: 4
        margin-top: 10
        image-source: /images/ui/percent-buttons
        image-clip: 0 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updateMagicShooterPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 0 0 10 24
        $pressed:
          image-clip: 0 24 10 24
        $disabled:
          image-clip: 0 48 10 24
      FlatPanel
        id: spellPercentBg0
        size: 35 24
        image-source: /images/ui/percentBg
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        !tooltip: tr('Mana Percent')
        Label
          id: spellPercentLabel0
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 4
          !text: tr('80%%')
          font: $var-cip-font
          color: $var-text-cip-color
          text-auto-resize: true
          phantom: true
      UIButton
        id: addPercentButton0
        size: 10 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 2
        image-source: /images/ui/percent-buttons
        image-clip: 10 0 10 24
        @onSetup: |
          g_mouse.bindAutoPress(self, function() updateMagicShooterPercent(self:getId()) end, 150)
        $hover !pressed:
          image-clip: 10 0 10 24
        $pressed:
          image-clip: 10 24 10 24
        $disabled:
          image-clip: 10 48 10 24
      ComboBox
        id: countMinCreature0
        size: 50 24
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 18
        color: $var-text-cip-color
        @onOptionChange: modules.game_helper.updateMagicShooterCreatures(self:getId(), self:getId():match("%d+"), self:getCurrentOption().text:match("%d+"))
        @onSetup: |
          self:addOption("1+")
          self:addOption("2+")
          self:addOption("3+")
          self:addOption("4+")
          self:addOption("5+")
          self:addOption("6+")
          self:addOption("7+")
          self:addOption("8+")
          self:addOption("9+")
          self:addOption("10+")
          self:setCurrentOption("1+")
      CheckBox
        id: conditionSetting0
        width: 12
        anchors.top: prev.top
        anchors.left: prev.right
        margin-left: 5
        margin-top: 7
        change-cursor-image: false
        !tooltip: tr('Cast if have +1 creatures')
        visible: false
        @onCheckChange: toggleForceCast(self:getId():match("%d+"), self:isChecked())
      ComboBox
        id: priority0
        size: 53 24
        anchors.top: countMinCreature0.top
        anchors.left: prev.right
        margin-left: 14
        font: Icon-VBold-11px
        color: $var-text-cip-color
        @onOptionChange: modules.game_helper.updateMagicShooterPriority(self:getId():match("%d+"), self:getCurrentOption().text:match("%d+"))
