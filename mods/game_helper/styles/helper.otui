MagicPotionSettingsWindow < NewMainWindow
  id: magicPotionSettingsWindow
  !text: tr('Magic Potion Settings')
  size: 300 260
  @onEscape: modules.game_helper.saveMagicPotionSettings()

  Panel
    id: contentPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonsPanel.top
    margin-bottom: 5
    padding: 10

    Label
      id: popupTitleLabel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      !text: tr('Magic Potion Settings')
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true

    Panel
      id: hpRow
      anchors.top: popupTitleLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      margin-top: 12

      Label
        id: hpLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        !text: tr('HP:')
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

      HelperTextEdit
        id: magicPotionPercentInput
        size: 55 20
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        padding-top: 3
        color: $var-text-cip-color
        font: $var-cip-font
        only-number: true
        !placeholder: tr('30')
        @onTextChange: |
          local value = modules.game_helper.validatePercentInput(self, 0, 100, 30)
          if value then
            modules.game_helper.updateMagicPotionPercentInput(value)
          end
        @onFocusChange: |
          if not self:isFocused() then
            local text = self:getText()
            if text == "" or tonumber(text) == nil or tonumber(text) < 0 or tonumber(text) > 100 then
              self:setText("30")
              modules.game_helper.updateMagicPotionPercentInput(30)
            end
          end

    Panel
      id: optionsRow
      anchors.top: hpRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 86
      margin-top: 8

      HelperCheckBox
        id: magicPotionOnlyOnVitaCD
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr("Use Only On Vita CD")
        text-auto-resize: true
        font: $var-cip-font
        color: $var-text-cip-color

      HelperCheckBox
        id: magicPotionUseWhenRooted
        anchors.top: magicPotionOnlyOnVitaCD.bottom
        anchors.left: parent.left
        margin-top: 8
        !text: tr("Use when Rooted")
        text-auto-resize: true
        font: $var-cip-font
        color: $var-text-cip-color

      HelperCheckBox
        id: magicPotionUseWhenFeared
        anchors.top: magicPotionUseWhenRooted.bottom
        anchors.left: parent.left
        margin-top: 8
        !text: tr("Use when Feared")
        text-auto-resize: true
        font: $var-cip-font
        color: $var-text-cip-color

    Panel
      id: utamoShieldRow
      anchors.top: optionsRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      margin-top: 6

      HelperCheckBox
        id: magicPotionRenewOnUtamoShield
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        !text: tr("Renew if utamo shield <")
        text-auto-resize: true
        font: $var-cip-font
        color: $var-text-cip-color

      HelperTextEdit
        id: magicPotionUtamoShieldPercentInput
        size: 45 20
        anchors.left: magicPotionRenewOnUtamoShield.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        padding-top: 3
        color: $var-text-cip-color
        font: $var-cip-font
        only-number: true
        !placeholder: tr('30')
        @onTextChange: |
          local value = modules.game_helper.validatePercentInput(self, 0, 100, 30)
          if value then
            modules.game_helper.updateMagicPotionUtamoShieldPercentInput(value)
          end
        @onFocusChange: |
          if not self:isFocused() then
            local text = self:getText()
            if text == "" or tonumber(text) == nil or tonumber(text) < 0 or tonumber(text) > 100 then
              self:setText("30")
              modules.game_helper.updateMagicPotionUtamoShieldPercentInput(30)
            end
          end

      Label
        id: utamoShieldPercentLabel
        anchors.left: magicPotionUtamoShieldPercentInput.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2
        text: %
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

  Panel
    id: buttonsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 30
    margin-left: 8
    margin-right: 8
    margin-bottom: 8

    HelperButton
      id: cancelButton
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 52 22
      !text: tr('Cancel')
      @onClick: modules.game_helper.closeMagicPotionSettings()

    HelperButton
      id: saveButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 52 22
      !text: tr('Save')
      @onClick: modules.game_helper.saveMagicPotionSettings()

