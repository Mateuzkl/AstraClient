// Waypoint Creator - tipos em 2 colunas no topo; Mode (esq) + Direction (dir) no rodape.
// IDs preservados (Lua busca por recursiveGetChildById): nao renomear sem ajustar hunting_recorder.lua.

WaypointCreatorBtn < HelperButton
  height: 24
  change-cursor-image: true
  cursor: pointer

// Botao de modo (segmented control): mesmo visual, com estado $checked destacado.
WaypointModeBtn < HelperButton
  height: 24
  change-cursor-image: true
  cursor: pointer

  $checked:
    image-clip: 0 20 43 20
    text-offset: 1 1
    color: $var-text-cip-color-yellow

// Cabecalho de secao da palette.
WaypointSection < Label
  font: $var-cip-font
  color: $var-text-cip-color-grey
  text-auto-resize: true
  margin-top: 7
  margin-left: 2

// Linha de botoes da palette (2 botoes de 86 ou 1 de 176).
WaypointRow < Panel
  height: 24
  layout:
    type: horizontalBox
    spacing: 4

WaypointCreatorWindow < UIWidget
  id: waypointCreatorWindow
  size: 400 560
  draggable: false
  phantom: false
  focusable: true
  image-source: /images/ui/panel_flat
  image-border: 4
  background-color: #1e1e1eff
  @onEscape: self:destroy()

  UIWidget
    id: dragArea
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 20
    phantom: false

    HorizontalSeparator
      id: dragHandle1
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 4
      width: 30
      phantom: true
      visible: false

    HorizontalSeparator
      id: dragHandle2
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 4
      width: 30
      phantom: true
      visible: false

  Label
    id: titleLabel
    !text: 'Waypoint Creator'
    anchors.top: dragArea.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    font: verdana-11px-rounded
    color: $var-text-cip-color-yellow
    text-align: center
    phantom: true

  Panel
    id: contentPanel
    anchors.top: titleLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    padding: 8
    phantom: true

    Label
      id: waypointTypeLabel
      !text: 'Waypoint Type:'
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 5
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true

    // ===== TOPO: tipos em 2 colunas =====
    Panel
      id: typeColumns
      anchors.top: waypointTypeLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: bottomArea.top
      margin-top: 4
      margin-bottom: 8

      // ----- COLUNA A -----
      Panel
        id: typeColA
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        width: 176
        layout:
          type: verticalBox
          spacing: 2

        WaypointSection
          !text: 'MOVEMENT'
          margin-top: 0
        WaypointRow
          WaypointCreatorBtn
            id: nodeButton
            width: 86
            !text: 'Node'
            @onClick: modules.game_helper.hunting_recorderModule.createWaypointFromCreatorWithType(0)
          WaypointCreatorBtn
            id: standButton
            width: 86
            !text: 'Stand'
            @onClick: modules.game_helper.hunting_recorderModule.createWaypointFromCreatorWithType(1)
        WaypointRow
          WaypointCreatorBtn
            id: gotoButton
            width: 176
            !text: 'Goto'
            @onClick: modules.game_helper.hunting_recorderModule.createGotoWaypoint()

        WaypointSection
          !text: 'INTERACTION'
        WaypointRow
          WaypointCreatorBtn
            id: useButton
            width: 86
            !text: 'Use'
            @onClick: modules.game_helper.hunting_recorderModule.createUseWaypoint()
          WaypointCreatorBtn
            id: leverButton
            width: 86
            !text: 'Lever'
            @onClick: modules.game_helper.hunting_recorderModule.createLeverWaypoint()
        WaypointRow
          WaypointCreatorBtn
            id: ropeButton
            width: 86
            !text: 'Rope'
            @onClick: modules.game_helper.hunting_recorderModule.createRopeWaypoint()
          WaypointCreatorBtn
            id: holeButton
            width: 86
            !text: 'Hole'
            @onClick: modules.game_helper.hunting_recorderModule.createHoleWaypoint()
        WaypointRow
          WaypointCreatorBtn
            id: doorButton
            width: 86
            !text: 'Door'
            @onClick: modules.game_helper.hunting_recorderModule.createDoorWaypoint()

        WaypointSection
          !text: 'LURE'
        WaypointRow
          WaypointCreatorBtn
            id: startLureButton
            width: 86
            !text: 'Start Lure'
            color: $var-text-cip-color-green
            @onClick: modules.game_helper.hunting_recorderModule.createStartLureWaypoint()
          WaypointCreatorBtn
            id: stopLureButton
            width: 86
            !text: 'Stop Lure'
            color: $var-text-cip-color-green
            @onClick: modules.game_helper.hunting_recorderModule.createStopLureWaypoint()

      // ----- COLUNA B -----
      Panel
        id: typeColB
        anchors.top: parent.top
        anchors.left: typeColA.right
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 8
        layout:
          type: verticalBox
          spacing: 2

        WaypointSection
          !text: 'FLOW'
          margin-top: 0
        WaypointRow
          WaypointCreatorBtn
            id: labelButton
            width: 86
            !text: 'Label'
            @onClick: modules.game_helper.hunting_recorderModule.createLabelWaypoint()
          WaypointCreatorBtn
            id: waitDelayButton
            width: 86
            !text: 'Wait Delay'
            @onClick: modules.game_helper.hunting_recorderModule.createWaitDelayWaypoint()
        WaypointRow
          WaypointCreatorBtn
            id: stopCavebotButton
            width: 176
            !text: 'Stop Cavebot'
            color: $var-text-cip-color-light-red
            @onClick: modules.game_helper.hunting_recorderModule.createStopCavebotWaypoint()

        WaypointSection
          !text: 'COMBAT'
        WaypointRow
          WaypointCreatorBtn
            id: stopToKillButton
            width: 176
            !text: 'STOP TO KILL'
            color: $var-text-cip-color-light-red
            @onClick: modules.game_helper.hunting_recorderModule.createStopToKill()

        WaypointSection
          !text: 'LEVITATE'
        WaypointRow
          WaypointCreatorBtn
            id: levitateUpButton
            width: 86
            !text: 'Hur Up'
            color: #BB99FF
            @onClick: modules.game_helper.hunting_recorderModule.createLevitateWaypoint("up")
          WaypointCreatorBtn
            id: levitateDownButton
            width: 86
            !text: 'Hur Down'
            color: #BB99FF
            @onClick: modules.game_helper.hunting_recorderModule.createLevitateWaypoint("down")

        WaypointSection
          !text: 'AREAS'
        WaypointRow
          WaypointCreatorBtn
            id: specialAreaButton
            width: 176
            !text: 'Special Area'
            @onClick: modules.game_helper.hunting_recorderModule.createSpecialAreaWaypoint()

        WaypointSection
          !text: 'SCRIPT'
        WaypointRow
          WaypointCreatorBtn
            id: scriptButton
            width: 176
            !text: 'Script'
            color: #33CCFF
            @onClick: modules.game_helper.hunting_recorderModule.createScriptWaypoint()

    // ===== RODAPE: Mode (esq) + Direction (dir) =====
    Panel
      id: bottomArea
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: buttonsPanel.top
      height: 128
      margin-bottom: 6

      // ----- Mode (esquerda) -----
      Label
        id: modeLabel
        !text: 'Waypoint Mode:'
        anchors.top: parent.top
        anchors.left: parent.left
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

      Panel
        id: modeSegment
        anchors.top: modeLabel.bottom
        anchors.left: parent.left
        margin-top: 8
        width: 178
        height: 24
        layout:
          type: horizontalBox
          spacing: 2

        WaypointModeBtn
          id: modeReplace
          width: 58
          !text: 'Replace'
          @onClick: modules.game_helper.hunting_recorderModule.setCreatorMode('replace')
        WaypointModeBtn
          id: modeAdd
          width: 58
          !text: 'Add'
          checked: true
          @onClick: modules.game_helper.hunting_recorderModule.setCreatorMode('add')
        WaypointModeBtn
          id: modeInsert
          width: 58
          !text: 'Insert'
          @onClick: modules.game_helper.hunting_recorderModule.setCreatorMode('insert')

      // ----- Direction (direita) -----
      Label
        id: directionLabel
        !text: 'Direction:'
        anchors.top: parent.top
        anchors.left: modeSegment.right
        margin-left: 18
        font: $var-cip-font
        color: $var-text-cip-color
        text-auto-resize: true

      Panel
        id: directionPanel
        anchors.top: directionLabel.bottom
        anchors.left: modeSegment.right
        anchors.right: parent.right
        margin-left: 18
        margin-top: 6
        height: 104

        # Linha 1: NW, N, NE
        Panel
          id: directionRow1
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 16
          layout:
            type: horizontalBox
            spacing: 8

          HelperCheckBox
            id: dirNW
            !text: 'NW'
            width: 50
            @onClick: modules.game_helper.hunting_recorderModule.setCreatorDirection(7)
          HelperCheckBox
            id: dirN
            !text: 'N'
            width: 50
            @onClick: modules.game_helper.hunting_recorderModule.setCreatorDirection(0)
          HelperCheckBox
            id: dirNE
            !text: 'NE'
            width: 50
            @onClick: modules.game_helper.hunting_recorderModule.setCreatorDirection(4)

        # Linha 2: W, C, E
        Panel
          id: directionRow2
          anchors.top: directionRow1.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 16
          margin-top: 8
          layout:
            type: horizontalBox
            spacing: 8

          HelperCheckBox
            id: dirW
            !text: 'W'
            width: 50
            @onClick: modules.game_helper.hunting_recorderModule.setCreatorDirection(3)
          HelperCheckBox
            id: dirC
            !text: 'C'
            width: 50
            checked: true
            @onClick: modules.game_helper.hunting_recorderModule.setCreatorDirection(nil)
          HelperCheckBox
            id: dirE
            !text: 'E'
            width: 50
            @onClick: modules.game_helper.hunting_recorderModule.setCreatorDirection(1)

        # Linha 3: SW, S, SE
        Panel
          id: directionRow3
          anchors.top: directionRow2.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 16
          margin-top: 8
          layout:
            type: horizontalBox
            spacing: 8

          HelperCheckBox
            id: dirSW
            !text: 'SW'
            width: 50
            @onClick: modules.game_helper.hunting_recorderModule.setCreatorDirection(6)
          HelperCheckBox
            id: dirS
            !text: 'S'
            width: 50
            @onClick: modules.game_helper.hunting_recorderModule.setCreatorDirection(2)
          HelperCheckBox
            id: dirSE
            !text: 'SE'
            width: 50
            @onClick: modules.game_helper.hunting_recorderModule.setCreatorDirection(5)

    Panel
      id: buttonsPanel
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 28
      layout:
        type: horizontalBox
        align-right: true
        spacing: 5
      margin-bottom: 5

      WaypointCreatorBtn
        id: closeButton
        !text: 'Close'
        size: 80 25
        @onClick: modules.game_helper.hunting_recorderModule.closeWaypointCreator()
