MainWindow
  id: cavebotsManagerWindow
  size: 500 500
  image-source: /images/ui/login/login_frame
  image-border: 16
  text: Cavebots Manager
  draggable: true
  @onEscape: self:destroy()
  @onSetup: |
    g_keyboard.bindKeyPress('Up', function() 
      local listBox = self:recursiveGetChildById('cavebotsListBox')
      if listBox then
        listBox:focusPreviousChild(KeyboardFocusReason)
      end
    end, self)
    g_keyboard.bindKeyPress('Down', function() 
      local listBox = self:recursiveGetChildById('cavebotsListBox')
      if listBox then
        listBox:focusNextChild(KeyboardFocusReason)
      end
    end, self)

  Panel
    id: cavebotsMainPanel
    anchors.fill: parent
    margin: 10
    margin-top: 2

    Label
      id: currentCavebotLabel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      !text: tr('Cavebot: None')
      font: verdana-11px-monochrome
      color: #4CAF50
      text-auto-resize: true

    Panel
      id: cavebotsButtonsPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 40
      margin-top: 5

      Panel
        id: firstRowButtons
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
        height: 20
        layout:
          type: horizontalBox
          spacing: 5

        HelperButton
          id: newCavebotButton
          size: 55 20
          !text: tr('New')
          @onClick: |
            print("[CLICK] New button clicked")
            modules.game_helper.hunting_recorderModule.confirmNewCavebot()

        HelperButton
          id: loadCavebotButton
          size: 55 20
          !text: tr('Load')
          @onClick: |
            print("[CLICK] Load button clicked")
            modules.game_helper.hunting_recorderModule.loadSelectedCavebot()

        HelperButton
          id: saveCavebotButton
          size: 55 20
          !text: tr('Save')
          @onClick: |
            print("[CLICK] Save button clicked")
            modules.game_helper.hunting_recorderModule.saveCurrentCavebot()

        HelperButton
          id: deleteCavebotButton
          size: 55 20
          !text: tr('Delete')
          @onClick: |
            print("[CLICK] Delete button clicked")
            modules.game_helper.hunting_recorderModule.deleteSelectedCavebot()

        HelperButton
          id: reloadButton
          size: 55 20
          !text: tr('Reload')
          @onClick: |
            print("[CLICK] Reload button clicked")
            modules.game_helper.hunting_recorderModule.reloadCavebotsList()

        HelperButton
          id: importZeroCbButton
          size: 130 20
          !text: tr('Import from Zerobot')
          @onClick: |
            print("[CLICK] Import .cb button clicked")
            modules.game_helper.hunting_recorderModule.importZeroBotCavebot()
    
    TextList
      id: cavebotsListBox
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: closeButton.top
      margin-bottom: 5
      vertical-scrollbar: cavebotsListScrollBar
      background-color: #00000040
      padding: 0
      focusable: true
      @onSelectionChange: |
        local selectedItem = self:getSelectedItem()
        modules.game_helper.hunting_recorderModule.onCavebotListSelectionChange(selectedItem)
        -- Atualizar cores de todos os itens
        for _, child in ipairs(self:getChildren()) do
          if child.updateOnStates then
            child:updateOnStates()
          end
        end
      @onMousePress: modules.game_helper.hunting_recorderModule.onCavebotsListMousePress(self, mousePos, mouseButton)
    
    HelperScrollBar
      id: cavebotsListScrollBar
      anchors.top: cavebotsListBox.top
      anchors.bottom: cavebotsListBox.bottom
      anchors.right: cavebotsListBox.right
      step: 18
      pixels-scroll: true

    HelperButton
      id: openFolderButton
      width: 100
      height: 20
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      !text: tr('Open Folder')
      margin: 2
      margin-bottom: 5
      margin-left: 0
      @onClick: |
        modules.game_helper.hunting_recorderModule.openCavebotsFolder()

    HelperButton
      id: closeButton
      height: 20
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Close')
      margin: 2
      margin-bottom: 5
      margin-right: 5
      @onClick: |
        self:getParent():getParent():destroy()


