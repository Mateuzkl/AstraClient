NewMainWindow
  id: timerSettingsPopup
  !text: tr('Add Timer')
  size: 336 248
  @onEscape: modules.game_helper.closeTimerSettingsPopup()

  Panel
    id: contentPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonsPanel.top
    margin-bottom: 5
    padding: 10

    Label
      id: popupTitleLabel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      !text: tr('Add Timer')
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true

    Panel
      id: actionRow
      anchors.top: popupTitleLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      margin-top: 12

      Label
        id: actionTypeLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 60
        !text: tr('Action:')
        font: $var-cip-font
        color: $var-text-cip-color

      HelperComboBox
        id: actionTypeCombo
        anchors.left: actionTypeLabel.right
        anchors.verticalCenter: parent.verticalCenter
        size: 100 20

    Panel
      id: intervalRow
      anchors.top: actionRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      margin-top: 6

      Label
        id: intervalLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 60
        !text: tr('Interval:')
        font: $var-cip-font
        color: $var-text-cip-color

      HelperTextEdit
        id: intervalInput
        anchors.left: intervalLabel.right
        anchors.verticalCenter: parent.verticalCenter
        size: 50 18
        color: $var-text-cip-color
        font: $var-cip-font

      HelperComboBox
        id: intervalUnitCombo
        anchors.left: intervalInput.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        size: 110 20

    Panel
      id: itemRow
      anchors.top: intervalRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 34
      margin-top: 8

      Label
        id: itemLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 60
        !text: tr('Item:')
        font: $var-cip-font
        color: $var-text-cip-color

      UIButton
        id: itemPreviewButton
        anchors.left: itemLabel.right
        anchors.verticalCenter: parent.verticalCenter
        size: 34 34
        image-source: /images/game/actionbar/slot-actionbar.png

      UIWidget
        id: itemInfoIcon
        anchors.left: itemPreviewButton.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        size: 12 12
        color: $var-text-cip-color
        image-source: /images/icons/show_gui_help_grey
        !tooltip: tr('Left/right click to configure item slot')

      Label
        id: itemNameLabel
        anchors.left: itemInfoIcon.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        anchors.right: parent.right
        !text: tr('')
        font: $var-cip-font
        color: $var-text-cip-color
        text-wrap: true

    Panel
      id: textRow
      anchors.top: intervalRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      margin-top: 8
      visible: false

      Label
        id: wordsLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 60
        !text: tr('Words:')
        font: $var-cip-font
        color: $var-text-cip-color

      HelperTextEdit
        id: wordsInput
        anchors.left: wordsLabel.right
        anchors.verticalCenter: parent.verticalCenter
        anchors.right: parent.right
        margin-right: 4
        height: 18
        color: $var-text-cip-color
        font: $var-cip-font
        text-horizontal-margin: 3
        text-vertical-margin: 3
        placeholder: Type here...

    Panel
      id: conditionsRow
      anchors.top: itemRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      margin-top: 10

      Label
        id: conditionsLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 60
        !text: tr('Zones:')
        font: $var-cip-font
        color: $var-text-cip-color

      HelperCheckBox
        id: runInPzCheck
        anchors.left: conditionsLabel.right
        anchors.verticalCenter: parent.verticalCenter
        width: 52
        !text: tr('PZ')
        text-offset: 17 0
        change-cursor-image: false
        color: $var-text-cip-color
        font: $var-cip-font

      HelperCheckBox
        id: runOutPzCheck
        anchors.left: runInPzCheck.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 10
        width: 78
        !text: tr('OUT PZ')
        text-offset: 17 0
        change-cursor-image: false
        color: $var-text-cip-color
        font: $var-cip-font

  Panel
    id: buttonsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 30
    margin-left: 8
    margin-right: 8
    margin-bottom: 8

    HelperButton
      id: cancelButton
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 52 22
      !text: tr('Cancel')
      @onClick: modules.game_helper.closeTimerSettingsPopup()

    HelperButton
      id: saveButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 52 22
      !text: tr('Add')
      @onClick: modules.game_helper.saveTimerSettingsPopup()
