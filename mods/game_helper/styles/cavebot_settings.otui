CavebotSettingsWindow < NewMainWindow
  id: cavebotSettingsWindow
  anchors.horizontalCenter: parent.horizontalCenter
  anchors.verticalCenter: parent.verticalCenter
  !text: tr('Cavebot Settings')
  font: $var-main-font
  color: #AAAAAA
  size: 300 524
  @onEscape: self:hide()

  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 14 12 12 12

    Panel
      id: safetyLureSection
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 85
      image-source: /images/ui/panel_flat
      image-border: 1

      Label
        id: safetyLureTitle
        !text: tr('[Safety Lure Settings]')
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3
        font: $var-main-font
        color: #AAAAAA
        text-align: center

      Label
        id: minMonstersLabel
        !text: tr('Min monsters to wait lure:')
        anchors.top: safetyLureTitle.bottom
        anchors.left: parent.left
        margin-top: 8
        margin-left: 8
        font: $var-main-font

      UITooltipGrey
        id: infoMinMonstersToWait
        anchors.top: safetyLureTitle.bottom
        anchors.right: parent.right
        margin-top: 8
        margin-right: 8
        !tooltip: tr('Minimum monsters on screen required to start luring.\nExample: If set to 2, luring only begins when 2+ monsters are visible.')

      SpinBox
        id: minMonstersToWait
        anchors.top: safetyLureTitle.bottom
        anchors.right: infoMinMonstersToWait.left
        margin-top: 5
        margin-right: 5
        width: 40
        minimum: 0
        maximum: 20

      Label
        id: nearMonstersLabel
        // Was "Near monsters to run:", and the tooltip promised the bot would
        // flee. It never did: avoidLostInMonsters() returns false at this
        // threshold, which means "stop waiting for stragglers and walk on".
        // There is no escape behaviour anywhere in that function.
        !text: tr('Stop waiting when surrounded:')
        anchors.top: minMonstersLabel.bottom
        anchors.left: parent.left
        margin-top: 10
        margin-left: 8
        font: $var-main-font

      UITooltipGrey
        id: infoAvoidTrap
        image-border: 0
        anchors.top: minMonstersLabel.bottom
        anchors.right: parent.right
        margin-top: 10
        margin-right: 8
        !tooltip: tr('How hemmed in you must be before the cavebot gives\nup waiting for monsters that fall behind.\n\nAdds up monsters within 2 tiles and blocked tiles\naround you. Once the total reaches this number the\nwalker carries on instead of standing still.\n\nThe bot does not flee at this threshold - it only\nstops waiting. Set to 0 to always wait.')

      SpinBox
        id: avoidTrap
        anchors.top: minMonstersLabel.bottom
        anchors.right: infoAvoidTrap.left
        margin-top: 7
        margin-right: 5
        width: 40
        minimum: 0
        maximum: 20

    Panel
      id: autoRecorderSection
      anchors.top: safetyLureSection.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      height: 95
      image-source: /images/ui/panel_flat
      image-border: 1

      Label
        id: autoRecorderTitle
        !text: tr('[Auto Recorder Settings]')
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3
        font: $var-main-font
        color: #AAAAAA
        text-align: center

      Label
        id: distanceLabel
        !text: tr('Distance:')
        anchors.top: autoRecorderTitle.bottom
        anchors.left: parent.left
        margin-top: 8
        margin-left: 8
        font: $var-main-font

      UITooltipGrey
        id: infoRecorderDist
        image-border: 0
        anchors.top: autoRecorderTitle.bottom
        anchors.right: parent.right
        margin-top: 8
        margin-right: 8
        !tooltip: tr('Minimum distance to record a new waypoint (1-8 sqm).')

      SpinBox
        id: recorderDistance
        anchors.top: autoRecorderTitle.bottom
        anchors.right: infoRecorderDist.left
        margin-top: 5
        margin-right: 5
        width: 40
        minimum: 1
        maximum: 8

      Label
        id: typeLabel
        !text: tr('Type:')
        anchors.top: distanceLabel.bottom
        anchors.left: parent.left
        margin-top: 10
        margin-left: 8
        font: $var-main-font

      CheckBoxCircle
        id: typeStand
        !text: tr('Stand')
        anchors.verticalCenter: typeLabel.verticalCenter
        anchors.left: typeLabel.right
        margin-left: 10
        width: 55

      CheckBoxCircle
        id: typeNode
        !text: tr('Node')
        anchors.verticalCenter: typeLabel.verticalCenter
        anchors.left: typeStand.right
        margin-left: 15
        width: 55

      Label
        id: recordingKeyLabel
        !text: tr('Recording Key:')
        anchors.top: typeLabel.bottom
        anchors.left: parent.left
        margin-top: 10
        margin-left: 8
        font: $var-main-font

      Button
        id: setRecordingKeyButton
        !text: tr('Set Key')
        anchors.verticalCenter: recordingKeyLabel.verticalCenter
        anchors.left: recordingKeyLabel.right
        margin-left: 10
        width: 60
        height: 18
        @onClick: modules.game_helper.manageHotkeys("Toggle Recording")

    Panel
      id: nodeSection
      anchors.top: autoRecorderSection.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      height: 50
      image-source: /images/ui/panel_flat
      image-border: 1

      Label
        id: nodeTitle
        !text: tr('[Node Settings]')
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3
        font: $var-main-font
        color: #AAAAAA
        text-align: center

      Label
        id: nodeDistanceLabel
        !text: tr('Distance:')
        anchors.top: nodeTitle.bottom
        anchors.left: parent.left
        margin-top: 8
        margin-left: 8
        font: $var-main-font

      UITooltipGrey
        id: infoNodeDist
        anchors.top: nodeTitle.bottom
        anchors.right: parent.right
        margin-top: 8
        margin-right: 8
        !tooltip: tr('Distance to recognize Node waypoint before moving to next index (1-5 sqm).')

      SpinBox
        id: nodeDistance
        anchors.top: nodeTitle.bottom
        anchors.right: infoNodeDist.left
        margin-top: 5
        margin-right: 5
        width: 40
        minimum: 1
        maximum: 5

    Panel
      id: walkingSection
      anchors.top: nodeSection.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      height: 65
      image-source: /images/ui/panel_flat
      image-border: 1

      Label
        id: walkingTitle
        !text: tr('[Walking Settings]')
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3
        font: $var-main-font
        color: #AAAAAA
        text-align: center

      UITooltipGrey
        id: infoWalking
        anchors.top: parent.top
        anchors.right: parent.right
        margin-top: 3
        margin-right: 8
        !tooltip: tr('Walking method and delay settings.\nMap Walk: Uses map click pathfinding.\nArrow Keys: Uses keyboard movement.\nWalk Delay: Additional delay (ms) added to each step.\nNote: Walk Delay only applies when monster count >= Min monsters to wait lure.')

      CheckBoxCircle
        id: walkMapWalk
        !text: tr('Map Walk')
        anchors.top: walkingTitle.bottom
        anchors.left: parent.left
        margin-top: 8
        margin-left: 8
        width: 80

      CheckBoxCircle
        id: walkArrowKeys
        !text: tr('Arrow Keys')
        anchors.top: walkingTitle.bottom
        anchors.left: walkMapWalk.right
        margin-top: 8
        margin-left: 10
        width: 80

      Label
        id: walkDelayLabel
        !text: tr('Walk Delay:')
        anchors.top: walkMapWalk.bottom
        anchors.left: parent.left
        margin-top: 8
        margin-left: 8
        font: $var-main-font

      TextEdit
        id: walkDelay
        anchors.verticalCenter: walkDelayLabel.verticalCenter
        anchors.left: walkDelayLabel.right
        margin-left: 5
        width: 50
        height: 20
        focusable: true

      Label
        id: walkDelayMs
        !text: tr('ms')
        anchors.verticalCenter: walkDelayLabel.verticalCenter
        anchors.left: walkDelay.right
        margin-left: 5
        font: $var-main-font

    Panel
      id: advancedSection
      anchors.top: walkingSection.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      height: 112
      image-source: /images/ui/panel_flat
      image-border: 1

      Label
        id: advancedTitle
        !text: tr('[Cavebot Assistance]')
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3
        font: $var-main-font
        color: #AAAAAA

      // One checkbox per line, each spanning the section.
      //
      // These were laid out as a 2x2 grid: two boxes on parent.left and two on
      // parent.horizontalCenter, with fixed widths of 120 and 130. Half the
      // section is only ~130px wide, so "Walk to WP center" and "Skip fight
      // near players" ran straight under the right-hand column. The grid was
      // also mis-anchored -- skipFightOnPlayer hung off avoidPlayers, which is
      // in the *right* column, so it landed on a third row rather than beside
      // tryWalkCenter. Stacking removes the width limit entirely: each label
      // now has the full section to draw in and can never collide.
      CheckBox
        id: tryWalkCenter
        !text: tr('Walk to WP center')
        anchors.top: advancedTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        margin-left: 8
        margin-right: 8

      CheckBox
        id: dynamicLure
        !text: tr('Dynamic lure')
        // Hard-wrapped on purpose: the tooltip is a bare UILabel with no
        // text-wrap, so it sizes itself to the widest line. One long paragraph
        // would render as a single line wider than the screen.
        !tooltip: tr('Gathers a pack of monsters before fighting it.\n\nWhile fewer monsters are near you than "Min monsters to\nwait lure" above, Auto Target and Magic Shooter are held\nback, and any attack already in progress is cancelled.\nThe cavebot keeps walking its route, so more monsters\nfollow you. Once the count is reached combat resumes\nand you fight them all together.\n\nCounts monsters within 7 tiles that are in line of sight.\nNames on the ignore list never count.\nThe bot HUD shows progress as "Dynamic lure 1/2".')
        anchors.top: tryWalkCenter.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        margin-left: 8
        margin-right: 8

      CheckBox
        id: avoidPlayers
        !text: tr('Avoid players')
        anchors.top: dynamicLure.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        margin-left: 8
        margin-right: 8

      CheckBox
        id: skipFightOnPlayer
        !text: tr('Skip fight near players')
        !tooltip: tr('Keeps walking and suppresses Auto Target and Magic Shooter while another player is visible.')
        anchors.top: avoidPlayers.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        margin-left: 8
        margin-right: 8

    CloseButton
      id: closeButton
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
