SpellPreview < UICheckBox
  height: 34
  text-wrap: true
  multi-line: true
  focusable: true
  text-offset: 38 2
  image-source:
  change-cursor-image: false
  font: verdana-11px-monochrome
  color: #c0c0c0

  $hover !disabled:
    color: #ffffff

  $!checked:
    background-color: alpha
    color: #c0c0c0

  $checked:
    background-color: #ffffff18
    color: #f4f4f4


  UIWidget
    id: image
    anchors.left: parent.left
    anchors.top: parent.top
    phantom: true
    padding: 1
    size: 32 32

    Panel
      id: gray
      size: 32 32
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: -1
      margin-left: -1
      image-source: /images/ui/ditherpattern
      visible: false

  UIWidget
    id: imageGroup
    size: 20 20
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 8
    margin-right: 99
    phantom: true
    visible: false
    image-source: /images/game/spells/cooldowns
    image-clip: 1 25 20 20

  Label
    id: levelLabel
    anchors.top: parent.top
    anchors.left: prev.right
    margin-top: 12
    margin-left: 6
    !text: tr('Level: 0')
    font: verdana-11px-monochrome
    color: #c0c0c0
    text-auto-resize: true
    visible: false

NewMainWindow
  id: assignSpellWindow
  size: 375 609
  image-source: /images/ui/login/login_frame
  image-border: 16
  @onEscape: self:destroy()
  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 12 12 12 12
    SpellPreview
      id: preview
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      focusable: false
      $!checked:
        background-color: alpha
      $checked:
        background-color: alpha

    HorizontalSeparator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 9

    TextList
      id: spellList
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 11
      height: 420
      padding: 6
      padding-top: 26
      focusable: false
      vertical-scrollbar: listScrollBar
      background-color: #00000040

    HelperTextEdit
      id: searchText
      size: 160 20
      anchors.top: prev.top
      anchors.left: prev.left
      anchors.right: prev.right
      margin-top: 1
      margin-right: 1
      margin-left: 1
      !placeholder: tr('Type to search')
      padding: 2
      font: verdana-11px-monochrome
      placeholder-color: #808080
      @onTextChange: modules.game_helper.onSearchTextChange(self:getText())
    HelperButton
      id: clearButton
      anchors.top: prev.top
      anchors.right: prev.right
      margin-top: 1
      margin-right: 1
      size: 18 18
      image-source: /images/store/button-erase-small-up
      image-clip: 0 0 18 18
      @onClick: modules.game_helper.onClearSearchText()
      $pressed:
        image-source: /images/store/button-erase-small-down
        image-clip: 0 0 18 18
      $!hover:
        image-source: /images/store/button-erase-small-up
        image-clip: 0 0 18 18

    HelperScrollBar
      id: listScrollBar
      anchors.top: searchText.bottom
      anchors.right: spellList.right
      margin: 6 1 1 0
      anchors.bottom: spellList.bottom
      step: 14
      pixels-scroll: true

    FlatPanel
      id: checkPanel
      anchors.top: spellList.bottom
      margin-top: 6
      anchors.left: parent.left
      anchors.right: parent.right
      height: 22

      HelperCheckBox
        id: tick
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        anchors.right: parent.right
        margin-left: 5
        text: Only show learnt spells
        font: verdana-11px-monochrome
        color: #c0c0c0
        checked: true
        change-cursor-image: false
        $hover !disabled:
          color: #c0c0c0

    Label
      id: paramLabel
      anchors.top: prev.bottom
      margin-top: 7
      anchors.left: parent.left
      text: Parameter:
      font: verdana-11px-monochrome
      color: #c0c0c0
      text-auto-resize: true
      text-offset: -2 0
      on: false

      $on:
        color: #c0c0c0

      $!on:
        color: #707070

    HelperTextEdit
      id: paramText
      anchors.top: prev.top
      anchors.left: prev.right
      anchors.right: parent.right
      margin-top: -1
      margin-left: 5
      enabled: true

    HorizontalSeparator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 11

    HelperButton
      id: buttonClose
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      size: 60 22
      font: verdana-11px-monochrome
      text: Cancel

    HelperButton
      id: buttonApply
      anchors.right: prev.left
      margin-right: 8
      anchors.bottom: parent.bottom
      size: 60 22
      font: verdana-11px-monochrome
      text: Apply

    HelperButton
      id: buttonOk
      anchors.right: prev.left
      margin-right: 8
      anchors.bottom: parent.bottom
      size: 60 22
      font: verdana-11px-monochrome
      text: Ok
