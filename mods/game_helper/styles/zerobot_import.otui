NewMainWindow
  id: zerobotImportWindow
  !text: tr('Import from ZeroBot')
  size: 460 340
  @onEscape: modules.game_helper.closeZerobotImportDialog()

  Panel
    id: zerobotContentPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: zerobotButtonsPanel.top
    margin-bottom: 6
    padding: 10

    Label
      id: zerobotLabel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 6
      font: $var-cip-font
      color: $var-text-cip-color
      text-wrap: true
      !text: tr('Paste the ZeroBot profile JSON below or use Browse to select a file:')

    HelperButton
      id: zerobotBrowseButton
      anchors.top: zerobotLabel.bottom
      anchors.right: parent.right
      margin-top: 4
      margin-bottom: 4
      size: 90 22
      !text: tr('Browse...')
      @onClick: modules.game_helper.zerobotImportBrowse()

    MultilineTextEdit
      id: zerobotJsonEdit
      anchors.top: zerobotBrowseButton.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      font: $var-cip-font
      color: $var-text-cip-color
      padding: 4

  Panel
    id: zerobotButtonsPanel
    height: 36
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 10
    margin-right: 10
    margin-bottom: 8

    HelperButton
      id: zerobotCancelButton
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 80 26
      !text: tr('Cancel')
      @onClick: modules.game_helper.closeZerobotImportDialog()

    HelperButton
      id: zerobotImportButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 80 26
      !text: tr('Import')
      @onClick: modules.game_helper.zerobotImportDoImport()
