HelperTracker < MiniWindow
  id: helperTrackerWindow
  !text: tr('Helper Stats')
  height: 200
  &type: 'helper'
  @onClose: HelperTrackerModule.onMiniWindowClose()

  MiniWindowContents
    id: contentsPanel
    anchors.fill: parent
    margin: 20 9 5 9

    HelperButton
      id: helperStatusBtn
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      !text: tr('General Helper: Inactive')
      height: 22
      margin-left: 5
      margin-right: 5

    HelperButton
      id: caveHelperStatusBtn
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      !text: tr('Cavebot Helper: Inactive')
      height: 22
      margin-top: 3
      margin-left: 5
      margin-right: 5

    HelperButton
      id: targetStatusBtn
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      !text: tr('Target Helper: Inactive')
      height: 22
      margin-top: 3
      margin-left: 5
      margin-right: 5

    HelperButton
      id: shooterStatusBtn
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      !text: tr('Shooter Helper: Inactive')
      height: 22
      margin-top: 3
      margin-left: 5
      margin-right: 5

    HelperButton
      id: presetBtn
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      !text: tr('Preset: Default')
      height: 22
      margin-top: 3
      margin-left: 5
      margin-right: 5

    HelperButton
      id: utilityStatusBtn
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      !text: tr('Utility Helper: Inactive')
      height: 22
      margin-top: 3
      margin-left: 5
      margin-right: 5

    HelperButton
      id: openHelper
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      !text: tr('Open Helper')
      height: 20
      width: 120
      margin-top: 10
      @onClick: modules.game_helper:show(true)

  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder
    size: 14 14
    margin-left: 2
    margin-bottom: 2

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 200
    maximum: 200
    margin-left: 3
    margin-right: 3
