MiniBotHuntingRecorderEntry < UIWidget
  height: 18
  background-color: alpha
  text-align: left
  text-offset: 3 0
  color: $var-text-cip-color
  font: $var-cip-font
  focusable: true
  &updateOnStates: |
    function(self)
      -- Apply selection background color when focused (mesmo que cavebot list)
      if self:isFocused() then
        self:setBackgroundColor("#585858")
      else
        -- Use base background color when not focused
        if self.baseBackgroundColor then
          self:setBackgroundColor(self.baseBackgroundColor)
        end
      end
    end
  @onFocusChange: self:updateOnStates()

  $focus:
    background-color: #ffffff18

  UIWidget
    id: mask
    anchors.fill: parent
    background-color: white
    opacity: 0.2
    visible: false
    phantom: true

  UIWidget
    id: leftBorder
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 1
    background-color: #ffffff10
    phantom: true

  UIWidget
    id: rightBorder
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 1
    background-color: #ffffff10
    phantom: true

  UIWidget
    id: bottomBorder
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 1
    background-color: #ffffff10
    phantom: true

CavebotListEntry < UIWidget
  height: 18
  background-color: alpha
  text-align: left
  text-offset: 3 0
  color: $var-text-cip-color
  font: $var-cip-font
  focusable: true
  &updateOnStates: |
    function(self)
      -- Apply selection background color when focused
      if self:isFocused() then
        self:setBackgroundColor("#585858")
      else
        -- Use base background color when not focused
        if self.baseBackgroundColor then
          self:setBackgroundColor(self.baseBackgroundColor)
        end
      end
    end
  @onFocusChange: self:updateOnStates()

  $focus:
    background-color: #ffffff18

  UIWidget
    id: leftBorder
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 1
    background-color: #ffffff10
    phantom: true

  UIWidget
    id: rightBorder
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 1
    background-color: #ffffff10
    phantom: true

  UIWidget
    id: bottomBorder
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 1
    background-color: #ffffff10
    phantom: true

UIWidget
  anchors.fill: parent

  UIWidget
    id: map
    image-source: /images/ui/panel_flat
    image-border: 1
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.right: parent.right
    height: 200

    HelperButton
      id: centerPlayerButton
      !text: tr('Center')
      anchors.top: parent.top
      anchors.left: parent.left
      size: 50 13
      margin-top: 3
      margin-left: 2
      color: $var-text-cip-color
      text-offset: 0 2
      @onClick: modules.game_helper.hunting_recorderModule.centerOnPlayer()

    Label
      id: title
      !text: 'Map Preview'
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      text-horizontal-auto-resize: true
      margin-top: 2
      phantom: true
      color: $var-text-cip-color-grey

    ButtonBox
      id: enabled
      anchors.top: parent.top
      anchors.right: parent.right
      font: cipsoftFont
      !text: 'Off'
      size: 50 13
      color: $var-text-cip-color-light-red
      text-offset: 1 2
      checked: false
      margin-top: 3
      margin-right: 2
      visible: false

      $!checked:
        color: $var-text-cip-color-light-red
        text-offset: 1 1
        change-cursor-image: false
        !text: 'Disabled'

      $checked:
        color: $var-text-cip-color-green
        text-offset: 2 2
        change-cursor-image: false
        !text: 'Enabled'

    UIMinimap
      id: minimap
      draggable: true
      focusable: false
      cross: true
      color: black
      anchors.fill: parent
      margin-left: 5
      margin-right: 5
      margin-bottom: 5
      margin-top: 20

  UIWidget
    id: buttons
    image-source: /images/ui/panel_flat
    image-border: 1
    anchors.top: prev.bottom
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 5
    width: 150

    Label
      id: title
      !text: 'Actions'
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      text-horizontal-auto-resize: true
      margin-top: 2
      phantom: true
      color: $var-text-cip-color-grey

    Panel
      id: buttonsList
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-top: 23
      margin-left: 8
      margin-right: 8
      margin-bottom: 8

      Label
        id: cavebotsListTitle
        !text: tr('Cavebots')
        anchors.top: parent.top
        anchors.left: parent.left
        font: $var-cip-font
        color: $var-text-cip-color-grey
        text-auto-resize: true

      ScrollablePanel
        id: cavebotsList
        vertical-scrollbar: cavebotsListScrollBar
        padding: 0
        background-color: #00000040
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: cavebotsListTitle.bottom
        height: 150
        margin-top: 3
        layout:
          type: verticalBox

      HelperScrollBar
        id: cavebotsListScrollBar
        anchors.top: cavebotsList.top
        anchors.bottom: cavebotsList.bottom
        anchors.right: cavebotsList.right
        step: 18
        pixels-scroll: true

      HelperButton
        id: cavebotsButton
        !text: tr('Manage')
        anchors.top: cavebotsList.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 20
        margin-top: 3
        @onClick: modules.game_helper.hunting_recorderModule.openCavebotsManager()

      HelperButton
        id: settingsButton
        !text: tr('Settings')
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 20
        margin-top: 3
        @onClick: modules.game_helper.hunting_recorderModule.openCavebotSettings()

      HelperButton
        id: creatorButton
        !text: tr('Creator')
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 20
        margin-top: 3
        @onClick: modules.game_helper.hunting_recorderModule.openWaypointCreator()

      ButtonBox
        id: recordingButton
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        font: cipsoftFont
        !text: 'Not Recording'
        height: 20
        color: $var-text-cip-color-light-red
        text-offset: 1 2
        checked: false
        margin-top: 3
        @onCheckChange: modules.game_helper.hunting_recorderModule.onRecordingChange(self)

        $!checked:
          color: $var-text-cip-color-light-red
          text-offset: 1 1
          change-cursor-image: false
          !text: 'Not Recording'

        $checked:
          color: $var-text-cip-color-green
          text-offset: 2 2
          change-cursor-image: false
          !text: 'Recording'

      HelperCheckBox
        id: startFromNearestCheckBox
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        !text: tr('Start from nearest')
        margin-top: 5
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 15 0
        change-cursor-image: false
        checked: true
        $hover !disabled:
          color: $var-text-cip-color

      HelperCheckBox
        id: debugPosCheckBox
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        !text: tr('DEBUG POS')
        margin-top: 5
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 15 0
        change-cursor-image: false
        @onCheckChange: modules.game_helper.hunting_recorderModule.onDebugPosChange(self)
        $hover !disabled:
          color: $var-text-cip-color

      HelperCheckBox
        id: enableCaveBot
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        !text: tr('Enable Cavebot')
        margin-top: 5
        font: $var-cip-font
        color: $var-text-cip-color
        text-offset: 15 0
        @onCheckChange: modules.game_helper.hunting_recorderModule.toggleCavebot(self)
        change-cursor-image: false
        $hover !disabled:
          color: $var-text-cip-color

  UIWidget
    id: settings
    image-source: /images/ui/panel_flat
    image-border: 1
    anchors.left: parent.left
    anchors.top: map.bottom
    anchors.right: buttons.left
    anchors.bottom: parent.bottom
    margin-top: 5
    margin-right: 5

    Label
      id: title
      !text: 'Waypoints List'
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      text-horizontal-auto-resize: true
      margin-top: 2
      phantom: true
      color: $var-text-cip-color-grey

    UIWidget
      id: main
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-bottom: 25
      margin-top: 22
      margin-left: 5
      margin-right: 5
      padding: 0
      padding-top: 1

      UIWidget
        id: waypoints
        anchors.fill: parent

        UIWidget
          id: tabsContainer
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 25
          margin-bottom: 3

          HelperButton
            id: waypointsTab
            !text: tr('Waypoints')
            anchors.left: parent.left
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            width: 173
            checked: true
            @onClick: modules.game_helper.hunting_recorderModule.switchToWaypointsTab()

          HelperButton
            id: specialsTab
            !text: tr('Specials')
            anchors.left: waypointsTab.right
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            width: 173
            checked: false
            !tooltip: tr("Special Areas: tiles marked as BLOCKED.\nThe cavebot AVOIDS these tiles when pathfinding -\nuse them to steer around traps, holes or dangerous spots.\nMark them with the 'Special Area' button in the waypoint creator.")
            @onClick: modules.game_helper.hunting_recorderModule.switchToSpecialsTab()

            UIWidget
              id: specialsTabHelp
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
              margin-right: 6
              size: 12 12
              phantom: true
              image-source: /images/icons/show_gui_help_grey

        ScrollablePanel
          id: list
          vertical-scrollbar: listScrollBar
          padding: 0
          background-color: #00000040
          anchors.top: tabsContainer.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: waypointButtons.top
          margin-bottom: 5
          layout:
            type: verticalBox

        HelperScrollBar
          id: listScrollBar
          anchors.top: list.top
          anchors.bottom: list.bottom
          anchors.right: list.right
          step: 18
          pixels-scroll: true

        ScrollablePanel
          id: specialList
          vertical-scrollbar: specialListScrollBar
          padding: 0
          background-color: #00000040
          anchors.top: tabsContainer.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: waypointButtons.top
          margin-bottom: 5
          layout:
            type: verticalBox
          visible: false

        HelperScrollBar
          id: specialListScrollBar
          anchors.top: specialList.top
          anchors.bottom: specialList.bottom
          anchors.right: specialList.right
          step: 18
          pixels-scroll: true
          visible: false

        UIWidget
          id: waypointButtons
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 55

          HelperButton
            id: deleteWaypointButton
            !text: tr('Delete')
            anchors.left: parent.left
            anchors.bottom: parent.bottom
            margin-left: 10
            width: 90
            height: 20
            @onClick: modules.game_helper.hunting_recorderModule.deleteSelectedWaypoint()

          HelperButton
            id: openCavebotLogButton
            !text: tr('Log')
            anchors.left: parent.left
            anchors.bottom: deleteWaypointButton.top
            margin-left: 10
            margin-bottom: 3
            width: 90
            height: 20
            color: $var-text-cip-color-yellow
            @onClick: modules.game_helper.hunting_recorderModule.openCavebotLog()

          HelperButton
            id: clearWaypointsButton
            !text: tr('Clear')
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            margin-right: 10
            width: 90
            height: 20
            @onClick: modules.game_helper.hunting_recorderModule.clearAllWaypoints()

          HelperButton
            id: showSpecialAreasButton
            !text: tr('Specials')
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.bottom: parent.bottom
            width: 90
            height: 20
            visible: false
            @onClick: modules.game_helper.hunting_recorderModule.toggleSpecialAreasList()

        UIWidget
          id: specialButtons
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 55
          visible: false

          HelperButton
            id: deleteSpecialAreaButton
            !text: tr('Delete')
            anchors.left: parent.left
            anchors.bottom: parent.bottom
            margin-left: 10
            width: 90
            height: 20
            @onClick: modules.game_helper.hunting_recorderModule.deleteSelectedSpecialArea()

          HelperButton
            id: addSpecialAreaButton
            !text: tr('Add Special')
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            margin-right: 10
            width: 90
            height: 20
            @onClick: modules.game_helper.hunting_recorderModule.createSpecialAreaWaypoint()

          HelperButton
            id: backToWaypointsButton
            !text: tr('Waypoints')
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            margin-right: 10
            width: 90
            height: 20
            visible: false
            @onClick: modules.game_helper.hunting_recorderModule.toggleSpecialAreasList()
