DraggableSpellIcon < UIWidget
  id: moveableImage
  size: 32 32
  draggable: true

SpellListData < UIWidget
  size: 155 35
  background-opacity: 0.85

  UIWidget
    id: fixedImage
    size: 32 32
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 2
    margin-left: 2
    phantom: true
    image-source: /images/game/spells/spell-icons-32x32

  DraggableSpellIcon
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 2
    margin-left: 2

  UIWidget
    id: name
    font: $var-cip-font
    color: $var-text-cip-color
    anchors.left: fixedImage.right
    anchors.top: parent.top
    margin-top: 4
    margin-left: 2
    text-auto-resize: true
  UIWidget
    id: words
    font: $var-cip-font
    color: $var-text-cip-color
    anchors.left: fixedImage.right
    anchors.top: prev.bottom
    margin-top: -1
    margin-left: 2
    text-auto-resize: true

SpellListWindow
  id: spellListWidget
  !text: tr('Spell List')
  font: $var-cip-font
  text-offset: 20 0
  height: 251
  icon: /images/icons/icon-spell-list-widget
  focusable: true

  SpellListContents
    height: 38
    padding-right: 1
    padding-left: 2
    padding-bottom: 1
    layout: verticalBox

    Label
      id: emptySpellList
      height: 22
      text-align: center
      focusable: false
      color: $var-cip-inactive-color
      !text: tr('No spells available')

  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder
    size: 14 14
    margin-left: 2
    margin-bottom: 2
