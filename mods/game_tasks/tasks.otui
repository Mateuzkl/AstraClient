HeadlessWindow
  id: tasksWindow
  size: 740 540
  anchors.verticalCenter: parent.verticalCenter
  anchors.horizontalCenter: parent.horizontalCenter
  draggable: false
  image-source: /images/ui/window_headless
  image-border: 5
  padding: 5

  // --- Header: Title ---
  Label
    id: titleLabel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 8
    margin-left: 8
    font: $var-cip-font
    color: $var-text-cip-color-grey
    text: Task Manager
    text-auto-resize: true

  // --- Header: Close Button (helper X) ---
  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 3
    margin-right: 3
    size: 20 20
    background-color: #4d4d4d
    border-width: 1
    text: X
    font: $var-cip-font
    color: $var-text-cip-color-light-red
    text-align: center
    text-offset: 0 -1
    @onClick: modules.game_tasks.toggle()
    !tooltip: tr('Close')
    $hover !disabled:
      background-color: #4d4d4d
      color: $var-text-cip-color-light-red
    $pressed:
      background-color: #363636
      color: $var-text-cip-color-light-red
      text-offset: 1 0

  // --- Stats Row ---
  Panel
    id: statsRow
    anchors.top: titleLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 20

    Label
      id: activeCount
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      font: $var-cip-font
      color: $var-text-cip-color-green
      text: Active: 0/2
      text-auto-resize: true

    // Task Enhancement toggle (server-side "renewer"; renamed in the UI only).
    FilterButtonTasks
      id: autoRenewToggle
      anchors.left: activeCount.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 18
      size: 180 20
      @onClick: modules.game_tasks.toggleAutoRenew()

      Label
        id: autoRenewLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 10
        font: $var-cip-font
        color: $var-text-cip-color-grey
        text: Task Enhancement:
        text-auto-resize: true
        phantom: true

      Label
        id: autoRenewState
        anchors.left: autoRenewLabel.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        font: $var-cip-font
        color: $var-text-cip-color-light-red
        text: OFF
        text-auto-resize: true
        phantom: true

    // Boost Reward action + counter (server-driven). Sits next to Task Enhancement.
    TaskButton
      id: boostRewardBtn
      anchors.left: autoRenewToggle.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      size: 104 20
      text: Boost Reward
      color: $var-text-cip-color-orange
      @onClick: modules.game_tasks.boostReward()

    Label
      id: boostedRewards
      anchors.left: boostRewardBtn.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      font: $var-cip-font
      color: $var-text-cip-color-orange
      text: Boosted Rewards: 0
      text-auto-resize: true

    Label
      id: completedToday
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true

  // --- Top Separator ---
  UIWidget
    id: topSeparator
    anchors.top: statsRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 1
    background-color: #ffffff10
    phantom: true

  // --- Controls Row (Tabs + Search) ---
  Panel
    id: header
    anchors.top: topSeparator.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 22

    Panel
      id: tabsPanel
      anchors.top: parent.top
      anchors.left: parent.left
      height: 22
      width: 280

      TabButtonTasks
        id: tabActive
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 90 22
        text: Active
        @onClick: modules.game_tasks.setTab('active')

      TabButtonTasks
        id: tabAll
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        size: 90 22
        text: All Tasks
        @onClick: modules.game_tasks.setTab('all')

      TabButtonTasks
        id: tabShop
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        size: 90 22
        text: Shop
        @onClick: modules.game_tasks.setTab('shop')

    Panel
      id: searchPanel
      anchors.top: parent.top
      anchors.left: tabsPanel.right
      anchors.right: parent.right
      height: 22
      margin-left: 8

      TaskTextEdit
        id: searchInput
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        placeholder: Search by monster name...
        placeholder-color: #60606088

  // --- Results count (atualizado por updateTaskList) ---
  Label
    id: resultsCount
    anchors.top: header.bottom
    anchors.right: parent.right
    margin-top: 4
    margin-right: 8
    font: $var-cip-font
    color: $var-text-cip-color-grey
    text: ''
    text-auto-resize: true

  // --- Task Grid ---
  ScrollablePanel
    id: taskList
    anchors.top: resultsCount.bottom
    anchors.left: parent.left
    anchors.right: taskListScroll.left
    anchors.bottom: bottomSeparator.top
    margin-top: 6
    margin-bottom: 6
    margin-right: 6
    padding: 6
    vertical-scrollbar: taskListScroll
    background-color: #363636
    border-width: 1
    layout:
      type: grid
      cell-size: 217 185
      cell-spacing: 6
      flow: true

  TaskShopVerticalScrollBar
    id: taskListScroll
    anchors.top: resultsCount.bottom
    anchors.right: parent.right
    anchors.bottom: bottomSeparator.top
    margin-top: 6
    margin-bottom: 6
    margin-right: 4
    step: 28

  // --- Shop tier tabs (one per token: common / rare / legendary). Lua fills sprite+count. ---
  Panel
    id: shopTabs
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 26
    visible: false

    ShopTierTab
      id: shopTier1
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      width: 236
      @onClick: modules.game_tasks.setShopTier(1)

    ShopTierTab
      id: shopTier2
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: prev.right
      margin-left: 6
      width: 236
      @onClick: modules.game_tasks.setShopTier(2)

    ShopTierTab
      id: shopTier3
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: prev.right
      margin-left: 6
      width: 236
      @onClick: modules.game_tasks.setShopTier(3)

  // --- Shop Grid ---
  ScrollablePanel
    id: shopList
    anchors.top: shopTabs.bottom
    anchors.left: parent.left
    anchors.right: shopListScroll.left
    anchors.bottom: bottomSeparator.top
    margin-top: 6
    margin-bottom: 6
    margin-right: 6
    padding: 6
    vertical-scrollbar: shopListScroll
    background-color: #363636
    border-width: 1
    visible: false
    layout:
      type: grid
      cell-size: 217 72
      cell-spacing: 6
      flow: true

  TaskShopVerticalScrollBar
    id: shopListScroll
    anchors.top: shopTabs.bottom
    anchors.right: parent.right
    anchors.bottom: bottomSeparator.top
    margin-top: 6
    margin-bottom: 6
    margin-right: 4
    step: 28
    visible: false

  // --- Bottom Separator ---
  UIWidget
    id: bottomSeparator
    anchors.bottom: footer.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 8
    height: 1
    background-color: #ffffff10
    phantom: true

  // --- Footer Buttons ---
  Panel
    id: footer
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 2
    height: 22

    TaskButton
      id: btnStart
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 80 22
      text: Start
      color: $var-text-cip-color-green
      visible: false
      @onClick: modules.game_tasks.startTask()

    TaskButton
      id: btnAbort
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 80 22
      text: Abort
      color: $var-text-cip-color-light-red
      visible: false
      @onClick: modules.game_tasks.abortTask()

    TaskButton
      id: btnFinish
      anchors.left: btnAbort.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      size: 80 22
      text: Finish
      color: $var-text-cip-color-green
      visible: false
      @onClick: modules.game_tasks.finishTask()

    Label
      id: messageLabel
      anchors.left: btnFinish.right
      anchors.right: btnRefresh.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      margin-right: 10
      font: $var-cip-font
      color: $var-text-cip-color
      text-wrap: true

    TaskButton
      id: btnClose
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 80 22
      text: Close
      @onClick: modules.game_tasks.toggle()

    TaskButton
      id: btnTracker
      anchors.right: btnClose.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      size: 80 22
      text: Tracker
      @onClick: modules.game_tasks.toggleTracker()

    TaskButton
      id: btnRefresh
      anchors.right: btnTracker.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      size: 80 22
      text: Refresh
      @onClick: modules.game_tasks.refresh()

  // ============================
  // Details Overlay Panel
  // ============================
  Panel
    id: detailsPanel
    anchors.fill: parent
    visible: false
    background-color: #3f3f3f
    border-width: 1
    padding: 12

    // --- Detail Header ---
    Label
      id: detailName
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8
      font: $var-cip-font
      color: $var-text-cip-color-yellow
      text-auto-resize: true

    UIWidget
      id: detailTopSeparator
      anchors.top: detailName.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      height: 1
      background-color: #ffffff10
      phantom: true

    // --- Detail Left Info ---
    Label
      id: detailProgress
      anchors.top: detailTopSeparator.bottom
      anchors.left: parent.left
      margin-top: 12
      margin-left: 8
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true

    Label
      id: detailType
      anchors.top: detailProgress.bottom
      anchors.left: parent.left
      margin-top: 4
      margin-left: 8
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true

    Label
      id: detailBoostedLevel
      anchors.top: detailType.bottom
      anchors.left: parent.left
      margin-top: 4
      margin-left: 8
      font: $var-cip-font
      color: $var-text-cip-color-orange
      text-auto-resize: true
      visible: false

    Label
      id: detailLevelPick
      anchors.top: detailBoostedLevel.bottom
      anchors.left: parent.left
      margin-top: 4
      margin-left: 8
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true
      visible: false

    Label
      id: detailLevelDeliver
      anchors.top: detailLevelPick.bottom
      anchors.left: parent.left
      margin-top: 4
      margin-left: 8
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true
      visible: false

    Label
      id: detailCompletions
      anchors.top: detailLevelDeliver.bottom
      anchors.left: parent.left
      margin-top: 4
      margin-left: 8
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text-auto-resize: true

    // --- Detail Right Info ---
    Label
      id: detailReward
      anchors.top: detailTopSeparator.bottom
      anchors.right: parent.right
      margin-top: 12
      margin-right: 8
      font: $var-cip-font
      color: $var-text-cip-color-yellow
      text-auto-resize: true

    Label
      id: detailCost
      anchors.top: detailReward.bottom
      anchors.right: parent.right
      margin-top: 4
      margin-right: 8
      font: $var-cip-font
      color: $var-text-cip-color-light-red
      text-auto-resize: true

    // --- Creature Display ---
    UICreature
      id: detailCreature
      size: 100 100
      anchors.top: detailCompletions.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 16
      phantom: true

    // --- Creatures List ---
    Label
      id: detailMobsTitle
      anchors.top: detailCreature.bottom
      anchors.left: parent.left
      margin-top: 20
      margin-left: 30
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text: Creatures:
      text-auto-resize: true
      visible: false

    // Fixed 3-column grid (flow:false so num-columns is honored; flow would
    // recompute columns from width and ignore it). Bottom stops at the rewards
    // title so the list scrolls when a task has many creatures.
    ScrollablePanel
      id: detailMobsGrid
      anchors.top: detailMobsTitle.bottom
      anchors.left: parent.left
      anchors.right: detailMobsScroll.left
      anchors.bottom: detailRewardsTitle.top
      margin-top: 6
      margin-bottom: 8
      margin-left: 30
      margin-right: 4
      padding: 2
      vertical-scrollbar: detailMobsScroll
      layout:
        type: grid
        cell-size: 205 18
        cell-spacing: 3
        num-columns: 3
        flow: false

    TaskShopVerticalScrollBar
      id: detailMobsScroll
      anchors.top: detailMobsTitle.bottom
      anchors.right: parent.right
      anchors.bottom: detailRewardsTitle.top
      margin-top: 6
      margin-bottom: 8
      margin-right: 8
      step: 21

    // --- Rewards (item sprite + qty + name) ---
    Label
      id: detailRewardsTitle
      anchors.left: parent.left
      anchors.bottom: detailRewardsList.top
      margin-left: 30
      margin-bottom: 3
      font: $var-cip-font
      color: $var-text-cip-color-grey
      text: Rewards:
      text-auto-resize: true
      visible: false

    Panel
      id: detailRewardsList
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: detailBottomSeparator.top
      margin-left: 30
      margin-right: 8
      margin-bottom: 6
      height: 58
      layout:
        type: horizontalBox
        spacing: 6

    // --- Detail Bottom Separator ---
    UIWidget
      id: detailBottomSeparator
      anchors.bottom: detailActions.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 8
      height: 1
      background-color: #ffffff10
      phantom: true

    // --- Detail Action Buttons ---
    Panel
      id: detailActions
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 4
      height: 22

      TaskButton
        id: detailBtnStart
        size: 90 22
        text: Start
        color: $var-text-cip-color-green
        visible: false
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        @onClick: modules.game_tasks.startTask()

      TaskButton
        id: detailBtnFinish
        size: 90 22
        text: Finish
        color: $var-text-cip-color-green
        visible: false
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        @onClick: modules.game_tasks.finishTask()

      TaskButton
        id: detailBtnAbort
        size: 90 22
        text: Abort
        color: $var-text-cip-color-light-red
        visible: false
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        @onClick: modules.game_tasks.abortTask()

      TaskButton
        id: detailBtnBack
        size: 90 22
        text: Back
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 8
        @onClick: modules.game_tasks.hideDetailsPanel()
