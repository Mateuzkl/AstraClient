TaskTracker < MiniWindow
  id: taskTracker
  !text: tr('Task Tracker')
  icon: /images/options/taskIcon
  @onOpen: modules.game_tasks.onTrackerOpen()
  @onClose: modules.game_tasks.onTrackerClose()

  MiniWindowContents
    id: contentsPanel
    anchors.top: miniwindowTopBar.bottom
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    anchors.bottom: parent.bottom
    margin-left: 3
    margin-top: -2
    margin-right: 1
    vertical-scrollbar: miniwindowScrollBar
    padding-left: 5
    padding-right: 5
    padding-bottom: 3
    layout: verticalBox
