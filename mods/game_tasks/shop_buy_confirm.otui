// ========== Task Shop Buy Confirm Modal (CipSoft-12 dark theme, matches game_helper) ==========
// Confirmacao para evitar compra acidental no shop de Task Tokens.
// Comentarios em OTUI usam // (memoria feedback_otui_comments_double_slash).

NewMainWindow
  id: shopBuyConfirmWindow
  !text: tr('Confirm Purchase')
  size: 400 200
  focusable: true
  @onEscape: modules.game_tasks.cancelShopBuy()

  // --- Title (Lua setText + setColor) ---
  Label
    id: shopBuyConfirmTitle
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    font: $var-cip-font
    color: $var-text-cip-color-yellow
    text: Confirm Purchase
    text-auto-resize: true

  // --- Message (Lua setText) ---
  Label
    id: shopBuyConfirmMessage
    anchors.top: shopBuyConfirmTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: shopBuyActions.top
    margin-top: 8
    margin-bottom: 8
    margin-left: 10
    margin-right: 10
    font: $var-cip-font
    color: $var-text-cip-color
    text-align: center
    text-wrap: true
    text: Confirm?

  Panel
    id: shopBuyActions
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 8
    margin-right: 8
    margin-bottom: 8
    height: 22

    TaskButton
      id: shopBuyBtnNo
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 64 22
      text: Cancel
      @onClick: modules.game_tasks.cancelShopBuy()

    TaskButton
      id: shopBuyBtnYes
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 64 22
      text: Buy
      color: $var-text-cip-color-green
      @onClick: modules.game_tasks.confirmShopBuy()
