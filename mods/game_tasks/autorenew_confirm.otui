// ========== Auto-Renew Confirm Modal (CipSoft-12 dark theme, matches game_helper) ==========

NewMainWindow
  id: autoRenewConfirmWindow
  !text: tr('Auto-Renew')
  size: 400 190
  focusable: true
  @onEscape: modules.game_tasks.cancelAutoRenew()
  @onEnter: modules.game_tasks.confirmAutoRenew()

  // --- Title (Lua setText + setColor: green when enabling, red when disabling) ---
  Label
    id: autoRenewConfirmTitle
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    font: $var-cip-font
    color: $var-text-cip-color-green
    text: Enable Auto-Renew
    text-auto-resize: true

  // --- Message (Lua setText) ---
  Label
    id: autoRenewConfirmMessage
    anchors.top: autoRenewConfirmTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: autoRenewActions.top
    margin-top: 8
    margin-bottom: 8
    margin-left: 10
    margin-right: 10
    font: $var-cip-font
    color: $var-text-cip-color
    text-align: center
    text-wrap: true
    text: Do you want to enable automatic task renewal?

  Panel
    id: autoRenewActions
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 8
    margin-right: 8
    margin-bottom: 8
    height: 22

    TaskButton
      id: autoRenewBtnNo
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 60 22
      text: No
      @onClick: modules.game_tasks.cancelAutoRenew()

    TaskButton
      id: autoRenewBtnYes
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 60 22
      text: Yes
      @onClick: modules.game_tasks.confirmAutoRenew()
