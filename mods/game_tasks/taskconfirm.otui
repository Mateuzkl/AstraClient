// ========== Task Confirm Modal (CipSoft-12 dark theme, matches game_helper) ==========

NewMainWindow
  id: taskConfirmWindow
  !text: tr('Abort Task')
  size: 340 150
  focusable: true
  @onEscape: modules.game_tasks.closeConfirmModal()

  // --- Title (kept for id contract; colored heading) ---
  Label
    id: confirmTitle
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    font: $var-cip-font
    color: $var-text-cip-color-light-red
    text: Abort Task
    text-auto-resize: true

  // --- Message ---
  Label
    id: confirmMessage
    anchors.top: confirmTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: confirmActions.top
    margin-top: 8
    margin-bottom: 8
    margin-left: 10
    margin-right: 10
    font: $var-cip-font
    color: $var-text-cip-color
    text-align: center
    text-wrap: true
    text: Are you sure you want to abort this task?\nAll progress will be lost.

  // --- Action Buttons ---
  Panel
    id: confirmActions
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 8
    margin-right: 8
    margin-bottom: 8
    height: 22

    TaskButton
      id: confirmBtnNo
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 60 22
      text: No
      @onClick: modules.game_tasks.closeConfirmModal()

    TaskButton
      id: confirmBtnYes
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 60 22
      text: Yes
      color: $var-text-cip-color-light-red
      @onClick: modules.game_tasks.confirmAbortTask()
