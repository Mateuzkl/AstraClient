// ========== Task Pay Confirm Modal (CipSoft-12 dark theme, matches game_helper) ==========
// Confirmacao de cobranca quando player pega task pela segunda vez no dia.
// Comentarios em OTUI usam // (memoria feedback_otui_comments_double_slash).

NewMainWindow
  id: taskPayConfirmWindow
  !text: tr('Renew Task')
  size: 400 190
  focusable: true
  @onEscape: modules.game_tasks.cancelPayTask()

  // --- Title (Lua setText + setColor) ---
  Label
    id: taskPayConfirmTitle
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    font: $var-cip-font
    color: $var-text-cip-color-yellow
    text: Renew Task
    text-auto-resize: true

  // --- Message (Lua setText) ---
  Label
    id: taskPayConfirmMessage
    anchors.top: taskPayConfirmTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: taskPayActions.top
    margin-top: 8
    margin-bottom: 8
    margin-left: 10
    margin-right: 10
    font: $var-cip-font
    color: $var-text-cip-color
    text-align: center
    text-wrap: true
    text: You already did this task today.\nRenew for X gold?

  Panel
    id: taskPayActions
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 8
    margin-right: 8
    margin-bottom: 8
    height: 22

    TaskButton
      id: taskPayBtnNo
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 64 22
      text: Cancel
      @onClick: modules.game_tasks.cancelPayTask()

    TaskButton
      id: taskPayBtnYes
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 64 22
      text: Pay
      @onClick: modules.game_tasks.confirmPayTask()
