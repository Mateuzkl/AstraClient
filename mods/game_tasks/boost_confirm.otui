// ========== Boost Reward Confirm Modal (CipSoft-12 dark theme, matches game_helper) ==========

NewMainWindow
  id: boostRewardConfirmWindow
  !text: tr('Boost Reward')
  color: #c08040
  size: 400 210
  focusable: true
  @onEscape: modules.game_tasks.cancelBoostReward()
  @onEnter: modules.game_tasks.confirmBoostReward()

  // --- Message (Lua setText) ---
  Label
    id: boostRewardConfirmMessage
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: boostRewardSkip.top
    margin-top: 8
    margin-bottom: 8
    margin-left: 10
    margin-right: 10
    font: $var-cip-font
    color: $var-text-cip-color
    text-align: center
    text-wrap: true
    text: Do you want to use a reward boost on your next task?

  // --- "Don't ask again" -> future purchases go straight through ---
  CheckBox
    id: boostRewardSkip
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: boostRewardActions.top
    margin-bottom: 8
    size: 320 16
    font: $var-cip-font
    text: Don't ask again (buy directly next time)

  Panel
    id: boostRewardActions
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 8
    margin-right: 8
    margin-bottom: 8
    height: 22

    TaskButton
      id: boostRewardBtnNo
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 60 22
      text: No
      @onClick: modules.game_tasks.cancelBoostReward()

    TaskButton
      id: boostRewardBtnYes
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 60 22
      text: Yes
      color: $var-text-cip-color-orange
      @onClick: modules.game_tasks.confirmBoostReward()
