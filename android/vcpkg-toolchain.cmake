# Entry point for Gradle/CMake. Never mix the old C:/android C++17 libraries
# with current libc++; build both supported ABIs and every dependency with NDK.
set(_astra_ndk "${ANDROID_NDK}")
if(NOT _astra_ndk)
    set(_astra_ndk "$ENV{ANDROID_NDK_HOME}")
endif()
if(NOT EXISTS "${_astra_ndk}/build/cmake/android.toolchain.cmake")
    message(FATAL_ERROR "Set ANDROID_NDK (or ANDROID_NDK_HOME) to NDK r28+.")
endif()
if(ANDROID_ABI STREQUAL "arm64-v8a")
    set(VCPKG_TARGET_TRIPLET astra-arm64-android CACHE STRING "" FORCE)
elseif(ANDROID_ABI STREQUAL "armeabi-v7a")
    set(VCPKG_TARGET_TRIPLET astra-arm-android CACHE STRING "" FORCE)
else()
    message(FATAL_ERROR "Supported Android ABIs: arm64-v8a and armeabi-v7a.")
endif()
set(VCPKG_OVERLAY_TRIPLETS "${CMAKE_CURRENT_LIST_DIR}/triplets" CACHE STRING "" FORCE)
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${_astra_ndk}/build/cmake/android.toolchain.cmake" CACHE FILEPATH "" FORCE)
set(ENV{ANDROID_NDK_HOME} "${_astra_ndk}")
include("$ENV{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
