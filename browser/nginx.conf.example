# Browser bundle and WebSocket-to-TCP bridge front end.
# Replace paths/upstreams/hostnames and issue a real TLS certificate.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream astra_game_websocket_bridge {
    # websockify (or another binary-transparent bridge), not the raw TFS port.
    server 127.0.0.1:7173;
}

server {
    listen 443 ssl http2;
    server_name play.example.com;
    root /srv/astraclient;

    ssl_certificate     /etc/letsencrypt/live/play.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/play.example.com/privkey.pem;

    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Embedder-Policy require-corp always;
    add_header Cross-Origin-Resource-Policy same-origin always;
    add_header X-Content-Type-Options nosniff always;

    types { application/wasm wasm; }

    location / {
        try_files $uri $uri/ =404;
    }

    location /game {
        proxy_pass http://astra_game_websocket_bridge;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }
}
