# Browser bundle and WebSocket-to-TCP bridge front end.
# Include inside http {}. Replace domain, root, certificates and upstreams.
# Valores iniciais: ajustar para jogadores atras de NAT; Origin nao substitui autenticacao.
map $http_origin $astra_origin_allowed {
    default 0;
    "https://play.example.com" 1;
}
limit_req_zone $binary_remote_addr zone=astra_handshake:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=astra_connections:10m;
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream astra_game_websocket_bridge {
    # websockify (or another binary-transparent bridge), not the raw TFS port.
    server 127.0.0.1:7173;
}

upstream astra_login_websocket_bridge {
    # Separate bridge to the TCP login port (7171 for classic TFS).
    server 127.0.0.1:7174;
}

server {
    listen 80;
    server_name play.example.com;
    return 308 https://play.example.com$request_uri;
}

server {
    listen 443 ssl;
    # Optional on nginx 1.25.1+ with ngx_http_v2_module: http2 on;
    server_name play.example.com;
    root /srv/astraclient;

    ssl_certificate     /etc/letsencrypt/live/play.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/play.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;
    client_header_timeout 10s;
    client_body_timeout 15s;
    send_timeout 30s;
    # Evita registrar query strings de OAuth/login. Nunca registrar corpos/Authorization.
    access_log off;
    error_log /var/log/nginx/astra-error.log warn;

    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Embedder-Policy require-corp always;
    add_header Cross-Origin-Resource-Policy same-origin always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://play.example.com; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" always;
    # Ativar somente depois de validar o certificado e todos os subdominios relevantes.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    location ~ /\. { return 404; }

    # Keep the inherited MIME table (notably JavaScript with nosniff).
    location ~ \.wasm$ {
        types { application/wasm wasm; }
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location = /game {
        if ($astra_origin_allowed = 0) { return 403; }
        if ($http_upgrade != "websocket") { return 400; }
        limit_req zone=astra_handshake burst=10 nodelay;
        limit_req_status 429;
        limit_conn astra_connections 20;
        limit_conn_status 429;
        proxy_pass http://astra_game_websocket_bridge;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }

    location = /login {
        if ($astra_origin_allowed = 0) { return 403; }
        if ($http_upgrade != "websocket") { return 400; }
        limit_req zone=astra_handshake burst=10 nodelay;
        limit_req_status 429;
        limit_conn astra_connections 20;
        limit_conn_status 429;
        proxy_pass http://astra_login_websocket_bridge;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }
}
